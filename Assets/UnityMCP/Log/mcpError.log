"abyssDepthThreshold\").floatValue = 44f;\n    utcSo.FindProperty(\"sunDepthExtinction\").floatValue = 0.024f;\n    utcSo.FindProperty(\"lowerApronFadeStart\").floatValue = 36f;\n    utcSo.FindProperty(\"lowerApronFadeEnd\").floatValue = 52f;\n    utcSo.FindProperty(\"causticsFadeDepth\").floatValue = 38f;\n    utcSo.ApplyModifiedPropertiesWithoutUndo();\n    EditorUtility.SetDirty(utc);\n    sb.AppendLine(\"UnderwaterTransitionController updated for -28m..-45m bathymetry.\");\n}\n\nAssetDatabase.SaveAssets();\nmm.RegenerateMap();\nsb.AppendLine(\"Map regenerated. Selected pattern = \" + mm.SelectedPatternName);\n\n// Report actual generated terrain stats & vent count\nvar grids = Object.FindObjectsOfType<MapGrid>();\nint islands = 0, plateaus = 0, vents = 0;\nfloat minY = float.MaxValue, maxY = float.MinValue;\nfloat plateauTopY = float.MinValue;\nfor (int i = 0; i < grids.Length; i++)\n{\n    var g = grids[i];\n    if (g.TerrainKind == GridType.Type.Island) islands++;\n    else if (g.TerrainKind == GridType.Type.Plateau)\n    {\n        plateaus++;\n        var mf = g.GetComponent<MeshFilter>();\n        if (mf != null && mf.sharedMesh != null)\n        {\n            var b = mf.sharedMesh.bounds;\n            if (b.max.y > plateauTopY) plateauTopY = b.max.y;\n        }\n    }\n    var mr = g.GetComponent<MeshRenderer>();\n    if (mr != null)\n    {\n        if (mr.bounds.min.y < minY) minY = mr.bounds.min.y;\n        if (mr.bounds.max.y > maxY) maxY = mr.bounds.max.y;\n    }\n    var trs = g.GetComponentsInChildren<Transform>(true);\n    for (int j = 0; j < trs.Length; j++)\n        if (trs[j].name.StartsWith(\"Hydrothermal Vent\")) vents++;\n}\nsb.AppendLine(\"Grids: total=\" + grids.Length + \" islands=\" + islands + \" plateaus=\" + plateaus\n    + \" vents=\" + vents + \" meshY=[\" + minY.ToString(\"F2\") + \"..\" + maxY.ToString(\"F2\")\n    + \"] plateauMeshMaxY=\" + plateauTopY.ToString(\"F2\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"c