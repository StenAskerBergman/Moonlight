{"ts":"2026-11-15T17:29:24.434Z","tool":"execute_code","type":"tool","status":"ERROR","ms":978,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar camRig = GameObject.Find(\"Camera Rig\");\nsb.AppendLine(\"=== CAMERA RIG ===\");\nif (camRig != null) {\n    sb.AppendLine($\"Camera Rig pos={camRig.transform.position}, scale={camRig.transform.localScale}\");\n    foreach (Transform c in camRig.transform) {\n        var comps = string.Join(\", \", System.Array.ConvertAll(c.GetComponents<Component>(), x => x ? x.GetType().Name : \"null\"));\n        sb.AppendLine($\"  child {c.name} act={c.gameObject.activeSelf} pos={c.position} localPos={c.localPosition} comps=[{comps}]\");\n        foreach (Transform gc in c) {\n            sb.AppendLine($\"    grandchild {gc.name} act={gc.gameObject.activeSelf} localPos={gc.localPosition}\");\n        }\n    }\n}\nsb.AppendLine(\"=== ALL LINERENDERERS IN SCENE ===\");\nforeach (var lr in Object.FindObjectsOfType<LineRenderer>(true)) {\n    var matName = lr.sharedMaterial ? lr.sharedMaterial.name : \"null\";\n    sb.AppendLine($\"LR go={lr.gameObject.name} parent={(lr.transform.parent?lr.transform.parent.name:\"none\")} actH={lr.gameObject.activeInHierarchy} en={lr.enabled} pos={lr.transform.position} world={lr.useWorldSpace} count={lr.positionCount} mat={matName} w=({lr.startWidth},{lr.endWidth})\");\n}\nsb.AppendLine(\"=== BOAT & ALL UNITS ===\");\nforeach (var u in Object.FindObjectsOfType<Unit>(true)) {\n    sb.AppendLine($\"Unit {u.name} actH={u.gameObject.activeInHierarchy} pos={u.transform.position} scale={u.transform.localScale}\");\n    foreach (Transform c in u.transform) {\n        var mr = c.GetComponent<MeshRenderer>();\n        var mf = c.GetComponent<MeshFilter>();\n        sb.AppendLine($\"  child {c.name} act={c.gameObject.activeSelf} localPos={c.localPosition} localScale={c.localScale} mesh={(mf&&mf.sharedMesh?mf.sharedMesh.name:\"none\")} mrEn={(mr?mr.enabled.ToStrin