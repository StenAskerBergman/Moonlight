ine.GameObject.Find(\"Player Faction Controller\");\nif (pfc == null) {\n    foreach (var t in UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.Transform>()) {\n        if (!UnityEditor.EditorUtility.IsPersistent(t.gameObject) && t.name == \"Player Faction Controller\") { pfc = t.gameObject; break; }\n    }\n}\nif (pfc != null) {\n    sb.AppendLine(\"=== Player Faction Controller ===\");\n    var ts = pfc.GetComponentsInChildren<UnityEngine.Transform>(true);\n    foreach (var t in ts) {\n        var rt = t as UnityEngine.RectTransform;\n        var cs = t.GetComponents<UnityEngine.Component>();\n        string s = \"\";\n        foreach (var comp in cs) {\n            if (comp is UnityEngine.UI.Image img) s += \"Image(\" + (img.sprite != null ? img.sprite.name : \"null\") + \",col=\" + img.color + \"),\";\n            else if (comp is TMPro.TMP_Text txt) s += \"TMP('\" + txt.text + \"',col=\" + txt.color + \"),\";\n            else if (comp != null && !(comp is UnityEngine.RectTransform) && !(comp is UnityEngine.CanvasRenderer)) s += comp.GetType().Name + \",\";\n        }\n        sb.AppendLine(\"  \" + t.name + \" act=\" + t.gameObject.activeSelf + \" pos=\" + (rt != null ? rt.anchoredPosition.ToString() : \"\") + \" size=\" + (rt != null ? rt.sizeDelta.ToString() : \"\") + \" | \" + s);\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"},"error":"Runtime error: Object reference not set to an instance of an object"}
