eturn \"ERROR: Expected single UW controller on Camera Rig; found \" + remainingUw.Count + (remainingUw.Count > 0 ? \" on \" + remainingUw[0].gameObject.name : \"\");\n}\nvar uw = remainingUw[0];\nvar uwSo = new UnityEditor.SerializedObject(uw);\nstring[] floatNames = new string[] {\n    \"waterHeight\", \"fogDensity\", \"deepDepthThreshold\", \"abyssDepthThreshold\",\n    \"sunDepthExtinction\", \"lowerApronFadeStart\", \"lowerApronFadeEnd\",\n    \"causticsStrength\", \"causticsFadeDepth\", \"debrisDensity\"\n};\nfloat[] floatVals = new float[] {\n    -0.5f, 0.022f, 9.5f, 19f,\n    0.07f, 12f, 26f,\n    0.65f, 18f, 0.45f\n};\n\nvar pWs = uwSo.FindProperty(\"waterSurface\");\nvar pAbs = uwSo.FindProperty(\"absorptionCoefficients\");\nif (pWs == null || pAbs == null) return \"ERROR: Missing UW property waterSurface/absorptionCoefficients.\";\npWs.objectReferenceValue = oceanGo.transform;\npAbs.vector4Value = new UnityEngine.Vector4(0.16f, 0.05f, 0.02f, 0f);\n\nfor (int i = 0; i < floatNames.Length; i++) {\n    var p = uwSo.FindProperty(floatNames[i]);\n    if (p == null) return \"ERROR: Missing UW float property: \" + floatNames[i];\n    p.floatValue = floatVals[i];\n}\nuwSo.ApplyModifiedPropertiesWithoutUndo();\nUnityEditor.EditorUtility.SetDirty(uw);\n\n// 5. Regenerate Map in EditMode\nif (mgr == null) return \"ERROR: MapManager not found.\";\nvar regenMethod = mgrType.GetMethod(\"RegenerateMap\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);\nif (regenMethod == null) return \"ERROR: MapManager.RegenerateMap not found.\";\nregenMethod.Invoke(mgr, null);\n\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(rig.gameObject.scene);\n\n// 6. Inspect regenerated state\nvar grids = findSceneComponents(gridType);\nint plateauGridCount = 0;\nint islandGridCount = 0;\nint oceanGridCount = 0;\nvar propCurrentType = gridType.GetField(\"currentGridType\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);\nfor (int i = 0; i < grids.Count; i++) {\n    if (propCurrentType != null) {\n        var val = propCurrentType.GetValue(grids[i]).ToString();\n        if (val == \"Plateau\") plateauGridCount++;\n        else if (val == \"Island\") islandGridCount++;\n        else if (val == \"Ocean\") oceanGridCount++;\n    }\n}\n\nsb.AppendLine(\"Regenerated MapGrids: total=\" + grids.Count + \", Island=\" + islandGridCount + \", Plateau=\" + plateauGridCount + \", Ocean=\" + oceanGridCount);\n\nvar rend = oceanGo.GetComponent<UnityEngine.Renderer>();\nvar col = oceanGo.GetComponent<UnityEngine.Collider>();\nsb.AppendLine(\"Ocean activeSelf=\" + oceanGo.activeSelf + \", layer=\" + UnityEngine.LayerMask.LayerToName(oceanGo.layer) + \"(\" + oceanGo.layer + \")\");\nif (rend != null) sb.AppendLine(\"Ocean renderer.bounds=\" + rend.bounds);\nif (col != null) sb.AppendLine(\"Ocean collider.enabled=\" + col.enabled + \", bounds=\" + col.bounds);\n\nsb.AppendLine(\"CameraRig: seaLevel=\" + rigSo.FindProperty(\"seaLevel\").floatValue + \", waterSurface=\" + rigSo.FindProperty(\"waterSurface\").objectReferenceValue.name);\nsb.AppendLine(\"UW Controller: waterHeight=\" + uwSo.FindProperty(\"waterHeight\").floatValue\n    + \", waterSurface=\" + uwSo.FindProperty(\"waterSurface\").objectReferenceValue.name\n    + \", absorption=\" + uwSo.FindProperty(\"absorptionCoefficients\").vector4Value\n    + \", fogDensity=\" + uwSo.FindProperty(\"fogDensity\").floatValue\n    + \", deep=\" + uwSo.FindProperty(\"deepDepthThreshold\").floatValue\n    + \", abyss=\" + uwSo.FindProperty(\"abyssDepthThreshold\").floatValue\n    + \", sunExt=\" + uwSo.FindProperty(\"sunDepthExtinction\").floatValue\n    + \", apron=\" + uwSo.FindProperty(\"lowerApronFadeStart\").floatValue + \"..\" + uwSo.FindProperty(\"lowerApronFadeEnd\").floatValue\n    + \", caustics=\" + uwSo.FindProperty(\"causticsStrength\").floatValue + \"@\" + uwSo.FindProperty(\"causticsFadeDepth\").floatValue\n    + \", debris=\" + uwSo.FindProperty(\"debrisDensity\").floatValue);\n\nsb.AppendLine(\"scriptCompilationFailed=\" + UnityEditor.EditorUtility.scriptCompilationFailed);\n\nstring[] shaderNames = new string[] {\n    \"Hidden/Moonlight/UnderwaterTransition\",\n    \"Custom/UnderwaterPlateauMaterial\",\n    \"Universal Render Pipeline/Particles/Unlit\"\n};\nfor (int i = 0; i < shaderNames.Length; i++) {\n    var sh = UnityEngine.Shader.Find(shaderNames[i]);\n    if (sh == null) {\n        sb.AppendLine(\"Shader '\" + shaderNames[i] + \"': NOT FOUND\");\n    } else {\n        int msgCount = UnityEditor.ShaderUtil.GetShaderMessageCount(sh);\n        sb.AppendLine(\"Shader '\" + shaderNames[i] + \"': isSupported=\" + sh.isSupported + \", messageCount=\" + msgCount);\n        var msgs = UnityEditor.ShaderUtil.GetShaderMessages(sh);\n        for (int m = 0; m < msgs.Length; m++) {\n            sb.AppendLine(\"  [\" + msgs[m].severity + \"] L\" + msgs[m].line + \": \" + msgs[m].message);\n        }\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"},"error":"Runtime error: This cannot be used during play mode."}
