{"ts":"2026-11-15T19:01:15.182Z","tool":"execute_code","type":"tool","status":"ERROR","ms":8259,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\n// ---------------------------------------------------------------------------\n// 1. Polish Depot.prefab craneYaw -> 16 deg + re-render verify_depot.png\n// ---------------------------------------------------------------------------\nstring depotPath = \"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/Depot.prefab\";\nMaterial matSteel = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Buildings/Depot/Depot_Steel_Mat.mat\");\nMaterial matOchre = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Buildings/Depot/Depot_OchreTrim_Mat.mat\");\nMaterial matEmissive = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Buildings/Depot/Depot_EmissiveBay_Mat.mat\");\n\nGameObject depotRoot = PrefabUtility.LoadPrefabContents(depotPath);\ntry\n{\n    Transform holder = depotRoot.transform.Find(\"Model - Placeholder\");\n    if (holder != null)\n    {\n        Vector3 cranePivot = new Vector3(0.68f, 0f, 0.62f);\n        float craneYaw = 16f;\n        float boomTilt = -32f;\n        float boomLen = 0.68f;\n        Vector3 boomBase = cranePivot + new Vector3(0f, 0.88f, 0f);\n        Quaternion boomRot = Quaternion.Euler(boomTilt, craneYaw, 0f);\n        Vector3 boomDir = boomRot * Vector3.forward;\n        Vector3 boomMid = boomBase + boomDir * (boomLen * 0.5f);\n        Vector3 boomTip = boomBase + boomDir * boomLen;\n        Vector3 backDir = Quaternion.Euler(0f, craneYaw, 0f) * Vector3.back;\n        Vector3 forwardHoriz = Quaternion.Euler(0f, craneYaw, 0f) * Vector3.forward;\n\n        System.Action<string, Vector3, Vector3, Vector3> movePart = (n, p, s, r) =>\n        {\n            Transform tf = holder.Find(n);\n            if (tf != null)\n            {\n                tf.localPosition = p;\n                tf.localScale = s;\n                tf.localRotation = Quaternion.Euler(r);\n            }\n        };\n        movePart(\"Crane_Turret\", cranePivot + new Vector3(0f, 0.47f, 0f), new Vector3(0.22f, 0.20f, 0.28f), new Vector3(0f, craneYaw, 0f));\n        movePart(\"Crane_CabGlass\", cranePivot + forwardHoriz * 0.125f + new Vector3(0f, 0.50f, 0f), new Vector3(0.15f, 0.08f, 0.04f), new Vector3(0f, craneYaw, 0f));\n        movePart(\"Crane_Counterweight\", cranePivot + backDir * 0.14f + new Vector3(0f, 0.58f, 0f), new Vector3(0.18f, 0.14f, 0.14f), new Vector3(0f, craneYaw, 0f));\n        movePart(\"Crane_Mast\", cranePivot + new Vector3(0f, 0.74f, 0f), new Vector3(0.09f, 0.34f, 0.09f), new Vector3(0f, craneYaw, 0f));\n        movePart(\"Crane_Jib\", boomMid, new Vector3(0.065f, 0.065f, boomLen), new Vector3(boomTilt, craneYaw, 0f));\n        float spreaderY = 0.72f;\n        float cableH = boomTip.y - spreaderY;\n        movePart(\"Crane_Cable\", new Vector3(boomTip.x, spreaderY + cableH * 0.5f, boomTip.z), new Vector3(0.015f, cableH * 0.5f, 0.015f), Vector3.zero);\n        movePart(\"Crane_HookSpreader\", new Vector3(boomTip.x, spreaderY, boomTip.z), new Vector3(0.16f, 0.04f, 0.10f), new Vector3(0f, craneYaw, 0f));\n        PrefabUtility.SaveAsPrefabAsset(depotRoot, depotPath);\n        sb.AppendLine(\"1. Polished Depot crane yaw -> 16 deg.\");\n    }\n}\nfinally\n{\n    PrefabUtility.UnloadPrefabContents(depotRoot);\n}\n\n// ---------------------------------------------------------------------------\n// 2. Create crisp circular SelectionRing.png & configure SelectionMarker.mat\n// ---------------------------------------------------------------------------\nif (!AssetDatabase.IsValidFolder(\"Assets/Textures\")) AssetDatabase.CreateFolder(\"Assets\", \"Textures\");\nif (!AssetDatabase.IsValidFolder(\"Assets/Textures/UI\")) AssetDatabase.CreateFolder(\"Assets/Textures\", \"UI\");\nstring ringPngAssetPath = \"Assets/Textures/UI/SelectionRing.png\";\nstring ringFullPath = System.IO.Path.GetFullPath(ringPngAssetPath);\n\nint size = 256;\nTexture2D ringTex = new Texture2D(size, size, TextureFormat.RGBA32, false);\ntry\n{\n    Color32[] pixels = new Color32[size * size];\n    float half = (size - 1) * 0.5f;\n    for (int y = 0; y < size; y++)\n    {\n        for (int x = 0; x < size; x++)\n        {\n            float dx = (x - half) / half;\n            float dy = (y - half) / half;\n            float r = Mathf.Sqrt(dx * dx + dy * dy);\n            float ang = Mathf.Atan2(dy, dx);\n\n            // Crisp outer Anno-style selection ring + soft glow + subtle inner tactical ring + 4 cardinal notches\n            float outerBand = Mathf.Exp(-Mathf.Pow((r - 0.84f) / 0.042f, 2f));\n            float softHalo = Mathf.Exp(-Mathf.Pow((r - 0.84f) / 0.11f, 2f)) * 0.35f;\n            float innerRing = Mathf.Exp(-Mathf.Pow((r - 0.68f) / 0.016f, 2f)) * 0.55f;\n\n            // Subtle gaps every 90 deg on inner ring for authentic tactical naval feel\n            float cos4 = Mathf.Abs(Mathf.Cos(ang * 2f));\n            float tick = (r > 0.72f && r < 0.93f) ? Mathf.Pow(cos4, 28f) * 0.55f : 0f;\n\n            float alpha = Mathf.Clamp01(outerBand + softHalo + innerRing * Mathf.Clamp01(1f - Mathf.Pow(cos4, 16f) * 0.5f) + tick);\n            if (r >= 0.985f) alpha = 0f;\n            byte aByte = (byte)Mathf.RoundToInt(alpha * 255f);\n            pixels[y * size + x] = new Color32(255, 255, 255, aByte);\n        }\n    }\n    ringTex.SetPixels32(pixels);\n    ringTex.Apply();\n    System.IO.File.WriteAllBytes(ringFullPath, ringTex.EncodeToPNG());\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(ringTex);\n}\n\nAssetDatabase.ImportAsset(ringPngAssetPath, ImportAssetOptions.ForceUpdate);\nTextureImporter ringImp = AssetImporter.GetAtPath(ringPngAssetPath) as TextureImporter;\nif (ringImp != null)\n{\n    ringImp.textureType = TextureImporterType.Default;\n    ringImp.alphaIsTransparency = true;\n    ringImp.sRGBTexture = true;\n    ringImp.wrapMode = TextureWrapMode.Clamp;\n    ringImp.maxTextureSize = 256;\n    ringImp.SaveAndReimport();\n}\nTexture2D loadedRing = AssetDatabase.LoadAssetAtPath<Texture2D>(ringPngAssetPath);\n\nstring markerMatPath = \"Assets/Materials/GameWorld/SelectionMarker.mat\";\nMaterial markerMat = AssetDatabase.LoadAssetAtPath<Material>(markerMatPath);\nShader unlitShader = Shader.Find(\"Universal Render Pipeline/Unlit\");\nif (markerMat != null && unlitShader != null)\n{\n    markerMat.shader = unlitShader;\n    markerMat.SetFloat(\"_Surface\", 1f);\n    markerMat.SetFloat(\"_Blend\", 0f);\n    markerMat.SetFloat(\"_SrcBlend\", (float)UnityEngine.Rendering.BlendMode.SrcAlpha);\n    markerMat.SetFloat(\"_DstBlend\", (float)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);\n    markerMat.SetFloat(\"_ZWrite\", 0f);\n    markerMat.SetFloat(\"_Cull\", 0f);\n    markerMat.EnableKeyword(\"_SURFACE_TYPE_TRANSPARENT\");\n    markerMat.renderQueue = 3000;\n    markerMat.SetTexture(\"_BaseMap\", loadedRing);\n    markerMat.SetTexture(\"_MainTex\", loadedRing);\n    markerMat.SetTextureScale(\"_BaseMap\", Vector2.one);\n    markerMat.SetTextureOffset(\"_BaseMap\", Vector2.zero);\n    markerMat.SetColor(\"_BaseColor\", Color.white);\n    markerMat.SetColor(\"_Color\", Color.white);\n    EditorUtility.SetDirty(markerMat);\n    sb.AppendLine(\"2. Created SelectionRing.png and updated SelectionMarker.mat (URP/Unlit Transparent).\");\n}\n\n// ---------------------------------------------------------------------------\n// 3. Attach SelectionOutlineRendererFeature to UniversalRenderPipelineAsset_Renderer\n// ---------------------------------------------------------------------------\nstring rendererPath = \"Assets/Shaders/FullScreen VFX/UniversalRenderPipelineAsset_Renderer.asset\";\nUnityEngine.Rendering.Universal.UniversalRendererData rendererData =\n    AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.Universal.UniversalRendererData>(rendererPath);\nif (rendererData != null)\n{\n    SelectionOutlineRendererFeature outlineFeat = null;\n    foreach (UnityEngine.Rendering.Universal.ScriptableRendererFeature f in rendererData.rendererFeatures)\n    {\n        if (f is SelectionOutlineRendererFeature)\n        {\n            outlineFeat = (SelectionOutlineRendererFeature)f;\n            break;\n        }\n    }\n\n    if (outlineFeat == null)\n    {\n        outlineFeat = ScriptableObject.CreateInstance<SelectionOutlineRendererFeature>();\n        outlineFeat.name = \"Selection Outline\";\n        AssetDatabase.AddObjectToAsset(outlineFeat, rendererData);\n\n        SerializedObject rdSo = new SerializedObject(rendererData);\n        SerializedProperty featuresProp = rdSo.FindProperty(\"m_RendererFeatures\");\n        SerializedProperty mapProp = rdSo.FindProperty(\"m_RendererFeatureMap\");\n        int idx = featuresProp.arraySize;\n        featuresProp.InsertArrayElementAtIndex(idx);\n        featuresProp.GetArrayElementAtIndex(idx).objectReferenceValue = outlineFeat;\n        if (mapProp != null && mapProp.isArray)\n        {\n            mapProp.InsertArrayElementAtIndex(idx);\n            // Try GetFileID via TryGetGUIDAndLocalFileIdentifier\n            string gUnused;\n            long localId;\n            if (AssetDatabase.TryGetGUIDAndLocalFileIdentifier(outlineFeat, out gUnused, out localId))\n            {\n                mapProp.GetArrayElementAtIndex(idx).longValue = localId;\n            }\n        }\n        rdSo.ApplyModifiedPropertiesWithoutUndo();\n    }\n\n    Shader maskShader = Shader.Find(\"Hidden/SelectionOutline/Mask\");\n    Shader outShader = Shader.Find(\"Hidden/SelectionOutline/Outline\");\n    outlineFeat.SetActive(true);\n    SerializedObject featSo = new SerializedObject(outlineFeat);\n    SerializedProperty sProp = featSo.FindProperty(\"settings\");\n    if (sProp != null)\n    {\n        SerializedProperty pMask = sProp.FindPropertyRelative(\"maskShader\");\n        SerializedProperty pOut = sProp.FindPropertyRelative(\"outlineShader\");\n        SerializedProperty pCol = sProp.FindPropertyRelative(\"outlineColor\");\n        SerializedProperty pWid = sProp.FindPropertyRelative(\"outlineWidth\");\n        SerializedProperty pPulse = sProp.FindPropertyRelative(\"pulse\");\n        SerializedProperty pEvt = sProp.FindPropertyRelative(\"renderPassEvent\");\n        if (pMask != null) pMask.objectReferenceValue = maskShader;\n        if (pOut != null) pOut.objectReferenceValue = outShader;\n        if (pCol != null) pCol.colorValue = new Color(1f, 0.87f, 0.15f, 1f);\n        if (pWid != null) pWid.floatValue = 0.06f;\n        if (pPulse != null) pPulse.boolValue = true;\n        if (pEvt != null) pEvt.intValue = (int)UnityEngine.Rendering.Universal.RenderPassEvent.AfterRenderingOpaques;\n    }\n    featSo.ApplyModifiedPropertiesWithoutUndo();\n    EditorUtility.SetDirty(outlineFeat);\n    rendererData.SetDirty();\n    EditorUtility.SetDirty(rendererData);\n    sb.AppendLine(\"3. Wired SelectionOutlineRendererFeature on URP Renderer (mask=\" + (maskShader != null) + \", out=\" + (outShader != null) + \", count=\" + rendererData.rendererFeatures.Count + \").\");\n}\n\n// ---------------------------------------------------------------------------\n// 4. Obtain shared Quad mesh & clean Camera Rig + Scene units + All 17 naval prefabs\n// ---------------------------------------------------------------------------\nGameObject tmpQuad = GameObject.CreatePrimitive(PrimitiveType.Quad);\nMesh quadMesh = tmpQuad.GetComponent<MeshFilter>().sharedMesh;\nUnityEngine.Object.DestroyImmediate(tmpQuad);\n\n// Clean Camera Rig / Main Camera / Camera Target\nGameObject camRig = GameObject.Find(\"Camera Rig\");\nif (camRig != null)\n{\n    MeshRenderer crMr = camRig.GetComponent<MeshRenderer>();\n    if (crMr != null) UnityEngine.Object.DestroyImmediate(crMr);\n    MeshFilter crMf = camRig.GetComponent<MeshFilter>();\n    if (crMf != null) UnityEngine.Object.DestroyImmediate(crMf);\n\n    Transform mainCamT = camRig.transform.Find(\"Main Camera\");\n    int removedMissing = 0;\n    if (mainCamT != null) removedMissing = GameObjectUtility.RemoveMonoBehavioursWithMissingScript(mainCamT.gameObject);\n\n    Transform camTargetT = camRig.transform.Find(\"Camera Target\");\n    if (camTargetT != null)\n    {\n        MeshRenderer ctMr = camTargetT.GetComponent<MeshRenderer>();\n        if (ctMr != null) ctMr.enabled = false;\n    }\n    sb.AppendLine(\"4a. Cleaned Camera Rig (removed MeshFilter/MeshRenderer), Camera Target (disabled MeshRenderer), Main Camera (removed \" + removedMissing + \" missing scripts).\");\n}\n\n// Determine ocean surface world Y\nfloat seaY = 0f;\nGameObject oceanObj = GameObject.Find(\"Ocean Cube - Water Cube\");\nif (oceanObj != null && oceanObj.GetComponent<Renderer>() != null)\n{\n    seaY = oceanObj.GetComponent<Renderer>().bounds.max.y;\n}\n\n// Fix Boat (Unit Inventory) (1) & Submarine (Unit Inventory) (1) in scene\nUnit[] sceneUnits = Resources.FindObjectsOfTypeAll<Unit>();\nint fixedSceneUnits = 0;\nforeach (Unit u in sceneUnits)\n{\n    if (!u.gameObject.scene.IsValid()) continue;\n    Transform ch0 = u.transform.childCount > 0 ? u.transform.GetChild(0) : null;\n    if (ch0 != null && (ch0.name == \"Selected\" || ch0.name == \"Selection\"))\n    {\n        ch0.name = \"Selected\";\n        Collider c0 = ch0.GetComponent<Collider>();\n        if (c0 != null) UnityEngine.Object.DestroyImmediate(c0);\n        MeshFilter mf0 = ch0.GetComponent<MeshFilter>();\n        if (mf0 == null) mf0 = ch0.gameObject.AddComponent<MeshFilter>();\n        mf0.sharedMesh = quadMesh;\n        MeshRenderer mr0 = ch0.GetComponent<MeshRenderer>();\n        if (mr0 == null) mr0 = ch0.gameObject.AddComponent<MeshRenderer>();\n        mr0.sharedMaterial = markerMat;\n        mr0.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;\n        mr0.receiveShadows = false;\n\n        // Measure hull XZ bounds\n        Bounds? hullB = null;\n        foreach (Renderer r in u.GetComponentsInChildren<Renderer>(true))\n        {\n            if (r.gameObject == ch0.gameObject || r is LineRenderer) continue;\n            if (!hullB.HasValue) hullB = r.bounds;\n            else { Bounds b2 = hullB.Value; b2.Encapsulate(r.bounds); hullB = b2; }\n        }\n        float footprint = hullB.HasValue ? Mathf.Max(hullB.Value.size.x, hullB.Value.size.z) : 2.2f;\n        float ringScale = Mathf.Clamp(footprint * 1.45f, 3.0f, 9.0f);\n        ch0.localRotation = Quaternion.Euler(90f, 0f, 0f);\n        ch0.localScale = new Vector3(ringScale, ringScale, 1f);\n        Vector3 worldCenter = hullB.HasValue ? new Vector3(hullB.Value.center.x, seaY + 0.04f, hullB.Value.center.z) : new Vector3(u.transform.position.x, seaY + 0.04f, u.transform.position.z);\n        ch0.position = worldCenter;\n        ch0.gameObject.SetActive(false);\n\n        SelectionOutlineTarget sot = u.GetComponent<SelectionOutlineTarget>();\n        if (sot != null)\n        {\n            sot.SetSelected(false);\n            sot.RefreshRenderers();\n        }\n        fixedSceneUnits++;\n    }\n}\nsb.AppendLine(\"4b. Fixed \" + fixedSceneUnits + \" scene units (Selected Quad ring + inactive by default, SOT deselected).\");\n\n// Fix ALL 17 naval prefabs (Unit + Selected child) in Assets/Prefabs/Units Prefabs/\nstring[] prefabGuids = AssetDatabase.FindAssets(\"t:Prefab\", new string[] { \"Assets/Prefabs/Units Prefabs\" });\nint fixedPrefabs = 0;\nforeach (string g in prefabGuids)\n{\n    string pPath = AssetDatabase.GUIDToAssetPath(g);\n    GameObject assetCheck = AssetDatabase.LoadAssetAtPath<GameObject>(pPath);\n    if (assetCheck == null || assetCheck.GetComponent<Unit>() == null) continue;\n    if (assetCheck.transform.childCount == 0 || assetCheck.transform.GetChild(0).name != \"Selected\") continue;\n\n    GameObject inst = PrefabUtility.LoadPrefabContents(pPath);\n    try\n    {\n        Transform ch0 = inst.transform.GetChild(0);\n        Collider c0 = ch0.GetComponent<Collider>();\n        if (c0 != null) UnityEngine.Object.DestroyImmediate(c0);\n        MeshFilter mf0 = ch0.GetComponent<MeshFilter>();\n        if (mf0 == null) mf0 = ch0.gameObject.AddComponent<MeshFilter>();\n        mf0.sharedMesh = quadMesh;\n        MeshRenderer mr0 = ch0.GetComponent<MeshRenderer>();\n        if (mr0 == null) mr0 = ch0.gameObject.AddComponent<MeshRenderer>();\n        mr0.sharedMaterial = markerMat;\n        mr0.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;\n        mr0.receiveShadows = false;\n\n        Bounds? hullB = null;\n        foreach (Renderer r in inst.GetComponentsInChildren<Renderer>(true))\n        {\n            if (r.gameObject == ch0.gameObject || r is LineRenderer) continue;\n            if (!hullB.HasValue) hullB = r.bounds;\n            else { Bounds b2 = hullB.Value; b2.Encapsulate(r.bounds); hullB = b2; }\n        }\n        float footprint = hullB.HasValue ? Mathf.Max(hullB.Value.size.x, hullB.Value.size.z) : 2.5f;\n        float ringScale = Mathf.Clamp(footprint * 1.45f, 3.0f, 9.5f);\n        float yPos = 0.04f;\n        if (hullB.HasValue && hullB.Value.min.y > 0.05f) yPos = hullB.Value.min.y + 0.04f;\n        ch0.localPosition = new Vector3(0f, yPos, 0f);\n        ch0.localRotation = Quaternion.Euler(90f, 0f, 0f);\n        ch0.localScale = new Vector3(ringScale, ringScale, 1f);\n        ch0.gameObject.SetActive(false);\n\n        PrefabUtility.SaveAsPrefabAsset(inst, pPath);\n        fixedPrefabs++;\n    }\n    finally\n    {\n        PrefabUtility.UnloadPrefabContents(inst);\n    }\n}\nsb.AppendLine(\"4c. Fixed \" + fixedPrefabs + \" naval prefabs (Replaced 101x101x101 Cube -> sized SelectionMarker Quad).\");\n\n// ---------------------------------------------------------------------------\n// 5. Minimal UI bar fixes on Match.unity & User Interface (B).prefab\n// ---------------------------------------------------------------------------\nSystem.Action<Transform> fixHudHierarchy = (rootTf) =>\n{\n    if (rootTf == null) return;\n    // Deduplicate ProductionTierPageIntegration on all AB.Tier pages\n    foreach (Transform tr in rootTf.GetComponentsInChildren<Transform>(true))\n    {\n        if (tr.name.StartsWith(\"AB.Tier\"))\n        {\n            ProductionTierPageIntegration[] arr = tr.GetComponents<ProductionTierPageIntegration>();\n            for (int k = 1; k < arr.Length; k++)\n            {\n                UnityEngine.Object.DestroyImmediate(arr[k], true);\n            }\n        }\n        if (tr.name == \"BG Lower (1)\")\n        {\n            UnityEngine.UI.LayoutElement le = tr.GetComponent<UnityEngine.UI.LayoutElement>();\n            if (le == null) le = tr.gameObject.AddComponent<UnityEngine.UI.LayoutElement>();\n            le.ignoreLayout = true;\n        }\n        if (tr.name == \"Tier Button Manager\" || tr.name == \"Player Tab Controller\" || tr.name == \"Player Faction Controller\")\n        {\n            UnityEngine.UI.HorizontalLayoutGroup hlg = tr.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n            if (hlg != null)\n            {\n                hlg.enabled = true;\n                if (tr.name == \"Tier Button Manager\")\n                {\n                    hlg.padding = new RectOffset(4, 4, 2, 2);\n                    hlg.spacing = 2f;\n                    hlg.childAlignment = TextAnchor.MiddleCenter;\n                    hlg.childControlWidth = true;\n                    hlg.childControlHeight = true;\n                    hlg.childForceExpandWidth = true;\n                    hlg.childForceExpandHeight = true;\n                }\n                EditorUtility.SetDirty(hlg);\n                UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate((RectTransform)tr);\n            }\n        }\n    }\n};\n\nCanvas[] sceneCanvases = Resources.FindObjectsOfTypeAll<Canvas>();\nforeach (Canvas c in sceneCanvases)\n{\n    if (!c.gameObject.scene.IsValid()) continue;\n    fixHudHierarchy(c.transform);\n}\nsb.AppendLine(\"5a. Fixed Match.unity HUD Tier Button Managers & deduplicated AB.Tier 5 ProductionTierPageIntegration.\");\n\nstring uiBPath = \"Assets/Prefabs/Interface Prefabs/HUD Testing/User Interface (B).prefab\";\nif (System.IO.File.Exists(uiBPath))\n{\n    GameObject uiBRoot = PrefabUtility.LoadPrefabContents(uiBPath);\n    try\n    {\n        fixHudHierarchy(uiBRoot.transform);\n        PrefabUtility.SaveAsPrefabAsset(uiBRoot, uiBPath);\n        sb.AppendLine(\"5b. Updated User Interface (B).prefab with identical Tier Button Manager & dedupe fixes.\");\n    }\n    finally\n    {\n        PrefabUtility.UnloadPrefabContents(uiBRoot);\n    }\n}\n\nAssetDatabase.SaveAssets();\n\n// Verify Faction A: Tyc / Tier Button Manager positions after layout rebuild\nforeach (Transform tr in Resources.FindObjectsOfTypeAll<Transform>())\n{\n    if (!tr.gameObject.scene.IsValid()) continue;\n    if (tr.name == \"Tier Button Manager\" && tr.parent != null && tr.parent.name == \"Faction A: Tyc\")\n    {\n        sb.Append(\"Tyc Tier Button Manager layout: \");\n        for (int i = 0; i < tr.childCount; i++)\n        {\n            RectTransform rt = tr.GetChild(i) as RectTransform;\n            sb.Append(rt.name + \"(x=\" + rt.anchoredPosition.x.ToString(\"F1\") + \",w=\" + rt.sizeDelta.x.ToString(\"F1\") + \") \");\n        }\n        sb.AppendLine();\n    }\n    if (tr.name == \"AB.Tier 5\" && tr.parent != null && tr.parent.name == \"Faction A: Tyc\")\n    {\n        sb.AppendLine(\"AB.Tier 5 PTPI count now: \" + tr.GetComponents<ProductionTierPageIntegration>().Length);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// 6. Render verify_depot.png + verify_selection.png\n// ---------------------------------------------------------------------------\nstring scratchDir = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\";\nSystem.IO.Directory.CreateDirectory(scratchDir);\n\n// 6a. verify_depot.png\nGameObject prev1 = new GameObject(\"__TEMP_PreviewDepot\");\nprev1.transform.position = new Vector3(0f, 500f, 0f);\nCamera cam1 = null; RenderTexture rt1 = null; Texture2D tex1 = null; Mesh m1a = null; Mesh m1b = null;\ntry\n{\n    Material quayMat = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n    GameObject deck = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    deck.transform.SetParent(prev1.transform, false);\n    deck.transform.localPosition = new Vector3(0f, -0.25f, 0f);\n    deck.transform.localScale = new Vector3(4.2f, 0.5f, 4.2f);\n    m1a = UnityEngine.Object.Instantiate(deck.GetComponent<MeshFilter>().sharedMesh);\n    Vector2[] uvs = m1a.uv;\n    for (int i = 0; i < uvs.Length; i++) uvs[i] = new Vector2(Mathf.Lerp(0.02f, 0.29f, uvs[i].x), Mathf.Lerp(0.55f, 0.95f, uvs[i].y));\n    m1a.uv = uvs;\n    deck.GetComponent<MeshFilter>().sharedMesh = m1a;\n    deck.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n\n    GameObject wall = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    wall.transform.SetParent(prev1.transform, false);\n    wall.transform.localPosition = new Vector3(0f, -0.52f, 2.11f);\n    wall.transform.localScale = new Vector3(4.2f, 0.90f, 0.08f);\n    m1b = UnityEngine.Object.Instantiate(wall.GetComponent<MeshFilter>().sharedMesh);\n    Vector2[] wuv = m1b.uv;\n    for (int i = 0; i < wuv.Length; i++) wuv[i] = new Vector2(Mathf.Lerp(0.55f, 0.77f, wuv[i].x), Mathf.Lerp(0.04f, 0.46f, wuv[i].y));\n    m1b.uv = wuv;\n    wall.GetComponent<MeshFilter>().sharedMesh = m1b;\n    wall.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n\n    GameObject depotInst = (GameObject)PrefabUtility.InstantiatePrefab(AssetDatabase.LoadAssetAtPath<GameObject>(depotPath));\n    depotInst.transform.SetParent(prev1.transform, false);\n\n    GameObject camGo = new GameObject(\"Cam1\");\n    camGo.transform.SetParent(prev1.transform, false);\n    camGo.transform.localPosition = new Vector3