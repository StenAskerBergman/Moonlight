{"ts":"2026-11-15T18:54:00.750Z","tool":"execute_code","type":"tool","status":"ERROR","ms":282,"action":"execute","params":{"action":"execute","code":"using System;\nusing System.IO;\nusing System.Text;\nusing UnityEngine;\nusing UnityEngine.Rendering;\nusing UnityEditor;\n\npublic class BuildDepotAndVerify\n{\n    private static Material CreateLitMaterial(\n        string assetPath,\n        string albedoTexPath,\n        string normalTexPath,\n        Color baseColor,\n        float metallic,\n        float smoothness,\n        float bumpScale,\n        Vector2 tiling,\n        Color? emissionColor)\n    {\n        Shader litShader = Shader.Find(\"Universal Render Pipeline/Lit\");\n        if (litShader == null) throw new Exception(\"Could not find Universal Render Pipeline/Lit shader.\");\n\n        Material mat = AssetDatabase.LoadAssetAtPath<Material>(assetPath);\n        if (mat == null)\n        {\n            mat = new Material(litShader);\n            AssetDatabase.CreateAsset(mat, assetPath);\n        }\n        else\n        {\n            mat.shader = litShader;\n        }\n\n        mat.SetColor(\"_BaseColor\", baseColor);\n        mat.SetColor(\"_Color\", baseColor);\n        mat.SetFloat(\"_Metallic\", metallic);\n        mat.SetFloat(\"_Smoothness\", smoothness);\n        mat.SetFloat(\"_WorkflowMode\", 1f);\n        mat.SetFloat(\"_Surface\", 0f);\n        mat.SetFloat(\"_Cull\", 2f);\n\n        if (!string.IsNullOrEmpty(albedoTexPath))\n        {\n            Texture2D albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(albedoTexPath);\n            if (albedo == null) throw new Exception(\"Missing albedo texture: \" + albedoTexPath);\n            mat.SetTexture(\"_BaseMap\", albedo);\n            mat.SetTexture(\"_MainTex\", albedo);\n            mat.SetTextureScale(\"_BaseMap\", tiling);\n            mat.SetTextureScale(\"_MainTex\", tiling);\n        }\n        else\n        {\n            mat.SetTexture(\"_BaseMap\", null);\n            mat.SetTexture(\"_MainTex\", null);\n        }\n\n        if (!string.IsNullOrEmpty(normalTexPath))\n        {\n            Texture2D normal = AssetDatabase.LoadAssetAtPath<Texture2D>(normalTexPath);\n            if (normal == null) throw new Exception(\"Missing normal texture: \" + normalTexPath);\n            mat.SetTexture(\"_BumpMap\", normal);\n            mat.SetFloat(\"_BumpScale\", bumpScale);\n            mat.SetTextureScale(\"_BumpMap\", tiling);\n            mat.EnableKeyword(\"_NORMALMAP\");\n        }\n        else\n        {\n            mat.SetTexture(\"_BumpMap\", null);\n            mat.DisableKeyword(\"_NORMALMAP\");\n        }\n\n        if (emissionColor.HasValue)\n        {\n            mat.EnableKeyword(\"_EMISSION\");\n            mat.globalIlluminationFlags = MaterialGlobalIlluminationFlags.BakedEmissive;\n            mat.SetColor(\"_EmissionColor\", emissionColor.Value);\n        }\n        else\n        {\n            mat.DisableKeyword(\"_EMISSION\");\n            mat.SetColor(\"_EmissionColor\", Color.black);\n        }\n\n        EditorUtility.SetDirty(mat);\n        return mat;\n    }\n\n    private static GameObject AddPart(\n        Transform parent,\n        string name,\n        PrimitiveType primitive,\n        Vector3 localPos,\n        Vector3 localScale,\n        Vector3 localEuler,\n        Material mat,\n        int layer)\n    {\n        GameObject go = GameObject.CreatePrimitive(primitive);\n        go.name = name;\n        go.layer = layer;\n        Collider col = go.GetComponent<Collider>();\n        if (col != null) UnityEngine.Object.DestroyImmediate(col);\n\n        go.transform.SetParent(parent, false);\n        go.transform.localPosition = localPos;\n        go.transform.localScale = localScale;\n        go.transform.localRotation = Quaternion.Euler(localEuler);\n\n        MeshRenderer mr = go.GetComponent<MeshRenderer>();\n        mr.sharedMaterial = mat;\n        mr.shadowCastingMode = ShadowCastingMode.On;\n        mr.receiv