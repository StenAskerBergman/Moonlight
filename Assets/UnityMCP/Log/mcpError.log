{"ts":"2026-11-15T01:19:53.326Z","tool":"execute_code","type":"tool","status":"ERROR","ms":928,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar g = UnityEngine.Object.FindFirstObjectByType<MapGrid>();\nvar plats = UnityEngine.Object.FindObjectsByType<MapGrid>(UnityEngine.FindObjectsSortMode.None);\nforeach (var p in plats)\n{\n    if (p.currentGridType != GridType.Type.Plateau) continue;\n    var ts = p.TerrainSource;\n    sb.AppendLine($\"Plateau {p.name}: size={p.size}, pos={p.transform.position}, waterH={ts?.Settings.waterHeight}, platH={ts?.Settings.underwaterPlateauHeight}, abyssH={ts?.Settings.abyssHeight}, ownedSame={p.gameObject.name}\");\n    var cache = ts?.BuiltCache;\n    if (cache != null)\n    {\n        float minH = float.MaxValue, maxH = float.MinValue;\n        int platCount = 0;\n        for (int i = 0; i < cache.Heights.Length; i++)\n        {\n            if (cache.Heights[i] < minH) minH = cache.Heights[i];\n            if (cache.Heights[i] > maxH) maxH = cache.Heights[i];\n            if (cache.TerrainTypes[i] == Cell.TerrainType.Plateau) platCount++;\n        }\n        sb.AppendLine($\"  cache res={cache.Resolution}, minH={minH:F2}, maxH={maxH:F2}, plateauSamples={platCount}/{cache.Heights.Length}\");\n    }\n    break;\n}\nvar mgr = UnityEngine.Object.FindFirstObjectByType<MapManager>();\nvar cfg = mgr?.SelectedPatternData?.configuration;\nsb.AppendLine(\"Config: \" + (cfg != null ? cfg.name : \"null\"));\nvar cat = ResourceDepositCatalog.Load();\nsb.AppendLine(\"Catalog: oil=\" + cat?.CrudeOilPrefab?.name + \" hydrothermal=\" + (cat != null ? cat.GetType().GetFields(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Length.ToString() : \"null\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
