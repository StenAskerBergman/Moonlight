{"ts":"2026-11-15T19:52:47.473Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1251,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. Update all TerrainGenerationSettings assets (e.g. Assets/Settings/Terrain World Settings.asset)\nstring[] settingsGuids = AssetDatabase.FindAssets(\"t:TerrainGenerationSettings\");\nfor (int i = 0; i < settingsGuids.Length; i++)\n{\n    string p = AssetDatabase.GUIDToAssetPath(settingsGuids[i]);\n    var tgs = AssetDatabase.LoadAssetAtPath<TerrainGenerationSettings>(p);\n    if (tgs == null) continue;\n    if (tgs.coastalProfile != null && tgs.coastalProfile.continentalSlopeWidth < 21.9f)\n    {\n        tgs.coastalProfile.continentalSlopeWidth = 22f;\n        tgs.coastalProfile.continentalSlopeExponent = 1.65f;\n    }\n    tgs.Validate();\n    EditorUtility.SetDirty(tgs);\n    sb.AppendLine(\"Asset \" + p + \": tabletopDepth=\" + tgs.standalonePlateau.tabletopDepthBelowWater\n        + \" cliffDrop=\" + tgs.standalonePlateau.cliffDropDepth\n        + \" lowerDrop=\" + tgs.standalonePlateau.lowerApronDrop\n        + \" abyssH=\" + tgs.abyssHeight\n        + \" plateauH=\" + tgs.underwaterPlateauHeight);\n}\n\n// 2. Update MapManager PatternData entries in active scene\nvar mm = Object.FindObjectOfType<MapManager>();\nif (mm == null) return \"MapManager not found\";\nvar mmSo = new SerializedObject(mm);\nvar patProp = mmSo.FindProperty(\"patternDataList\");\nif (patProp != null && patProp.isArray)\n{\n    for (int i = 0; i < patProp.arraySize; i++)\n    {\n        var el = patProp.GetArrayElementAtIndex(i);\n        var ps = el.FindPropertyRelative(\"plateauSettings\");\n        if (ps != null)\n        {\n            var td = ps.FindPropertyRelative(\"tabletopDepthBelowWater\");\n            var cd = ps.FindPropertyRelative(\"cliffDropDepth\");\n            var ld = ps.FindPropertyRelative(\"lowerApronDrop\");\n            var uw = ps.FindPropertyRelative(\"upperEsca