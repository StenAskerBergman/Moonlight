gBay_HeaderGlow\", PrimitiveType.Cube, new Vector3(-0.14f, 0.61f, -0.72f), Vector3.zero, new Vector3(0.56f, 0.04f, 0.03f), matGlow);\n\n    // Rooftop Industrial Vents & Antenna Mast\n    addPart(\"Roof_Vent_1\", PrimitiveType.Cylinder, new Vector3(-0.42f, 1.19f, 0.18f), Vector3.zero, new Vector3(0.16f, 0.05f, 0.16f), matBrass);\n    addPart(\"Roof_Vent_2\", PrimitiveType.Cylinder, new Vector3(-0.14f, 1.19f, 0.18f), Vector3.zero, new Vector3(0.16f, 0.05f, 0.16f), matBrass);\n    addPart(\"Roof_Mast\", PrimitiveType.Cylinder, new Vector3(0.20f, 1.32f, 0.30f), Vector3.zero, new Vector3(0.03f, 0.28f, 0.03f), matMetal);\n    addPart(\"Roof_Beacon\", PrimitiveType.Sphere, new Vector3(0.20f, 1.60f, 0.30f), Vector3.zero, new Vector3(0.07f, 0.07f, 0.07f), matGlow);\n\n    // Corner Harbor Crane (+X, -Z quadrant)\n    addPart(\"Crane_Pedestal\", PrimitiveType.Cylinder, new Vector3(0.68f, 0.25f, -0.58f), Vector3.zero, new Vector3(0.28f, 0.13f, 0.28f), matMetal);\n    addPart(\"Crane_Cab\", PrimitiveType.Cube, new Vector3(0.68f, 0.46f, -0.56f), new Vector3(0f, -22f, 0f), new Vector3(0.26f, 0.22f, 0.34f), matBrass);\n    addPart(\"Crane_Jib\", PrimitiveType.Cube, new Vector3(0.79f, 0.84f, -0.80f), new Vector3(-42f, -22f, 0f), new Vector3(0.08f, 0.08f, 0.92f), matBrass);\n    addPart(\"Crane_Cable\", PrimitiveType.Cylinder, new Vector3(0.92f, 0.72f, -1.08f), Vector3.zero, new Vector3(0.018f, 0.36f, 0.018f), matMetal);\n    addPart(\"Crane_Hook\", PrimitiveType.Cube, new Vector3(0.92f, 0.36f, -1.08f), Vector3.zero, new Vector3(0.09f, 0.07f, 0.09f), matMetal);\n\n    // Stacked Cargo Containers (+X, +Z yard pad)\n    addPart(\"Cargo_Blue_A\", PrimitiveType.Cube, new Vector3(0.68f, 0.21f, 0.16f), Vector3.zero, new Vector3(0.32f, 0.18f, 0.56f), matCrateBlue);\n    addPart(\"Cargo_Rust_B\", PrimitiveType.Cube, new Vector3(0.68f, 0.21f, 0.76f), Vector3.zero, new Vector3(0.32f, 0.18f, 0.42f), matCrateRust);\n    addPart(\"Cargo_Top_C\", PrimitiveType.Cube, new Vector3(0.69f, 0.39f, 0.38f), new Vector3(0f, 8f, 0f), new Vector3(0.30f, 0.18f, 0.54f), matCrateRust);\n\n    UnityEditor.PrefabUtility.SaveAsPrefabAsset(root, prefabPath);\n}\nfinally\n{\n    UnityEditor.PrefabUtility.UnloadPrefabContents(root);\n}\nUnityEditor.AssetDatabase.SaveAssets();\n\n// Render temporary Quay + Depot showcase close-up on Island 21 coast to scratch\nvar tempDepot = UnityEditor.PrefabUtility.InstantiatePrefab(UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(prefabPath)) as GameObject;\nvar quayGo = new GameObject(\"TempPreviewQuay\");\nvar qCam = new GameObject(\"TempQuayCam\");\nvar rt = new RenderTexture(1024, 768, 24);\nvar tex = new Texture2D(1024, 768, TextureFormat.RGB24, false);\ntry\n{\n    // Sample a coastal Island chunk to place Depot next to a temporary Quay mesh\n    var island = UnityEngine.Object.FindObjectOfType<Island>();\n    Vector3 anchorPos = new Vector3(-45f, 0.5f, 135f);\n    if (island != null) anchorPos = island.transform.position + new Vector3(45f, 0.2f, 45f);\n    // Use Island 21 shoreline or direct isolated preview next to Ocean Cube (y = -0.5)\n    Vector3 previewPos = new Vector3(0f, -0.5f + 1.9f, -155f); // open water at (0,-155) for crystal clear inspection of walls & building!\n    // Build a quick 4x4 Quay test grid at previewPos using existing QuaySystem + GridSystem\n    quayGo.transform.position = new Vector3(previewPos.x - 2f, -0.5f, previewPos.z - 2f);\n    var gs = quayGo.AddComponent<GridSystem>();\n    gs.width = 6; gs.height = 6; gs.cellSize = 1f;\n    gs.InitializeGrid(new MapGrid { size = 6 }); // avoid MapGrid MonoBehaviour warning by setting up cells manually? Check QuaySystem instead:\n    // Actually spawn existing Island Quay chunk? Better: instantiate Depot on top of Island 21's coastal quay OR just render Depot + manual quay quad test!\n    // Even simpler: find an actual Island's QuaySystem, add 3x3 temp cells near coastline? Wait - don't mutate scene QuaySystem!\n    // Instantiate standalone Box/Wall using Quay Structure.mat so we test BOTH Quay Structure.mat AND Depot.prefab cleanly!\n    var qs = quayGo.AddComponent<QuaySystem>();\n    var qMat = UnityEditor.AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n    var flg = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n    typeof(QuaySystem).GetField(\"topMaterial\", flg).SetValue(qs, qMat);\n    typeof(QuaySystem).GetField(\"wallMaterial\", flg).SetValue(qs, qMat);\n    var gridArr = new Cell[6, 6];\n    for (int gx = 0; gx < 6; gx++) for (int gz = 0; gz < 6; gz++) gridArr[gx, gz] = new Cell(gx, gz, -3.5f, Cell.TerrainType.DeepWater, true);\n    typeof(GridSystem).GetField(\"grid\", flg).SetValue(gs, gridArr);\n    qs.Claim(1, 1, 999); qs.Claim(2, 1, 999); qs.Claim(3, 1, 999); qs.Claim(4, 1, 999);\n    qs.Claim(1, 2, 999); qs.Claim(2, 2, 999); qs.Claim(3, 2, 999); qs.Claim(4, 2, 999);\n    qs.Claim(1, 3, 999); qs.Claim(2, 3, 999); qs.Claim(3, 3, 999); qs.Claim(4, 3, 999);\n    qs.Claim(1, 4, 999); qs.Claim(2, 4, 999); qs.Claim(3, 4, 999); qs.Claim(4, 4, 999);\n    qs.RebuildNow();\n    tempDepot.transform.position = quayGo.transform.position + new Vector3(3f, qs.TopElevationLocal, 3f);\n    tempDepot.transform.rotation = Quaternion.Euler(0f, -20f, 0f);\n\n    qCam.transform.position = tempDepot.transform.position + new Vector3(3.6f, 3.2f, -4.4f);\n    qCam.transform.LookAt(tempDepot.transform.position + new Vector3(0f, 0.25f, 0f));\n    var cam = qCam.AddComponent<Camera>();\n    cam.fieldOfView = 35f;\n    cam.nearClipPlane = 0.2f;\n    cam.farClipPlane = 100f;\n    cam.targetTexture = rt;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 1024, 768), 0, 0);\n    tex.Apply();\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\verify_quay_depot.png\", tex.EncodeToPNG());\n}\nfinally\n{\n 