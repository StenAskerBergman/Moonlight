{"ts":"2026-11-15T18:09:40.910Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1295,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// 1. Check ALL MapGrids for Generated Inland Water & chunk origins & look for narrow trenches in Island meshes\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (mg.name.IndexOf(\"Island\", System.StringComparison.OrdinalIgnoreCase) < 0) continue;\n    var waterCh = mg.transform.Find(\"Generated Inland Water\");\n    string wStr = \"none\";\n    if (waterCh != null)\n    {\n        var wmf = waterCh.GetComponent<MeshFilter>();\n        if (wmf != null && wmf.sharedMesh != null)\n            wStr = \"verts=\" + wmf.sharedMesh.vertexCount + \" bounds=\" + wmf.sharedMesh.bounds;\n    }\n    var mf = mg.GetComponent<MeshFilter>();\n    int trenchCount = 0;\n    var trenchPts = new System.Collections.Generic.List<string>();\n    if (mf != null && mf.sharedMesh != null)\n    {\n        var m = mf.sharedMesh;\n        int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n        var v = m.vertices;\n        if (side * side == m.vertexCount)\n        {\n            for (int z = 2; z < side - 2; z++)\n            {\n                for (int x = 2; x < side - 2; x++)\n                {\n                    int idx = z * side + x;\n                    float y = v[idx].y;\n                    if (y > 0.65f && y < 1.15f)\n                    {\n                        float ym = (v[idx - 1].y + v[idx + 1].y) * 0.5f;\n                        float zm = (v[idx - side].y + v[idx + side].y) * 0.5f;\n                        float dipX = ym - y;\n                        float dipZ = zm - y;\n                        // 1-2 sample wide narrow dip\n                        float ym2 = (v[idx - 2].y + v[idx + 2].y) * 0.5f;\n                        float zm2 = (v[idx - 2 * side].y + v[idx + 2 * side].y) * 0.5f;\n                        if (dipX > 0.03f || dipZ > 0.03f || (ym2 - y) > 0.05f || (zm2 - y) > 0.05f)\n                        {\n                            trenchCount++;\n                            if (trenchPts.Count < 8)\n                            {\n                                Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                                trenchPts.Add(string.Format(\"({0:F2},{1:F2}) y={2:F3} dipX={3:F3} dipZ={4:F3} dip2={5:F3}\", wp.x, wp.z, y, dipX, dipZ, Mathf.Max(ym2-y, zm2-y)));\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    sb.AppendLine(mg.name + \" pos=\" + mg.transform.position + \" | trenchVerts=\" + trenchCount + \" | water=\" + wStr);\n    for (int i = 0; i < trenchPts.Count; i++) sb.AppendLine(\"  trench \" + trenchPts[i]);\n}\n\n// 2. Check all Island src RiverCarveDepths world bounds vs Report\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\nvar list = wtf.GetType().GetProperty(\"Sources\", flags).GetValue(wtf, null) as System.Collections.IList;\nsb.AppendLine(\"=== RiverCarveDepths across Sources ===\");\nfor (int s = 0; s < list.Count; s++)\n{\n    var src = list[s];\n    if (src == null) continue;\n    var st = src.GetType();\n    if (st.GetField(\"gridType\", flags).GetValue(src).ToString() != \"Island\") continue;\n    var orig = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src, null);\n    float pad = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src, null));\n    var cache = st.GetProperty(\"BuiltCache\", flags).GetValue(src, null);\n    var ct = cache.GetType();\n    int res = (int)ct.GetProperty(\"Resolution\", flags).GetValue(cache, null);\n    float step = (float)ct.GetProperty(\"Step\", flags).GetValue(cache, null);\n    float[] heights = (float[])ct.GetProperty(\"Heights\", flags).GetValue(cache, null);\n    float[] rCarves = (float[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache, null);\n    float[] mBoosts = (float[])ct.GetProperty(\"MountainBoosts\", flags).GetValue(cache, null);\n    int rcTotal = 0;\n    float minX = 9999, maxX = -9999, minZ = 9999, maxZ = -9999;\n    float maxRc = 0f;\n    for (int iz = 0; iz < res; iz++)\n    {\n        for (int ix = 0; ix < res; ix++)\n        {\n            int idx = iz * res + ix;\n            if (rCarves[idx] > 0.001f)\n            {\n                rcTotal++;\n                float wx = orig.x - pad + ix * step;\n                float wz = orig.y - pad + iz * step;\n                if (wx < minX) minX = wx; if (wx > maxX) maxX = wx;\n                if (wz < minZ) minZ = wz; if (wz > maxZ) maxZ = wz;\n                if (rCarves[idx] > maxRc) maxRc = rCarves[idx];\n            }\n        }\n    }\n    var rpt = st.GetProperty(\"RiverGenerationReport\", flags).GetValue(src, null);\n    sb.AppendLine(string.Format(\"src[{0}] orig={1} rcCount={2} rcMax={3:F3} worldBox=({4:F1}..{5:F1}, {6:F1}..{7:F1}) report={8}\",\n        s, orig, rcTotal, maxRc, minX, maxX, minZ, maxZ, rpt));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
