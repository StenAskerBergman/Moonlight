;\n                    for (int z = 0; z < r; z++) {\n                        for (int x = 0; x < r; x++) {\n                            int idx = z * r + x;\n                            float wx = org.x + x * st - pad;\n                            float wz = org.y + z * st - pad;\n                            if (cache.Heights[idx] > s.Settings.waterHeight) {\n                                landPts++;\n                                if (wx < minX) minX = wx;\n                                if (wx > maxX) maxX = wx;\n                                if (wz < minZ) minZ = wz;\n                                if (wz > maxZ) maxZ = wz;\n                            }\n                            if (cache.Attribution != null && cache.Attribution.DominantRiverIds != null && cache.Attribution.DominantRiverIds[idx] >= 0) riverPts++;\n                        }\n                    }\n                }\n                if (gt.ToString() == \"Island\" || landPts > 0) {\n                    sb.AppendLine(\"  src[\" + i + \"] type=\" + gt + \" size=\" + sz + \" pad=\" + pad + \" origin=\" + org\n                        + \" landWorldBox=[\" + minX.ToString(\"F1\") + \"..\" + maxX.ToString(\"F1\") + \", \" + minZ.ToString(\"F1\") + \"..\" + maxZ.ToString(\"F1\") + \"]\"\n                        + \" landPts=\" + landPts + \" riverPts=\" + riverPts);\n                }\n            }\n        }\n\n        // Check where River / Region / Control / Sharp seams occur across ALL Island sources!\n        if (srcs != null) {\n            for (int i = 0; i < srcs.Count; i++) {\n                var s = srcs[i];\n                var gt = typeof(IslandTerrainProvider).GetField(\"gridType\", flags).GetValue(s).ToString();\n                if (gt != \"Island\") continue;\n                var cache = s.BuiltCache;\n                if (cache == null) continue;\n                int r = cache.Resolution;\n                float st = cache.Step;\n                // Find ANY sharp 1-cell jump in Heights, MountainBoosts, or River inside inland grass!\n                int sharpHeightSteps = 0;\n                int sharpIdx = -1;\n                float maxJump = 0f;\n                for (int z = 2; z < r - 2; z++) {\n                    for (int x = 2; x < r - 2; x++) {\n                        int idx = z * r + x;\n                        float h = cache.Heights[idx];\n                        if (h < 0.4f || h > 1.2f) continue;\n                        float minN = UnityEngine.Mathf.Min(UnityEngine.Mathf.Min(cache.Heights[idx-1], cache.Heights[idx+1]), UnityEngine.Mathf.Min(cache.Heights[idx-r], cache.Heights[idx+r]));\n                        float maxN = UnityEngine.Mathf.Max(UnityEngine.Mathf.Max(cache.Heights[idx-1], cache.Heights[idx+1]), UnityEngine.Mathf.Max(cache.Heights[idx-r], cache.Heights[idx+r]));\n                        // Check V-trench or sudden dip/spike\n                        float avg = 0.25f * (cache.Heights[idx-1] + cache.Heights[idx+1] + cache.Heights[idx-r] + cache.Heights[idx+r]);\n                        float lap = avg - h;\n                        float d2 = UnityEngine.Mathf.Max(maxN - h, h - minN);\n                        if (UnityEngine.Mathf.Abs(lap) > 0.015f) {\n                            sharpHeightSteps++;\n                            if (UnityEngine.Mathf.Abs(lap) > maxJump) { maxJump = UnityEngine.Mathf.Abs(lap); sharpIdx = idx; }\n                        }\n                    }\n                }\n                var org = (UnityEngine.Vector2)typeof(IslandTerrainProvider).GetField(\"chunkWorldOrigin\", flags).GetValue(s);\n                int pad = (int)typeof(IslandTerrainProvider).GetField(\"samplingPadding\", flags).GetValue(s);\n                string riverInfo = \"\";\n                var rivMethod = typeof(IslandTerrainProvider).GetMethod(\"GetRiverPlan\", flags);\n                var rp = s.GetType().GetField(\"riverPlan\", flags) != null ? s.GetType().GetField(\"riverPlan\", flags).GetValue(s) : null;\n                var regActive = (bool)typeof(IslandTerrainProvider).GetField(\"regionActive\", flags).GetValue(s);\n                var regThresh = (float)typeof(IslandTerrainProvider).GetField(\"regionThreshold\", flags).GetValue(s);\n                sb.AppendLine(\"  IslandCache origin=\" + org + \": sharpLap(>0.015)=\" + sharpHeightSteps + \" maxLap=\" + maxJump.ToString(\"F4\")\n                    + \" regActive=\" + regActive + \" regThresh=\" + regThresh.ToString(\"F2\") + \" hasRiverPlan=\" + (rp != null));\n                if (sharpIdx >= 0) {\n                    int sx = sharpIdx % r, sz = sharpIdx / r;\n                    sb.AppendLine(\"    maxLap @ (\" + sx + \",\" + sz + \") world=(\" + (org.x + sx*st - pad).ToString(\"F2\") + \",\" + (org.y + sz*st - pad).ToString(\"F2\") + \")\"\n                        + \" h=\" + cache.Heights[sharpIdx].ToString(\"F4\")\n                        + \" N=[\" + cache.Heights[sharpIdx-1].ToString(\"F4\") + \",\" + cache.Heights[sharpIdx+1].ToString(\"F4\") + \",\" + cache.Heights[sharpIdx-r].ToString(\"F4\") + \",\" + cache.Heights[sharpIdx+r].ToString(\"F4\") + \"]\"\n                        + \" type=\" + cache.TerrainTypes[sharpIdx]\n                        + \" boost=\" + cache.MountainBoosts[sharpIdx].ToString(\"F3\")\n                        + \" domRiver=\" + (cache.Attribution != null ? cache.Attribution.DominantRiverIds[sharpIdx].ToString() : \"?\")\n                        + \" domRidge=\" + (cache.Attribution != null ? cache.Attribution.DominantRidgeIds[sharpIdx].ToString() : \"?\"));\n                }\n            }\n        }\n    }\n}\n\n// 2. Also inspect Boat (Unit Inventory) (1) vs PlayerSpawnManager & Freight Ship in Scene/Prefabs\nvar b = UnityEngine.GameObject.Find(\"Boat (Unit Inventory) (1)\");\nif (b != null) {\n    sb.AppendLine(\"Boat (Unit Inventory) (1) layer=\" + UnityEngine.LayerMask.LayerToName(b.layer) + \" parent=\" + (b.transform.parent != null ? b.transform.parent.name : \"null\"));\n}\n\n