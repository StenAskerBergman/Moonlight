{"ts":"2026-11-15T19:48:45.035Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":13849,"action":"execute","params":{"action":"execute","code":"string dir = \"Assets/Resources/VFX\";\nSystem.IO.Directory.CreateDirectory(dir);\n\nSystem.Func<float, float, float, float> hash2 = (x, y, s) => {\n    float n = Mathf.Sin(x * 127.1f + y * 311.7f + s * 74.7f) * 43758.5453f;\n    return n - Mathf.Floor(n);\n};\nSystem.Func<float, float, float, float> vnoise = (x, y, s) => {\n    float ix = Mathf.Floor(x), iy = Mathf.Floor(y);\n    float fx = x - ix, fy = y - iy;\n    float ux = fx * fx * (3f - 2f * fx), uy = fy * fy * (3f - 2f * fy);\n    float a = hash2(ix, iy, s), b = hash2(ix + 1f, iy, s);\n    float c = hash2(ix, iy + 1f, s), d = hash2(ix + 1f, iy + 1f, s);\n    return Mathf.Lerp(Mathf.Lerp(a, b, ux), Mathf.Lerp(c, d, ux), uy);\n};\nSystem.Func<float, float, float, float> fbm = (x, y, s) => {\n    float sum = 0f, amp = 0.52f, freq = 1f;\n    for (int o = 0; o < 5; o++) { sum += amp * vnoise(x * freq, y * freq, s + o * 13.7f); freq *= 2.04f; amp *= 0.5f; }\n    return sum;\n};\n\n// 1. VentSmokeSheet.png (1024x1024, 4x4 grid of 256x256 billowing smoke puffs)\nint sheetSize = 1024, cellSize = 256;\nvar smokePixels = new UnityEngine.Color32[sheetSize * sheetSize];\nfor (int row = 0; row < 4; row++)\nfor (int col = 0; col < 4; col++)\n{\n    int frame = row * 4 + col;\n    float seed = 11.3f + frame * 17.91f;\n    for (int py = 0; py < cellSize; py++)\n    for (int px = 0; px < cellSize; px++)\n    {\n        float u = (px + 0.5f) / cellSize * 2f - 1f;\n        float v = (py + 0.5f) / cellSize * 2f - 1f;\n        float r = Mathf.Sqrt(u * u + v * v);\n        // Domain-warped turbulent curl smoke\n        float wx = fbm(u * 2.4f + 4.1f, v * 2.4f - 2.3f, seed) * 2f - 1f;\n        float wy = fbm(u * 2.4f - 3.7f, v * 2.4f + 5.9f, seed + 5.3f) * 2f - 1f;\n        float density = fbm((u + wx * 0.48f) * 3.1f + 8f, (v + wy * 0.48f) * 3.1f + 8f, seed + 29.1f);\n        float fine = fbm((u + wy * 0.3f) * 6.5f, (v - wx * 0.3f) * 6.5f, seed + 61.7f);\n        float puff = Mathf.Clamp01(1f - Mathf.SmoothStep(0.22f, 0.96f, r + (density - 0.5f) * 0.38f));\n        float radialMask = Mathf.Pow(Mathf.Clamp01(1f - r / 0.97f), 1.65f);\n        float alpha = Mathf.Clamp01(puff * radialMask * Mathf.Lerp(0.45f, 1.15f, density * 0.7f + fine * 0.3f));\n        // Subtle 3D top-lit shading gradient inside cloud puff\n        float shade = Mathf.Clamp01(0.42f + v * 0.22f + density * 0.38f - (1f - fine) * 0.14f);\n        byte c = (byte)Mathf.RoundToInt(shade * 255f);\n        byte a = (byte)Mathf.RoundToInt(alpha * 255f);\n        smokePixels[(row * cellSize + py) * sheetSize + (col * cellSize + px)] = new UnityEngine.Color32(c, c, (byte)Mathf.Min(255, c + 6), a);\n    }\n}\nvar smokeTex = new UnityEngine.Texture2D(sheetSize, sheetSize, UnityEngine.TextureFormat.RGBA32, false);\nsmokeTex.SetPixels32(smokePixels);\nsmokeTex.Apply();\nSystem.IO.File.WriteAllBytes(dir + \"/VentSmokeSheet.png\", UnityEngine.ImageConversion.EncodeToPNG(smokeTex));\nUnityEngine.Object.DestroyImmediate(smokeTex);\n\n// 2. VentThermalWisp.png (256x256 elongated upward mineral wisp)\nint wispSize = 256;\nvar wispPixels = new UnityEngine.Color32[wispSize * wispSize];\nfor (int py = 0; py < wispSize; py++)\nfor (int px = 0; px < wispSize; px++)\n{\n    float u = (px + 0.5f) / wispSize * 2f - 1f;\n    float v = (py + 0.5f) / wispSize * 2f - 1f;\n    float rx = u * 1.35f, ry = v * 0.95f;\n    float r = Mathf.Sqrt(rx * rx + ry * ry);\n    float w = fbm(u * 3.5f + 12f, v * 2.2f - 6f, 103.5f);\n    float core = Mathf.Pow(Mathf.Clamp01(1f - r / 0.95f), 2.1f);\n    float alpha = Mathf.Clamp01(core * Mathf.Lerp(0.4f, 1.25f, w));\n    byte val = (byte)Mathf.RoundToInt(Mathf.Clamp01(0.65f + w * 0.35f) * 255f);\n    wispPixels[py * wispSize + px] = new UnityEngine.Color32(val, val, val, (byte)Mathf.RoundToInt(alpha * 255f));\n}\nvar wispTex = new UnityEngine.Texture2D(wispSize, wispSize, UnityEngine.TextureFormat.RGBA32, false);\nwispTex.SetPixels32(wispPixels);\nwispTex.Apply();\nSystem.IO.File.WriteAllBytes(dir + \"/VentThermalWisp.png\", UnityEngine.ImageConversion.EncodeToPNG(wispTex));\nUnityEngine.Object.DestroyImmediate(wispTex);\n\n// 3. VentBubble.png (128x128 crisp refraction bubble)\nint bubSize = 128;\nvar bubPixels = new UnityEngine.Color32[bubSize * bubSize];\nfor (int py = 0; py < bubSize; py++)\nfor (int px = 0; px < bubSize; px++)\n{\n    float u = (px + 0.5f) / bubSize * 2f - 1f;\n    float v = (py + 0.5f) / bubSize * 2f - 1f;\n    float r = Mathf.Sqrt(u * u + v * v);\n    float outer = 1f - Mathf.SmoothStep(0.76f, 0.94f, r);\n    float rim = Mathf.SmoothStep(0.46f, 0.78f, r) * outer;\n    float specDist = Mathf.Sqrt((u + 0.30f) * (u + 0.30f) + (v - 0.32f) * (v - 0.32f));\n    float spec = Mathf.Pow(Mathf.Clamp01(1f - specDist / 0.32f), 2.2f) * outer;\n    float alpha = Mathf.Clamp01(outer * (0.16f + rim * 0.76f + spec * 0.92f));\n    float bri = Mathf.Clamp01(0.78f + spec * 0.22f);\n    byte b = (byte)Mathf.RoundToInt(bri * 255f);\n    bubPixels[py * bubSize + px] = new UnityEngine.Color32((byte)(b * 0.88f), (byte)(b * 0.97f), b, (byte)Mathf.RoundToInt(alpha * 255f));\n}\nvar bubTex = new UnityEngine.Texture2D(bubSize, bubSize, UnityEngine.TextureFormat.RGBA32, false);\nbubTex.SetPixels32(bubPixels);\nbubTex.Apply();\nSystem.IO.File.WriteAllBytes(dir + \"/VentBubble.png\", UnityEngine.ImageConversion.EncodeToPNG(bubTex));\nUnityEngine.Object.DestroyImmediate(bubTex);\n\nUnityEditor.AssetDatabase.Refresh();\n\nstring[] texPaths = { dir + \"/VentSmokeSheet.png\", dir + \"/VentThermalWisp.png\", dir + \"/VentBubble.png\" };\nforeach (var tp in texPaths)\n{\n    var ti = UnityEditor.AssetImporter.GetAtPath(tp) as UnityEditor.TextureImporter;\n    if (ti != null)\n    {\n        ti.alphaIsTransparency = true;\n        ti.sRGBTexture = true;\n        ti.wrapMode = UnityEngine.TextureWrapMode.Clamp;\n        ti.mipmapEnabled = true;\n        ti.SaveAndReimport();\n    }\n}\n\nvar shader = UnityEngine.Shader.Find(\"Universal Render Pipeline/Particles/Unlit\");\nSystem.Action<string, string, UnityEngine.Color, bool, int> makeMat = (matPath, texPath, tint, additive, queue) => {\n    var existing = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(matPath);\n    var m = existing != null ? existing : new UnityEngine.Material(shader);\n    m.shader = shader;\n    var tx = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Texture2D>(texPath);\n    m.SetTexture(\"_BaseMap\", tx);\n    m.SetTexture(\"_MainTex\", tx);\n    m.SetColor(\"_BaseColor\", tint);\n    m.SetFloat(\"_Surface\", 1f);\n    m.SetFloat(\"_Blend\", additive ? 2f : 0f);\n    m.SetFloat(\"_SrcBlend\", (float)UnityEngine.Rendering.BlendMode.SrcAlpha);\n    m.SetFloat(\"_DstBlend\", (float)(additive ? UnityEngine.Rendering.BlendMode.One : UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha));\n    m.SetFloat(\"_ZWrite\", 0f);\n    m.SetFloat(\"_AlphaClip\", 0f);\n    m.SetFloat(\"_SoftParticlesEnabled\", 1f);\n    m.SetVector(\"_SoftParticleFadeParams\", new UnityEngine.Vector4(0.15f, 1.25f, 0f, 0f));\n    m.EnableKeyword(\"_SURFACE_TYPE_TRANSPARENT\");\n    m.EnableKeyword(\"_SOFTPARTICLES_ON\");\n    if (additive) m.EnableKeyword(\"_ALPHABLEND_ON\");\n    m.DisableKeyword(\"_ALPHATEST_ON\");\n    m.renderQueue = queue;\n    if (existing == null) UnityEditor.AssetDatabase.CreateAsset(m, matPath);\n    else UnityEditor.EditorUtility.SetDirty(m);\n};\n\nmakeMat(dir + \"/VentMineralPlume.mat\", dir + \"/VentSmokeSheet.png\", new UnityEngine.Color(0.68f, 0.78f, 0.84f, 0.76f), false, 3000);\nmakeMat(dir + \"/VentThermalCoreGlow.mat\", dir + \"/VentThermalWisp.png\", new UnityEngine.Color(1.00f, 0.56f, 0.24f, 0.58f), true, 3001);\nmakeMat(dir + \"/VentRisingBubbles.mat\", dir + \"/VentBubble.png\", new UnityEngine.Color(0.84f, 0.96f, 1.00f, 0.85f), false, 3002);\n\n// Also copy fallback textures onto Underwater Plateau Surface/Escarpment/Formations .mat assets so Edit Mode NEVER renders white!\nvar splat = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Materials/Island/Terrain Splat.mat\");\nstring[] platMats = {\n    \"Assets/Materials/Island/Underwater Plateau Surface.mat\",\n    \"Assets/Materials/Island/Underwater Plateau Escarpment.mat\",\n    \"Assets/Materials/Island/Underwater Plateau Formations.mat\"\n};\nstring[] texProps = { \"_RockAlbedo\", \"_RockNormal\", \"_SandAlbedo\", \"_SandNormal\", \"_SeabedAlbedo\", \"_SeabedNormal\", \"_GrassAlbedo\", \"_GrassNormal\" };\nstring[] fltProps = { \"_RockTiling\", \"_RockNormalScale\", \"_SandTiling\", \"_SandNormalScale\", \"_SeabedTiling\", \"_SeabedNormalScale\", \"_GrassTiling\", \"_SeabedSmoothness\", \"_MacroTiling\", \"_MacroStrength\" };\nforeach (var pmPath in platMats)\n{\n    var pm = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(pmPath);\n    if (pm == null || splat == null) continue;\n    foreach (var tp in texProps) if (splat.HasProperty(tp) && pm.HasProperty(tp)) pm.SetTexture(tp, splat.GetTexture(tp));\n    foreach (var fp in fltProps) if (splat.HasProperty(fp) && pm.HasProperty(fp)) pm.SetFloat(fp, splat.GetFloat(fp));\n    if (splat.HasProperty(\"_SeabedTint\") && pm.HasProperty(\"_SeabedTint\")) pm.SetColor(\"_SeabedTint\", splat.GetColor(\"_SeabedTint\"));\n    UnityEditor.EditorUtility.SetDirty(pm);\n}\n\nUnityEditor.AssetDatabase.SaveAssets();\nreturn \"Generated VFX assets and updated Plateau fallback materials!\";","safety_checks":true,"compiler":"codedom"}}
