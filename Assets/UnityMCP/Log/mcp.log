{"ts":"2026-11-15T17:56:30.845Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1250,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// Check ALL 8 Island chunks in MapManager for terrain texture properties, seam anomalies, AND exact WorldTerrainField coverage\nvar mgr = UnityEngine.Object.FindObjectOfType<MapManager>();\nsb.AppendLine(\"MapManager found=\" + (mgr != null));\nif (mgr != null) {\n    var so = new UnityEditor.SerializedObject(mgr);\n    var pIdx = so.FindProperty(\"selectedPatternDataIndex\");\n    var patterns = so.FindProperty(\"patternDataList\");\n    sb.AppendLine(\"selectedPattern=\" + (pIdx != null ? pIdx.intValue.ToString() : \"?\") + \" patternsCount=\" + (patterns != null ? patterns.arraySize.ToString() : \"?\"));\n    if (pIdx != null && patterns != null && pIdx.intValue < patterns.arraySize) {\n        var pat = patterns.GetArrayElementAtIndex(pIdx.intValue);\n        sb.AppendLine(\"  displayName=\" + pat.FindPropertyRelative(\"displayName\").stringValue\n            + \" gridSize=\" + pat.FindPropertyRelative(\"gridSize\").intValue\n            + \" slotSpacing=\" + pat.FindPropertyRelative(\"slotSpacing\").floatValue\n            + \" defaultType=\" + pat.FindPropertyRelative(\"defaultTerrainType\").enumDisplayNames[pat.FindPropertyRelative(\"defaultTerrainType\").enumValueIndex]\n            + \" uwType=\" + pat.FindPropertyRelative(\"underwaterSelectionTerrainType\").enumDisplayNames[pat.FindPropertyRelative(\"underwaterSelectionTerrainType\").enumValueIndex]);\n        var islSel = pat.FindPropertyRelative(\"currentIslandSelection\");\n        var ocSel = pat.FindPropertyRelative(\"currentOceanSelection\");\n        string islStr = \"\", ocStr = \"\";\n        for (int i = 0; i < islSel.arraySize; i++) islStr += islSel.GetArrayElementAtIndex(i).intValue + \",\";\n        for (int i = 0; i < ocSel.arraySize; i++) ocStr += ocSel.GetArrayElementAtIndex(i).intValue + \",\";\n        sb.AppendLine(\"  islandSlots=[\" + islStr + \"] oceanSlots=[\" + ocStr + \"]\");\n    }\n}\n\n// Inspect ALL 8 Islands for any crease / step in grass flatland [0.65..1.15] AND sample heights on a line\nvar allGrids = UnityEngine.Resources.FindObjectsOfTypeAll<MapGrid>();\nfor (int g = 0; g < allGrids.Length; g++) {\n    var grid = allGrids[g];\n    if (UnityEditor.EditorUtility.IsPersistent(grid.gameObject)) continue;\n    if (grid.currentGridType != GridType.Type.Island) continue;\n    var mesh = grid.GetComponent<UnityEngine.MeshFilter>().sharedMesh;\n    var verts = mesh.vertices;\n    var norms = mesh.normals;\n    int side = UnityEngine.Mathf.RoundToInt(UnityEngine.Mathf.Sqrt(verts.Length));\n\n    int grassValleyAnom = 0;\n    float worstGrad = 0f;\n    int worstIdx = -1;\n    // Look for vertices INSIDE flat grass (0.78 <= y <= 0.96, OR where neighbors are ~0.85 +/- 0.12) where there is a crease/normal tilt!\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            float avg4 = 0.25f * (verts[idx-1].y + verts[idx+1].y + verts[idx-side].y + verts[idx+side].y);\n            if (avg4 > 0.72f && avg4 < 0.98f && UnityEngine.Mathf.Abs(y - avg4) > 0.008f) {\n                grassValleyAnom++;\n            }\n            if (y > 0.72f && y < 0.98f && norms[idx].y < 0.985f) {\n                float grad = UnityEngine.Mathf.Max(\n                    UnityEngine.Mathf.Abs(verts[idx+1].y - verts[idx-1].y),\n                    UnityEngine.Mathf.Abs(verts[idx+side].y - verts[idx-side].y));\n                if (grad > worstGrad) { worstGrad = grad; worstIdx = idx; }\n            }\n        }\n    }\n    sb.AppendLine(\"  \" + grid.gameObject.name + \": grassDipAnom(|y-avg|>0.008)=\" + grassValleyAnom + \" worstFlatGrad=\" + worstGrad.ToString(\"F4\")\n        + (worstIdx >= 0 ? \" @(\" + (worstIdx % side) + \",\" + (worstIdx / side) + \") y=\" + verts[worstIdx].y.ToString(\"F3\") + \" ny=\" + norms[worstIdx].y.ToString(\"F3\") : \"\"));\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
