\"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.54f, 0.50f), new Vector3(0.40f, 0.06f, 0.13f), Vector3.zero, matOchre, layer);\n                AddPart(holderTf, \"LoadingBay_F\" + i + \"_Glow\", PrimitiveType.Cube, new Vector3(bayX[i], 0.30f, 0.485f), new Vector3(0.26f, 0.32f, 0.03f), Vector3.zero, matEmissive, layer);\n                // Back\n                AddPart(holderTf, \"LoadingBay_B\" + i + \"_Frame\", PrimitiveType.Cube, new Vector3(bayX[i], 0.31f, -0.745f), new Vector3(0.36f, 0.40f, 0.06f), Vector3.zero, matSteel, layer);\n                AddPart(holderTf, \"LoadingBay_B\" + i + \"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.54f, -0.78f), new Vector3(0.40f, 0.06f, 0.13f), Vector3.zero, matOchre, layer);\n                AddPart(holderTf, \"LoadingBay_B\" + i + \"_Glow\", PrimitiveType.Cube, new Vector3(bayX[i], 0.30f, -0.765f), new Vector3(0.26f, 0.32f, 0.03f), Vector3.zero, matEmissive, layer);\n            }\n\n            // Roof vents & comms mast\n            float[] ventX = new float[] { -0.52f, -0.18f, 0.14f };\n            for (int i = 0; i < ventX.Length; i++)\n            {\n                AddPart(holderTf, \"Roof_Vent_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.87f, -0.58f), new Vector3(0.13f, 0.06f, 0.13f), Vector3.zero, matSteel, layer);\n                AddPart(holderTf, \"Roof_VentRim_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.92f, -0.58f), new Vector3(0.10f, 0.02f, 0.10f), Vector3.zero, matOchre, layer);\n            }\n            AddPart(holderTf, \"Roof_MastBase\", PrimitiveType.Cube, new Vector3(0.38f, 0.86f, -0.56f), new Vector3(0.14f, 0.09f, 0.14f), Vector3.zero, matSteel, layer);\n            AddPart(holderTf, \"Roof_Mast\", PrimitiveType.Cylinder, new Vector3(0.38f, 1.18f, -0.56f), new Vector3(0.03f, 0.32f, 0.03f), Vector3.zero, matSteel, layer);\n            AddPart(holderTf, \"Roof_Beacon\", PrimitiveType.Sphere, new Vector3(0.38f, 1.50f, -0.56f), new Vector3(0.08f, 0.08f, 0.08f), Vector3.zero, matEmissive, layer);\n\n            // Corner dock crane\n            AddPart(holderTf, \"Crane_Pedestal\", PrimitiveType.Cylinder, new Vector3(0.70f, 0.25f, 0.62f), new Vector3(0.24f, 0.15f, 0.24f), Vector3.zero, matSteel, layer);\n            AddPart(holderTf, \"Crane_Turret\", PrimitiveType.Cube, new Vector3(0.70f, 0.49f, 0.62f), new Vector3(0.22f, 0.20f, 0.28f), new Vector3(0f, -20f, 0f), matOchre, layer);\n            AddPart(holderTf, \"Crane_CabGlass\", PrimitiveType.Cube, new Vector3(0.65f, 0.52f, 0.74f), new Vector3(0.15f, 0.08f, 0.05f), new Vector3(0f, -20f, 0f), matEmissive, layer);\n            AddPart(holderTf, \"Crane_Mast\", PrimitiveType.Cube, new Vector3(0.72f, 0.80f, 0.56f), new Vector3(0.09f, 0.46f, 0.09f), new Vector3(0f, -20f, 0f), matOchre, layer);\n            AddPart(holderTf, \"Crane_Counterweight\", PrimitiveType.Cube, new Vector3(0.78f, 0.68f, 0.44f), new Vector3(0.16f, 0.13f, 0.15f), new Vector3(0f, -20f, 0f), matSteel, layer);\n            AddPart(holderTf, \"Crane_Jib\", PrimitiveType.Cube, new Vector3(0.61f, 1.12f, 0.76f), new Vector3(0.065f, 0.065f, 0.72f), new Vector3(-34f, -24f, 0f), matOchre, layer);\n            AddPart(holderTf, \"Crane_Cable\", PrimitiveType.Cylinder, new Vector3(0.49f, 1.00f, 0.98f), new Vector3(0.015f, 0.22f, 0.015f), Vector3.zero, matSteel, layer);\n            AddPart(holderTf, \"Crane_HookSpreader\", PrimitiveType.Cube, new Vector3(0.49f, 0.77f, 0.98f), new Vector3(0.16f, 0.04f, 0.09f), new Vector3(0f, -24f, 0f), matOchre, layer);\n\n            // Stacked cargo containers\n            AddPart(holderTf, \"Cargo_FrontTeal\", PrimitiveType.Cube, new Vector3(-0.44f, 0.20f, 0.72f), new Vector3(0.44f, 0.18f, 0.21f), Vector3.zero, matTeal, layer);\n            AddPart(holderTf, \"Cargo_FrontRust\", PrimitiveType.Cube, new Vector3(0.08f, 0.20f, 0.74f), new Vector3(0.42f, 0.18f, 0.21f), new Vector3(0f, 3f, 0f), matRust, layer);\n            AddPart(holderTf, \"Cargo_FrontUpperOchre\", PrimitiveType.Cube, new Vector3(-0.39f, 0.375f, 0.72f), new Vector3(0.38f, 0.17f, 0.19f), new Vector3(0f, 7f, 0f), matOchre, layer);\n\n            AddPart(holderTf, \"Cargo_SideTeal\", PrimitiveType.Cube, new Vector3(0.73f, 0.20f, -0.36f), new Vector3(0.21f, 0.18f, 0.44f), Vector3.zero, matTeal, layer);\n            AddPart(holderTf, \"Cargo_SideRust\", PrimitiveType.Cube, new Vector3(0.73f, 0.20f, 0.14f), new Vector3(0.21f, 0.18f, 0.40f), new Vector3(0f, -3f, 0f), matRust, layer);\n            AddPart(holderTf, \"Cargo_SideUpperTeal\", PrimitiveType.Cube, new Vector3(0.73f, 0.375f, -0.32f), new Vector3(0.19f, 0.17f, 0.40f), new Vector3(0f, -5f, 0f), matTeal, layer);\n\n            PrefabUtility.SaveAsPrefabAsset(root, depotPath);\n            sb.AppendLine(\"Saved upgraded multi-part Depot.prefab (\" + holderTf.childCount + \" visual parts).\");\n        }\n        finally\n        {\n            PrefabUtility.UnloadPrefabContents(root);\n        }\n\n        // Render verification image: Depot + Quay Structure preview\n        GameObject previewRoot = new GameObject(\"__TEMP_DepotQuayPreview\");\n        Camera cam = null;\n        RenderTexture rt = null;\n        Texture2D tex = null;\n        try\n        {\n            // Ground/Quay deck test surface using Quay Structure.mat\n            Material quayMat = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n            GameObject deck = GameObject.CreatePrimitive(PrimitiveType.Cube);\n            deck.name = \"PreviewQuayDeck\";\n            deck.transform.SetParent(previewRoot.transform, false);\n            deck.transform.position = new Vector3(0f, -0.5f, 0f);\n            deck.transform.localScale = new Vector3(4.5f, 1.0f, 4.5f);\n            if (quayMat != null)\n            {\n                // Apply deck UV subset (u: 0.04..0.28, v: 0.52..0.96 approx) via mesh UVs so atlas deck reads naturally\n                Mesh deckMesh = UnityEngine.Object.Instantiate(deck.GetComponent<MeshFilter>().sharedMesh);\n                Vector2[] uvs = deckMesh.uv;\n                for (int i = 0; i < uvs.Length; i++)\n                {\n                    uvs[i] = new Vector2(Mathf.Lerp(0.03f, 0.26f, uvs[i].x), Mathf.Lerp(0.54f, 0.96f, uvs[i].y));\n                }\n                deckMesh.uv = uvs;\n                deck.GetComponent<MeshFilter>().sharedMesh = deckMesh;\n                deck.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n            }\n\n            // Side wall sample using wallBay region of atlas\n            GameObject wall = GameObject.CreatePrimitive(PrimitiveType.Cube);\n            wall.name = \"PreviewQuayWall\";\n            wall.transform.SetParent(previewRoot.transform, false);\n            wall.transform.position = new Vector3(0f, -0.55f, 2.26f);\n            wall.transform.localScale = new Vector3(4.5f, 0.95f, 0.08f);\n            if (quayMat != null)\n            {\n                Mesh wallMesh = UnityEngine.Object.Instantiate(wall.GetComponent<MeshFilter>().sharedMesh);\n                Vector2[] wuv = wallMesh.uv;\n                for (int i = 0; i < wuv.Length; i++)\n                {\n                    wuv[i] = new Vector2(Mathf.Lerp(0.56f, 0.77f, wuv[i].x), Mathf.Lerp(0.05f, 0.45f, wuv[i].y));\n                }\n                wallMesh.uv = wuv;\n                wall.GetComponent<MeshFilter>().sharedMesh = wallMesh;\n                wall.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n            }\n\n            GameObject depotAsset = AssetDatabase.LoadAssetAtPath<GameObject>(depotPath);\n            GameObject depotInst = (GameObject)PrefabUtility.InstantiatePrefab(depotAsset);\n            depotInst.transform.SetParent(previewRoot.transform, false);\n            depotInst.transform.position = Vector3.zero;\n\n            GameObject camGo = new GameObject(\"PreviewCam\");\n            camGo.transform.SetParent(previewRoot.transform, false);\n            camGo.transform.position = new Vector3(2.85f, 2.55f, 3.10f);\n            camGo.transform.LookAt(new Vector3(0.0f, 0.42f, 0.0f));\n            cam = camGo.AddComponent<Camera>();\n            cam.clearFlags = CameraClearFlags.SolidColor;\n            cam.backgroundColor = new Color(0.14f, 0.22f, 0.28f, 1f);\n            cam.fieldOfView = 35f;\n\n            // Temporary key light if scene light isn't aiming here\n            GameObject lightGo = new GameObject(\"PreviewKeyLight\");\n            lightGo.transform.SetParent(previewRoot.transform, false);\n            lightGo.transform.rotation = Quaternion.Euler(48f, -135f, 0f);\n            Light l = lightGo.AddComponent<Light>();\n            l.type = LightType.Directional;\n            l.intensity = 1.1f;\n            l.color = new Color(1.0f, 0.97f, 0.92f, 1f);\n\n            int w = 960;\n            int h = 640;\n            rt = new RenderTexture(w, h, 24, RenderTextureFormat.ARGB32);\n            cam.targetTexture = rt;\n            cam.Render();\n\n            RenderTexture prev = RenderTexture.active;\n            RenderTexture.active = rt;\n            tex = new Texture2D(w, h, TextureFormat.RGBA32, false);\n            tex.ReadPixels(new Rect(0, 0, w, h), 0, 0);\n            tex.Apply();\n            RenderTexture.active = prev;\n\n            string scratchDir = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\";\n            Directory.CreateDirectory(scratchDir);\n            string outPath = Path.Combine(scratchDir, \"verify_depot.png\");\n            File.WriteAllBytes(outPath, tex.EncodeToPNG());\n            sb.AppendLine(\"Rendered preview to: \" + outPath);\n        }\n        finally\n        {\n            if (cam != null) cam.targetTexture = null;\n            if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n            if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n            UnityEngine.Object.DestroyImmediate(previewRoot);\n        }\n\n        return sb.ToString();\n    }\n}\n","safety_checks":true,"compiler":"codedom"},"error":"Compilation failed"}
