{"ts":"2026-11-15T18:29:26.490Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1215,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// Check Camera Rig hierarchy, all components, Main Camera missing scripts, all Units & Selection objects in Match.unity\nvar cr = GameObject.Find(\"Camera Rig\");\nif (cr != null)\n{\n    foreach (Transform t in cr.GetComponentsInChildren<Transform>(true))\n    {\n        var comps = t.GetComponents<Component>();\n        string cs = \"\";\n        foreach (var c in comps) cs += (c == null ? \"MISSING\" : c.GetType().Name) + \", \";\n        sb.AppendLine(string.Format(\"CR child '{0}' act={1}/{2} pos={3} lPos={4} scale={5} comps=[{6}]\",\n            t.name, t.gameObject.activeSelf, t.gameObject.activeInHierarchy, t.position, t.localPosition, t.localScale, cs));\n    }\n}\n// Check all objects matching Selection, Box, Line, Ring, Boat, Submarine, Unit\nforeach (var go in UnityEngine.Object.FindObjectsOfType<GameObject>(true))\n{\n    string n = go.name;\n    if (n.IndexOf(\"Select\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        n.IndexOf(\"Boat\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        n.IndexOf(\"Submarine\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        n.IndexOf(\"Order\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        n.IndexOf(\"Depot\", System.StringComparison.OrdinalIgnoreCase) >= 0)\n    {\n        var mf = go.GetComponent<MeshFilter>();\n        var mr = go.GetComponent<MeshRenderer>();\n        var lr = go.GetComponent<LineRenderer>();\n        var comps = go.GetComponents<Component>();\n        string cs = \"\";\n        foreach (var c in comps) cs += (c == null ? \"MISSING\" : c.GetType().Name) + \", \";\n        sb.AppendLine(string.Format(\"GO '{0}' parent='{1}' act={2}/{3} pos={4} lScale={5} mesh={6} mat={7} lr={8} comps=[{9}]\",\n            n, go.transform.parent != null ? go.transform.parent