{"ts":"2026-11-15T18:23:57.812Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":5745,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeIso\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    foreach (Transform ch in clone.GetComponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n\n    // 1) Camera matching probe_i31_bay: southern sand bay is around local (38, 0, 22) -> world (38, 0, -68), looking NNW toward river (22, 0, -25)\n    camGo = new GameObject(\"__ProbeIsoCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = false;\n    cam.fieldOfView = 45f;\n    Vector3 lookAtPt = i31.transform.position + new Vector3(36f, 0f, 38f);\n    cam.transform.position = i31.transform.position + new Vector3(44f, 18f, 6f);\n    cam.transform.LookAt(lookAtPt);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n\n    System.Func<string, int> countAndSave = (label) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        if (tex == null) tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        var pxs = tex.GetPixels32();\n        int cnt = 0;\n        for (int y = 4; y < 508; y++)\n        for (int x = 4; x < 508; x++)\n        {\n            var c = pxs[y * 512 + x];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nSum = 0f; int nCnt = 0;\n            for (int dy = -3; dy <= 3; dy += 3)\n            for (int dx = -3; dx <= 3; dx += 3)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var nc = pxs[(y + dy) * 512 + (x + dx)];\n                if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n                nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n                nCnt++;\n            }\n            if (nCnt >= 6 && (nSum / nCnt) > 0.10f && lum < (nSum / nCnt) * 0.45f) cnt++;\n        }\n        System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\iso_\" + label + \".png\", tex.EncodeToPNG());\n        sb.AppendLine(label + \" darkCount=\" + cnt);\n        return cnt;\n    };\n\n    // Pass A: Baseline (everything enabled, exact bay view)\n    countAndSave(\"A_baseline\");\n\n    // Pass B: Shadows OFF on main directional light(s)\n    var lights = UnityEngine.Object.FindObjectsOfType<Light>();\n    var oldShadows = new LightShadows[lights.Length];\n    for (int i = 0; i < lights.Length; i++) { oldShadows[i] = lights[i].shadows; lights[i].shadows = LightShadows.None; }\n    countAndSave(\"B_noshadows\");\n    for (int i = 0; i < lights.Length; i++) lights[i].shadows = oldShadows[i];\n\n    // Pass C: SSAO OFF\n    var rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\n    var rList = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\n    UnityEngine.Rendering.Universal.ScriptableRendererFeature ssao = null;\n    if (rList != null && rList.Length > 0)\n        foreach (var f in rList[0].rendererFeatures)\n            if (f != null && f.GetType().Name.Contains(\"AmbientOcclusion\")) { ssao = f; break; }\n    if (ssao != null)\n    {\n        bool prev = ssao.isActive;\n        ssao.SetActive(false);\n        countAndSave(\"C_nossao\");\n        ssao.SetActive(prev);\n    }\n\n    // Pass D: Replace clone material with plain URP/Lit white (isolates MESH vs SHADER!)\n    var mr = clone.GetComponent<MeshRenderer>();\n    var origMat = mr.sharedMaterial;\n    var plainMat = new Material(Shader.Find(\"Universal Render Pipeline/Lit\"));\n    plainMat.color = Color.gray;\n    mr.sharedMaterial = plainMat;\n    countAndSave(\"D_plainlit\");\n    mr.sharedMaterial = origMat;\n    UnityEngine.Object.DestroyImmediate(plainMat);\n\n    // Pass E: Also inspect the seabed curve pixels at bottom-left of probe_i31_ortho: sample TerrainSampleCache + vertices around local (12, 8) -> px ~ (72, 48)\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = new Vector3(mr.bounds.center.x, 40f, mr.bounds.center.z);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    var opx = tex.GetPixels32();\n    var mf = clone.GetComponent<MeshFilter>();\n    var verts = mf.sharedMesh.vertices;\n    int res = 541;\n    // Check bottom-left seabed dark curve around py in [20..120], px in [20..220] (which is bottom-left of ortho image)\n    int orthoHits = 0;\n    for (int y = 10; y < 180 && orthoHits < 8; y++)\n    for (int x = 10; x < 240 && orthoHits < 8; x++)\n    {\n        var c = opx[y * 512 + x];\n        if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        float nSum = 0f; int nCnt = 0;\n        for (int dy = -2; dy <= 2; dy += 2)\n        for (int dx = -2; dx <= 2; dx += 2)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var nc = opx[(y + dy) * 512 + (x + dx)];\n            nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n            nCnt++;\n        }\n        float avg = nSum / nCnt;\n        if (avg > 0.12f && lum < avg * 0.45f)\n        {\n            float lx = (x + 0.5f) / 512f * 90f;\n            float lz = (y + 0.5f) / 512f * 90f;\n            int gx = Mathf.Clamp(Mathf.RoundToInt(lx / 90f * 540f), 1, 539);\n            int gz = Mathf.Clamp(Mathf.RoundToInt(lz / 90f * 540f), 1, 539);\n            sb.AppendLine(string.Format(\"SEABED DARK ({0},{1}) local=({2:F2},{3:F2}) g=({4},{5}) h(g-1,g,g+1)=({6:F4},{7:F4},{8:F4}) z({9:F4},{10:F4}) c=({11},{12},{13})\",\n                x, y, lx, lz, gx, gz,\n                verts[gz * res + gx - 1].y, verts[gz * res + gx].y, verts[gz * res + gx + 1].y,\n                verts[(gz - 1) * res + gx].y, verts[(gz + 1) * res + gx].y, c.r, c.g, c.b));\n            orthoHits++;\n        }\n    }\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
