{"ts":"2026-11-15T19:43:07.715Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":156520,"action":"execute","params":{"action":"execute","code":"// Check EVERY Pattern in MapManager: which patterns generate island heights > waterHeight inside Plateau chunks, OR wait - check why Pattern[4] in 59fc0fd0 had DIFFERENT island shapes than diag_topdown.png!\nvar mm = UnityEngine.Object.FindFirstObjectByType<MapManager>();\nvar sb = new System.Text.StringBuilder();\n// Test Pattern[4] BuildWorldTerrainField heights inside every Plateau slot box!\nvar method = typeof(MapManager).GetMethod(\"BuildWorldTerrainField\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nfor (int pi = 0; pi < mm.patternDataList.Count; pi++)\n{\n    var p = mm.patternDataList[pi];\n    if (p == null) continue;\n    int count = p.spawnPattern == MapManager.SpawnPattern.Singular ? 1 : p.gridSize;\n    float spacing = 45f; // wait check PatternData slot spacing!\n    int hitsAboveWaterInPlateau = 0;\n    float maxPlateauOverlayH = -999f;\n    var wtf = (WorldTerrainField)method.Invoke(mm, new object[] { p });\n    for (int r = 0; r < count; r++)\n    for (int c = 0; c < count; c++)\n    {\n        int slot = count == 1 ? 1 : r * count + c + 1;\n        if (!p.TryResolveSlot(slot, r, c, out var kind, out var prefab, out var ov)) continue;\n        if (kind != GridType.Type.Plateau) continue;\n        var src = wtf.SourceForSlot(slot);\n        float maxH = -999f;\n        var cache = src.GetOrCreateSampleCache(8);\n        // Sample WorldTerrainField across this plateau's 90x90 bounds!\n        float ox = r * mm.LatticeSlotSpacing - mm.LatticeCenteringOffset;\n        float oz = c * mm.LatticeSlotSpacing - mm.LatticeCenteringOffset;\n        // Wait: LatticeCenteringOffset uses SelectedPatternData! Compute directly:\n        float offset = count == 1 ? mm.ChunkWorldSize * 0.5f : ((count - 1) * mm.LatticeSlotSpacing + mm.ChunkWorldSize) * 0.5f;\n        ox = r * mm.LatticeSlotSpacing - offset;\n        oz = c * mm.LatticeSlotSpacing - offset;\n        for (int z = 0; z <= 90; z += 5)\n        for (int x = 0; x <= 90; x += 5)\n        {\n            // use src.UseWorldField check via reflection or wtf.Find\n            var findM = typeof(WorldTerrainField).GetMethod(\"Find\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\n            object[] args = new object[] { new UnityEngine.Vector2(ox + x, oz + z), 0 };\n            var win = (IslandTerrainProvider)findM.Invoke(wtf, args);\n            if (win != null)\n            {\n                int idx = (int)args[1];\n                var bc = typeof(IslandTerrainProvider).GetProperty(\"BuiltCache\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic).GetValue(win) as TerrainSampleCache;\n                float h = bc.Heights[idx];\n                if (h > maxH) maxH = h;\n                if (h > -1f) hitsAboveWaterInPlateau++;\n            }\n        }\n        if (maxH > maxPlateauOverlayH) maxPlateauOverlayH = maxH;\n    }\n    sb.AppendLine(string.Format(\"Pattern[{0}] '{1}': maxH_in_any_plateau={2:F2} hitsAbove(-1)={3}\", pi, p.displayName, maxPlateauOverlayH, hitsAboveWaterInPlateau));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
