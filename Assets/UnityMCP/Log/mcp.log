\n            sb.AppendLine(\"  Field tex \" + f.Name + \" = \" + (t ? t.name + \" \" + t.width + \"x\" + t.height : \"null\"));\n        }\n    }\n    if (mat != null)\n    {\n        string[] pnames = new string[] { \"_Control\", \"_SurfaceTint\", \"_RegionMask\" };\n        for (int p = 0; p < pnames.Length; p++)\n        {\n            var t = mat.HasProperty(pnames[p]) ? mat.GetTexture(pnames[p]) as Texture2D : null;\n            sb.AppendLine(\"  Mat tex \" + pnames[p] + \" = \" + (t ? t.name + \" \" + t.width + \"x\" + t.height + \" readable=\" + t.isReadable : \"null\"));\n        }\n        // Check MaterialPropertyBlock if any or mat instances!\n        var mpb = new MaterialPropertyBlock();\n        cmr.GetPropertyBlock(mpb);\n        sb.AppendLine(\"  MPB isEmpty=\" + mpb.isEmpty);\n    }\n}\ncatch (System.Exception ex)\n{\n    sb.AppendLine(\"Exception: \" + ex.ToString());\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
