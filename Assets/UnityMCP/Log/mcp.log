Bands\", flags);\nsb.AppendLine(\"=== CoastalBands at src[8] (44.83,-120.67) dx=-1..0 ===\");\nfor (int dx = -1; dx <= 0; dx++)\n{\n    int idx = scz * res8 + (scx + dx);\n    float lx = (scx + dx) * step8 - pad8;\n    float lz = scz * step8 - pad8;\n    object bands = resolveBandsM.Invoke(src8, new object[] { lx, lz, hm8[idx], sc8[idx] });\n    sb.Append(\"  dx=\" + dx + \" h=\" + h8[idx].ToString(\"F3\") + \" sh=\" + sh8[idx].ToString(\"F3\") + \" \");\n    foreach (var f in bands.GetType().GetFields(flags)) sb.Append(f.Name + \"=\" + f.GetValue(bands) + \" \");\n    foreach (var p in bands.GetType().GetProperties(flags)) sb.Append(p.Name + \"=\" + p.GetValue(bands, null) + \" \");\n    sb.AppendLine(\"\");\n}\nsb.AppendLine(\"IslandTerrainProvider coastal/height methods:\");\nforeach (var m in st8.GetMethods(flags))\n    if (m.DeclaringType == st8 && (m.Name.Contains(\"Height\") || m.Name.Contains(\"Coast\") || m.Name.Contains(\"Resolve\")))\n        sb.AppendLine(\"  \" + m.Name + \"(\" + m.GetParameters().Length + \")\");\n\n// 2. Find ALL flatland seams across ALL 8 Islands where min(5x5) > 0.55 AND max(5x5) < 1.15 AND (lap > 0.02 OR max(|dh|) > 0.05)\nsb.AppendLine(\"=== Strict Flat-Grass Creases (5x5 all in 0.55..1.15, lap>0.02 or dh>0.05) across ALL 8 Islands ===\");\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (!mg.name.StartsWith(\"Island \")) continue;\n    var m = mg.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n    if (side * side != m.vertexCount) continue;\n    int cnt = 0;\n    var pts = new System.Collections.Generic.List<string>();\n    for (int z = 3; z < side - 3; z++)\n    {\n        for (int x = 3; x < side - 3; x++)\n        {\n            int idx = z * side + x;\n            float y = v[idx].y;\n            if (y < 0.60f || y > 1.05f) continue;\n            float min5 = 99f, max5 = -99f;\n            for (int dz = -2; dz <= 2; dz++)\n                for (int dx = -2; dx <= 2; dx++)\n                {\n                    float nyv = v[(z + dz) * side + (x + dx)].y;\n                    if (nyv < min5) min5 = nyv;\n                    if (nyv > max5) max5 = nyv;\n                }\n            if (min5 > 0.55f && max5 < 1.15f)\n            {\n                float avg4 = 0.25f * (v[idx - 1].y + v[idx + 1].y + v[idx - side].y + v[idx + side].y);\n                float lap = Mathf.Abs(y - avg4);\n                float dh = Mathf.Max(\n                    Mathf.Max(Mathf.Abs(y - v[idx - 1].y), Mathf.Abs(y - v[idx + 1].y)),\n                    Mathf.Max(Mathf.Abs(y - v[idx - side].y), Mathf.Abs(y - v[idx + side].y)));\n                if (lap > 0.02f || dh > 0.05f)\n                {\n                    cnt++;\n                    if (pts.Count < 8)\n                    {\n                        Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                        pts.Add(string.Format(\"({0:F2},{1:F2}) y={2:F3} lap={3:F3} dh={4:F3}\", wp.x, wp.z, y, lap, dh));\n                    }\n                }\n            }\n        }\n    }\n    sb.AppendLine(string.Format(\"  {0}: count={1}\", mg.name, cnt));\n    for (int i = 0; i < pts.Count; i++) sb.AppendLine(\"    \" + pts[i]);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
