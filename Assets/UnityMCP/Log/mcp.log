{"ts":"2026-11-15T18:57:36.840Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1605,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\n// Check GroundMarker / UnitSelections / UnitClick in scene\nUnitSelections us = UnityEngine.Object.FindObjectOfType<UnitSelections>(true);\nif (us != null)\n{\n    sb.AppendLine(\"UnitSelections on: \" + us.name + \" groundMarker=\" + (us.groundMarker != null ? us.groundMarker.name : \"null\"));\n}\nUnitClick uc = UnityEngine.Object.FindObjectOfType<UnitClick>(true);\nif (uc != null)\n{\n    sb.AppendLine(\"UnitClick on: \" + uc.name + \" groundMarker=\" + (uc.groundMarker != null ? uc.groundMarker.name : \"null\") + \" gfx=\" + (uc.GroundMarkerGraphics != null ? uc.GroundMarkerGraphics.name : \"null\"));\n}\n\n// Check all SelectionOutlineTarget components in scene\nSelectionOutlineTarget[] sots = UnityEngine.Object.FindObjectsOfType<SelectionOutlineTarget>(true);\nsb.AppendLine(\"SelectionOutlineTargets in scene: \" + sots.Length);\nforeach (SelectionOutlineTarget s in sots)\n{\n    sb.AppendLine(\"  \" + s.name + \" act=\" + s.gameObject.activeInHierarchy + \" selected=\" + s.IsSelected + \" pos=\" + s.transform.position);\n}\n\n// Check SelectionMarker.mat references across scene and prefabs & existing ring textures in Assets\nstring[] ringTexs = AssetDatabase.FindAssets(\"t:Texture2D\", new string[] { \"Assets\" });\nsb.Append(\"Textures matching Ring/Circle/Select/Marker: \");\nforeach (string g in ringTexs)\n{\n    string p = AssetDatabase.GUIDToAssetPath(g);\n    if (p.IndexOf(\"Ring\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        p.IndexOf(\"Select\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        p.IndexOf(\"Circle\", System.StringComparison.OrdinalIgnoreCase) >= 0 ||\n        p.IndexOf(\"Marker\", System.StringComparison.OrdinalIgnoreCase) >= 0)\n    {\n        sb.Append(p + \"; \");\n    }\n}\nsb.AppendLine();\n\n// Step 3 UI inspection: Tier Button Manager, T5A, T6A, AB.Tier 5, AB.Tier 6, BG Lower (1), Player Faction Controller, Player Tab Controller, Tab Button A/B/C\nsb.AppendLine(\"=== Step 3 UI Objects ===\");\nstring[] uiNames = new string[] {\n    \"Tier Button Manager\", \"T1A\", \"T2A\", \"T3A\", \"T4A\", \"T5A\", \"T6A\",\n    \"AB.Tier 1\", \"AB.Tier 2\", \"AB.Tier 3\", \"AB.Tier 4\", \"AB.Tier 5\", \"AB.Tier 6\",\n    \"BG Lower (1)\", \"Player Faction Controller\", \"Player Tab Controller\",\n    \"Tab Button A\", \"Tab Button B\", \"Tab Button C\"\n};\n\nTransform[] allTransforms = Resources.FindObjectsOfTypeAll<Transform>();\nforeach (string target in uiNames)\n{\n    bool found = false;\n    foreach (Transform t in allTransforms)\n    {\n        if (!t.gameObject.scene.IsValid()) continue;\n        if (t.name != target) continue;\n        found = true;\n        RectTransform rt = t as RectTransform;\n        string rtInfo = rt != null\n            ? (\"aPos=\" + rt.anchoredPosition + \" size=\" + rt.sizeDelta + \" anchorMin=\" + rt.anchorMin + \" anchorMax=\" + rt.anchorMax + \" wPos=\" + t.position)\n            : (\"pos=\" + t.position);\n        sb.AppendLine(\"  [\" + t.name + \"] act=\" + t.gameObject.activeSelf + \" parent=\" + (t.parent != null ? t.parent.name : \"ROOT\") + \" \" + rtInfo);\n\n        Component[] comps = t.GetComponents<Component>();\n        string cList = \"\";\n        int missingCount = 0;\n        foreach (Component c in comps)\n        {\n            if (c == null) missingCount++;\n            else cList += c.GetType().Name + \", \";\n        }\n        if (missingCount > 0) cList += \"MISSING x\" + missingCount;\n        sb.AppendLine(\"    comps: \" + cList);\n\n        if (t.name == \"Tier Button Manager\")\n        {\n            UnityEngine.UI.HorizontalLayoutGroup hlg = t.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n            if (hlg != null)\n                sb.AppendLine(\"    HLG enabled=\" + hlg.enabled + \" spacing=\" + hlg.spacing + \" pad=(\" + hlg.padding.left + \",\" + hlg.padding.right + \",\" + hlg.padding.top + \",\" + hlg.padding.bottom + \") childForceExpandW=\" + hlg.childForceExpandWidth);\n            sb.Append(\"    children(\" + t.childCount + \"): \");\n            for (int ci = 0; ci < t.childCount; ci++)\n            {\n                RectTransform crt = t.GetChild(ci) as RectTransform;\n                sb.Append(t.GetChild(ci).name + \"(act=\" + t.GetChild(ci).gameObject.activeSelf + \",x=\" + (crt != null ? crt.anchoredPosition.x.ToString(\"F1\") : \"?\") + \") \");\n            }\n            sb.AppendLine();\n        }\n        if (t.name == \"AB.Tier 5\" || t.name == \"AB.Tier 6\")\n        {\n            for (int ci = 0; ci < t.childCount; ci++)\n            {\n                Transform ch = t.GetChild(ci);\n                int mc = 0;\n                foreach (Component cc in ch.GetComponents<Component>()) if (cc == null) mc++;\n                if (mc > 0) sb.AppendLine(\"    child \" + ch.name + \" has MISSING x\" + mc);\n            }\n        }\n        if (t.name.StartsWith(\"Tab Button\"))\n        {\n            UnityEngine.UI.Button btn = t.GetComponent<UnityEngine.UI.Button>();\n            if (btn != null)\n            {\n                sb.AppendLine(\"    Button onClick count=\" + btn.onClick.GetPersistentEventCount() + \" interactable=\" + btn.interactable);\n                for (int e = 0; e < btn.onClick.GetPersistentEventCount(); e++)\n                {\n                    UnityEngine.Object tgt = btn.onClick.GetPersistentTarget(e);\n                    sb.AppendLine(\"      onClick[\" + e + \"]: \" + (tgt != null ? tgt.name : \"NULL\") + \".\" + btn.onClick.GetPersistentMethodName(e));\n                }\n            }\n        }\n        if (t.name.StartsWith(\"T\") && t.name.EndsWith(\"A\") && t.name.Length == 3)\n        {\n            UnityEngine.UI.Button btn = t.GetComponent<UnityEngine.UI.Button>();\n            if (btn != null)\n            {\n                string evs = \"\";\n                for (int e = 0; e < btn.onClick.GetPersistentEventCount(); e++)\n                {\n                    UnityEngine.Object tgt = btn.onClick.GetPersistentTarget(e);\n                    evs += (tgt != null ? tgt.name : \"NULL\") + \".\" + btn.onClick.GetPersistentMethodName(e) + \"; \";\n                }\n                sb.AppendLine(\"    Button onClick: \" + evs);\n            }\n            UnityEngine.UI.LayoutElement le = t.GetComponent<UnityEngine.UI.LayoutElement>();\n            if (le != null) sb.AppendLine(\"    LayoutElement ignore=\" + le.ignoreLayout + \" pref=\" + le.preferredWidth + \"x\" + le.preferredHeight);\n        }\n        if (t.name == \"BG Lower (1)\")\n        {\n            UnityEngine.UI.LayoutElement le = t.GetComponent<UnityEngine.UI.LayoutElement>();\n            sb.AppendLine(\"    LayoutElement: \" + (le != null ? (\"ignore=\" + le.ignoreLayout) : \"NONE\"));\n        }\n    }\n    if (!found) sb.AppendLine(\"  [\" + target + \"] NOT FOUND\");\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
