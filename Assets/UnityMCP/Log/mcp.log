{"ts":"2026-11-15T18:33:41.682Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1129,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mm = UnityEngine.Object.FindObjectOfType(typeof(MapManager)) as MapManager;\nvar bf = System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;\nvar wt = mm.GetTerrainField();\nvar srcs = new System.Collections.Generic.List<object>();\nforeach (var s in (wt.GetType().GetProperty(\"Sources\", bf).GetValue(wt, null) as System.Collections.IEnumerable)) srcs.Add(s);\n\nSystem.Action<int, int, int, string> inspectRiver = (sIdx, cx, cz, lbl) =>\n{\n    var s = srcs[sIdx];\n    var resObj = s.GetType().GetProperty(\"Reservations\", bf).GetValue(s, null);\n    var plan = resObj.GetType().GetProperty(\"RiverPlan\", bf) != null\n        ? resObj.GetType().GetProperty(\"RiverPlan\", bf).GetValue(resObj, null)\n        : resObj.GetType().GetField(\"riverPlan\", bf).GetValue(resObj);\n    var cache = s.GetType().GetProperty(\"BuiltCache\", bf).GetValue(s, null);\n    float step = (float)cache.GetType().GetProperty(\"Step\").GetValue(cache, null);\n    sb.AppendLine(lbl + \" plan=\" + (plan != null));\n    if (plan == null) return;\n    var tryM = plan.GetType().GetMethod(\"TrySample\");\n    for (int x = cx - 2; x <= cx + 3; x++)\n    {\n        object[] args = new object[] { new Vector2(x * step, cz * step), null };\n        bool ok = (bool)tryM.Invoke(plan, args);\n        if (!ok) sb.AppendLine(\"  (\" + x + \",\" + cz + \") -> FALSE\");\n        else\n        {\n            var smp = args[1];\n            var st = smp.GetType();\n            sb.AppendLine(string.Format(\"  ({0},{1}) -> inf={2:F3} wet={3} kind={4} target={5:F3} water={6:F3}\",\n                x, cz, st.GetField(\"Influence\").GetValue(smp), st.GetField(\"IsWater\").GetValue(smp),\n                st.GetField(\"Kind\").GetValue(smp), st.GetField(\"TargetHeight\").GetValue(smp), st.GetField(\"WaterHeight\").GetValue(smp)));\n        }\n    }\n    // Also dump nearby sections around (cx*step, cz*step)\n    var secs = plan.GetType().GetProperty(\"Sections\").GetValue(plan, null) as System.Collections.IList;\n    Vector2 pt = new Vector2(cx * step, cz * step);\n    for (int i = 0; i < secs.Count; i++)\n    {\n        var sec = secs[i];\n        var scType = sec.GetType();\n        Vector2 sc = (Vector2)scType.GetField(\"Centre\").GetValue(sec);\n        if (Vector2.Distance(sc, pt) < 12f)\n        {\n            sb.AppendLine(string.Format(\"  sec[{0}] centre={1:F2} water={2:F2} bed={3:F2} lw={4:F2} rw={5:F2} kind={6} lbExt={7:F2} rbExt={8:F2}\",\n                i, sc, scType.GetField(\"WaterHeight\").GetValue(sec), scType.GetField(\"BedHeight\").GetValue(sec),\n                scType.GetField(\"LeftWaterWidth\").GetValue(sec), scType.GetField(\"RightWaterWidth\").GetValue(sec),\n                scType.GetField(\"Kind\").GetValue(sec),\n                ((RiverBankProfile)scType.GetField(\"LeftBank\").GetValue(sec)).Extent,\n                ((RiverBankProfile)scType.GetField(\"RightBank\").GetValue(sec)).Extent));\n        }\n    }\n};\n\ninspectRiver(7, 531, 366, \"=== src[7] Island 21 River Jump ===\");\ninspectRiver(14, 453, 333, \"=== src[14] Island 47 River Jump ===\");\n\n// Check for each Island source how high terrain is within 2m inside its [Origin, Origin+ShapeSize] borders:\nfor (int i = 0; i < srcs.Count; i++)\n{\n    var s = srcs[i];\n    if (s.GetType().GetField(\"gridType\", bf).GetValue(s).ToString() != \"Island\") continue;\n    var org = (Vector2)s.GetType().GetProperty(\"WorldOrigin\", bf).GetValue(s, null);\n    var size = Convert.ToSingle(s.GetType().GetField(\"shapeSize\", bf).GetValue(s));\n    var cache = s.GetType().GetProperty(\"BuiltCache\", bf).GetValue(s, null);\n    float pad = Convert.ToSingle(s.GetType().GetProperty(\"SampleCachePadding\", bf).GetValue(s, null));\n    int res = (int)cache.GetType().GetProperty(\"Resolution\").GetValue(cache, null);\n    float step = (float)cache.GetType().GetProperty(\"Step\").GetValue(cache, null);\n    float[] h = (float[])cache.GetType().GetProperty(\"Heights\").GetValue(cache, null);\n    // check max height OUTSIDE [org, org+size] (i.e. inside the padding ring!)\n    float maxOutsideH = -999f;\n    for (int z = 0; z < res; z++)\n    for (int x = 0; x < res; x++)\n    {\n        float lx = x * step - pad;\n        float lz = z * step - pad;\n        if (lx >= 0f && lx <= size && lz >= 0f && lz <= size) continue;\n        float hv = h[z * res + x];\n        if (hv > maxOutsideH) maxOutsideH = hv;\n    }\n    sb.AppendLine(string.Format(\"src[{0}] Island org={1} shapeSize={2} maxHeightOutsideShapeBox={3:F3}\", i, org, size, maxOutsideH));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"},"error":"Runtime error: Object reference not set to an instance of an object"}
