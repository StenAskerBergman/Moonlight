{"ts":"2026-11-15T18:12:40.391Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1984,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar i31 = GameObject.Find(\"Island 31\");\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nvar clone = UnityEngine.Object.Instantiate(i31);\nclone.name = \"__TempProbe\";\nclone.transform.SetParent(i31.transform.parent, true);\n\ntry\n{\n    var cmg = clone.GetComponent<MapGrid>();\n    var srcMg = i31.GetComponent<MapGrid>();\n    foreach (var f in typeof(MapGrid).GetFields(flags))\n    {\n        if (f.Name == \"pendingWorldField\" || f.Name == \"worldTerrainField\" || f.Name == \"mapManager\")\n        {\n            var val = f.GetValue(srcMg);\n            if (val != null) f.SetValue(cmg, val);\n        }\n    }\n    var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n    object wtf = null;\n    foreach (var f in typeof(MapManager).GetFields(flags))\n        if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n    if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n\n    typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags).Invoke(cmg, null);\n\n    var cmr = clone.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    cmr.GetPropertyBlock(mpb);\n    Texture2D ctrlSrc = mpb.GetTexture(\"_Control\") as Texture2D;\n    Texture2D tintSrc = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n    Texture2D regSrc = mpb.GetTexture(\"_RegionMask\") as Texture2D;\n\n    int w = tintSrc.width;\n    // GPU readback for non-readable textures\n    var rt = RenderTexture.GetTemporary(w, w, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);\n    var prev = RenderTexture.active;\n    RenderTexture.active = rt;\n\n    Graphics.Blit(tintSrc, rt);\n    var tintTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n    tintTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n    tintTex.Apply();\n    Color[] tCols = tintTex.GetPixels();\n\n    Graphics.Blit(ctrlSrc, rt);\n    var ctrlTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n    ctrlTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n    ctrlTex.Apply();\n    Color[] cCols = ctrlTex.GetPixels();\n\n    RenderTexture.active = prev;\n    RenderTexture.ReleaseTemporary(rt);\n    UnityEngine.Object.DestroyImmediate(tintTex);\n    UnityEngine.Object.DestroyImmediate(ctrlTex);\n\n    // Inspect mesh + textures across x=26..52, z=-62..-48 AND whole Island 31\n    var mesh = clone.GetComponent<MeshFilter>().sharedMesh;\n    var mv = mesh.vertices;\n    int mside = 541;\n\n    int px0 = Mathf.RoundToInt((26f / 90f) * w);\n    int px1 = Mathf.RoundToInt((52f / 90f) * w);\n    int pz0 = Mathf.RoundToInt((28f / 90f) * w);\n    int pz1 = Mathf.RoundToInt((42f / 90f) * w);\n\n    sb.AppendLine(\"w=\" + w + \" scanning box (\" + px0 + \"..\" + px1 + \", \" + pz0 + \"..\" + pz1 + \")\");\n    int odd = 0;\n    var hits = new System.Collections.Generic.List<string>();\n    for (int pz = pz0; pz <= pz1; pz++)\n    {\n        for (int px = px0; px <= px1; px++)\n        {\n            int idx = pz * w + px;\n            Color tc = tCols[idx];\n            Color cc = cCols[idx];\n            float y = mv[pz * mside + px].y;\n            float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n            float csum = cc.r + cc.g + cc.b + cc.a;\n            if (y > 0.4f && (luma < 0.72f || csum < 0.90f || cc.a > 0.10f || (cc.b > 0.3f && y < 1.1f)))\n            {\n                odd++;\n                if (hits.Count < 30)\n                    hits.Add(string.Format(\"({0:F2},{1:F2}) y={2:F2} tc=({3:F2},{4:F2},{5:F2}) cc=({6:F2},{7:F2},{8:F2},{9:F2})\",\n                        px / 6f, -90f + pz / 6f, y, tc.r, tc.g, tc.b, cc.r, cc.g, cc.b, cc.a));\n            }\n        }\n    }\n    sb.AppendLine(\"Box odd pixels=\" + odd);\n    for (int i = 0; i < hits.Count; i++) sb.AppendLine(\"  \" + hits[i]);\n\n    // Check WHOLE Island 31 flat grass (0.65 < y < 1.15) for ANY sharp dark contrast vs neighbors OR low csum OR non-grass control!\n    int globalOdd = 0;\n    var gHits = new System.Collections.Generic.List<string>();\n    for (int pz = 5; pz < w - 5; pz++)\n    {\n        for (int px = 5; px < w - 5; px++)\n        {\n            int idx = pz * w + px;\n            float y = mv[pz * mside + px].y;\n            if (y < 0.65f || y > 1.15f) continue;\n            Color tc = tCols[idx];\n            Color cc = cCols[idx];\n            float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n            // Also check local darkening relative to 3x3 average OR dark green/black control\n            if (luma < 0.60f || (cc.r + cc.g + cc.b + cc.a) < 0.85f || cc.a > 0.15f)\n            {\n                globalOdd++;\n                if (gHits.Count < 30)\n                    gHits.Add(string.Format(\"({0:F2},{1:F2}) y={2:F2} luma={3:F2} tc=({4:F2},{5:F2},{6:F2}) cc=({7:F2},{8:F2},{9:F2},{10:F2})\",\n                        px / 6f, -90f + pz / 6f, y, luma, tc.r, tc.g, tc.b, cc.r, cc.g, cc.b, cc.a));\n            }\n        }\n    }\n    sb.AppendLine(\"Whole Island 31 flatland odd pixels=\" + globalOdd);\n    for (int i = 0; i < gHits.Count; i++) sb.AppendLine(\"  \" + gHits[i]);\n}\ncatch (System.Exception ex)\n{\n    sb.AppendLine(\"Ex: \" + ex.ToString());\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
