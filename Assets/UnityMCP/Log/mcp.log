{"ts":"2026-11-15T19:54:17.253Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1159,"action":"execute","params":{"action":"execute","code":"string dir = \"C:/Users/stena/.gemini/antigravity/brain/80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0/scratch\";\nSystem.IO.Directory.CreateDirectory(dir);\nvar sb = new System.Text.StringBuilder();\n\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>();\nBounds worldBounds = new Bounds();\nbool hasBounds = false;\nTransform samplePlateau = null;\nTransform sampleVent = null;\nVector3 samplePlateauCenter = Vector3.zero;\nfloat samplePlateauTabletopY = -28f;\n\nfor (int i = 0; i < grids.Length; i++)\n{\n    var mr = grids[i].GetComponent<MeshRenderer>();\n    if (mr != null)\n    {\n        if (!hasBounds) { worldBounds = mr.bounds; hasBounds = true; }\n        else worldBounds.Encapsulate(mr.bounds);\n    }\n    var trs = grids[i].GetComponentsInChildren<Transform>(true);\n    for (int j = 0; j < trs.Length; j++)\n    {\n        if (sampleVent == null && trs[j].name.StartsWith(\"Hydrothermal Vent\"))\n            sampleVent = trs[j];\n    }\n    if (samplePlateau == null && mr != null && mr.sharedMaterial != null && mr.sharedMaterial.shader != null\n        && mr.sharedMaterial.shader.name.Contains(\"UnderwaterPlateau\"))\n    {\n        samplePlateau = grids[i].transform;\n        samplePlateauCenter = mr.bounds.center;\n        // Sample approximate center height by checking raycast downward onto chunk collider\n        var mc = grids[i].GetComponent<MeshCollider>();\n        RaycastHit hit;\n        if (mc != null && mc.Raycast(new Ray(new Vector3(mr.bounds.center.x, 5f, mr.bounds.center.z), Vector3.down), out hit, 80f))\n        {\n            samplePlateauTabletopY = hit.point.y;\n        }\n    }\n}\nsb.AppendLine(\"WorldBounds=\" + worldBounds.ToString() + \" samplePlateauY=\" + samplePlateauTabletopY.ToString(\"F2\"));\n\n// Hide Ocean Cube temporarily only during topdown check so submerged skirts are visible, then restore!\nvar ocean = GameObject.Find(\"Ocean Cube - Water Cube\");\nbool oceanWasActive = ocean != null && ocean.activeSelf;\n\nGameObject camGo = new GameObject(\"__TEMP_DiagCam\");\ntry\n{\n    var cam = camGo.AddComponent<Camera>();\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = new Color(0.03f, 0.14f, 0.20f, 1f);\n    cam.farClipPlane = 400f;\n\n    // 1. Top-down map view (without ocean surface so we inspect island + skirt transitions)\n    if (ocean != null) ocean.SetActive(false);\n    cam.orthographic = true;\n    cam.orthographicSize = Mathf.Max(worldBounds.extents.x, worldBounds.extents.z) * 1.05f;\n    cam.transform.position = new Vector3(worldBounds.center.x, 80f, worldBounds.center.z);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n\n    RenderTexture rt1 = new RenderTexture(1024, 1024, 24);\n    cam.targetTexture = rt1;\n    cam.Render();\n    RenderTexture.active = rt1;\n    Texture2D tex1 = new Texture2D(1024, 1024, TextureFormat.RGB24, false);\n    tex1.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\n    tex1.Apply();\n    System.IO.File.WriteAllBytes(dir + \"/diag_verify_topdown.png\", tex1.EncodeToPNG());\n    UnityEngine.Object.DestroyImmediate(tex1);\n    RenderTexture.active = null;\n    cam.targetTexture = null;\n    rt1.Release();\n    UnityEngine.Object.DestroyImmediate(rt1);\n    if (ocean != null) ocean.SetActive(oceanWasActive);\n\n    // 2. Underwater Plateau Overview from CameraRig dive height (-4m, FOV 67, pitch 49)\n    cam.orthographic = false;\n    cam.fieldOfView = 67f;\n    cam.transform.position = new Vector3(samplePlateauCenter.x, -4.0f, samplePlateauCenter.z - 14f);\n    cam.transform.rotation = Quaternion.Euler(49f, 0f, 0f);\n    Moonlight.Rendering.UnderwaterTransitionState.UnderwaterAmount = 1f;\n    Moonlight.Rendering.UnderwaterTransitionState.WaterLevel = -0.5f;\n\n    RenderTexture rt2 = new RenderTexture(1280, 720, 24);\n    cam.targetTexture = rt2;\n    cam.Render();\n    RenderTexture.active = rt2;\n    Texture2D tex2 = new Texture2D(1280, 720, TextureFormat.RGB24, false);\n    tex2.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0);\n    tex2.Apply();\n    System.IO.File.WriteAllBytes(dir + \"/diag_verify_underwater_overview.png\", tex2.EncodeToPNG());\n    UnityEngine.Object.DestroyImmediate(tex2);\n    RenderTexture.active = null;\n    cam.targetTexture = null;\n    rt2.Release();\n    UnityEngine.Object.DestroyImmediate(rt2);\n\n    // 3. Hydrothermal Vent smoke/bubble stack close-up\n    if (sampleVent != null)\n    {\n        var pss = sampleVent.GetComponentsInChildren<ParticleSystem>(true);\n        for (int p = 0; p < pss.Length; p++)\n        {\n            pss[p].Simulate(2.2f, false, true);\n        }\n        Vector3 vp = sampleVent.position;\n        sb.AppendLine(\"SampleVent=\" + sampleVent.name + \" pos=\" + vp.ToString(\"F2\") + \" psCount=\" + pss.Length);\n        cam.fieldOfView = 55f;\n        cam.transform.position = vp + new Vector3(0f, 2.2f, -3.8f);\n        cam.transform.LookAt(vp + new Vector3(0f, 1.4f, 0f));\n\n        RenderTexture rt3 = new RenderTexture(960, 720, 24);\n        cam.targetTexture = rt3;\n        cam.Render();\n        RenderTexture.active = rt3;\n        Texture2D tex3 = new Texture2D(960, 720, TextureFormat.RGB24, false);\n        tex3.ReadPixels(new Rect(0, 0, 960, 720), 0, 0);\n        tex3.Apply();\n        System.IO.File.WriteAllBytes(dir + \"/diag_verify_vent.png\", tex3.EncodeToPNG());\n        UnityEngine.Object.DestroyImmediate(tex3);\n        RenderTexture.active = null;\n        cam.targetTexture = null;\n        rt3.Release();\n        UnityEngine.Object.DestroyImmediate(rt3);\n        for (int p = 0; p < pss.Length; p++) pss[p].Stop(false, ParticleSystemStopBehavior.StopEmittingAndClear);\n    }\n}\nfinally\n{\n    Moonlight.Rendering.UnderwaterTransitionState.Reset();\n    if (ocean != null) ocean.SetActive(oceanWasActive);\n    UnityEngine.Object.DestroyImmediate(camGo);\n}\