{"ts":"2026-11-15T18:20:59.560Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":8336,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nsb.AppendLine(\"MapManager on \" + mm.name + \" fields:\");\nforeach (var f in typeof(MapManager).GetFields(flags))\n{\n    var tn = f.FieldType.Name;\n    if (tn == \"Int32\" || tn == \"Boolean\" || tn == \"Single\" || f.Name.IndexOf(\"seed\", System.StringComparison.OrdinalIgnoreCase) >= 0 || f.Name.IndexOf(\"rand\", System.StringComparison.OrdinalIgnoreCase) >= 0)\n        sb.AppendLine(\"  \" + f.Name + \" = \" + f.GetValue(mm));\n}\n\n// Check ALL scene root GameObjects and Managers\nsb.AppendLine(\"=== Scene Root Objects ===\");\nvar roots = UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects();\nfor (int i = 0; i < roots.Length; i++)\n{\n    var r = roots[i];\n    sb.Append(r.name + \" (act=\" + r.activeSelf + \") [\");\n    var cs = r.GetComponents<Component>();\n    for (int c = 0; c < cs.Length; c++)\n        if (cs[c] != null && !(cs[c] is Transform)) sb.Append(cs[c].GetType().Name + \", \");\n    sb.AppendLine(\"]\");\n}\n\n// Check rendered relative dark streaks (luma < 0.65 * neighborMin) on ALL 8 islands AND save oblique + topdown probe PNG of Island 31 bay!\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n\nvar camGo = new GameObject(\"__ProbeCam\");\nvar cam = camGo.AddComponent<Camera>();\ncam.clearFlags = CameraClearFlags.SolidColor;\ncam.backgroundColor = Color.magenta;\nvar rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\ncam.targetTexture = rt;\n\nstring[] islandNames = new string[] { \"Island 31\", \"Island 3\", \"Island 29\", \"Island 21\", \"Island 17\", \"Island 19\", \"Island 33\", \"Island 47\" };\ntry\n{\n    for (int i = 0; i < islandNames.Length; i++)\n    {\n        var go = GameObject.Find(islandNames[i]);\n        if (go == null) continue;\n        var clone = UnityEngine.Object.Instantiate(go);\n        clone.name = \"__Probe_\" + go.name;\n        clone.transform.SetParent(go.transform.parent, true);\n        bool origAct = go.activeSelf;\n        go.SetActive(false);\n        clone.transform.position = go.transform.position + new Vector3(0f, 500f, 0f);\n        try\n        {\n            var cmg = clone.GetComponent<MapGrid>();\n            var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n            if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n            typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags).Invoke(cmg, null);\n\n            cam.orthographic = true;\n            cam.orthographicSize = 45f;\n            cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n            cam.transform.position = clone.transform.position + new Vector3(45f, 80f, 45f);\n            cam.Render();\n\n            var prev = RenderTexture.active;\n            RenderTexture.active = rt;\n            var snap = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n            snap.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n            snap.Apply();\n            RenderTexture.active = prev;\n\n            var px = snap.GetPixels();\n            int relDark = 0;\n            var pts = new System.Collections.Generic.List<string>();\n            for (int y = 4; y < 508; y++)\n            {\n                for (int x = 4; x < 508; x++)\n                {\n                    Color c = px[y * 512 + x];\n                    float l = c.r * 0.3f + c.g * 0.59f + c.b * 0.11f;\n                    Color cL = px[y * 512 + (x - 2)], cR = px[y * 512 + (x + 2)];\n                    Color cD = px[(y - 2) * 512 + x], cU = px[(y + 2) * 512 + x];\n                    float lL = cL.r*0.3f+cL.g*0.59f+cL.b*0.11f;\n                    float lR = cR.r*0.3f+cR.g*0.59f+cR.b*0.11f;\n                    float lD = cD.r*0.3f+cD.g*0.59f+cD.b*0.11f;\n                    float lU = cU.r*0.3f+cU.g*0.59f+cU.b*0.11f;\n                    bool gLR = cL.g > cL.r * 1.15f && cR.g > cR.r * 1.15f && l < Mathf.Min(lL, lR) * 0.65f;\n                    bool gDU = cD.g > cD.r * 1.15f && cU.g > cU.r * 1.15f && l < Mathf.Min(lD, lU) * 0.65f;\n                    if (gLR || gDU)\n                    {\n                        relDark++;\n                        if (pts.Count < 4)\n                        {\n                            float wx = go.transform.position.x + (x / 512f) * 90f;\n                            float wz = go.transform.position.z + (y / 512f) * 90f;\n                            pts.Add(string.Format(\"({0:F1},{1:F1}) l={2:F3}/{3:F3}\", wx, wz, l, Mathf.Min(lL, lR)));\n                        }\n                    }\n                }\n            }\n            sb.AppendLine(go.name + \": rendered relDark(<0.65x) in green=\" + relDark);\n            for (int k = 0; k < pts.Count; k++) sb.AppendLine(\"  \" + pts[k]);\n\n            if (go.name == \"Island 31\")\n            {\n                try\n                {\n                    // Also render oblique view of Island 31 bay!\n                    cam.orthographic = false;\n                    cam.fieldOfView = 50f;\n                    cam.transform.position = clone.transform.position + new Vector3(38f, 18f, 16f); // x=38, z=-74\n                    cam.transform.LookAt(clone.transform.position + new Vector3(38f, 1f, 36f)); // looking at z=-54\n                    cam.Render();\n                    RenderTexture.active = rt;\n                    snap.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n                    snap.Apply();\n                    RenderTexture.active = prev;\n                    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\probe_i31_bay.png\", snap.EncodeToPNG());\n                    sb.AppendLine(\"Saved probe_i31_bay.png\");\n                }\n                catch (System.Exception ioex) { sb.AppendLine(\"Save png err: \" + ioex.Message); }\n            }\n            UnityEngine.Object.DestroyImmediate(snap);\n        }\n        finally\n        {\n            go.SetActive(origAct);\n            UnityEngine.Object.DestroyImmediate(clone);\n        }\n    }\n}\nfinally\n{\n    cam.targetTexture = null;\n    RenderTexture.DestroyImmediate(rt);\n    UnityEngine.Object.DestroyImmediate(camGo);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
