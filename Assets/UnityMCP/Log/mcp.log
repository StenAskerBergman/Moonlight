{"ts":"2026-11-15T18:11:40.520Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1143,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar i31 = GameObject.Find(\"Island 31\");\nvar mg = i31.GetComponent<MapGrid>();\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\nvar list = wtf.GetType().GetProperty(\"Sources\", flags).GetValue(wtf, null) as System.Collections.IList;\nvar src9 = list[9];\nvar st = src9.GetType();\nVector2 orig9 = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src9, null);\nfloat pad9 = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src9, null));\nvar cache9 = st.GetProperty(\"BuiltCache\", flags).GetValue(src9, null);\nvar ct = cache9.GetType();\nint res9 = (int)ct.GetProperty(\"Resolution\", flags).GetValue(cache9, null);\nfloat step9 = (float)ct.GetProperty(\"Step\", flags).GetValue(cache9, null);\nfloat[] h9 = (float[])ct.GetProperty(\"Heights\", flags).GetValue(cache9, null);\nfloat[] sl9 = (float[])ct.GetProperty(\"Slopes\", flags).GetValue(cache9, null);\nfloat[] sh9 = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache9, null);\nfloat[] mb9 = (float[])ct.GetProperty(\"MountainBoosts\", flags).GetValue(cache9, null);\nfloat[] ma9 = (float[])ct.GetProperty(\"MountainAllowances\", flags).GetValue(cache9, null);\nfloat[] rc9 = (float[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache9, null);\nvar tt9 = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache9, null);\n\n// Check TerrainTypes & Slopes & Heights in x=24..54, z=-64..-44 at 1m step (showing max slope & height)\nsb.AppendLine(\"=== Island 31 (x=24..54, z=-64..-44) TerrainType (0.5m step on x=26..52, z=-62..-48) ===\");\nfor (int kz = 0; kz <= 28; kz++)\n{\n    float wz = -48f - kz * 0.5f;\n    int iz = Mathf.RoundToInt((wz - orig9.y + pad9) / step9);\n    sb.Append(string.Format(\"z={0,5:F1}: \", wz));\n    for (int kx = 0; kx <= 52; kx++)\n    {\n        float wx = 26f + kx * 0.5f;\n        int ix = Mathf.RoundToInt((wx - orig9.x + pad9) / step9);\n        int idx = iz * res9 + ix;\n        string t = tt9.GetValue(idx).ToString();\n        float sl = sl9[idx];\n        char c = t == \"Water\" || t == \"Ocean\" || t == \"Shallow\" ? '~'\n            : t == \"Beach\" ? '.'\n            : t == \"Mountain\" ? 'M'\n            : t == \"Cliff\" ? 'C'\n            : (sl > 0.35f ? 's' : (t == \"Land\" ? '_' : 'o'));\n        sb.Append(c);\n    }\n    sb.AppendLine(\"\");\n}\n\n// Now build TerrainTextures via MapGrid on a temporary/safe clone of Island 31 and scan for dark pixels or 1px staircases!\nvar clone = UnityEngine.Object.Instantiate(i31);\nclone.name = \"__TempProbe\";\ntry\n{\n    var cmg = clone.GetComponent<MapGrid>();\n    // Call GenerateTerrain() or GenerateIslandTerrain? Let's call GenerateTerrain() on clone!\n    var genM = typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags);\n    // Check if MapGrid needs MapManager registration? Try GenerateTerrain and inspect _Control / _SurfaceTint!\n    genM.Invoke(cmg, null);\n    var cmr = clone.GetComponent<MeshRenderer>();\n    var cmat = cmr != null ? cmr.sharedMaterial : null;\n    if (cmat == null) { sb.AppendLine(\"Clone sharedMat null\"); }\n    else\n    {\n        // Note MapGrid may apply PropertyBlock or instanced material! Check PropertyBlock + mat + MapGrid fields!\n        foreach (var f in typeof(MapGrid).GetFields(flags))\n        {\n            if (typeof(Texture2D).IsAssignableFrom(f.FieldType))\n            {\n                var tex = f.GetValue(cmg) as Texture2D;\n                sb.AppendLine(\"Clone MapGrid TexField \" + f.Name + \" = \" + (tex ? tex.name + \" \" + tex.width + \"x\" + tex.height : \"null\"));\n                if (tex != null && (f.Name.IndexOf(\"Control\", System.StringComparison.OrdinalIgnoreCase) >= 0\n                    || f.Name.IndexOf(\"Tint\", System.StringComparison.OrdinalIgnoreCase) >= 0))\n                {\n                    // Scan pixels in x=26..52, z=-62..-48 (UV x = wx/90, y = (wz - (-90))/90)\n                    int w = tex.width;\n                    int px0 = Mathf.RoundToInt((26f / 90f) * w);\n                    int px1 = Mathf.RoundToInt((52f / 90f) * w);\n                    int pz0 = Mathf.RoundToInt(((-62f + 90f) / 90f) * w);\n                    int pz1 = Mathf.RoundToInt(((-48f + 90f) / 90f) * w);\n                    var cols = tex.GetPixels();\n                    int darkOrOdd = 0;\n                    var pts = new System.Collections.Generic.List<string>();\n                    for (int pz = pz0; pz <= pz1; pz++)\n                    {\n                        for (int px = px0; px <= px1; px++)\n                        {\n                            Color col = cols[pz * w + px];\n                            // Look for dark RGB (<0.25) or zero control sum or non-green rock/sand inside flat grass (col.r < 0.7 on Control or rgb < 0.25 on Tint)\n                            if (f.Name.IndexOf(\"Tint\", System.StringComparison.OrdinalIgnoreCase) >= 0)\n                            {\n                                float luma = col.r * 0.3f + col.g * 0.59f + col.b * 0.11f;\n                                if (luma < 0.35f)\n                                {\n                                    darkOrOdd++;\n                                    if (pts.Count < 15) pts.Add(string.Format(\"px({0},{1})={2}\", px, pz, col));\n                                }\n                            }\n                            else\n                            {\n                                float sum = col.r + col.g + col.b + col.a;\n                                if (sum < 0.7f || col.a > 0.2f || (col.b > 0.25f && col.r < 0.5f))\n                                {\n                                    darkOrOdd++;\n                                    if (pts.Count < 15) pts.Add(string.Format(\"px({0},{1}) sum={2:F2} col={3}\", px, pz, sum, col));\n                                }\n                            }\n                        }\n                    }\n                    sb.AppendLine(\"  Scan box oddPixels=\" + darkOrOdd);\n                    for (int i = 0; i < pts.Count; i++) sb.AppendLine(\"    \" + pts[i]);\n                }\n            }\n        }\n        // Also inspect MaterialPropertyBlock on cmr!\n        var mpb = new MaterialPropertyBlock();\n        cmr.GetPropertyBlock(mpb);\n        sb.AppendLine(\"Clone MPB empty=\" + mpb.isEmpty);\n    }\n}\ncatch (System.Exception ex)\n{\n    sb.AppendLine(\"Clone GenerateTerrain exception: \" + ex.ToString());\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(clone);\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
