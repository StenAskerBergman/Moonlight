{"ts":"2026-11-15T18:33:04.531Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1789,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mm = UnityEngine.Object.FindObjectOfType(typeof(MapManager)) as MapManager;\nvar bf = System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;\nvar wt = mm.GetTerrainField();\nvar srcs = new System.Collections.Generic.List<object>();\nforeach (var s in (wt.GetType().GetProperty(\"Sources\", bf).GetValue(wt, null) as System.Collections.IEnumerable)) srcs.Add(s);\n\nSystem.Action<int, int, int, string> dumpPatch = (sIdx, cx, cz, lbl) =>\n{\n    var s = srcs[sIdx];\n    var cache = s.GetType().GetProperty(\"BuiltCache\", bf).GetValue(s, null) ?? s.GetType().GetMethod(\"GetOrCreateSampleCache\", bf).Invoke(s, new object[] { 6 });\n    var ct = cache.GetType();\n    int res = (int)ct.GetProperty(\"Resolution\").GetValue(cache, null);\n    float[] h = (float[])ct.GetProperty(\"Heights\").GetValue(cache, null);\n    float[] sd = (float[])ct.GetProperty(\"ShoreDistances\").GetValue(cache, null);\n    float[] sc = (float[])ct.GetProperty(\"ShoreCurvatures\").GetValue(cache, null);\n    float[] rc = (float[])ct.GetProperty(\"RiverCarveDepths\").GetValue(cache, null);\n    sb.AppendLine(lbl);\n    for (int z = cz - 1; z <= cz + 1; z++)\n    {\n        string row = \"z=\" + z + \": \";\n        for (int x = cx - 2; x <= cx + 2; x++)\n        {\n            int idx = z * res + x;\n            row += string.Format(\"[{0}:h={1:F3},sd={2:F2},sc={3:F3},rc={4:F2}] \", x, h[idx], sd[idx], sc[idx], rc[idx]);\n        }\n        sb.AppendLine(row);\n    }\n};\n\ndumpPatch(6, 717, 276, \"=== src[6] CoastJ@(717,276) ===\");\ndumpPatch(8, 327, 561, \"=== src[8] CoastJ@(327,561) ===\");\ndumpPatch(7, 531, 366, \"=== src[7] RivJ@(531,366) ===\");\ndumpPatch(14, 453, 333, \"=== src[14] RivJ@(453,333) ===\");\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
