{"ts":"2026-11-15T18:03:26.057Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2076,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. Inspect ALL fields/properties containing River/Landform/Cache on IslandTerrainProvider for all Island sources\nvar mm = UnityEngine.Object.FindFirstObjectByType<MapManager>();\nvar wtf = mm.GetTerrainField();\nvar srcs = wtf.GetType().GetField(\"sources\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic).GetValue(wtf) as System.Collections.IList;\nvar gF = typeof(IslandTerrainProvider).GetField(\"gridType\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar oF = typeof(IslandTerrainProvider).GetField(\"chunkWorldOrigin\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\n\nforeach (IslandTerrainProvider p in srcs)\n{\n    if (gF.GetValue(p).ToString() != \"Island\") continue;\n    Vector2 orig = (Vector2)oF.GetValue(p);\n    sb.AppendLine(\"IslandSource orig=\" + orig);\n    foreach (var f in typeof(IslandTerrainProvider).GetFields(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public))\n    {\n        if (f.Name.ToLower().Contains(\"river\") || f.Name.ToLower().Contains(\"landform\") || f.Name.ToLower().Contains(\"cache\"))\n            sb.AppendLine(\"  f.\" + f.Name + \" = \" + f.GetValue(p));\n    }\n    foreach (var pr in typeof(IslandTerrainProvider).GetProperties(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public))\n    {\n        if (pr.Name.ToLower().Contains(\"river\") || pr.Name.ToLower().Contains(\"landform\") || pr.Name.ToLower().Contains(\"cache\"))\n            sb.AppendLine(\"  p.\" + pr.Name + \" = \" + pr.GetValue(p, null));\n    }\n    break;\n}\n\n// 2. Check Island 31 Generated Inland Water & MapGrid properties/fields, especially riverPlan/cells/textures\nvar go31 = GameObject.Find(\"Island 31\");\nvar mg31 = go31.GetComponent<MapGrid>();\nvar inlW = go31.transform.Find(\"Generated Inland Water\");\nif (inlW != null)\n{\n    var wm = inlW.GetComponent<MeshFilter>().sharedMesh;\n    sb.AppendLine(\"Island 31 InlandWater localOffset=\" + inlW.localPosition + \" bounds=\" + wm.bounds + \" verts=\" + wm.vertexCount);\n}\nforeach (var f in typeof(MapGrid).GetFields(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public))\n{\n    if (f.Name.ToLower().Contains(\"river\") || f.Name.ToLower().Contains(\"splat\") || f.Name.ToLower().Contains(\"control\") || f.Name.ToLower().Contains(\"tex\") || f.Name.ToLower().Contains(\"source\") || f.Name.ToLower().Contains(\"grid\"))\n    {\n        sb.AppendLine(\"MapGrid31 f.\" + f.Name + \" = \" + f.GetValue(mg31));\n    }\n}\n\n// 3. Find ALL objects/components related to Selection or Camera or Unit in scene\nvar mbs = UnityEngine.Object.FindObjectsByType<MonoBehaviour>(UnityEngine.FindObjectsInactive.Include, UnityEngine.FindObjectsSortMode.None);\nforeach (var mb in mbs)\n{\n    if (mb == null) continue;\n    string tn = mb.GetType().Name;\n    if (tn.Contains(\"Select\") || tn.Contains(\"Outline\") || tn.Contains(\"Highlight\") || tn.Contains(\"Ring\") || tn.Contains(\"Camera\") || tn.Contains(\"Drag\") || tn.Contains(\"Visualizer\"))\n    {\n        sb.AppendLine(\"Comp: \" + tn + \" on '\" + mb.gameObject.name + \"' (parent='\" + (mb.transform.parent != null ? mb.transform.parent.name : \"ROOT\") + \"', act=\" + mb.gameObject.activeInHierarchy + \", en=\" + mb.enabled + \")\");\n    }\n}\n\n// 4. Inspect Unit prefabs Selected child (Freight Ship, Boat, Submarine, etc.)\nstring[] guids = UnityEditor.AssetDatabase.FindAssets(\"t:Prefab\", new string[] { \"Assets/Prefabs\" });\nforeach (string guid in guids)\n{\n    string path = UnityEditor.AssetDatabase.GUIDToAssetPath(guid);\n    var pf = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(path);\n    if (pf != null && pf.GetComponent<Unit>() != null)\n    {\n        string ch0 = pf.transform.childCount > 0 ? pf.transform.GetChild(0).name : \"none\";\n        var ch0T = pf.transform.childCount > 0 ? pf.transform.GetChild(0) : null;\n        string mat = \"\";\n        if (ch0T != null)\n        {\n            var r = ch0T.GetComponent<Renderer>();\n            var mf = ch0T.GetComponent<MeshFilter>();\n            mat = \" lPos=\" + ch0T.localPosition + \" lScale=\" + ch0T.localScale + \" mesh=\" + (mf != null && mf.sharedMesh != null ? mf.sharedMesh.name : \"null\") + \" mat=\" + (r != null && r.sharedMaterial != null ? r.sharedMaterial.name : \"null\");\n        }\n        sb.AppendLine(\"UnitPrefab: \" + path + \" ch0=\" + ch0 + mat + \" hasOutline=\" + (pf.GetComponent<SelectionOutlineTarget>() != null));\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
