{"ts":"2026-11-15T17:53:00.559Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1159,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. Units detail (scale, Graphics scale, Selected world bounds, prefabs)\nvar units = UnityEngine.Resources.FindObjectsOfTypeAll<Unit>();\nsb.AppendLine(\"=== Units Detail (\" + units.Length + \") ===\");\nfor (int i = 0; i < units.Length; i++) {\n    var u = units[i];\n    bool persist = UnityEditor.EditorUtility.IsPersistent(u.gameObject);\n    string assetPath = persist ? UnityEditor.AssetDatabase.GetAssetPath(u.gameObject) : \"SCENE\";\n    sb.AppendLine(\"  [\" + i + \"] \" + u.name + \" (\" + assetPath + \") wPos=\" + u.transform.position + \" lScale=\" + u.transform.localScale);\n    if (u.transform.childCount > 0) {\n        var ch0 = u.transform.GetChild(0);\n        var mr = ch0.GetComponent<UnityEngine.Renderer>();\n        sb.AppendLine(\"     ch0=\" + ch0.name + \" act=\" + ch0.gameObject.activeSelf + \" lScale=\" + ch0.localScale + (mr != null ? \" bounds=\" + mr.bounds : \"\"));\n    }\n    if (u.transform.childCount > 1) {\n        var ch1 = u.transform.GetChild(1);\n        sb.AppendLine(\"     ch1=\" + ch1.name + \" lScale=\" + ch1.localScale);\n    }\n}\n\n// 2. Check SelectionMarker & SelectionBox materials & textures\nstring[] matPaths = new string[] {\n    \"Assets/Materials/SelectionMarker.mat\",\n    \"Assets/Materials/SelectionBox.mat\"\n};\nvar allMatGuids = UnityEditor.AssetDatabase.FindAssets(\"t:Material Selection\");\nsb.AppendLine(\"=== Selection Materials (\" + allMatGuids.Length + \") ===\");\nfor (int i = 0; i < allMatGuids.Length; i++) {\n    string p = UnityEditor.AssetDatabase.GUIDToAssetPath(allMatGuids[i]);\n    var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(p);\n    sb.AppendLine(\"  \" + p + \" shader=\" + (m.shader != null ? m.shader.name : \"null\")\n        + \" mainTex=\" + (m.HasProperty(\"_MainTex\") && m.GetTexture(\"_MainTex\") != null ? m.GetTexture(\"_MainTex\").name : \"null\")\n        + \" baseMap=\" + (m.HasProperty(\"_BaseMap\") && m.GetTexture(\"_BaseMap\") != null ? m.GetTexture(\"_BaseMap\").name : \"null\")\n        + \" color=\" + (m.HasProperty(\"_Color\") ? m.GetColor(\"_Color\").ToString() : (m.HasProperty(\"_BaseColor\") ? m.GetColor(\"_BaseColor\").ToString() : \"n/a\")));\n}\n\n// 3. Check Camera Rig MeshFilter & MeshRenderer details + Main Camera components\nvar rig = UnityEngine.GameObject.Find(\"Camera Rig\");\nif (rig != null) {\n    var mf = rig.GetComponent<UnityEngine.MeshFilter>();\n    var mr = rig.GetComponent<UnityEngine.MeshRenderer>();\n    sb.AppendLine(\"=== Camera Rig Mesh ===\");\n    sb.AppendLine(\"  mf.mesh=\" + (mf != null && mf.sharedMesh != null ? mf.sharedMesh.name : \"null\")\n        + \" mr.en=\" + (mr != null ? mr.enabled.ToString() : \"null\")\n        + \" mr.mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"null\"));\n}\n\n// 4. Inspect Tycoon UI Hierarchy\nsb.AppendLine(\"=== Tycoon UI ===\");\nvar tbm = UnityEngine.GameObject.Find(\"Tier Button Manager\");\nif (tbm != null) {\n    var hlg = tbm.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n    sb.AppendLine(\"Tier Button Manager found, HLG=\" + (hlg != null ? \"enabled=\" + hlg.enabled + \" spacing=\" + hlg.spacing + \" pad=\" + hlg.padding.left + \",\" + hlg.padding.right : \"null\") + \" children=\" + tbm.transform.childCount);\n    for (int i = 0; i < tbm.transform.childCount; i++) {\n        var ch = tbm.transform.GetChild(i) as UnityEngine.RectTransform;\n        sb.AppendLine(\"  [\" + i + \"] \" + ch.name + \" act=\" + ch.gameObject.activeSelf + \" aPos=\" + ch.anchoredPosition + \" size=\" + ch.sizeDelta);\n    }\n} else {\n    var allGs = UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.GameObject>();\n    for (int i = 0; i < allGs.Length; i++) {\n        if (!UnityEditor.EditorUtility.IsPersistent(allGs[i]) && allGs[i].name.Contains(\"Tier Button\")) {\n            sb.AppendLine(\"  Found inactive: \" + allGs[i].name + \" actInHier=\" + allGs[i].activeInHierarchy);\n        }\n    }\n}\n\nforeach (string tierName in new string[] { \"AB.Tier 5\", \"AB.Tier 6\" }) {\n    var allGs = UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.GameObject>();\n    for (int i = 0; i < allGs.Length; i++) {\n        if (!UnityEditor.EditorUtility.IsPersistent(allGs[i]) && allGs[i].name == tierName) {\n            var go = allGs[i];\n            var comps = go.GetComponents<UnityEngine.Component>();\n            sb.AppendLine(\"  \" + tierName + \" act=\" + go.activeSelf + \" children=\" + go.transform.childCount + \" comps=\" + comps.Length);\n            var counts = new System.Collections.Generic.Dictionary<string, int>();\n            for (int c = 0; c < comps.Length; c++) {\n                string cn = comps[c] != null ? comps[c].GetType().Name : \"MISSING\";\n                if (!counts.ContainsKey(cn)) counts[cn] = 0;\n                counts[cn]++;\n            }\n            foreach (var kv in counts) sb.AppendLine(\"    \" + kv.Key + \" x\" + kv.Value);\n        }\n    }\n}\n\nvar pfcType = System.Type.GetType(\"PlayerFactionController, Assembly-CSharp\");\nif (pfcType != null) {\n    var pfcs = UnityEngine.Resources.FindObjectsOfTypeAll(pfcType);\n    sb.AppendLine(\"PlayerFactionController count=\" + pfcs.Length);\n    for (int i = 0; i < pfcs.Length; i++) {\n        var c = pfcs[i] as UnityEngine.Component;\n        if (c == null || UnityEditor.EditorUtility.IsPersistent(c.gameObject)) continue;\n        sb.AppendLine(\"  PFC on \" + c.gameObject.name + \" act=\" + c.gameObject.activeInHierarchy);\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
