{"ts":"2026-11-15T19:52:47.473Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1251,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. Update all TerrainGenerationSettings assets (e.g. Assets/Settings/Terrain World Settings.asset)\nstring[] settingsGuids = AssetDatabase.FindAssets(\"t:TerrainGenerationSettings\");\nfor (int i = 0; i < settingsGuids.Length; i++)\n{\n    string p = AssetDatabase.GUIDToAssetPath(settingsGuids[i]);\n    var tgs = AssetDatabase.LoadAssetAtPath<TerrainGenerationSettings>(p);\n    if (tgs == null) continue;\n    if (tgs.coastalProfile != null && tgs.coastalProfile.continentalSlopeWidth < 21.9f)\n    {\n        tgs.coastalProfile.continentalSlopeWidth = 22f;\n        tgs.coastalProfile.continentalSlopeExponent = 1.65f;\n    }\n    tgs.Validate();\n    EditorUtility.SetDirty(tgs);\n    sb.AppendLine(\"Asset \" + p + \": tabletopDepth=\" + tgs.standalonePlateau.tabletopDepthBelowWater\n        + \" cliffDrop=\" + tgs.standalonePlateau.cliffDropDepth\n        + \" lowerDrop=\" + tgs.standalonePlateau.lowerApronDrop\n        + \" abyssH=\" + tgs.abyssHeight\n        + \" plateauH=\" + tgs.underwaterPlateauHeight);\n}\n\n// 2. Update MapManager PatternData entries in active scene\nvar mm = Object.FindObjectOfType<MapManager>();\nif (mm == null) return \"MapManager not found\";\nvar mmSo = new SerializedObject(mm);\nvar patProp = mmSo.FindProperty(\"patternDataList\");\nif (patProp != null && patProp.isArray)\n{\n    for (int i = 0; i < patProp.arraySize; i++)\n    {\n        var el = patProp.GetArrayElementAtIndex(i);\n        var ps = el.FindPropertyRelative(\"plateauSettings\");\n        if (ps != null)\n        {\n            var td = ps.FindPropertyRelative(\"tabletopDepthBelowWater\");\n            var cd = ps.FindPropertyRelative(\"cliffDropDepth\");\n            var ld = ps.FindPropertyRelative(\"lowerApronDrop\");\n            var uw = ps.FindPropertyRelative(\"upperEscarpmentWidth\");\n            var lw = ps.FindPropertyRelative(\"lowerApronWidth\");\n            var dv = ps.FindPropertyRelative(\"dataVersion\");\n            if (td != null && td.floatValue < 20f) td.floatValue = 27f;\n            if (cd != null && cd.floatValue <= 8.5f) cd.floatValue = 13f;\n            if (ld != null && ld.floatValue <= 2.5f) ld.floatValue = 4f;\n            if (uw != null && uw.floatValue <= 1.85f) uw.floatValue = 2.8f;\n            if (lw != null && lw.floatValue <= 5.6f) lw.floatValue = 7f;\n            if (dv != null && dv.intValue < 9) dv.intValue = 9;\n            sb.AppendLine(\"Pattern[\" + i + \"]: td=\" + (td != null ? td.floatValue : -1f)\n                + \" cd=\" + (cd != null ? cd.floatValue : -1f)\n                + \" ld=\" + (ld != null ? ld.floatValue : -1f));\n        }\n    }\n    mmSo.ApplyModifiedPropertiesWithoutUndo();\n    EditorUtility.SetDirty(mm);\n}\n\n// 3. Update CameraRig in active scene\nvar rig = Object.FindObjectOfType<CameraRig>();\nif (rig != null)\n{\n    rig.abyssFloor = -22f;\n    rig.underwaterRestDepthBelowSurface = 3.5f;\n    rig.underwaterFieldOfView = 67f;\n    rig.underwaterPitchOffset = 4f;\n    rig.underwaterFramingLerpSpeed = 4.5f;\n    EditorUtility.SetDirty(rig);\n    sb.AppendLine(\"CameraRig updated: abyssFloor=\" + rig.abyssFloor\n        + \" restDepth=\" + rig.underwaterRestDepthBelowSurface\n        + \" uwFov=\" + rig.underwaterFieldOfView\n        + \" uwPitchOff=\" + rig.underwaterPitchOffset);\n}\n\n// 4. Update UnderwaterTransitionController serialized fields in active scene\nvar utc = Object.FindObjectOfType<Moonlight.Rendering.UnderwaterTransitionController>();\nif (utc != null)\n{\n    var utcSo = new SerializedObject(utc);\n    utcSo.FindProperty(\"absorptionCoefficients\").vector4Value = new Vector4(0.11f, 0.032f, 0.012f, 0f);\n    utcSo.FindProperty(\"fogDensity\").floatValue = 0.0115f;\n    utcSo.FindProperty(\"deepDepthThreshold\").floatValue = 24f;\n    utcSo.FindProperty(\"abyssDepthThreshold\").floatValue = 44f;\n    utcSo.FindProperty(\"sunDepthExtinction\").floatValue = 0.024f;\n    utcSo.FindProperty(\"lowerApronFadeStart\").floatValue = 36f;\n    utcSo.FindProperty(\"lowerApronFadeEnd\").floatValue = 52f;\n    utcSo.FindProperty(\"causticsFadeDepth\").floatValue = 38f;\n    utcSo.ApplyModifiedPropertiesWithoutUndo();\n    EditorUtility.SetDirty(utc);\n    sb.AppendLine(\"UnderwaterTransitionController updated for -28m..-45m bathymetry.\");\n}\n\nAssetDatabase.SaveAssets();\nmm.RegenerateMap();\nsb.AppendLine(\"Map regenerated. Selected pattern = \" + mm.SelectedPatternName);\n\n// Report actual generated terrain stats & vent count\nvar grids = Object.FindObjectsOfType<MapGrid>();\nint islands = 0, plateaus = 0, vents = 0;\nfloat minY = float.MaxValue, maxY = float.MinValue;\nfloat plateauTopY = float.MinValue;\nfor (int i = 0; i < grids.Length; i++)\n{\n    var g = grids[i];\n    if (g.TerrainKind == GridType.Type.Island) islands++;\n    else if (g.TerrainKind == GridType.Type.Plateau)\n    {\n        plateaus++;\n        var mf = g.GetComponent<MeshFilter>();\n        if (mf != null && mf.sharedMesh != null)\n        {\n            var b = mf.sharedMesh.bounds;\n            if (b.max.y > plateauTopY) plateauTopY = b.max.y;\n        }\n    }\n    var mr = g.GetComponent<MeshRenderer>();\n    if (mr != null)\n    {\n        if (mr.bounds.min.y < minY) minY = mr.bounds.min.y;\n        if (mr.bounds.max.y > maxY) maxY = mr.bounds.max.y;\n    }\n    var trs = g.GetComponentsInChildren<Transform>(true);\n    for (int j = 0; j < trs.Length; j++)\n        if (trs[j].name.StartsWith(\"Hydrothermal Vent\")) vents++;\n}\nsb.AppendLine(\"Grids: total=\" + grids.Length + \" islands=\" + islands + \" plateaus=\" + plateaus\n    + \" vents=\" + vents + \" meshY=[\" + minY.ToString(\"F2\") + \"..\" + maxY.ToString(\"F2\")\n    + \"] plateauMeshMaxY=\" + plateauTopY.ToString(\"F2\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"},"error":"Compilation failed"}
