{"ts":"2026-11-15T17:59:43.197Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":17233,"action":"execute","params":{"action":"execute","code":"var mm = UnityEngine.Object.FindFirstObjectByType<MapManager>();\nif (mm == null) return \"No MapManager\";\nvar sb = new System.Text.StringBuilder();\nvar wtf = mm.GetTerrainField();\nsb.AppendLine(\"WTF null=\" + (wtf == null));\nif (wtf != null)\n{\n    var srcsField = wtf.GetType().GetField(\"_sources\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public);\n    if (srcsField != null)\n    {\n        var srcs = srcsField.GetValue(wtf) as System.Collections.IList;\n        sb.AppendLine(\"Sources count=\" + (srcs != null ? srcs.Count : -1));\n        if (srcs != null)\n        {\n            var bcProp = typeof(IslandTerrainProvider).GetProperty(\"BuiltCache\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public);\n            foreach (var item in srcs)\n            {\n                var t = item.GetType();\n                var providerF = t.GetField(\"Provider\");\n                var originF = t.GetField(\"Origin\");\n                var sizeF = t.GetField(\"Size\");\n                var kindF = t.GetField(\"Kind\");\n                var origin = originF != null ? (Vector2)originF.GetValue(item) : Vector2.zero;\n                var sz = sizeF != null ? (float)sizeF.GetValue(item) : 0f;\n                var kind = kindF != null ? kindF.GetValue(item) : null;\n                var prov = providerF != null ? providerF.GetValue(item) as IslandTerrainProvider : null;\n                sb.AppendLine(\"  Src kind=\" + kind + \" origin=\" + origin + \" size=\" + sz + \" end=\" + (origin + Vector2.one * sz));\n                if (prov != null && bcProp != null)\n                {\n                    var cache = bcProp.GetValue(prov, null);\n                    if (cache != null)\n                    {\n                        var ct = cache.GetType();\n                        var resF = ct.GetField(\"Resolution\");\n                        var heightsF = ct.GetField(\"Heights\");\n                        var riverF = ct.GetField(\"Rivers\");\n                        if (riverF == null) riverF = ct.GetField(\"RiverPlan\");\n                        int res = resF != null ? (int)resF.GetValue(cache) : 0;\n                        float[,] heights = heightsF != null ? heightsF.GetValue(cache) as float[,] : null;\n                        object rplan = null;\n                        foreach (var f in ct.GetFields(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic))\n                        {\n                            if (f.Name.ToLower().Contains(\"river\")) rplan = f.GetValue(cache);\n                        }\n                        sb.AppendLine(\"    cache res=\" + res + \" heights=\" + (heights != null) + \" river=\" + (rplan != null));\n                        if (heights != null)\n                        {\n                            int steepFlat = 0;\n                            float maxFlatGrad = 0f;\n                            int maxX = -1, maxZ = -1;\n                            for (int x = 1; x < res - 1; x++)\n                            for (int z = 1; z < res - 1; z++)\n                            {\n                                float h = heights[x, z];\n                                if (h >= 0.4f && h <= 1.2f)\n                                {\n                                    float gx = Mathf.Abs(heights[x + 1, z] - heights[x - 1, z]);\n                                    float gz = Mathf.Abs(heights[x, z + 1] - heights[x, z - 1]);\n                                    float g = Mathf.Max(gx, gz);\n                                    if (g > 0.25f) { steepFlat++; if (g > maxFlatGrad) { maxFlatGrad = g; maxX = x; maxZ = z; } }\n                                }\n                            }\n                            sb.AppendLine(\"    flatAnomalies(>0.25 across 2px)=\" + steepFlat + \" maxGrad=\" + maxFlatGrad.ToString(\"F3\") + \" at (\" + maxX + \",\" + maxZ + \")\");\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\nvar ig = GameObject.Find(\"Island 31\");\nif (ig != null)\n{\n    var mr = ig.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var bm = mpb.GetTexture(\"_BaseMap\");\n    var ctrl = mpb.GetTexture(\"_Control\");\n    var reg = mpb.GetTexture(\"_RegionMask\");\n    var st = mpb.GetTexture(\"_SurfaceTint\");\n    sb.AppendLine(\"Island 31 MPB: _BaseMap=\" + (bm != null ? bm.name : \"null\") + \" _Control=\" + (ctrl != null ? ctrl.name : \"null\") + \" _RegionMask=\" + (reg != null ? reg.name : \"null\") + \" _SurfaceTint=\" + (st != null ? st.name : \"null\"));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
