{"ts":"2026-11-15T18:58:35.742Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1410,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\n// 1. Check AB.Tier 5 exact component types\nTransform[] allTfs = Resources.FindObjectsOfTypeAll<Transform>();\nforeach (Transform t in allTfs)\n{\n    if (!t.gameObject.scene.IsValid()) continue;\n    if (t.name == \"AB.Tier 5\" && t.parent != null && t.parent.name == \"Faction A: Tyc\")\n    {\n        Component[] cs = t.GetComponents<Component>();\n        sb.AppendLine(\"Faction A: Tyc/AB.Tier 5 components (\" + cs.Length + \"):\");\n        for (int i = 0; i < cs.Length; i++) sb.AppendLine(\"  [\" + i + \"] \" + (cs[i] == null ? \"MISSING\" : cs[i].GetType().FullName));\n    }\n    if (t.name == \"Tier Button Manager\")\n    {\n        UnityEngine.UI.HorizontalLayoutGroup hlg = t.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n        sb.AppendLine(\"HLG under \" + (t.parent != null ? t.parent.name : \"ROOT\") +\n            \": en=\" + hlg.enabled + \" ctrlW=\" + hlg.childControlWidth + \" ctrlH=\" + hlg.childControlHeight +\n            \" expandW=\" + hlg.childForceExpandWidth + \" expandH=\" + hlg.childForceExpandHeight +\n            \" spacing=\" + hlg.spacing + \" align=\" + hlg.childAlignment);\n\n        if (t.parent != null && t.parent.name == \"Faction A: Tyc\")\n        {\n            for (int i = 0; i < t.childCount; i++)\n            {\n                Transform c = t.GetChild(i);\n                Transform iconT = c.Find(\"Icon\");\n                UnityEngine.UI.Image iconImg = iconT != null ? iconT.GetComponent<UnityEngine.UI.Image>() : null;\n                UnityEngine.UI.Button btn = c.GetComponent<UnityEngine.UI.Button>();\n                string evStr = \"\";\n                if (btn != null)\n                {\n                    SerializedObject so = new SerializedObject(btn);\n                    SerializedProperty calls = so.FindProperty(\"m_OnClick.m_PersistentCalls.m_Calls\");\n                    for (int e = 0; e < calls.arraySize; e++)\n                    {\n                        SerializedProperty call = calls.GetArrayElementAtIndex(e);\n                        UnityEngine.Object tgt = call.FindPropertyRelative(\"m_Target\").objectReferenceValue;\n                        bool argBool = call.FindPropertyRelative(\"m_Arguments.m_BoolArgument\").boolValue;\n                        string mName = call.FindPropertyRelative(\"m_MethodName\").stringValue;\n                        evStr += (tgt != null ? tgt.name : \"null\") + \".\" + mName + \"(\" + argBool + \"); \";\n                    }\n                }\n                sb.AppendLine(\"  Tyc[\" + i + \"] \" + c.name + \" icon=\" + (iconImg != null && iconImg.sprite != null ? iconImg.sprite.name : \"none\") + \" -> \" + evStr);\n            }\n        }\n    }\n    if (t.name == \"Player Tab Controller\")\n    {\n        UnityEngine.UI.HorizontalLayoutGroup hlg = t.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n        sb.AppendLine(\"Player Tab Controller HLG: en=\" + hlg.enabled + \" ctrlW=\" + hlg.childControlWidth + \" ctrlH=\" + hlg.childControlHeight + \" expandW=\" + hlg.childForceExpandWidth);\n        for (int i = 0; i < t.childCount; i++)\n        {\n            Transform c = t.GetChild(i);\n            UnityEngine.UI.Button btn = c.GetComponent<UnityEngine.UI.Button>();\n            string evStr = \"\";\n            if (btn != null)\n            {\n                SerializedObject so = new SerializedObject(btn);\n                SerializedProperty calls = so.FindProperty(\"m_OnClick.m_PersistentCalls.m_Calls\");\n                for (int e = 0; e < calls.arraySize; e++)\n                {\n                    SerializedProperty call = calls.GetArrayElementAtIndex(e);\n                    UnityEngine.Object tgt = call.FindPropertyRelative(\"m_Target\").objectReferenceValue;\n                    bool argBool = call.FindPropertyRelative(\"m_Arguments.m_BoolArgument\").boolValue;\n                    string mName = call.FindPropertyRelative(\"m_MethodName\").stringValue;\n                    evStr += (tgt != null ? tgt.name : \"null\") + \".\" + mName + \"(\" + argBool + \"); \";\n                }\n            }\n            sb.AppendLine(\"  Tab[\" + i + \"] \" + c.name + \" act=\" + c.gameObject.activeSelf + \" -> \" + evStr);\n        }\n    }\n}\n\n// 2. Check Boat (Unit Inventory) (1) & Submarine (Unit Inventory) (1) & naval prefab Graphics bounds\nstring[] sceneUnits = new string[] { \"Boat (Unit Inventory) (1)\", \"Submarine (Unit Inventory) (1)\" };\nforeach (string un in sceneUnits)\n{\n    foreach (Transform t in allTfs)\n    {\n        if (!t.gameObject.scene.IsValid() || t.name != un) continue;\n        Renderer[] rs = t.GetComponentsInChildren<Renderer>(true);\n        Bounds? b = null;\n        foreach (Renderer r in rs)\n        {\n            if (r.name == \"Selected\") continue;\n            if (!b.HasValue) b = r.bounds; else { Bounds bb = b.Value; bb.Encapsulate(r.bounds); b = bb; }\n        }\n        sb.AppendLine(\"SceneUnit \" + un + \" hull world bounds=\" + (b.HasValue ? b.Value.size.ToString(\"F2\") : \"none\") + \" minY=\" + (b.HasValue ? b.Value.min.y.ToString(\"F2\") : \"none\"));\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
