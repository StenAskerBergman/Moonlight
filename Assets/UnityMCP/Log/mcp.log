{"ts":"2026-11-15T18:00:49.644Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1227,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar allGrids = UnityEngine.Object.FindObjectsByType<MapGrid>(UnityEngine.FindObjectsSortMode.None);\nSystem.Array.Sort(allGrids, (a, b) => string.Compare(a.name, b.name, System.StringComparison.Ordinal));\nforeach (var mg in allGrids)\n{\n    var m = mg.GetComponent<MeshFilter>() != null ? mg.GetComponent<MeshFilter>().sharedMesh : null;\n    if (m == null) continue;\n    var verts = m.vertices;\n    var norms = m.normals;\n    // Detect mesh dim N (sqrt of verts.Length)\n    int n = Mathf.RoundToInt(Mathf.Sqrt(verts.Length));\n    if (n * n != verts.Length) { sb.AppendLine(mg.name + \" verts=\" + verts.Length + \" not square\"); continue; }\n    int trenches = 0;\n    float worstDrop = 0f;\n    Vector3 worstPos = Vector3.zero;\n    int darkCreases = 0;\n    for (int z = 2; z < n - 2; z++)\n    for (int x = 2; x < n - 2; x++)\n    {\n        int idx = z * n + x;\n        float y = verts[idx].y;\n        if (y > 0.60f && y < 1.30f)\n        {\n            float avgN = 0.25f * (verts[idx - 1].y + verts[idx + 1].y + verts[idx - n].y + verts[idx + n].y);\n            float drop = avgN - y;\n            if (drop > 0.015f)\n            {\n                trenches++;\n                if (drop > worstDrop) { worstDrop = drop; worstPos = verts[idx]; }\n            }\n            if (norms[idx].y < 0.80f && avgN < 1.25f) darkCreases++;\n        }\n    }\n    var mr = mg.GetComponent<MeshRenderer>();\n    string matName = (mr != null && mr.sharedMaterial != null) ? mr.sharedMaterial.name : \"null\";\n    int inlW = mg.transform.Find(\"Generated Inland Water\") != null ? 1 : 0;\n    int platG = mg.transform.Find(\"Generated Plateau Geometry\") != null ? 1 : 0;\n    sb.AppendLine(mg.name + \" pos=\" + mg.transform.position + \" mat=\" + matName + \" n=\" + n + \" inlW=\" + inlW + \" platG=\" + platG + \" trenches=\" + trenches + \" worstDrop=\" + worstDrop.ToString(\"F3\") + \"@\" + worstPos + \" darkFlatCreases=\" + darkCreases);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
