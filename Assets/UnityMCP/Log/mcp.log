{"ts":"2026-11-15T19:57:17.135Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1120,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar vent = GameObject.Find(\"Hydrothermal Vent (53, 35)\");\nif (vent != null)\n{\n    var pss = vent.GetComponentsInChildren<ParticleSystem>(true);\n    for (int i = 0; i < pss.Length; i++)\n    {\n        var ps = pss[i];\n        ps.Play(false);\n        ps.Simulate(2.2f, false, true);\n        var parts = new ParticleSystem.Particle[64];\n        int n = ps.GetParticles(parts);\n        int maxA = 0;\n        float minY = float.MaxValue, maxY = float.MinValue;\n        for (int k = 0; k < n; k++)\n        {\n            var c = parts[k].GetCurrentColor(ps);\n            if (c.a > maxA) maxA = c.a;\n            if (parts[k].position.y < minY) minY = parts[k].position.y;\n            if (parts[k].position.y > maxY) maxY = parts[k].position.y;\n        }\n        sb.AppendLine(ps.name + \": n=\" + n + \" maxA=\" + maxA + \"/255 y=[\" + minY.ToString(\"F2\") + \"..\" + maxY.ToString(\"F2\") + \"]\");\n        ps.Stop(false, ParticleSystemStopBehavior.StopEmittingAndClear);\n    }\n}\n\n// Check why top-middle island (chunk 0,1? or 1,0?) overflows ~5m into Plateau neighbor\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>();\nfor (int i = 0; i < grids.Length; i++)\n{\n    var mr = grids[i].GetComponent<MeshRenderer>();\n    if (mr != null && mr.bounds.min.y > -45f)\n    {\n        sb.AppendLine(grids[i].name + \" shader=\" + mr.sharedMaterial.shader.name\n            + \" center=(\" + mr.bounds.center.x.ToString(\"F0\") + \",\" + mr.bounds.center.z.ToString(\"F0\")\n            + \") y=[\" + mr.bounds.min.y.ToString(\"F1\") + \"..\" + mr.bounds.max.y.ToString(\"F1\") + \"]\");\n    }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
