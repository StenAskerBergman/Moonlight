{"ts":"2026-11-15T19:33:11.942Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1466,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\n// 1. Inspect ALL MapGrid chunks in scene: name, terrainType, bounds/pos, mesh Y range, material, shader, textures!\nMapGrid[] grids = Resources.FindObjectsOfTypeAll<MapGrid>();\nsb.AppendLine(\"=== MapGrid chunks in scene: \" + grids.Length + \" ===\");\nforeach (MapGrid g in grids)\n{\n    if (!g.gameObject.scene.IsValid()) continue;\n    MeshRenderer mr = g.GetComponent<MeshRenderer>();\n    MeshFilter mf = g.GetComponent<MeshFilter>();\n    string matName = (mr != null && mr.sharedMaterial != null) ? mr.sharedMaterial.name : \"NONE\";\n    string shName = (mr != null && mr.sharedMaterial != null && mr.sharedMaterial.shader != null) ? mr.sharedMaterial.shader.name : \"NONE\";\n    float minY = 999f, maxY = -999f;\n    if (mf != null && mf.sharedMesh != null)\n    {\n        Vector3[] vs = mf.sharedMesh.vertices;\n        for (int i = 0; i < vs.Length; i++)\n        {\n            if (vs[i].y < minY) minY = vs[i].y;\n            if (vs[i].y > maxY) maxY = vs[i].y;\n        }\n    }\n    string ctrlTex = \"none\";\n    if (mr != null && mr.sharedMaterial != null && mr.sharedMaterial.HasProperty(\"_Control\"))\n    {\n        Texture ct = mr.sharedMaterial.GetTexture(\"_Control\");\n        ctrlTex = ct != null ? (ct.name + \"(\" + ct.width + \")\") : \"NULL\";\n    }\n    if (maxY > -15f || matName != \"NONE\")\n    {\n        // Only print chunks that rise above seafloor or all chunks compactly\n        sb.AppendLine(\"  \" + g.name + \" pos=(\" + g.transform.position.x.ToString(\"F0\") + \",\" + g.transform.position.z.ToString(\"F0\") + \")\" +\n            \" y=[\" + minY.ToString(\"F1\") + \"..\" + maxY.ToString(\"F1\") + \"]\" +\n            \" mat=\" + matName + \" shader=\" + shName + \" _Control=\" + ctrlTex);\n    }\n}\n\n// 2. Inspect ParticleSystems in scene or prefabs\nParticleSystem[] pss = Resources.FindObjectsOfTypeAll<ParticleSystem>();\nsb.AppendLine(\"=== ParticleSystems in scene ===\");\nint psCount = 0;\nforeach (ParticleSystem ps in pss)\n{\n    if (!ps.gameObject.scene.IsValid()) continue;\n    psCount++;\n    if (psCount <= 25)\n    {\n        ParticleSystemRenderer pr = ps.GetComponent<ParticleSystemRenderer>();\n        string mName = (pr != null && pr.sharedMaterial != null) ? pr.sharedMaterial.name : \"NULL\";\n        string shName = (pr != null && pr.sharedMaterial != null && pr.sharedMaterial.shader != null) ? pr.sharedMaterial.shader.name : \"NULL\";\n        Texture mTex = (pr != null && pr.sharedMaterial != null && pr.sharedMaterial.HasProperty(\"_BaseMap\")) ? pr.sharedMaterial.GetTexture(\"_BaseMap\") : null;\n        if (mTex == null && pr != null && pr.sharedMaterial != null && pr.sharedMaterial.HasProperty(\"_MainTex\")) mTex = pr.sharedMaterial.GetTexture(\"_MainTex\");\n        sb.AppendLine(\"  [\" + ps.name + \"] parent=\" + (ps.transform.parent != null ? ps.transform.parent.name : \"ROOT\") +\n            \" mat=\" + mName + \" sh=\" + shName + \" tex=\" + (mTex != null ? mTex.name : \"NULL\"));\n    }\n}\nsb.AppendLine(\"Total scene ParticleSystems: \" + psCount);\n\n// 3. Inspect CameraRig & UnderwaterTransitionController\nCameraRig cr = UnityEngine.Object.FindObjectOfType<CameraRig>(true);\nif (cr != null)\n{\n    Camera cam = cr.GetComponentInChildren<Camera>(true);\n    sb.AppendLine(\"=== CameraRig & Main Camera ===\");\n    sb.AppendLine(\"  pos=\" + cr.transform.position + \" minZoom=\" + cr.minZoomDistance + \" maxZoom=\" + cr.maxZoomDistance +\n        \" skyLimit=\" + cr.skyLimit + \" abyssFloor=\" + cr.abyssFloor + \" seaLevel=\" + cr.seaLevel +\n        \" restDist=\" + cr.surfaceRestDistance);\n    if (cam != null)\n    {\n        sb.AppendLine(\"  MainCam localPos=\" + cam.transform.localPosition + \" localRot=\" + cam.transform.localEulerAngles + \" fov=\" + cam.fieldOfView + \" farClip=\" + cam.farClipPlane);\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
