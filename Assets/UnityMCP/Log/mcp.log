{"ts":"2026-11-15T18:12:59.620Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2008,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// Find PlayerSpawnManager anywhere (including inactive)\nvar psms = Resources.FindObjectsOfTypeAll<PlayerSpawnManager>();\nsb.AppendLine(\"PlayerSpawnManager count=\" + psms.Length);\nforeach (var p in psms)\n{\n    if (!p.gameObject.scene.IsValid()) continue;\n    sb.AppendLine(\"  PSM go=\" + p.name + \" act=\" + p.gameObject.activeInHierarchy + \" pos=\" + p.transform.position);\n    foreach (var f in typeof(PlayerSpawnManager).GetFields(flags))\n        sb.AppendLine(\"    \" + f.Name + \" = \" + f.GetValue(p));\n}\n\n// Probe Island 31 textures via clone\nvar i31 = GameObject.Find(\"Island 31\");\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nvar clone = UnityEngine.Object.Instantiate(i31);\nclone.name = \"__TempProbe\";\nclone.transform.SetParent(i31.transform.parent, true);\n\ntry\n{\n    var cmg = clone.GetComponent<MapGrid>();\n    var srcMg = i31.GetComponent<MapGrid>();\n    object wtf = null;\n    foreach (var f in typeof(MapManager).GetFields(flags))\n        if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n    var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n    if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n    typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags).Invoke(cmg, null);\n\n    var cmr = clone.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    cmr.GetPropertyBlock(mpb);\n    Texture2D ctrlSrc = mpb.GetTexture(\"_Control\") as Texture2D;\n    Texture2D tintSrc = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n\n    int w = tintSrc.width;\n    var rt = RenderTexture.GetTemporary(w, w, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);\n    var prev = RenderTexture.active;\n    RenderTexture.active = rt;\n    Graphics.Blit(tintSrc, rt);\n    var tintTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n    tintTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n    tintTex.Apply();\n    Color[] tCols = tintTex.GetPixels();\n    Graphics.Blit(ctrlSrc, rt);\n    var ctrlTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n    ctrlTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n    ctrlTex.Apply();\n    Color[] cCols = ctrlTex.GetPixels();\n    RenderTexture.active = prev;\n    RenderTexture.ReleaseTemporary(rt);\n    UnityEngine.Object.DestroyImmediate(tintTex);\n    UnityEngine.Object.DestroyImmediate(ctrlTex);\n\n    // 1. Scan WHOLE Island 31 (541x541) for thin dark 1-3px streaks in grass (where center luma < 0.70*nbMax or cc.r < 0.5 surrounded by cc.r > 0.8 at +-3px)\n    int thinStreaks = 0;\n    var pts = new System.Collections.Generic.List<string>();\n    for (int pz = 4; pz < w - 4; pz++)\n    {\n        for (int px = 4; px < w - 4; px++)\n        {\n            int idx = pz * w + px;\n            Color tc = tCols[idx];\n            Color cc = cCols[idx];\n            float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n            Color tcL = tCols[pz * w + (px - 3)], tcR = tCols[pz * w + (px + 3)];\n            Color tcD = tCols[(pz - 3) * w + px], tcU = tCols[(pz + 3) * w + px];\n            float lL = tcL.r * 0.3f + tcL.g * 0.59f + tcL.b * 0.11f;\n            float lR = tcR.r * 0.3f + tcR.g * 0.59f + tcR.b * 0.11f;\n            float lD = tcD.r * 0.3f + tcD.g * 0.59f + tcD.b * 0.11f;\n            float lU = tcU.r * 0.3f + tcU.g * 0.59f + tcU.b * 0.11f;\n            Color ccL = cCols[pz * w + (px - 3)], ccR = cCols[pz * w + (px + 3)];\n            Color ccD = cCols[(pz - 3) * w + px], ccU = cCols[(pz + 3) * w + px];\n\n            bool grassBridgeX = ccL.r > 0.7f && ccR.r > 0.7f && (cc.r < 0.4f || luma < Mathf.Min(lL, lR) * 0.78f);\n            bool grassBridgeZ = ccD.r > 0.7f && ccU.r > 0.7f && (cc.r < 0.4f || luma < Mathf.Min(lD, lU) * 0.78f);\n            if (grassBridgeX || grassBridgeZ)\n            {\n                thinStreaks++;\n                if (pts.Count < 25)\n                    pts.Add(string.Format(\"({0:F2},{1:F2}) px({2},{3}) luma={4:F2} tc={5} cc={6}\",\n                        px / 6f, -90f + pz / 6f, px, pz, luma, tc, cc));\n            }\n        }\n    }\n    sb.AppendLine(\"Island 31 thin dark/non-grass streaks in grass = \" + thinStreaks);\n    for (int i = 0; i < pts.Count; i++) sb.AppendLine(\"  \" + pts[i]);\n\n    // 2. Also check min luminance on GRASS ONLY (cc.r > 0.75) across whole Island 31\n    float minGrassLuma = 9f;\n    int minPx = 0, minPz = 0;\n    Color minTc = Color.white;\n    for (int pz = 0; pz < w; pz++)\n        for (int px = 0; px < w; px++)\n        {\n            int idx = pz * w + px;\n            if (cCols[idx].r > 0.75f)\n            {\n                Color tc = tCols[idx];\n                float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n                if (luma < minGrassLuma) { minGrassLuma = luma; minPx = px; minPz = pz; minTc = tc; }\n            }\n        }\n    sb.AppendLine(string.Format(\"Island 31 minGrassLuma={0:F3} at px({1},{2}) world=({3:F2},{4:F2}) tc={5}\",\n        minGrassLuma, minPx, minPz, minPx / 6f, -90f + minPz / 6f, minTc));\n\n    // 3. Print min/max SurfaceTint & Control in box x=28..50, z=-61..-49\n    int x0 = Mathf.RoundToInt(28f * 6f), x1 = Mathf.RoundToInt(50f * 6f);\n    int z0 = Mathf.RoundToInt(29f * 6f), z1 = Mathf.RoundToInt(41f * 6f);\n    float bMinL = 9f; Color bMinTc = Color.white; int bPx = 0, bPz = 0;\n    for (int pz = z0; pz <= z1; pz++)\n        for (int px = x0; px <= x1; px++)\n        {\n            Color tc = tCols[pz * w + px];\n            Color cc = cCols[pz * w + px];\n            if (cc.r > 0.5f)\n            {\n                float l = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n                if (l < bMinL) { bMinL = l; bMinTc = tc; bPx = px; bPz = pz; }\n            }\n        }\n    sb.AppendLine(string.Format(\"Bay box grass-or-blend minL={0:F3} at ({1:F2},{2:F2}) tc={3} cc={4}\",\n        bMinL, bPx / 6f, -90f + bPz / 6f, bMinTc, cCols[bPz * w + bPx]));\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
