{"ts":"2026-11-15T19:54:56.553Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1087,"action":"execute","params":{"action":"execute","code":"var vent = GameObject.Find(\"Hydrothermal Vent (53, 35)\");\nvar sb = new System.Text.StringBuilder();\nif (vent != null)\n{\n    var pss = vent.GetComponentsInChildren<ParticleSystem>(true);\n    sb.AppendLine(\"Found vent, psCount=\" + pss.Length);\n    for (int i = 0; i < pss.Length; i++)\n    {\n        var ps = pss[i];\n        ps.Simulate(2.0f, false, true);\n        var r = ps.GetComponent<ParticleSystemRenderer>();\n        var m = r.sharedMaterial;\n        sb.AppendLine(\"[\" + i + \"] \" + ps.name\n            + \" count=\" + ps.particleCount\n            + \" simSpace=\" + ps.main.simulationSpace\n            + \" enabled=\" + r.enabled\n            + \" mat=\" + (m != null ? m.name + \" shader=\" + m.shader.name + \" rq=\" + m.renderQueue : \"NULL\")\n            + \" tex=\" + (m != null && m.mainTexture != null ? m.mainTexture.name + \"(\" + m.mainTexture.width + \")\" : \"NULL\")\n            + \" baseCol=\" + (m != null && m.HasProperty(\"_BaseColor\") ? m.GetColor(\"_BaseColor\").ToString() : \"n/a\")\n            + \" surface=\" + (m != null && m.HasProperty(\"_Surface\") ? m.GetFloat(\"_Surface\").ToString() : \"n/a\"));\n        ps.Stop(false, ParticleSystemStopBehavior.StopEmittingAndClear);\n    }\n}\nvar ts = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Terrain Splat.mat\");\nvar ups = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Underwater Plateau Surface.mat\");\nif (ts != null && ups != null)\n{\n    sb.AppendLine(\"TerrainSplat: _SeabedTint=\" + ts.GetColor(\"_SeabedTint\") + \" _SeabedSmoothness=\" + ts.GetFloat(\"_SeabedSmoothness\")\n        + \" _MacroStrength=\" + ts.GetFloat(\"_MacroStrength\") + \" _MacroTiling=\" + ts.GetFloat(\"_MacroTiling\"));\n    sb.AppendLine(\"PlateauSurfaceMat: _SeabedTint=\" + ups.GetColor(\"_SeabedTint\") + \" _GeneratedColorBlend=\" + ups.GetFloat(\"_GeneratedColorBlend\")\n        + \" _SandColor? n/a _RockDark=\" + ups.GetColor(\"_RockDarkColor\"));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
