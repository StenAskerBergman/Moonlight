{"ts":"2026-11-15T18:27:14.080Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2231,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    // Check if ANYTHING in the whole scene is already on layer 31!\n    foreach (var go in UnityEngine.Object.FindObjectsOfType<GameObject>(true))\n        if (go.layer == 31) sb.AppendLine(\"EXISTING ON LAYER 31: \" + go.name);\n\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeDbgImg\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    foreach (Transform ch in clone.GetComponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mat = mr.sharedMaterial;\n\n    camGo = new GameObject(\"__ProbeDbgImgCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    // 1) Render _DebugView=1 + save PNG!\n    var testMat = new Material(mat);\n    testMat.SetFloat(\"_DebugView\", 1f);\n    testMat.SetTexture(\"_BaseMap\", Texture2D.whiteTexture);\n    mr.sharedMaterial = testMat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\dbg_debugview1.png\", tex.EncodeToPNG());\n\n    // Print pixels along row y=6..10, x=180..195 in dbg_debugview1!\n    for (int y = 6; y <= 10; y += 2)\n    {\n        string row = \"y=\" + y + \": \";\n        for (int x = 180; x <= 194; x += 2)\n        {\n            var c = tex.GetPixel(x, y);\n            row += string.Format(\"{0}:({1:F2},{2:F2},{3:F2}) \", x, c.r, c.g, c.b);\n        }\n        sb.AppendLine(row);\n    }\n\n    // 2) Render URP/Unlit White + save PNG!\n    var unlitMat = new Material(Shader.Find(\"Universal Render Pipeline/Unlit\"));\n    unlitMat.color = Color.white;\n    mr.sharedMaterial = unlitMat;\n    // Clear MPB temporarily to make sure MPB isn't supplying a dark _BaseMap/Color!\n    var savedMpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(savedMpb);\n    mr.SetPropertyBlock(null);\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\dbg_unlit.png\", tex.EncodeToPNG());\n    int unlitNonWhite = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = tex.GetPixel(x, y);\n        if (c.r < 0.99f || c.g < 0.99f || c.b < 0.99f) unlitNonWhite++;\n    }\n    sb.AppendLine(\"URP/Unlit nonWhite in box: \" + unlitNonWhite);\n\n    // 3) Render TerrainSplatNormal WITH RendererFeatures ALL DISABLED + check dark curve!\n    mr.SetPropertyBlock(savedMpb);\n    mr.sharedMaterial = mat;\n    var rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\n    var rList = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\n    var oldStates = new bool[rList[0].rendererFeatures.Count];\n    for (int i = 0; i < rList[0].rendererFeatures.Count; i++)\n    {\n        var f = rList[0].rendererFeatures[i];\n        if (f != null) { oldStates[i] = f.isActive; f.SetActive(false); }\n    }\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\dbg_nofeatures.png\", tex.EncodeToPNG());\n    for (int i = 0; i < rList[0].rendererFeatures.Count; i++)\n    {\n        var f = rList[0].rendererFeatures[i];\n        if (f != null) f.SetActive(oldStates[i]);\n    }\n    int noFeatDark = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var px = (Color32)tex.GetPixel(x, y);\n        if (px.r + px.g + px.b < 140) noFeatDark++;\n    }\n    sb.AppendLine(\"NoRendererFeatures TerrainSplatNormal dark<140 in box: \" + noFeatDark);\n\n    mr.sharedMaterial = mat;\n    UnityEngine.Object.DestroyImmediate(testMat);\n    UnityEngine.Object.DestroyImmediate(unlitMat);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
