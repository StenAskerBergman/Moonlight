Tex.width, tintTex.height), 0, 0);\n    rTint.Apply();\n    RenderTexture.active = null;\n\n    sb.AppendLine(\"=== Pixels around (181, 13) ===\");\n    for (int z = 10; z <= 18; z++)\n    {\n        string line = \"z=\" + z + \": \";\n        for (int x = 178; x <= 184; x++)\n        {\n            Color c = rCtrl.GetPixel(x, z);\n            Color t = rTint.GetPixel(x, z);\n            line += string.Format(\"[x={0} C=({1:F2},{2:F2},{3:F2},{4:F2}) T=({5:F2},{6:F2},{7:F2},{8:F2})] \", x, c.r, c.g, c.b, c.a, t.r, t.g, t.b, t.a);\n        }\n        sb.AppendLine(line);\n    }\n\n    UnityEngine.Object.DestroyImmediate(crt);\n    UnityEngine.Object.DestroyImmediate(trt);\n    UnityEngine.Object.DestroyImmediate(rCtrl);\n    UnityEngine.Object.DestroyImmediate(rTint);\n\n    // 2) Render ortho top-down at 512x512 in 4 modes to see which mode eliminates SEABED DARK around bottom-left:\n    camGo = new GameObject(\"__ProbeSeabedCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = new Vector3(mr.bounds.center.x, 40f, mr.bounds.center.z);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    System.Func<string, int> countSeabedDark = (lbl) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        var pxs = tex.GetPixels32();\n        int cnt = 0;\n        for (int y = 4; y < 508; y++)\n        for (int x = 4; x < 508; x++)\n        {\n            var c = pxs[y * 512 + x];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nSum = 0f; int nCnt = 0;\n            for (int dy = -2; dy <= 2; dy += 2)\n            for (int dx = -2; dx <= 2; dx += 2)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var nc = pxs[(y + dy) * 512 + (x + dx)];\n                if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n                nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n                nCnt++;\n            }\n            if (nCnt >= 6 && (nSum / nCnt) > 0.12f && lum < (nSum / nCnt) * 0.45f) cnt++;\n        }\n        sb.AppendLine(\"Ortho \" + lbl + \" darkCount=\" + cnt);\n        return cnt;\n    };\n\n    countSeabedDark(\"1_baseline\");\n\n    // Disable Shadows\n    var lights = UnityEngine.Object.FindObjectsOfType<Light>();\n    var oldSh = new LightShadows[lights.Length];\n    for (int i = 0; i < lights.Length; i++) { oldSh[i] = lights[i].shadows; lights[i].shadows = LightShadows.None; }\n    countSeabedDark(\"2_noshadows\");\n    for (int i = 0; i < lights.Length; i++) lights[i].shadows = oldSh[i];\n\n    // Disable SSAO\n    var rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\n    var rList = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\n    UnityEngine.Rendering.Universal.ScriptableRendererFeature ssao = null;\n    if (rList != null && rList.Length > 0)\n        foreach (var f in rList[0].rendererFeatures)\n            if (f != null && f.GetType().Name.Contains(\"AmbientOcclusion\")) { ssao = f; break; }\n    if (ssao != null)\n    {\n        bool prev = ssao.isActive;\n        ssao.SetActive(false);\n        countSeabedDark(\"3_nossao\");\n        ssao.SetActive(prev);\n    }\n\n    // Check TerrainSplat properties via cloned material!\n    var origMat = mr.sharedMaterial