{"ts":"2026-11-15T18:28:03.717Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2931,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeMPB2\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var origCtrl = mpb.GetTexture(\"_Control\") as Texture2D;\n    var origTint = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n\n    // 1) Read GPU values of _Control and _SurfaceTint across local x=26..36, z=1..4 -> texels x=156..216, z=6..24!\n    var crt = new RenderTexture(541, 541, 0, RenderTextureFormat.ARGB32);\n    Graphics.Blit(origCtrl, crt);\n    RenderTexture.active = crt;\n    var rCtrl = new Texture2D(541, 541, TextureFormat.RGBA32, false);\n    rCtrl.ReadPixels(new Rect(0, 0, 541, 541), 0, 0);\n    rCtrl.Apply();\n\n    var trt = new RenderTexture(541, 541, 0, RenderTextureFormat.ARGB32);\n    Graphics.Blit(origTint, trt);\n    RenderTexture.active = trt;\n    var rTint = new Texture2D(541, 541, TextureFormat.RGBA32, false);\n    rTint.ReadPixels(new Rect(0, 0, 541, 541), 0, 0);\n    rTint.Apply();\n    RenderTexture.active = null;\n\n    // Find ANY anomalous pixels in x=156..216, z=4..24 in rCtrl OR rTint!\n    for (int z = 5; z <= 12; z++)\n    {\n        string l = \"z=\" + z + \": \";\n        for (int x = 196; x <= 206; x++)\n        {\n            Color c = rCtrl.GetPixel(x, z);\n            Color t = rTint.GetPixel(x, z);\n            l += string.Format(\"[{0}:C({1:F2},{2:F2},{3:F2},{4:F2})T({5:F2},{6:F2},{7:F2})]\", x, c.r, c.g, c.b, c.a, t.r, t.g, t.b);\n        }\n        sb.AppendLine(l);\n    }\n\n    // ALSO scan ALL 541x541 of rCtrl and rTint for ANY sharp 1-px dark dip in tint brightness OR ctrl rock/total anomaly!\n    int tintDips = 0; int ctrlRocks = 0;\n    for (int z = 1; z < 540; z++)\n    for (int x = 1; x < 540; x++)\n    {\n        Color t = rTint.GetPixel(x, z);\n        float lum = (t.r + t.g + t.b) / 3f;\n        float n1 = (rTint.GetPixel(x - 1, z).r + rTint.GetPixel(x - 1, z).g + rTint.GetPixel(x - 1, z).b) / 3f;\n        float n2 = (rTint.GetPixel(x + 1, z).r + rTint.GetPixel(x + 1, z).g + rTint.GetPixel(x + 1, z).b) / 3f;\n        float n3 = (rTint.GetPixel(x, z - 1).r + rTint.GetPixel(x, z - 1).g + rTint.GetPixel(x, z - 1).b) / 3f;\n        float n4 = (rTint.GetPixel(x, z + 1).r + rTint.GetPixel(x, z + 1).g + rTint.GetPixel(x, z + 1).b) / 3f;\n        float navg = 0.25f * (n1 + n2 + n3 + n4);\n        if (navg > 0.1f && lum < navg * 0.7f)\n        {\n            tintDips++;\n            if (tintDips <= 8) sb.AppendLine(string.Format(\"TINT DIP ({0},{1}) lum={2:F3} avg={3:F3} c={4}\", x, z, lum, navg, t));\n        }\n        Color c = rCtrl.GetPixel(x, z);\n        float cSum = c.r + c.g + c.b + c.a;\n        if (cSum < 0.9f || cSum > 1.1f) { ctrlRocks++; if (ctrlRocks <= 5) sb.AppendLine(\"CTRL SUM ANOMALY (\" + x + \",\" + z + \") \" + c); }\n    }\n    sb.AppendLine(\"Total tintDips(<0.7x)=\" + tintDips + \" ctrlSumAnom=\" + ctrlRocks);\n\n    UnityEngine.Object.DestroyImmediate(crt);\n    UnityEngine.Object.DestroyImmediate(trt);\n    UnityEngine.Object.DestroyImmediate(rCtrl);\n    UnityEngine.Object.DestroyImmediate(rTint);\n\n    // 2) Render check removing ONLY ONE MPB property at a time!\n    camGo = new GameObject(\"__ProbeMPB2Cam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    System.Func<string, int> checkDark = (lbl) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        int dark = 0; Color32 minC = new Color32(255,255,255,255);\n        for (int y = 6; y <= 28; y++)\n        for (int x = 148; x <= 193; x++)\n        {\n            var c = (Color32)tex.GetPixel(x, y);\n            if (c.r + c.g + c.b < 140) dark++;\n            if (c.r + c.g + c.b < minC.r + minC.g + minC.b) minC = c;\n        }\n        sb.AppendLine(lbl + \": dark<140=\" + dark + \" minC=(\" + minC.r + \",\" + minC.g + \",\" + minC.b + \")\");\n        return dark;\n    };\n\n    var flatCtrl = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var flatTint = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var fc = new Color[16]; var ft = new Color[16];\n    for (int i = 0; i < 16; i++) { fc[i] = new Color(0, 0, 0, 1); ft[i] = Color.white; }\n    flatCtrl.SetPixels(fc); flatCtrl.Apply();\n    flatTint.SetPixels(ft); flatTint.Apply();\n\n    // Test MPB with ONLY _Control flat + _UseSurfaceTint=0:\n    var mpbTest = new MaterialPropertyBlock();\n    mpbTest.SetTexture(\"_Control\", flatCtrl);\n    mpbTest.SetTexture(\"_SurfaceTint\", flatTint);\n    mpbTest.SetFloat(\"_UseSurfaceTint\", 0f);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"A_bothFlat_tint0\");\n\n    // Test MPB with ONLY origCtrl + flatTint + _UseSurfaceTint=0:\n    mpbTest.SetTexture(\"_Control\", origCtrl);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"B_origCtrl_only_tint0\");\n\n    // Test MPB with flatCtrl + origTint + _UseSurfaceTint=1:\n    mpbTest.SetTexture(\"_Control\", flatCtrl);\n    mpbTest.SetTexture(\"_SurfaceTint\", origTint);\n    mpbTest.SetFloat(\"_UseSurfaceTint\", 1f);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"C_origTint_only\");\n\n    // Wait also test mipmap bias / FilterMode.Point vs Bilinear on origCtrl!\n    var prevFilter = origCtrl.filterMode;\n    origCtrl.filterMode = FilterMode.Point;\n    mpbTest.SetTexture(\"_Control\", origCtrl);\n    mpbTest.SetTexture(\"_SurfaceTint\", flatTint);\n    mpbTest.SetFloat(\"_UseSurfaceTint\", 0f);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"D_origCtrl_POINT\");\n    origCtrl.filterMode = prevFilter;\n\n    UnityEngine.Object.DestroyImmediate(flatCtrl);\n    UnityEngine.Object.DestroyImmediate(flatTint);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
