wz++)\n{\n    float zf = -49f - wz / 6f;\n    int mz = Mathf.RoundToInt((zf + 90f) * 6f);\n    for (int wx = 0; wx <= 108; wx++)\n    {\n        float xf = 30f + wx / 6f;\n        int mx = Mathf.RoundToInt(xf * 6f);\n        int idx = mz * side + mx;\n        float y = mv[idx].y;\n        if (y < 0.65f || y > 1.05f) continue;\n        float avg4 = 0.25f * (mv[idx - 1].y + mv[idx + 1].y + mv[idx - side].y + mv[idx + side].y);\n        float lap = Mathf.Abs(y - avg4);\n        if (mn[idx].y < 0.985f || lap > 0.006f)\n        {\n            subCnt++;\n            if (subCnt <= 20)\n                sb.AppendLine(string.Format(\"  ({0:F2},{1:F2}) y={2:F4} ny={3:F4} lap={4:F4}\", xf, zf, y, mn[idx].y, lap));\n        }\n    }\n}\nsb.AppendLine(\"Total subtle creases in Bay grass=\" + subCnt);\n\n// 2. Inspect src[8] (Island 29, 44.83, -120.67) coastal evaluation vs final height\nvar src8 = sources[8];\nvar st = src8.GetType();\nVector2 orig8 = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src8, null);\nfloat pad8 = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src8, null));\nvar cache8 = st.GetProperty(\"BuiltCache\", flags).GetValue(src8, null);\nvar ct8 = cache8.GetType();\nint res8 = (int)ct8.GetProperty(\"Resolution\", flags).GetValue(cache8, null);\nfloat step8 = (float)ct8.GetProperty(\"Step\", flags).GetValue(cache8, null);\nfloat[] h8 = (float[])ct8.GetProperty(\"Heights\", flags).GetValue(cache8, null);\nfloat[] bf8 = (float[])ct8.GetProperty(\"BaseFields\", flags).GetValue(cache8, null);\nfloat[] sf8 = (float[])ct8.GetProperty(\"SmoothFields\", flags).GetValue(cache8, null);\nfloat[] sh8 = (float[])ct8.GetProperty(\"ShoreDistances\", flags).GetValue(cache8, null);\nfloat[] hm8 = (float[])ct8.GetProperty(\"HeadlandMasks\", flags).GetValue(cache8, null);\nfloat[] sc8 = (float[])ct8.GetProperty(\"ShoreCurvatures\", flags).GetValue(cache8, null);\n\nint scz = Mathf.RoundToInt((-120.667f - orig8.y + pad8) / step8);\nint scx = Mathf.RoundToInt((44.833f - orig8.x + pad8) / step8);\nvar resolveBandsM = st.GetMethod(\"ResolveCoastalBands\", flags);\nvar evalCoastM = st.GetMethod(\"EvaluateCoastalProfile\", flags);\nsb.AppendLine(\"=== src[8] (44.83,-120.67) CoastalBands & Profile around dx=-1..0 ===\");\nfor (int dx = -2; dx <= 2; dx++)\n{\n    int idx = scz * res8 + (scx + dx);\n    float lx = (scx + dx) * step8 - pad8;\n    float lz = scz * step8 - pad8;\n    object bands = resolveBandsM.Invoke(src8, new object[] { lx, lz, hm8[idx], sc8[idx] });\n    float cp = evalCoastM != null ? System.Convert.ToSingle(evalCoastM.Invoke(src8, new object[] { sh8[idx], bands, hm8[idx], sf8[idx], sc8[idx] })) : -99f;\n    sb.AppendLine(string.Format(\"  dx={0,2}: h={1:F3} cp={2:F3} sh={3:F3} sf={4:F3} bf={5:F3} bands={6}\",\n        dx, h8[idx], cp, sh8[idx], sf8[idx], bf8[idx], bands));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
