{"ts":"2026-11-15T18:01:48.171Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1246,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mm = UnityEngine.Object.FindFirstObjectByType<MapManager>();\nvar wtf = mm.GetTerrainField();\nvar srcs = wtf.GetType().GetField(\"sources\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic).GetValue(wtf) as System.Collections.IList;\nvar bcProp = typeof(IslandTerrainProvider).GetProperty(\"BuiltCache\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public);\nvar oF = typeof(IslandTerrainProvider).GetField(\"chunkWorldOrigin\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar olF = typeof(IslandTerrainProvider).GetField(\"ownedLandform\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar gF = typeof(IslandTerrainProvider).GetField(\"gridType\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar rActF = typeof(IslandTerrainProvider).GetField(\"regionActive\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar rDirF = typeof(IslandTerrainProvider).GetField(\"regionDirection\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar rThrF = typeof(IslandTerrainProvider).GetField(\"regionThreshold\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\n\nint idxS = 0;\nforeach (IslandTerrainProvider p in srcs)\n{\n    var g = gF.GetValue(p).ToString();\n    if (g != \"Island\") { idxS++; continue; }\n    var orig = (Vector2)oF.GetValue(p);\n    var cache = bcProp.GetValue(p, null) as TerrainSampleCache;\n    var rp = olF.GetValue(p) as RiverPlan;\n    bool reg = (bool)rActF.GetValue(p);\n    Vector2 rdir = (Vector2)rDirF.GetValue(p);\n    float rthr = (float)rThrF.GetValue(p);\n    sb.AppendLine(\"IslandSrc[\" + idxS + \"] orig=\" + orig + \" res=\" + (cache != null ? cache.Resolution : -1) + \" regionActive=\" + reg + \" dir=\" + rdir + \" thr=\" + rthr.ToString(\"F2\") + \" river=\" + (rp != null ? rp.Sections.Count + \" sections len=\" + rp.Length.ToString(\"F1\") : \"null\"));\n    if (cache != null)\n    {\n        int r = cache.Resolution;\n        int sharpSteps = 0;\n        for (int z = 2; z < r - 2; z++)\n        for (int x = 2; x < r - 2; x++)\n        {\n            int ci = z * r + x;\n            float y = cache.Heights[ci];\n            if (y > 0.65f && y < 1.15f)\n            {\n                float avg = 0.25f * (cache.Heights[ci - 1] + cache.Heights[ci + 1] + cache.Heights[ci - r] + cache.Heights[ci + r]);\n                float gx = Mathf.Abs(cache.Heights[ci + 1] - cache.Heights[ci - 1]) * 0.5f;\n                float gz = Mathf.Abs(cache.Heights[ci + r] - cache.Heights[ci - r]) * 0.5f;\n                float slope = Mathf.Max(gx, gz);\n                if (slope > 0.06f && cache.RiverCarveDepths[ci] < 0.001f && avg < 1.15f)\n                {\n                    sharpSteps++;\n                    if (sharpSteps <= 8)\n                        sb.AppendLine(\"  sharp cache[\" + x + \",\" + z + \"] w=\" + (orig + new Vector2(x * cache.Step, z * cache.Step)) + \" h=\" + y.ToString(\"F3\") + \" gx=\" + gx.ToString(\"F3\") + \" gz=\" + gz.ToString(\"F3\") + \" type=\" + cache.TerrainTypes[ci] + \" mAllow=\" + cache.MountainAllowances[ci].ToString(\"F2\") + \" mBoost=\" + cache.MountainBoosts[ci].ToString(\"F2\"));\n                }\n            }\n        }\n        sb.AppendLine(\"  cache sharpSteps(non-river, h=0.65..1.15, maxDiff>0.06)=\" + sharpSteps);\n    }\n    idxS++;\n}\n\n// Now check Island 21 and Island 31 mesh directly for ANY 1-vertex dark line (drop 0.015..0.06 OR sharp gradient in flat grass y=0.65..0.95)\nforeach (string nm in new string[] { \"Island 21\", \"Island 31\", \"Island 47\" })\n{\n    var go = GameObject.Find(nm);\n    var m = go.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    var nrm = m.normals;\n    int n = 541;\n    int linePts = 0;\n    for (int z = 5; z < n - 5; z++)\n    for (int x = 5; x < n - 5; x++)\n    {\n        int i = z * n + x;\n        float y = v[i].y;\n        if (y > 0.68f && y < 0.90f)\n        {\n            float maxD = Mathf.Max(Mathf.Abs(v[i + 1].y - v[i - 1].y), Mathf.Abs(v[i + n].y - v[i - n].y));\n            if (maxD > 0.05f && v[i + 1].y < 0.95f && v[i - 1].y < 0.95f && v[i + n].y < 0.95f && v[i - n].y < 0.95f)\n            {\n                linePts++;\n                if (linePts <= 10)\n                    sb.AppendLine(nm + \" flatAnomaly[\" + x + \",\" + z + \"] w=\" + (new Vector2(go.transform.position.x + v[i].x, go.transform.position.z + v[i].z)) + \" y=\" + y.ToString(\"F3\") + \" nrmY=\" + nrm[i].y.ToString(\"F2\") + \" max2px=\" + maxD.ToString(\"F3\"));\n            }\n        }\n    }\n    sb.AppendLine(nm + \" flatAnomalies(y=0.68..0.90, max2px>0.05, allN<0.95)=\" + linePts);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
