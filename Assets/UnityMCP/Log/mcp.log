{"ts":"2026-11-15T19:55:08.574Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1167,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar vent = GameObject.Find(\"Hydrothermal Vent (53, 35)\");\nvar plume = vent != null ? vent.transform.Find(\"Thermal Plume\").GetComponent<ParticleSystem>() : null;\nif (plume != null)\n{\n    var r = plume.GetComponent<ParticleSystemRenderer>();\n    var m = r.sharedMaterial;\n    sb.AppendLine(\"Plume layer=\" + LayerMask.LayerToName(plume.gameObject.layer) + \"(\" + plume.gameObject.layer + \")\");\n    sb.AppendLine(\"Renderer renderMode=\" + r.renderMode + \" align=\" + r.alignment + \" keywords=\" + string.Join(\",\", m.shaderKeywords));\n    sb.AppendLine(\"_AlphaClip=\" + (m.HasProperty(\"_AlphaClip\") ? m.GetFloat(\"_AlphaClip\").ToString() : \"n/a\")\n        + \" _SrcBlend=\" + (m.HasProperty(\"_SrcBlend\") ? m.GetFloat(\"_SrcBlend\").ToString() : \"n/a\")\n        + \" _DstBlend=\" + (m.HasProperty(\"_DstBlend\") ? m.GetFloat(\"_DstBlend\").ToString() : \"n/a\")\n        + \" _BlendOp=\" + (m.HasProperty(\"_BlendOp\") ? m.GetFloat(\"_BlendOp\").ToString() : \"n/a\")\n        + \" _Cutoff=\" + (m.HasProperty(\"_Cutoff\") ? m.GetFloat(\"_Cutoff\").ToString() : \"n/a\")\n        + \" _SoftParticles=\" + (m.HasProperty(\"_SoftParticlesEnabled\") ? m.GetFloat(\"_SoftParticlesEnabled\").ToString() : \"n/a\"));\n    plume.Simulate(2.0f, false, true);\n    var parts = new ParticleSystem.Particle[32];\n    int n = plume.GetParticles(parts);\n    sb.AppendLine(\"Active particles=\" + n + \" firstPos=\" + (n > 0 ? parts[0].position.ToString(\"F2\") : \"none\")\n        + \" firstSize=\" + (n > 0 ? parts[0].GetCurrentSize(plume).ToString(\"F3\") : \"none\")\n        + \" firstCol=\" + (n > 0 ? parts[0].GetCurrentColor(plume).ToString() : \"none\"));\n    plume.Stop(false, ParticleSystemStopBehavior.StopEmittingAndClear);\n}\n\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>();\nMaterial splatMat = null, platMat = null;\nfor (int i = 0; i < grids.Length; i++)\n{\n    var m = grids[i].GetComponent<MeshRenderer>().sharedMaterial;\n    if (m != null && m.shader.name.Contains(\"Terrain Splat\") && splatMat == null) splatMat = m;\n    if (m != null && m.shader.name.Contains(\"UnderwaterPlateau\") && platMat == null) platMat = m;\n}\nif (splatMat != null)\n    sb.AppendLine(\"Splat: \" + AssetDatabase.GetAssetPath(splatMat) + \" _SeabedTint=\" + splatMat.GetColor(\"_SeabedTint\")\n        + \" _MacroStr=\" + splatMat.GetFloat(\"_MacroStrength\") + \" _MacroTile=\" + splatMat.GetFloat(\"_MacroTiling\")\n        + \" _SeabedTile=\" + splatMat.GetFloat(\"_SeabedTiling\")\n        + \" _SeabedTex=\" + (splatMat.GetTexture(\"_SeabedAlbedo\") != null ? splatMat.GetTexture(\"_SeabedAlbedo\").name : \"NULL\")\n        + \" _BaseMap=\" + (splatMat.GetTexture(\"_BaseMap\") != null ? splatMat.GetTexture(\"_BaseMap\").name : \"NULL\"));\nif (platMat != null)\n    sb.AppendLine(\"Plateau: \" + AssetDatabase.GetAssetPath(platMat) + \" _SeabedTint=\" + platMat.GetColor(\"_SeabedTint\")\n        + \" _MacroStr=\" + platMat.GetFloat(\"_MacroStrength\") + \" _MacroTile=\" + platMat.GetFloat(\"_MacroTiling\")\n        + \" _SeabedTile=\" + platMat.GetFloat(\"_SeabedTiling\")\n        + \" _SeabedTex=\" + (platMat.GetTexture(\"_SeabedAlbedo\") != null ? platMat.GetTexture(\"_SeabedAlbedo\").name : \"NULL\")\n        + \" _GenBlend=\" + platMat.GetFloat(\"_GeneratedColorBlend\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
