{"ts":"2026-11-15T18:10:43.134Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1196,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// Print ASCII height/normal map around any isolated flat-grass creases on Island 31 (and check ALL 267 crease coords)\nvar i31 = GameObject.Find(\"Island 31\");\nvar mg = i31.GetComponent<MapGrid>();\nvar mesh = i31.GetComponent<MeshFilter>().sharedMesh;\nvar v = mesh.vertices;\nvar n = mesh.normals;\nint side = 541;\n\n// Find bounding box of ny < 0.93 where 0.65 < y < 1.05 and max 3x3 neighbor < 1.25\nfloat minX = 999, maxX = -999, minZ = 999, maxZ = -999;\nint cnt = 0;\nfor (int z = 5; z < side - 5; z++)\n{\n    for (int x = 5; x < side - 5; x++)\n    {\n        int idx = z * side + x;\n        float y = v[idx].y;\n        if (y < 0.65f || y > 1.05f) continue;\n        float maxY = y;\n        for (int dz = -3; dz <= 3; dz++)\n            for (int dx = -3; dx <= 3; dx++)\n            {\n                float nyv = v[(z + dz) * side + (x + dx)].y;\n                if (nyv > maxY) maxY = nyv;\n            }\n        if (maxY < 1.25f && n[idx].y < 0.93f)\n        {\n            cnt++;\n            if (x < minX) minX = x; if (x > maxX) maxX = x;\n            if (z < minZ) minZ = z; if (z > maxZ) maxZ = z;\n        }\n    }\n}\nsb.AppendLine(\"Creases cnt=\" + cnt + \" gridIdxBox=(\" + minX + \"..\" + maxX + \", \" + minZ + \"..\" + maxZ + \")\");\n\n// Inspect local strip around (x=160..240, z=160..190) -> world x=26.6..40, z=-63.3..-58.3\nsb.AppendLine(\"Heights along x=165..185 (world 27.5..30.8), z=165..180 (world -62.5..-60.0):\");\nfor (int z = 165; z <= 180; z++)\n{\n    sb.Append(string.Format(\"z={0,3}({1,6:F2}): \", z, -90f + z / 6f));\n    for (int x = 165; x <= 185; x++)\n    {\n        int idx = z * side + x;\n        sb.Append(string.Format(\"{0:F3}{1} \", v[idx].y, n[idx].y < 0.93f ? \"*\" : \" \"));\n    }\n    sb.AppendLine(\"\");\n}\n\n// Check what TerrainSampleCache of src[9] has at world (28..40, -63..-58)\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\nvar list = wtf.GetType().GetProperty(\"Sources\", flags).GetValue(wtf, null) as System.Collections.IList;\nvar src9 = list[9];\nvar st = src9.GetType();\nVector2 orig9 = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src9, null);\nfloat pad9 = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src9, null));\nvar cache9 = st.GetProperty(\"BuiltCache\", flags).GetValue(src9, null);\nvar ct = cache9.GetType();\nint res9 = (int)ct.GetProperty(\"Resolution\", flags).GetValue(cache9, null);\nfloat step9 = (float)ct.GetProperty(\"Step\", flags).GetValue(cache9, null);\nfloat[] h9 = (float[])ct.GetProperty(\"Heights\", flags).GetValue(cache9, null);\nfloat[] s9 = (float[])ct.GetProperty(\"Slopes\", flags).GetValue(cache9, null);\nfloat[] sh9 = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache9, null);\nvar tt9 = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache9, null);\nfloat[] bf9 = (float[])ct.GetProperty(\"BaseFields\", flags).GetValue(cache9, null);\nfloat[] sf9 = (float[])ct.GetProperty(\"SmoothFields\", flags).GetValue(cache9, null);\nfloat[] pd9 = (float[])ct.GetProperty(\"PlateauInfluences\", flags).GetValue(cache9, null);\n\nsb.AppendLine(\"src[9] cache around world z=-61.0 (iz=Round((-61 - (-84) + 34)*6) = 342):\");\nint iz0 = Mathf.RoundToInt((-61.0f - orig9.y + pad9) / step9);\nfor (int x = 165; x <= 185; x++)\n{\n    float wx = 0f + x / 6f;\n    int ix0 = Mathf.RoundToInt((wx - orig9.x + pad9) / step9);\n    int cidx = iz0 * res9 + ix0;\n    sb.AppendLine(string.Format(\"  wx={0:F2}: cacheH={1:F4} slope={2:F3} shore={3:F3} bf={4:F3} sf={5:F3} pd={6:F3} tt={7}\",\n        wx, h9[cidx], s9[cidx], sh9[cidx], bf9[cidx], sf9[cidx], pd9[cidx], tt9.GetValue(cidx)));\n}\n\n// Check ALL vertices on Island 31 for ny < 0.70 where y is NOT coastal (<0.6) and NOT high mountain (>1.5)\n// Could a cliff-base or seam cut through flat grass?\nint weirdCliff = 0;\nvar wcPts = new System.Collections.Generic.List<string>();\nfor (int z = 2; z < side - 2; z++)\n{\n    for (int x = 2; x < side - 2; x++)\n    {\n        int idx = z * side + x;\n        float y = v[idx].y;\n        if (y > 0.65f && y < 1.15f)\n        {\n            // Check sharp 1-sample cliff/step: |h[x] - 0.5*(h[x-1]+h[x+1])| or |h[z+1]-h[z-1]| > 0.15\n            float lapX = Mathf.Abs(v[idx].y - 0.5f * (v[idx - 1].y + v[idx + 1].y));\n            float lapZ = Mathf.Abs(v[idx].y - 0.5f * (v[idx - side].y + v[idx + side].y));\n            if (lapX > 0.03f || lapZ > 0.03f)\n            {\n                weirdCliff++;\n                if (wcPts.Count < 15)\n                {\n                    Vector3 wp = i31.transform.TransformPoint(v[idx]);\n                    wcPts.Add(string.Format(\"({0:F2},{1:F2}) y={2:F3} lapX={3:F3} lapZ={4:F3}\", wp.x, wp.z, y, lapX, lapZ));\n                }\n            }\n        }\n    }\n}\nsb.AppendLine(\"Island 31 1-sample spikes/dips (lap>0.03 in 0.65<y<1.15): \" + weirdCliff);\nfor (int i = 0; i < wcPts.Count; i++) sb.AppendLine(\"  \" + wcPts[i]);\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
