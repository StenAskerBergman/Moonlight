ponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n    cam.cullingMask = 1 << 31;\n\n    rt = new RenderTexture(1080, 1080, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex = new Texture2D(1080, 1080, TextureFormat.RGBA32, false);\n    tex.ReadPixels(new Rect(0, 0, 1080, 1080), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n\n    var px = tex.GetPixels32();\n    var darkList = new System.Collections.Generic.List<Vector3>();\n    for (int py = 4; py < 1076; py++)\n    {\n        for (int pxx = 4; pxx < 1076; pxx++)\n        {\n            var c = px[py * 1080 + pxx];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nSum = 0f; int nCnt = 0;\n            for (int dy = -3; dy <= 3; dy += 3)\n            for (int dx = -3; dx <= 3; dx += 3)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var nc = px[(py + dy) * 1080 + (pxx + dx)];\n                if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n                nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n                nCnt++;\n            }\n            if (nCnt >= 6 && (nSum / nCnt) > 0.12f && lum < (nSum / nCnt) * 0.55f)\n            {\n                float wx = mr.bounds.min.x + (pxx + 0.5f) / 1080f * 90f;\n                float wz = mr.bounds.min.z + (py + 0.5f) / 1080f * 90f;\n                darkList.Add(new Vector3(wx, lum, wz));\n            }\n        }\n    }\n    sb.AppendLine(\"Ortho dark count (<0.55x): \" + darkList.Count);\n    for (int i = 0; i < Mathf.Min(20, darkList.Count); i++)\n        sb.AppendLine(\"  dark pt#\" + i + \": world=(\" + darkList[i].x.ToString(\"F2\") + \", \" + darkList[i].z.ToString(\"F2\") + \") lum=\" + darkList[i].y.ToString(\"F3\"));\n\n    // Read _Control and _SurfaceTint at those exact dark coordinates AND dump TerrainSampleCache around them!\n    if (ctrlTex != null && tintTex != null && darkList.Count > 0)\n    {\n        var crt = new RenderTexture(ctrlTex.width, ctrlTex.height, 0, RenderTextureFormat.ARGB32);\n        Graphics.Blit(ctrlTex, crt);\n        RenderTexture.active = crt;\n        var rCtrl = new Texture2D(ctrlTex.width, ctrlTex.height, TextureFormat.RGBA32, false);\n        rCtrl.ReadPixels(new Rect(0, 0, ctrlTex.width, ctrlTex.height), 0, 0);\n        rCtrl.Apply();\n\n        var trt = new RenderTexture(tintTex.width, tintTex.height, 0, RenderTextureFormat.ARGB32);\n        Graphics.Blit(tintTex, trt);\n        RenderTexture.active = trt;\n        var rTint = new Texture2D(tintTex.width, tintTex.height, TextureFormat.RGBA32, false);\n        rTint.ReadPixels(new Rect(0, 0, tintTex.width, tintTex.height), 0, 0);\n        rTint.Apply();\n        RenderTexture.active = null;\n\n        for (int i = 0; i < Mathf.Min(10, darkList.Count); i++)\n        {\n            float lx = darkList[i].x - i31.transform.position.x;\n            float lz = darkList[i].z - i31.transform.position.z;\n            int tx = Mathf.Clamp(Mathf.RoundToInt(lx / 90f * (ctrlTex.width - 1)), 1, ctrlTex.width - 2);\n            int tz = Mathf.Clamp(Mathf.RoundToInt(lz / 90f * (ctrlTex.height - 1)), 1, ctrlTex.height - 2);\n            sb.AppendLine(string.Format(\"  sample#{0} local=({1:F2},{2:F2}) px=({3},{4}) ctrl={5} tint={6}\",\n                i, lx, lz, tx, tz, rCtrl.GetPixel(tx, tz), rTint.GetPixel(tx, tz)));\n        }\n        UnityEngine.Object.DestroyImmediate(crt);\n        UnityEngine.Object.DestroyImmediate(trt);\n        UnityEngine.Object.DestroyImmediate(rCtrl);\n        UnityEngine.Object.DestroyImmediate(rTint);\n    }\n\n    // ALSO check TerrainSplat shader: render WITH a flat white Albedo or Unlit to see if dark curve comes from ALBEDO/NORMAL/MESH/SHADOW!\n    // Wait first let's save a full 1080x1080 ortho screenshot + child objects check on clone!\n    sb.Append