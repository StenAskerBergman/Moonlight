osition.x + v[idx].x, go.transform.position.z + v[idx].z);\n                string rInfo = \"\";\n                foreach (IslandTerrainProvider p in srcs)\n                {\n                    if (gF.GetValue(p).ToString() != \"Island\") continue;\n                    var orig = (Vector2)oF.GetValue(p);\n                    var rp = olF != null ? olF.GetValue(p) as RiverPlan : null;\n                    RiverSurfaceSample rs;\n                    if (rp != null && rp.TrySample(wp - orig, out rs))\n                    {\n                        rInfo += \" srcOrig=\" + orig + \" wet=\" + rs.IsWater + \" wH=\" + rs.WaterHeight.ToString(\"F2\") + \" inf=\" + rs.Influence.ToString(\"F2\") + \" tgt=\" + rs.TargetHeight.ToString(\"F2\") + \" rock=\" + rs.RockWeight.ToString(\"F2\") + \" kind=\" + rs.Kind + \";\";\n                    }\n                    var cache = bcProp.GetValue(p, null) as TerrainSampleCache;\n                    if (cache != null)\n                    {\n                        Vector2 lp = wp - orig;\n                        int cx = Mathf.RoundToInt(lp.x / cache.Step);\n                        int cz = Mathf.RoundToInt(lp.y / cache.Step);\n                        if (cx >= 1 && cx < cache.Resolution - 1 && cz >= 1 && cz < cache.Resolution - 1)\n                        {\n                            int ci = cz * cache.Resolution + cx;\n                            rInfo += \" [cache h=\" + cache.Heights[ci].ToString(\"F3\") + \" type=\" + cache.TerrainTypes[ci] + \" rCarve=\" + cache.RiverCarveDepths[ci].ToString(\"F3\") + \" shore=\" + cache.ShoreDistances[ci].ToString(\"F2\") + \" base=\" + cache.BaseFields[ci].ToString(\"F3\") + \" smooth=\" + cache.SmoothFields[ci].ToString(\"F3\") + \" slope=\" + cache.Slopes[ci].ToString(\"F2\") + \"]\";\n                        }\n                    }\n                }\n                sb.AppendLine(\"  trench[\" + x + \",\" + z + \"] w=\" + wp + \" y=\" + y.ToString(\"F3\") + \" avgN=\" + avgN.ToString(\"F3\") + \" nrmY=\" + nrm[idx].y.ToString(\"F2\") + rInfo);\n                // Also print a 3x3 height patch in mesh\n                sb.Append(\"    3x3 y: \");\n                for (int dz = -1; dz <= 1; dz++)\n                {\n                    sb.Append(\"[\");\n                    for (int dx = -1; dx <= 1; dx++) sb.Append(v[(z + dz) * n + (x + dx)].y.ToString(\"F3\") + \" \");\n                    sb.Append(\"] \");\n                }\n                sb.AppendLine();\n            }\n        }\n    }\n    sb.AppendLine(\"  total trenches(>0.04)=\" + count);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
