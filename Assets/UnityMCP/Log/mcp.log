{"ts":"2026-11-15T17:52:29.580Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1328,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nsb.AppendLine(\"isPlaying=\" + UnityEditor.EditorApplication.isPlaying);\n\n// 1. Inspect Camera Rig hierarchy, missing scripts, materials\nvar rig = UnityEngine.GameObject.Find(\"Camera Rig\");\nif (rig != null) {\n    sb.AppendLine(\"=== Camera Rig Hierarchy ===\");\n    var ts = rig.GetComponentsInChildren<UnityEngine.Transform>(true);\n    for (int i = 0; i < ts.Length; i++) {\n        var comps = ts[i].GetComponents<UnityEngine.Component>();\n        string compStr = \"\";\n        int nullCount = 0;\n        for (int c = 0; c < comps.Length; c++) {\n            if (comps[c] == null) nullCount++;\n            else compStr += comps[c].GetType().Name + \", \";\n        }\n        sb.AppendLine(\"  \" + ts[i].name + \" act=\" + ts[i].gameObject.activeInHierarchy + \" pos=\" + ts[i].localPosition + \" rot=\" + ts[i].localEulerAngles + \" scale=\" + ts[i].localScale + \" missing=\" + nullCount + \" comps=[\" + compStr + \"]\");\n    }\n}\n\n// 2. Inspect Units in scene (e.g. SeaHawk)\nvar units = UnityEngine.Resources.FindObjectsOfTypeAll<Unit>();\nsb.AppendLine(\"=== Units (\" + units.Length + \") ===\");\nfor (int i = 0; i < units.Length; i++) {\n    var u = units[i];\n    if (UnityEditor.EditorUtility.IsPersistent(u.gameObject)) continue;\n    sb.AppendLine(\"  Unit: \" + u.name + \" pos=\" + u.transform.position + \" children=\" + u.transform.childCount);\n    for (int c = 0; c < u.transform.childCount; c++) {\n        var ch = u.transform.GetChild(c);\n        var mr = ch.GetComponent<UnityEngine.MeshRenderer>();\n        var mf = ch.GetComponent<UnityEngine.MeshFilter>();\n        sb.AppendLine(\"    child[\" + c + \"]=\" + ch.name + \" act=\" + ch.gameObject.activeSelf + \" lPos=\" + ch.localPosition + \" lScale=\" + ch.localScale\n            + (mf != null && mf.sharedMesh != null ? \" mesh=\" + mf.sharedMesh.name : \"\")\n            + (mr != null && mr.sharedMaterial != null ? \" mat=\" + mr.sharedMaterial.name : \"\"));\n    }\n}\n\n// 3. Check SelectionOutlineRendererFeature & URP Renderer\nvar urpAsset = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline as UnityEngine.Rendering.Universal.UniversalRenderPipelineAsset;\nsb.AppendLine(\"URP Asset=\" + (urpAsset != null ? urpAsset.name : \"null\"));\nif (urpAsset != null) {\n    string assetPath = UnityEditor.AssetDatabase.GetAssetPath(urpAsset);\n    sb.AppendLine(\"URP Asset Path=\" + assetPath);\n    var assetSo = new UnityEditor.SerializedObject(urpAsset);\n    var rendererList = assetSo.FindProperty(\"m_RendererDataList\");\n    if (rendererList != null) {\n        for (int i = 0; i < rendererList.arraySize; i++) {\n            var rd = rendererList.GetArrayElementAtIndex(i).objectReferenceValue as UnityEngine.Rendering.Universal.ScriptableRendererData;\n            if (rd != null) {\n                sb.AppendLine(\"  RendererData[\" + i + \"]=\" + rd.name + \" path=\" + UnityEditor.AssetDatabase.GetAssetPath(rd));\n                for (int f = 0; f < rd.rendererFeatures.Count; f++) {\n                    var feat = rd.rendererFeatures[f];\n                    sb.AppendLine(\"    Feature[\" + f + \"]=\" + (feat != null ? feat.GetType().Name + \" active=\" + feat.isActive : \"null\"));\n                }\n            }\n        }\n    }\n}\n\n// 4. Restore Island 31 sharedMaterial if it is Terrain Splat (Instance)\nvar terrainSplatMat = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Materials/Terrain Splat.mat\");\nif (terrainSplatMat == null) {\n    var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Material Terrain Splat\");\n    if (guids.Length > 0) terrainSplatMat = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(UnityEditor.AssetDatabase.GUIDToAssetPath(guids[0]));\n}\nvar isl31 = UnityEngine.GameObject.Find(\"Island 31\");\nif (isl31 != null) {\n    var mr31 = isl31.GetComponent<UnityEngine.MeshRenderer>();\n    if (mr31 != null) {\n        sb.AppendLine(\"Island 31 sharedMat BEFORE=\" + (mr31.sharedMaterial != null ? mr31.sharedMaterial.name : \"null\"));\n        if (!UnityEditor.EditorApplication.isPlaying && terrainSplatMat != null && mr31.sharedMaterial != terrainSplatMat) {\n            mr31.sharedMaterial = terrainSplatMat;\n            UnityEditor.EditorUtility.SetDirty(isl31);\n            sb.AppendLine(\"Island 31 sharedMat RESTORED to \" + terrainSplatMat.name);\n        }\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
