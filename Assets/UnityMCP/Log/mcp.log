osition + new Vector3(24f, -18.4f, 1f);\n        Vector3 wMax = i31.transform.position + new Vector3(34f, -18.4f, 8f);\n        Color32 minC = new Color32(255,255,255,255);\n        int blackNear = 0;\n        Vector3 minW = Vector3.zero;\n        for (int y = 2; y < 510; y++)\n        for (int x = 2; x < 510; x++)\n        {\n            var c = pxs[y * 512 + x];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            // world pos under ortho cam:\n            float nx = (x + 0.5f) / 512f * 2f - 1f;\n            float ny = (y + 0.5f) / 512f * 2f - 1f;\n            float wx = cam.transform.position.x + nx * cam.orthographicSize;\n            float wz = cam.transform.position.z + ny * cam.orthographicSize;\n            float lx = wx - i31.transform.position.x;\n            float lz = wz - i31.transform.position.z;\n            if (lx < 24f || lx > 34f || lz < 1f || lz > 8f) continue;\n            int sum = c.r + c.g + c.b;\n            if (sum < 140)\n            {\n                blackNear++;\n                if (sum < (minC.r + minC.g + minC.b)) { minC = c; minW = new Vector3(lx, 0, lz); }\n            }\n        }\n        sb.AppendLine(string.Format(\"{0}: blackNear={1} minC=({2},{3},{4}) at local=({5:F2},{6:F2})\",\n            lbl, blackNear, minC.r, minC.g, minC.b, minW.x, minW.z));\n    };\n\n    probe(\"1_ortho45_at45_45\");\n\n    // Test 2: Move cam to (29, 40, 4) keeping orthoSize=45 (does black follow camera or stay at world?)\n    cam.transform.position = i31.transform.position + new Vector3(29f, 40f, 4f);\n    probe(\"2_ortho45_at29_4\");\n\n    // Test 3: Move cam back to (45, 40, 45), shrink cam.near/farClipPlane or move Y from 40 to 10 (closer depth!)\n    cam.transform.position = i31.transform.position + new Vector3(45f, 10f, 45f);\n    probe(\"3_ortho45_camY10\");\n\n    // Test 4: cam at (45, 40, 45) ortho45, disable shadows\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    var lights = UnityEngine.Object.FindObjectsOfType<Light>();\n    var oldSh = new LightShadows[lights.Length];\n    for (int i = 0; i < lights.Length; i++) { oldSh[i] = lights[i].shadows; lights[i].shadows = LightShadows.None; }\n    probe(\"4_ortho45_noshadows\");\n    for (int i = 0; i < lights.Length; i++) lights[i].shadows = oldSh[i];\n\n    // Test 5: cam at (45, 40, 45) ortho45, replace shader on clone with plainLit\n    var origMat = mr.sharedMaterial;\n    var plainMat = new Material(Shader.Find(\"Universal Render Pipeline/Lit\"));\n    plainMat.color = Color.gray;\n    mr.sharedMaterial = plainMat;\n    probe(\"5_ortho45_plainLit\");\n    mr.sharedMaterial = origMat;\n    UnityEngine.Object.DestroyImmediate(plainMat);\n\n    // Test 6: cam at (45, 40, 45) ortho45, turn SSAO OFF\n    var rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\n    var rList = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\n    UnityEngine.Rendering.Universal.ScriptableRendererFeature ssao = null;\n    if (rList != null && rList.Length > 0)\n        foreach (var f in rList[0].rendererFeatures)\n            if (f != null && f.GetType().Name.Contains(\"AmbientOcclusion\")) { ssao = f; break; }\n    if (ssao != null)\n    {\n        bool prev = ssao.isActive;\n        ssao.SetActive(false);\n        probe(\"6_ortho45_noSSAO\");\n        ssao.SetActive(prev);\n    }\n\n    // Test 7: orthoSize=18 centered on (28, 40, 5)\n    cam.transform.position = i31.transform.position + new Vector3(28f, 40f, 5f);\n    cam.orthographicSize = 18f;\n    probe(\"7_ortho18_at28_5\");\n\n    // Test 8: orthoSize=45 centered at (45,40,45), set cam.useOcclusionCulling = false and inspect _Control FilterMode / MipMaps / WrapMode!\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var cTex = mpb.GetTexture(\"_Control\") as Texture2D;\n    var tTex = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n    var rTex = mpb.GetTexture(\"_RegionMask\") as Texture2D;\n    sb.AppendLine(string.Format(\"Textures: ctrl mip={0} filter={1} wrap={2}; tint mip={3} filter={4} wrap={5}; reg mip={6} filter={7}\",\n        cTex.mipmapCount, cTex.filterMode, cTex.wrapMode,\n        tTex.mipmapCount, tTex.filterMode, tTex.wrapMode,\n        rTex.mipmapCount, rTex.filterMode));\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
