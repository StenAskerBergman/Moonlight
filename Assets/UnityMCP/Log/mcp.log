er).GetField(\"gridType\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\nvar oF = typeof(IslandTerrainProvider).GetField(\"chunkWorldOrigin\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\n\nforeach (IslandTerrainProvider p in srcs)\n{\n    if (gF.GetValue(p).ToString() != \"Island\") continue;\n    Vector2 orig = (Vector2)oF.GetValue(p);\n    var cache = bcProp.GetValue(p, null) as TerrainSampleCache;\n    int r = cache.Resolution;\n    // Check ALL points where Slopes[i] > 0.35 while Heights[i] in [0.55..1.10] AND MountainBoosts[i] < 0.05!\n    // Wait: WHAT causes Slopes[i] > 0.35 when Heights[i] is 0.55..1.10 and MountainBoost < 0.05?\n    int unexplainedSlope = 0;\n    for (int z = 5; z < r - 5; z++)\n    for (int x = 5; x < r - 5; x++)\n    {\n        int i = z * r + x;\n        float h = cache.Heights[i];\n        if (h >= 0.65f && h <= 1.05f && cache.MountainBoosts[i] < 0.02f && cache.RiverCarveDepths[i] < 0.001f)\n        {\n            // Check 1-px height anomaly OR slope anomaly\n            float gx = Mathf.Abs(cache.Heights[i+1] - cache.Heights[i-1]) / (2f * cache.Step);\n            float gz = Mathf.Abs(cache.Heights[i+r] - cache.Heights[i-r]) / (2f * cache.Step);\n            if (Mathf.Max(gx, gz) > 0.35f)\n            {\n                unexplainedSlope++;\n                if (unexplainedSlope <= 5)\n                    sb.AppendLine(\"  Unexplained slope on flatland orig=\" + orig + \" [\" + x + \",\" + z + \"] w=\" + (orig + new Vector2(x*cache.Step, z*cache.Step)) + \" h=\" + h.ToString(\"F3\") + \" gx=\" + gx.ToString(\"F2\") + \" gz=\" + gz.ToString(\"F2\") + \" shore=\" + cache.ShoreDistances[i].ToString(\"F2\"));\n            }\n        }\n    }\n    sb.AppendLine(\"Orig=\" + orig + \" unexplainedFlatSlope(>0.35)=\" + unexplainedSlope);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
