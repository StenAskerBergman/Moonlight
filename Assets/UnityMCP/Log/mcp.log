{"ts":"2026-11-15T18:32:21.326Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1434,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// 1. Check shader compilation after our edit!\nvar s1 = Shader.Find(\"Moonlight/Terrain Splat (Normal Mapped)\");\nvar s2 = Shader.Find(\"Moonlight/UnderwaterPlateauMaterial\");\nvar m1 = UnityEditor.ShaderUtil.GetShaderMessages(s1);\nvar m2 = UnityEditor.ShaderUtil.GetShaderMessages(s2);\nsb.AppendLine(\"Shader msgs TerrainSplat=\" + m1.Length + \" Plateau=\" + m2.Length);\nforeach (var m in m1) sb.AppendLine(\"  S1: \" + m.severity + \" \" + m.message);\nforeach (var m in m2) sb.AppendLine(\"  S2: \" + m.severity + \" \" + m.message);\n\n// 2. Test Island 31 clone render NOW to verify if the 1-px black stair-stepped cascade line in BR seabed + ortho + bay is 100% GONE!\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__VerifyNoCascade\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n    clone.layer = 31;\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    camGo = new GameObject(\"__VerifyCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n\n    rt = new RenderTexture(1080, 1080, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(1080, 1080, TextureFormat.RGBA32, false);\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 1080, 1080), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\verify_i31_ortho_fixed.png\", tex.EncodeToPNG());\n\n    // Count dark spike pixels in BR seabed box (1080x1080 -> x in [820..1040], y in [95..340])\n    var pxs = tex.GetPixels32();\n    int brDark = 0;\n    for (int y = 95; y <= 340; y++)\n    for (int x = 820; x <= 1040; x++)\n    {\n        var c = pxs[y * 1080 + x];\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        float nSum = 0f; int nc = 0;\n        for (int dy = -3; dy <= 3; dy += 3)\n        for (int dx = -3; dx <= 3; dx += 3)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var n = pxs[(y + dy) * 1080 + (x + dx)];\n            nSum += (0.299f * n.r + 0.587f * n.g + 0.114f * n.b) / 255f;\n            nc++;\n        }\n        float avg = nSum / nc;\n        if (avg > 0.18f && lum < avg * 0.45f) brDark++;\n    }\n    sb.AppendLine(\"VERIFY BR seabed dark pixels AFTER shadow fix: \" + brDark);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\n\n// 3. Also inspect River/Coastal jumps safely across WorldTerrainField Sources\nvar mm = UnityEngine.Object.FindObjectOfType(typeof(MapManager)) as MapManager;\nvar bf = System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;\nvar wt = mm.GetTerrainField();\nvar srcs = wt.GetType().GetProperty(\"Sources\", bf).GetValue(wt, null) as System.Collections.IEnumerable;\nint sIdx = 0;\nforeach (var s in srcs)\n{\n    var t = s.GetType();\n    var kind = t.GetField(\"gridType\", bf).GetValue(s).ToString();\n    var org = (Vector2)t.GetProperty(\"WorldOrigin\", bf).GetValue(s, null);\n    var pad = Convert.ToSingle(t.GetProperty(\"SampleCachePadding\", bf).GetValue(s, null));\n    var cache = t.GetProperty(\"BuiltCache\", bf).GetValue(s, null) ?? t.GetMethod(\"GetOrCreateSampleCache\", bf).Invoke(s, new object[] { 6 });\n    var ct = cache.GetType();\n    int res = (int)ct.GetProperty(\"Resolution\").GetValue(cache, null);\n    float step = (float)ct.GetProperty(\"Step\").GetValue(cache, null);\n    float[] h = (float[])ct.GetProperty(\"Heights\").GetValue(cache, null);\n    float[] rc = (float[])ct.GetProperty(\"RiverCarveDepths\").GetValue(cache, null);\n    float[] sd = (float[])ct.GetProperty(\"ShoreDistances\").GetValue(cache, null);\n    float[] sc = (float[])ct.GetProperty(\"ShoreCurvatures\").GetValue(cache, null);\n    float[] mb = (float[])ct.GetProperty(\"MountainBoosts\").GetValue(cache, null);\n\n    float maxCoastJ = 0f; int cjX = 0, cjZ = 0;\n    float maxRivJ = 0f; int rjX = 0, rjZ = 0;\n    for (int z = 1; z < res - 1; z++)\n    for (int x = 1; x < res - 1; x++)\n    {\n        int i = z * res + x;\n        int[] nbs = new int[] { i + 1, i + res };\n        foreach (int nb in nbs)\n        {\n            float dh = Mathf.Abs(h[nb] - h[i]);\n            if (Mathf.Abs(rc[nb] - rc[i]) > 0.25f && dh > maxRivJ) { maxRivJ = dh; rjX = x; rjZ = z; }\n            if (Mathf.Abs(sc[nb] - sc[i]) > 0.015f && mb[i] < 0.01f && mb[nb] < 0.01f && dh > maxCoastJ) { maxCoastJ = dh; cjX = x; cjZ = z; }\n        }\n    }\n    if (maxCoastJ > 0.1f || maxRivJ > 0.1f)\n        sb.AppendLine(string.Format(\"src[{0}] {1} org={2} maxCoastJ={3:F3}@({4},{5}) [sd={6:F2},sc={7:F3}] maxRivJ={8:F3}@({9},{10}) [rc={11:F2}]\",\n            sIdx, kind, org, maxCoastJ, cjX, cjZ, sd[cjZ * res + cjX], sc[cjZ * res + cjX], maxRivJ, rjX, rjZ, rc[rjZ * res + rjX]));\n    sIdx++;\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"},"error":"Runtime error: Value cannot be null.\r\nParameter name: s"}
