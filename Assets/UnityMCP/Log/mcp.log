ache9, null);\nfloat[] bf9 = (float[])ct.GetProperty(\"BaseFields\", flags).GetValue(cache9, null);\nfloat[] sf9 = (float[])ct.GetProperty(\"SmoothFields\", flags).GetValue(cache9, null);\nfloat[] mb9 = (float[])ct.GetProperty(\"MountainBoosts\", flags).GetValue(cache9, null);\nfloat[] rc9 = (float[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache9, null);\nfloat[] sh9 = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache9, null);\nfloat[] sc9 = (float[])ct.GetProperty(\"ShoreCurvatures\", flags).GetValue(cache9, null);\nfloat[] hm9 = (float[])ct.GetProperty(\"HeadlandMasks\", flags).GetValue(cache9, null);\nvar tt9 = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache9, null);\n\nint scz = Mathf.RoundToInt((-60.833f - orig9.y + pad9) / step9);\nint scx = Mathf.RoundToInt((47.50f - orig9.x + pad9) / step9);\nsb.AppendLine(\"=== src[9] cache column at x=47.50 across z=-61.5..-60.0 ===\");\nfor (int dz = -4; dz <= 4; dz++)\n{\n    int idx = (scz + dz) * res9 + scx;\n    sb.AppendLine(string.Format(\"  wz={0,6:F2}: h={1:F3} bf={2:F3} sf={3:F3} mb={4:F3} hm={5:F3} sc={6:F3} rc={7:F3} sh={8:F2} tt={9}\",\n        orig9.y - pad9 + (scz + dz) * step9, h9[idx], bf9[idx], sf9[idx], mb9[idx], hm9[idx], sc9[idx], rc9[idx], sh9[idx], tt9.GetValue(idx)));\n}\n\n// 3. Also check ALL 8 Island Meshes for ANY hard step (|dh| > 0.15) specifically on GRASS (TerrainType.Land or Hill or Mountain) AND trace connected chain!\n// Wait: trace where hardStep points on Island 31 (in x=25..55, z=-64..-44) lie by printing 0.33m ASCII map of max(|dy|) in Island 31 bay!\nsb.AppendLine(\"=== Island 31 Bay x=26..52, z=-62..-48 max(|dh|) in 1 sample ('.'<0.05, '+' 0.05..0.15, '#' >=0.15) ===\");\nfor (int wz = 0; wz <= 42; wz++)\n{\n    float zf = -48f - wz / 3f;\n    int mz = Mathf.RoundToInt((zf + 90f) * 6f);\n    sb.Append(string.Format(\"z={0,6:F2}: \", zf));\n    for (int wx = 0; wx <= 78; wx++)\n    {\n        float xf = 26f + wx / 3f;\n        int mx = Mathf.RoundToInt(xf * 6f);\n        float maxD = 0f;\n        for (int oz = 0; oz <= 1; oz++)\n            for (int ox = 0; ox <= 1; ox++)\n            {\n                int idx = (mz + oz) * side + (mx + ox);\n                float y = v[idx].y;\n                float d = Mathf.Max(\n                    Mathf.Max(Mathf.Abs(y - v[idx - 1].y), Mathf.Abs(y - v[idx + 1].y)),\n                    Mathf.Max(Mathf.Abs(y - v[idx - side].y), Mathf.Abs(y - v[idx + side].y)));\n                if (d > maxD) maxD = d;\n            }\n        sb.Append(maxD >= 0.15f ? '#' : (maxD >= 0.06f ? '+' : (v[mz * side + mx].y < 0.05f ? '~' : '.')));\n    }\n    sb.AppendLine(\"\");\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
