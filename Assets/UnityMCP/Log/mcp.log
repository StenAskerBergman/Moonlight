{"ts":"2026-11-15T20:19:17.341Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":48606,"action":"execute","params":{"action":"execute","code":"string dir = \"C:/Users/stena/.gemini/antigravity/brain/80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0/scratch\";\nvar sb = new System.Text.StringBuilder();\n\n// 1. Update CameraRig serialized scene values\nvar rig = UnityEngine.Object.FindObjectOfType<CameraRig>();\nif (rig != null)\n{\n    rig.normalSpeed = 42f;\n    rig.fastSpeed = 90f;\n    rig.movementSpeed = 42f;\n    rig.movementTime = 12f;\n    rig.rotationAmount = 90f;\n    rig.enableAltDragPan = true;\n    EditorUtility.SetDirty(rig);\n    var mainCam = rig.cameraTransform != null ? rig.cameraTransform.GetComponent<Camera>() : null;\n    if (mainCam != null && mainCam.farClipPlane < 1400f)\n    {\n        mainCam.farClipPlane = 1400f;\n        EditorUtility.SetDirty(mainCam);\n    }\n}\n\n// 2. Regenerate Map (which also creates InfiniteOceanHorizon + InfiniteAbyssFloor + calls GameBorder.FitToGeneratedMap())\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nmm.RegenerateMap();\n\nvar gb = UnityEngine.Object.FindObjectOfType<GameBorder>();\nif (gb != null)\n{\n    gb.autoFitToGeneratedMap = true;\n    gb.margin = 20f;\n    gb.xOff = 0f;\n    gb.zOff = 0f;\n    gb.FitToGeneratedMap();\n    EditorUtility.SetDirty(gb);\n    sb.AppendLine(\"GameBorder fitted: center=\" + gb.worldCenter + \" _range=\" + gb._range);\n}\n\nvar ioh = GameObject.Find(\"Infinite Ocean Horizon\");\nvar iaf = GameObject.Find(\"Infinite Abyss Floor\");\nsb.AppendLine(\"InfiniteOceanHorizon=\" + (ioh != null ? ioh.GetComponent<MeshRenderer>().bounds.ToString() : \"NULL\"));\nsb.AppendLine(\"InfiniteAbyssFloor=\" + (iaf != null ? iaf.GetComponent<MeshRenderer>().bounds.ToString() : \"NULL\"));\n\n// 3. Configure surface horizon fog for Edit Mode & Play Mode\nRenderSettings.fog = true;\nRenderSettings.fogMode = FogMode.Linear;\nRenderSettings.fogColor = new Color(0.71f, 0.80f, 0.88f, 1f);\nRenderSettings.fogStartDistance = 230f;\nRenderSettings.fogEndDistance = 920f;\n\n// 4. Render Surface Horizon, Underwater Horizon, and Top-Down verification!\nvar utsType = System.Type.GetType(\"Moonlight.Rendering.UnderwaterTransitionState, Assembly-CSharp\");\nvar ocean = GameObject.Find(\"Ocean Cube - Water Cube\");\nbool oceanWasActive = ocean != null && ocean.activeSelf;\n\nGameObject camGo = new GameObject(\"__TEMP_HorizonVerify\");\ntry\n{\n    var cam = camGo.AddComponent<Camera>();\n    cam.farClipPlane = 1400f;\n    cam.fieldOfView = 60f;\n\n    // A) Surface horizon view looking out past Northeast corner from above Plateau 49\n    cam.transform.position = new Vector3(95f, 18f, 95f);\n    cam.transform.rotation = Quaternion.Euler(14f, 45f, 0f);\n    var rt1 = new RenderTexture(1280, 720, 24);\n    cam.targetTexture = rt1;\n    cam.Render();\n    RenderTexture.active = rt1;\n    var tex1 = new Texture2D(1280, 720, TextureFormat.RGB24, false);\n    tex1.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0);\n    tex1.Apply();\n    System.IO.File.WriteAllBytes(dir + \"/diag_surface_horizon.png\", tex1.EncodeToPNG());\n    UnityEngine.Object.DestroyImmediate(tex1);\n    RenderTexture.active = null;\n    cam.targetTexture = null;\n    rt1.Release();\n    UnityEngine.Object.DestroyImmediate(rt1);\n\n    // B) Underwater view looking outward over outer plateau edge (disable linear surface fog during underwater render)\n    RenderSettings.fog = false;\n    if (utsType != null)\n    {\n        var bf = System.Reflection.BindingFlags.Static | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n        utsType.GetField(\"TargetCamera\", bf).SetValue(null, cam);\n        utsType.GetField(\"UnderwaterAmount\", bf).SetValue(null, 1f);\n        utsType.GetField(\"WaterLevel\", bf).SetValue(null, -0.5f);\n        utsType.GetField(\"FogDensity\", bf).SetValue(null, 0.0115f);\n        utsType.GetField(\"DeepDepthThreshold\", bf).SetValue(null, 24f);\n        utsType.GetField(\"AbyssDepthThreshold\", bf).SetValue(null, 44f);\n        utsType.GetField(\"SunDepthExtinction\", bf).SetValue(null, 0.024f);\n        utsType.GetField(\"CausticsFadeDepth\", bf).SetValue(null, 38f);\n    }\n    cam.fieldOfView = 67f;\n    cam.transform.position = new Vector3(110f, -6f, 110f);\n    cam.transform.rotation = Quaternion.Euler(28f, 45f, 0f);\n    var rt2 = new RenderTexture(1280, 720, 24);\n    cam.targetTexture = rt2;\n    cam.Render();\n    RenderTexture.active = rt2;\n    var tex2 = new Texture2D(1280, 720, TextureFormat.RGB24, false);\n    tex2.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0);\n    tex2.Apply();\n    System.IO.File.WriteAllBytes(dir + \"/diag_uw_horizon.png\", tex2.EncodeToPNG());\n    UnityEngine.Object.DestroyImmediate(tex2);\n    RenderTexture.active = null;\n    cam.targetTexture = null;\n    rt2.Release();\n    UnityEngine.Object.DestroyImmediate(rt2);\n\n    // Reset underwater state before topdown\n    if (utsType != null)\n        utsType.GetMethod(\"Reset\", System.Reflection.BindingFlags.Static | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public).Invoke(null, null);\n\n    // C) Top-down map view (ocean hidden temporarily to verify zero island/skirt slivers)\n    if (ocean != null) ocean.SetActive(false);\n    if (ioh != null) ioh.SetActive(false);\n    cam.orthographic = true;\n    cam.orthographicSize = 185f;\n    cam.transform.position = new Vector3(0f, 80f, 0f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    var rt3 = new RenderTexture(1024, 1024, 24);\n    cam.targetTexture = rt3;\n    cam.Render();\n    RenderTexture.active = rt3;\n    var tex3 = new Texture2D(1024, 1024, TextureFormat.RGB24, false);\n    tex3.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\n    tex3.Apply();\n    System.IO.File.WriteAllBytes(dir + \"/diag_verify_topdown.png\", tex3.EncodeToPNG());\n    UnityEngine.Object.DestroyImmediate(tex3);\n    RenderTexture.active = null;\n    cam.targetTexture = null;\n    rt3.Release();\n    UnityEngine.Object.DestroyImmediate(rt3);\n}\nfinally\n{\n    if (utsType != null)\n        utsType.GetMethod(\"Reset\", System.Reflection.BindingFlags.Static | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public).Invoke(null, null);\n    if (ocean != null) ocean.SetActive(oceanWasActive);\n    if (ioh != null) ioh.SetActive(true);\n    RenderSettings.fog = true;\n    RenderSettings.fogMode = FogMode.Linear;\n    RenderSettings.fogColor = new Color(0.71f, 0.80f, 0.88f, 1f);\n    RenderSettings.fogStartDistance = 230f;\n    RenderSettings.fogEndDistance = 920f;\n    UnityEngine.Object.DestroyImmediate(camGo);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
