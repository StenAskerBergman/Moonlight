{"ts":"2026-11-15T18:51:35.025Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":9512,"action":"execute","params":{"action":"execute","code":"Func<string, Color32[]> loadTex = null;\nint srcW = 1024, srcH = 1024;\nFunc<string, int[], Color32[]> loadPixels = (path, dims) => {\n    var t = new Texture2D(2, 2, TextureFormat.RGBA32, false);\n    t.LoadImage(System.IO.File.ReadAllBytes(path));\n    dims[0] = t.width; dims[1] = t.height;\n    var p = t.GetPixels32();\n    UnityEngine.Object.DestroyImmediate(t);\n    return p;\n};\n\nstring quayScratch = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\quay_src\\\";\nstring depotTexDir = @\"e:\\GitHub\\Moonlight\\Assets\\Textures\\Buildings\\Depot\\\";\n\nint[] dConc = new int[2], dConcN = new int[2], dConcAo = new int[2];\nint[] dStone = new int[2], dStoneN = new int[2];\nint[] dTile = new int[2], dTileN = new int[2];\nint[] dBrass = new int[2], dBrassN = new int[2];\n\nvar pConc   = loadPixels(quayScratch + \"concrete_0008_color.jpg\", dConc);\nvar pConcN  = loadPixels(quayScratch + \"concrete_0008_normal.png\", dConcN);\nvar pConcAo = loadPixels(quayScratch + \"concrete_0008_ao.jpg\", dConcAo);\nvar pStone  = loadPixels(quayScratch + \"stone_0031_color.jpg\", dStone);\nvar pStoneN = loadPixels(quayScratch + \"stone_0031_normal.png\", dStoneN);\nvar pTile   = loadPixels(depotTexDir + \"Depot_Paving_Albedo.jpg\", dTile);\nvar pTileN  = loadPixels(depotTexDir + \"Depot_Paving_Normal.png\", dTileN);\nvar pBrass  = loadPixels(depotTexDir + \"Depot_Brass_Albedo.jpg\", dBrass);\nvar pBrassN = loadPixels(depotTexDir + \"Depot_Brass_Normal.png\", dBrassN);\n\nFunc<Color32[], int[], float, float, Color> sample = (arr, dims, u, v) => {\n    u = u - Mathf.Floor(u);\n    v = v - Mathf.Floor(v);\n    float fx = u * dims[0];\n    float fy = v * dims[1];\n    int x0 = ((int)fx) % dims[0]; if (x0 < 0) x0 += dims[0];\n    int y0 = ((int)fy) % dims[1]; if (y0 < 0) y0 += dims[1];\n    int x1 = (x0 + 1) % dims[0];\n    int y1 = (y0 + 1) % dims[1];\n    float tx = fx - Mathf.Floor(fx), ty = fy - Mathf.Floor(fy);\n    Color c00 = arr[y0 * dims[0] + x0];\n    Color c10 = arr[y0 * dims[0] + x1];\n    Color c01 = arr[y1 * dims[0] + x0];\n    Color c11 = arr[y1 * dims[0] + x1];\n    return Color.Lerp(Color.Lerp(c00, c10, tx), Color.Lerp(c01, c11, tx), ty);\n};\n\nFunc<Color, float, float, Color> tiltNormal = (nc, nxAdd, nyAdd) => {\n    float nx = nc.r * 2f - 1f + nxAdd;\n    float ny = nc.g * 2f - 1f + nyAdd;\n    float nz = Mathf.Max(0.15f, nc.b * 2f - 1f);\n    Vector3 v = new Vector3(nx, ny, nz).normalized;\n    return new Color(v.x * 0.5f + 0.5f, v.y * 0.5f + 0.5f, v.z * 0.5f + 0.5f, 1f);\n};\n\nint W = 2048, H = 2048;\nvar outA = new Color32[W * H];\nvar outN = new Color32[W * H];\nColor32 bgA = new Color32(48, 52, 54, 255);\nColor32 bgN = new Color32(128, 128, 255, 255);\nfor (int i = 0; i < outA.Length; i++) { outA[i] = bgA; outN[i] = bgN; }\n\nvar layout = new QuaySystem.AtlasLayout();\nAction<Rect, int, Func<float, float, int, int, Color[]>> fillRegion = (uv, pad, evalFn) => {\n    int x0 = Mathf.Clamp(Mathf.FloorToInt(uv.xMin * W), 0, W - 1);\n    int x1 = Mathf.Clamp(Mathf.CeilToInt(uv.xMax * W) - 1, 0, W - 1);\n    int y0 = Mathf.Clamp(Mathf.FloorToInt(uv.yMin * H), 0, H - 1);\n    int y1 = Mathf.Clamp(Mathf.CeilToInt(uv.yMax * H) - 1, 0, H - 1);\n    int rw = Mathf.Max(1, x1 - x0);\n    int rh = Mathf.Max(1, y1 - y0);\n    for (int y = Mathf.Max(0, y0 - pad); y <= Mathf.Min(H - 1, y1 + pad); y++)\n    {\n        int py = Mathf.Clamp(y, y0, y1);\n        float ty = (py - y0) / (float)rh;\n        for (int x = Mathf.Max(0, x0 - pad); x <= Mathf.Min(W - 1, x1 + pad); x++)\n        {\n            int px = Mathf.Clamp(x, x0, x1);\n            float tx = (px - x0) / (float)rw;\n            Color[] pair = evalFn(tx, ty, x - x0, y - y0);\n            int idx = y * W + x;\n            outA[idx] = (Color32)pair[0];\n            outN[idx] = (Color32)pair[1];\n        }\n    }\n};\n\nColor[] pairBuf = new Color[2];\n\n// 1. Coping: bright dressed beveled concrete blocks\nfillRegion(layout.coping, 6, (tx, ty, px, py) => {\n    float su = tx * 6f, sv = ty * 0.5f;\n    Color c = sample(pConc, dConc, su, sv) * (0.92f + 0.14f * sample(pConcAo, dConcAo, su, sv).r);\n    Color n = sample(pConcN, dConcN, su, sv);\n    c = Color.Lerp(c, new Color(0.68f, 0.69f, 0.66f, 1f), 0.35f);\n    // Segmented stone block vertical seams & top/bottom bevel\n    float uBlock = su - Mathf.Floor(su);\n    float seam = Mathf.Min(uBlock, 1f - uBlock);\n    float ny = 0f, nx = 0f;\n    if (seam < 0.035f) { c *= 0.62f; nx = (uBlock < 0.5f ? 0.55f : -0.55f); }\n    if (ty < 0.12f) { c *= 0.72f; ny = -0.5f; }\n    else if (ty > 0.88f) { c *= 1.06f; ny = 0.45f; }\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = tiltNormal(n, nx, ny);\n    return pairBuf;\n});\n\n// 2. Banded header course under coping\nfillRegion(layout.band, 6, (tx, ty, px, py) => {\n    float su = tx * 6f + 0.25f, sv = ty * 0.55f + 0.2f;\n    Color c = sample(pConc, dConc, su, sv) * new Color(0.56f, 0.58f, 0.57f, 1f);\n    Color n = sample(pConcN, dConcN, su, sv);\n    float uBlock = (tx * 12f) - Mathf.Floor(tx * 12f);\n    float seam = Mathf.Min(uBlock, 1f - uBlock);\n    float nx = 0f, ny = 0f;\n    if (seam < 0.045f) { c *= 0.58f; nx = (uBlock < 0.5f ? 0.6f : -0.6f); }\n    if (ty > 0.85f) { c *= 0.55f; ny = -0.6f; }\n    else if (ty < 0.15f) { c *= 0.68f; ny = 0.4f; }\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = tiltNormal(n, nx, ny);\n    return pairBuf;\n});\n\n// 3. Deck plating: tiled concrete paving + industrial darksteel seam + worn brass/gold safety trim\nfillRegion(layout.deck, 6, (tx, ty, px, py) => {\n    Color baseTile = sample(pTile, dTile, tx * 1.75f, ty * 1.0f);\n    Color tileN = sample(pTileN, dTileN, tx * 1.75f, ty * 1.0f);\n    Color c = baseTile * new Color(0.76f, 0.78f, 0.79f, 1f);\n    Color n = tileN;\n    float ex = Mathf.Min(tx, 1f - tx);\n    float ey = Mathf.Min(ty, 1f - ty);\n    float eDist = Mathf.Min(ex, ey);\n    float nx = 0f, ny = 0f;\n    if (eDist < 0.028f)\n    {\n        c *= 0.42f;\n    }\n    else if (eDist < 0.068f)\n    {\n        Color br = sample(pBrass, dBrass, tx * 1.5f, ty * 1.5f);\n        c = Color.Lerp(br * new Color(0.72f, 0.58f, 0.30f, 1f), c, 0.25f);\n        n = sample(pBrassN, dBrassN, tx * 1.5f, ty * 1.5f);\n        if (Mathf.Abs(ex - ey) < 0.001f) {}\n        if (ex < ey) nx = tx < 0.5f ? -0.35f : 0.35f; else ny = ty < 0.5f ? -0.35f : 0.35f;\n    }\n    else if (eDist < 0.088f)\n    {\n        c *= 0.58f;\n        if (ex < ey) nx = tx < 0.5f ? 0.45f : -0.45f; else ny = ty < 0.5f ? 0.45f : -0.45f;\n    }\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = tiltNormal(n, nx, ny);\n    return pairBuf;\n});\n\n// 4. Recessed vertical concrete wall bay with ribs and tidal staining near bottom\nfillRegion(layout.wallBay, 6, (tx, ty, px, py) => {\n    float su = tx * 1.1f, sv = ty * 2.5f;\n    Color c = sample(pConc, dConc, su, sv) * sample(pConcAo, dConcAo, su, sv).r;\n    Color n = sample(pConcN, dConcN, su, sv);\n    c *= new Color(0.46f, 0.49f, 0.47f, 1f);\n    // Vertical industrial shuttering ribs & recessed center shadow\n    float ribPhase = tx * 3f - Mathf.Floor(tx * 3f);\n    float nx = 0f, ny = 0f;\n    if (ribPhase < 0.12f || ribPhase > 0.88f) { c *= 0.72f; nx = ribPhase < 0.5f ? -0.45f : 0.45f; }\n    // Recessed horizontal panel joint mid-height\n    if (Mathf.Abs(ty - 0.52f) < 0.025f) { c *= 0.62f; ny = ty > 0.52f ? -0.45f : 0.45f; }\n    // Tidal grime & algae gradient on lower third (waterline)\n    float algae = Mathf.SmoothStep(0.45f, 0.02f, ty);\n    c = Color.Lerp(c, c * new Color(0.45f, 0.54f, 0.36f, 1f), algae * 0.8f);\n    // Side ambient shadow near buttresses\n    float sideEdge = Mathf.Min(tx, 1f - tx);\n    c *= Mathf.Lerp(0.58f, 1.0f, Mathf.SmoothStep(0f, 0.14f, sideEdge));\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = tiltNormal(n, nx, ny);\n    return pairBuf;\n});\n\n// 5. Buttress rib column: brighter weathered concrete pier with central chamfer ridge & bevels\nfillRegion(layout.buttress, 6, (tx, ty, px, py) => {\n    float su = tx * 0.9f + 0.3f, sv = ty * 2.5f;\n    Color c = sample(pConc, dConc, su, sv) * (0.88f + 0.12f * sample(pConcAo, dConcAo, su, sv).r);\n    Color n = sample(pConcN, dConcN, su, sv);\n    c *= new Color(0.76f, 0.76f, 0.72f, 1f);\n    float nx = 0f, ny = 0f;\n    // Chamfered architectural pier faces\n    if (tx < 0.18f) { c *= 0.68f; nx = -0.55f; }\n    else if (tx > 0.82f) { c *= 0.68f; nx = 0.55f; }\n    else if (Mathf.Abs(tx - 0.5f) < 0.12f) { c *= 1.07f; nx = (tx - 0.5f) * 1.8f; }\n    // Base flare joint\n    if (ty < 0.25f) { c = Color.Lerp(c, c * new Color(0.50f, 0.56f, 0.44f, 1f), Mathf.SmoothStep(0.25f, 0.0f, ty)); }\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = tiltNormal(n, nx, ny);\n    return pairBuf;\n});\n\n// 6. Submerged stone/rubble foundation footing (rock)\nfillRegion(layout.rock, 6, (tx, ty, px, py) => {\n    float su = tx * 4f, sv = ty * 1.5f;\n    Color c = sample(pStone, dStone, su, sv);\n    Color n = sample(pStoneN, dStoneN, su, sv);\n    float wet = Mathf.Lerp(0.32f, 0.68f, ty);\n    c *= new Color(wet * 0.85f, wet * 0.92f, wet * 0.78f, 1f);\n    pairBuf[0] = new Color(c.r, c.g, c.b, 1f);\n    pairBuf[1] = n;\n    return pairBuf;\n});\n\nvar texA = new Texture2D(W, H, TextureFormat.RGBA32, false);\ntexA.SetPixels32(outA);\ntexA.Apply(false, false);\nvar texN = new Texture2D(W, H, TextureFormat.RGBA32, false);\ntexN.SetPixels32(outN);\ntexN.Apply(false, false);\n\nstring outAlbedoAsset = \"Assets/Game Assets/Quay/Quay_Atlas_Albedo.png\";\nstring outNormalAsset = \"Assets/Game Assets/Quay/Quay_Atlas_Normal.png\";\nSystem.IO.File.WriteAllBytes(outAlbedoAsset, texA.EncodeToPNG());\nSystem.IO.File.WriteAllBytes(outNormalAsset, texN.EncodeToPNG());\nSystem.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\quay_atlas_albedo_preview.png\", texA.EncodeToPNG());\n\nUnityEngine.Object.DestroyImmediate(texA);\nUnityEngine.Object.DestroyImmediate(texN);\n\nUnityEditor.AssetDatabase.ImportAsset(outAlbedoAsset, UnityEditor.ImportAssetOptions.ForceUpdate);\nUnityEditor.AssetDatabase.ImportAsset(outNormalAsset, UnityEditor.ImportAssetOptions.ForceUpdate);\n\nvar impA = UnityEditor.AssetImporter.GetAtPath(outAlbedoAsset) as UnityEditor.TextureImporter;\nif (impA != null) { impA.sRGBTexture = true; impA.maxTextureSize = 2048; impA.anisoLevel = 4; impA.wrapMode = TextureWrapMode.Clamp; impA.SaveAndReimport(); }\nvar impN = UnityEditor.AssetImporter.GetAtPath(outNormalAsset) as UnityEditor.TextureImporter;\nif (impN != null) { impN.textureType = UnityEditor.TextureImporterType.NormalMap; impN.sRGBTexture = false; impN.maxTextureSize = 2048; impN.anisoLevel = 4; impN.wrapMode = TextureWrapMode.Clamp; impN.SaveAndReimport(); }\n\n// Also set NormalMap import on extracted Depot normal textures\nstring[] depotFiles = System.IO.Directory.GetFiles(depotTexDir);\nforeach (var df in depotFiles)\n{\n    string rel = \"Assets\" + df.Substring(@\"e:\\GitHub\\Moonlight\\Assets\".Length).Replace(\"\\\\\", \"/\");\n    if (rel.EndsWith(\".meta\")) continue;\n    UnityEditor.AssetDatabase.ImportAsset(rel, UnityEditor.ImportAssetOptions.ForceUpdate);\n    var imp = UnityEditor.AssetImporter.GetAtPath(rel) as UnityEditor.TextureImporter;\n    if (imp != null)\n    {\n        imp.maxTextureSize = 1024;\n        imp.anisoLevel = 4;\n        if (rel.Contains(\"_Normal.\"))\n        {\n            imp.textureType = UnityEditor.TextureImporterType.NormalMap;\n            imp.sRGBTexture = false;\n        }\n        else\n        {\n            imp.sRGBTexture = true;\n        }\n        imp.SaveAndReimport();\n    }\n}\n\n// Wire Quay Structure.mat\nvar quayMat = UnityEditor.AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\nvar alTex = UnityEditor.AssetDatabase.LoadAssetAtPath<Texture2D>(outAlbedoAsset);\nvar nmTex = UnityEditor.AssetDatabase.LoadAssetAtPath<Texture2D>(outNormalAsset);\nif (quayMat != null && alTex != null && nmTex != null)\n{\n    quayMat.SetTexture(\"_BaseMap\", alTex);\n    quayMat.SetTexture(\"_MainTex\", alTex);\n    quayMat.SetTexture(\"_BumpMap\", nmTex);\n    quayMat.SetFloat(\"_BumpScale\", 0.9f);\n    quayMat.SetFloat(\"_Smoothness\", 0.32f);\n    quayMat.SetFloat(\"_Metallic\", 0.08f);\n    quayMat.SetFloat(\"_EnvironmentReflections\", 1f);\n    quayMat.EnableKeyword(\"_NORMALMAP\");\n    UnityEditor.EditorUtility.SetDirty(quayMat);\n    UnityEditor.AssetDatabase.SaveAssets();\n}\nreturn \"Quay Atlas & Depot Textures Imported Successfully\";","safety_checks":true,"compiler":"codedom"}}
