{"ts":"2026-11-15T18:26:50.444Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2068,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeDbg\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    foreach (Transform ch in clone.GetComponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n\n    // List ALL Renderers in clone hierarchy!\n    foreach (var r in clone.GetComponentsInChildren<Renderer>(true))\n        sb.AppendLine(\"Renderer: \" + r.name + \" enabled=\" + r.enabled + \" mat=\" + (r.sharedMaterial != null ? r.sharedMaterial.name : \"null\") + \" bounds=\" + r.bounds);\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mat = mr.sharedMaterial;\n    camGo = new GameObject(\"__ProbeDbgCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    // 1) _DebugView = 1 with _BaseMap = whiteTexture AND _BaseMap in MPB too\n    var testMat = new Material(mat);\n    testMat.SetFloat(\"_DebugView\", 1f);\n    testMat.SetTexture(\"_BaseMap\", Texture2D.whiteTexture);\n    mr.sharedMaterial = testMat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    var pxs = tex.GetPixels32();\n    Color32 minC = new Color32(255,255,255,255);\n    int darkUnder200 = 0;\n    Vector2Int minXY = Vector2Int.zero;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        if (c.r + c.g + c.b < 200) darkUnder200++;\n        if (c.r + c.g + c.b < minC.r + minC.g + minC.b) { minC = c; minXY = new Vector2Int(x, y); }\n    }\n    sb.AppendLine(string.Format(\"_DebugView=1 box(148..193,6..28): dark<200={0} minC=({1},{2},{3}) at ({4},{5})\",\n        darkUnder200, minC.r, minC.g, minC.b, minXY.x, minXY.y));\n\n    // Also test what shader Renderers draw! What if Generated Foliage/Water wasn't it — test disabling ALL children of clone!\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    // Now test baseline TerrainSplatNormal WITH children disabled:\n    mr.sharedMaterial = mat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    pxs = tex.GetPixels32();\n    minC = new Color32(255,255,255,255); darkUnder200 = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        if (c.r + c.g + c.b < 140) darkUnder200++;\n        if (c.r + c.g + c.b < minC.r + minC.g + minC.b) { minC = c; minXY = new Vector2Int(x, y); }\n    }\n    sb.AppendLine(string.Format(\"NoChildren TerrainSplatNormal box: dark<140={0} minC=({1},{2},{3}) at ({4},{5})\",\n        darkUnder200, minC.r, minC.g, minC.b, minXY.x, minXY.y));\n\n    // Wait check ONE MORE THING: what about _DebugView=1 with children disabled?\n    mr.sharedMaterial = testMat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    pxs = tex.GetPixels32();\n    minC = new Color32(255,255,255,255); darkUnder200 = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        if (c.r + c.g + c.b < 700) darkUnder200++;\n        if (c.r + c.g + c.b < minC.r + minC.g + minC.b) { minC = c; minXY = new Vector2Int(x, y); }\n    }\n    sb.AppendLine(string.Format(\"NoChildren _DebugView=1 box: nonwhite={0} minC=({1},{2},{3}) at ({4},{5})\",\n        darkUnder200, minC.r, minC.g, minC.b, minXY.x, minXY.y));\n\n    // Also test Universal Render Pipeline/Lit WITH NO COLOR OVERRIDE vs WITH Texture2D.whiteTexture AND compare!\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    sb.AppendLine(\"MPB has _BaseMap? \" + (mpb.GetTexture(\"_BaseMap\") != null ? mpb.GetTexture(\"_BaseMap\").name : \"null\"));\n\n    mr.sharedMaterial = mat;\n    UnityEngine.Object.DestroyImmediate(testMat);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
