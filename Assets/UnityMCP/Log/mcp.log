{"ts":"2026-11-15T18:22:47.947Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2242,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject camGo = GameObject.Find(\"__ProbeCam2\");\nif (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\ncamGo = new GameObject(\"__ProbeCam2\");\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    var mr = i31.GetComponent<MeshRenderer>();\n    var mf = i31.GetComponent<MeshFilter>();\n    var mesh = mf.sharedMesh;\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var ctrlTex = mpb.GetTexture(\"_Control\") as Texture2D;\n    var tintTex = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n    var regTex = mpb.GetTexture(\"_RegionMask\") as Texture2D;\n    sb.AppendLine(string.Format(\"i31 pos={0} bounds={1} meshVerts={2} ctrl={3} tint={4} reg={5}\",\n        i31.transform.position, mr.bounds, mesh != null ? mesh.vertexCount : -1,\n        ctrlTex != null ? ctrlTex.width + \"x\" + ctrlTex.height + \" fmt=\" + ctrlTex.format : \"null\",\n        tintTex != null ? tintTex.width + \"x\" + tintTex.height : \"null\",\n        regTex != null ? regTex.width + \"x\" + regTex.height : \"null\"));\n\n    var verts = mesh.vertices;\n    var norms = mesh.normals;\n    var uvs = mesh.uv;\n    int weirdNorm = 0;\n    for (int i = 0; i < norms.Length; i++)\n    {\n        if (norms[i].y < 0.05f || float.IsNaN(norms[i].x))\n        {\n            weirdNorm++;\n            if (weirdNorm <= 10)\n                sb.AppendLine(string.Format(\"weirdNorm v[{0}]={1} n={2} uv={3}\", i, verts[i], norms[i], uvs[i]));\n        }\n    }\n    sb.AppendLine(\"weirdNorm total=\" + weirdNorm);\n\n    // Match probe_i31_bay camera angle (southern bay of Island 31: i31 origin is (0,-90) roughly; find where bay sits)\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = false;\n    cam.fieldOfView = 45f;\n    // South bay center: i31 origin + (45, 0, 22), look from south-ish oblique like probe_i31_bay\n    Vector3 target = new Vector3(i31.transform.position.x + 48f, 1.5f, i31.transform.position.z + 25f);\n    cam.transform.position = target + new Vector3(0f, 18f, -18f);\n    cam.transform.LookAt(target);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << i31.layer;\n\n    rt = new RenderTexture(1024, 1024, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    cam.Render();\n\n    RenderTexture.active = rt;\n    tex = new Texture2D(1024, 1024, TextureFormat.RGBA32, false);\n    tex.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n\n    var px = tex.GetPixels32();\n    int darkCount = 0;\n    var hitCoords = new System.Collections.Generic.List<Vector3>();\n    var mc = i31.GetComponent<MeshCollider>();\n    for (int py = 4; py < 1020; py++)\n    {\n        for (int pxx = 4; pxx < 1020; pxx++)\n        {\n            var c = px[py * 1024 + pxx];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nSum = 0f; int nCnt = 0;\n            for (int dy = -3; dy <= 3; dy += 3)\n            for (int dx = -3; dx <= 3; dx += 3)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var nc = px[(py + dy) * 1024 + (pxx + dx)];\n                if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n                nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n                nCnt++;\n            }\n            if (nCnt >= 6)\n            {\n                float avg = nSum / nCnt;\n                if (avg > 0.15f && lum < avg * 0.45f)\n                {\n                    darkCount++;\n                    if (hitCoords.Count < 15)\n                    {\n                        Ray ray = cam.ScreenPointToRay(new Vector3(pxx + 0.5f, py + 0.5f, 0f));\n                        RaycastHit hit;\n                        if (mc != null && mc.Raycast(ray, out hit, 200f))\n                            hitCoords.Add(hit.point);\n                    }\n                }\n            }\n        }\n    }\n    sb.AppendLine(\"Bay dark pixels (<0.45x avg): \" + darkCount);\n\n    // Now render WITHOUT SSAO\n    var rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\n    var rendererDataListField = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);\n    var rList = rendererDataListField.GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\n    UnityEngine.Rendering.Universal.ScriptableRendererFeature ssao = null;\n    if (rList != null && rList.Length > 0)\n    {\n        foreach (var f in rList[0].rendererFeatures)\n        {\n            if (f != null && f.GetType().Name.Contains(\"AmbientOcclusion\")) { ssao = f; break; }\n        }\n    }\n    if (ssao != null)\n    {\n        bool prevActive = ssao.isActive;\n        ssao.SetActive(false);\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        ssao.SetActive(prevActive);\n        var px2 = tex.GetPixels32();\n        int darkNoSSAO = 0;\n        for (int py = 4; py < 1020; py++)\n        for (int pxx = 4; pxx < 1020; pxx++)\n        {\n            var c = px2[py * 1024 + pxx];\n            if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nSum = 0f; int nCnt = 0;\n            for (int dy = -3; dy <= 3; dy += 3)\n            for (int dx = -3; dx <= 3; dx += 3)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var nc = px2[(py + dy) * 1024 + (pxx + dx)];\n                if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n                nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n                nCnt++;\n            }\n            if (nCnt >= 6 && (nSum / nCnt) > 0.15f && lum < (nSum / nCnt) * 0.45f) darkNoSSAO++;\n        }\n        sb.AppendLine(\"Bay dark pixels WITHOUT SSAO: \" + darkNoSSAO);\n    }\n\n    if (ctrlTex != null && tintTex != null && hitCoords.Count > 0)\n    {\n        var crt = new RenderTexture(ctrlTex.width, ctrlTex.height, 0, RenderTextureFormat.ARGB32);\n        Graphics.Blit(ctrlTex, crt);\n        RenderTexture.active = crt;\n        var rCtrl = new Texture2D(ctrlTex.width, ctrlTex.height, TextureFormat.RGBA32, false);\n        rCtrl.ReadPixels(new Rect(0, 0, ctrlTex.width, ctrlTex.height), 0, 0);\n        rCtrl.Apply();\n\n        var trt = new RenderTexture(tintTex.width, tintTex.height, 0, RenderTextureFormat.ARGB32);\n        Graphics.Blit(tintTex, trt);\n        RenderTexture.active = trt;\n        var rTint = new Texture2D(tintTex.width, tintTex.height, TextureFormat.RGBA32, false);\n        rTint.ReadPixels(new Rect(0, 0, tintTex.width, tintTex.height), 0, 0);\n        rTint.Apply();\n        RenderTexture.active = null;\n\n        int sampleHits = Mathf.Min(8, hitCoords.Count);\n        for (int k = 0; k < sampleHits; k++)\n        {\n            Vector3 lp = i31.transform.InverseTransformPoint(hitCoords[k]);\n            int tx = Mathf.Clamp(Mathf.RoundToInt(lp.x / 90f * (ctrlTex.width - 1)), 1, ctrlTex.width - 2);\n            int tz = Mathf.Clamp(Mathf.RoundToInt(lp.z / 90f * (ctrlTex.height - 1)), 1, ctrlTex.height - 2);\n            sb.AppendLine(string.Format(\"Hit#{0} w={1:F2} l=({2:F2},{3:F3},{4:F2}) px=({5},{6}): ctrl={7} tint={8}\",\n                k, hitCoords[k], lp.x, lp.y, lp.z, tx, tz, rCtrl.GetPixel(tx, tz), rTint.GetPixel(tx, tz)));\n        }\n        UnityEngine.Object.DestroyImmediate(crt);\n        UnityEngine.Object.DestroyImmediate(trt);\n        UnityEngine.Object.DestroyImmediate(rCtrl);\n        UnityEngine.Object.DestroyImmediate(rTint);\n    }\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
