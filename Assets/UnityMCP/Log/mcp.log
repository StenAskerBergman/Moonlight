\n// Verify Step 2b: Camera Rig, Main Camera, Camera Target, Boat, Submarine\nGameObject camRig = GameObject.Find(\"Camera Rig\");\nif (camRig != null)\n{\n    sb.AppendLine(\"=== Camera Rig ===\");\n    sb.AppendLine(\"  MeshFilter=\" + (camRig.GetComponent<MeshFilter>() != null) + \" MeshRenderer=\" + (camRig.GetComponent<MeshRenderer>() != null));\n    Transform mc = camRig.transform.Find(\"Main Camera\");\n    int mcMissing = 0;\n    foreach (Component c in mc.GetComponents<Component>()) if (c == null) mcMissing++;\n    sb.AppendLine(\"  Main Camera missing=\" + mcMissing);\n    Transform ct = camRig.transform.Find(\"Camera Target\");\n    sb.AppendLine(\"  Camera Target mrEnabled=\" + (ct.GetComponent<MeshRenderer>() != null ? ct.GetComponent<MeshRenderer>().enabled.ToString() : \"none\"));\n}\n\nforeach (Unit u in Resources.FindObjectsOfTypeAll<Unit>())\n{\n    if (!u.gameObject.scene.IsValid()) continue;\n    Transform c0 = u.transform.childCount > 0 ? u.transform.GetChild(0) : null;\n    MeshFilter mf = c0 != null ? c0.GetComponent<MeshFilter>() : null;\n    MeshRenderer mr = c0 != null ? c0.GetComponent<MeshRenderer>() : null;\n    SelectionOutlineTarget sot = u.GetComponent<SelectionOutlineTarget>();\n    sb.AppendLine(\"SceneUnit \" + u.name + \": ch0=\" + (c0 != null ? c0.name : \"none\") +\n        \" act=\" + (c0 != null && c0.gameObject.activeSelf) +\n        \" mesh=\" + (mf != null && mf.sharedMesh != null ? mf.sharedMesh.name : \"none\") +\n        \" mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"none\") +\n        \" scale=\" + (c0 != null ? c0.localScale.ToString(\"F2\") : \"\") +\n        \" SOT.sel=\" + (sot != null ? sot.IsSelected.ToString() : \"none\"));\n}\n\n// Verify Step 3: Tyc Tier Button Manager + AB.Tier 5\nforeach (Transform tr in Resources.FindObjectsOfTypeAll<Transform>())\n{\n    if (!tr.gameObject.scene.IsValid()) continue;\n    if (tr.name == \"Tier Button Manager\" && tr.parent != null && (tr.parent.name == \"Faction A: Tyc\" || tr.parent.name == \"Faction B: Eco\" || tr.parent.name == \"Faction C: Sci\"))\n    {\n        UnityEngine.UI.HorizontalLayoutGroup hlg = tr.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n        sb.Append(tr.parent.name + \" TBM (HLG=\" + (hlg != null && hlg.enabled) + \"): \");\n        for (int i = 0; i < tr.childCount; i++)\n        {\n            RectTransform rt = tr.GetChild(i) as RectTransform;\n            sb.Append(rt.name + \"(x=\" + rt.anchoredPosition.x.ToString(\"F1\") + \",w=\" + rt.sizeDelta.x.ToString(\"F1\") + \") \");\n        }\n        sb.AppendLine();\n    }\n    if (tr.name == \"AB.Tier 5\" && tr.parent != null && tr.parent.name == \"Faction A: Tyc\")\n    {\n        sb.AppendLine(\"AB.Tier 5 PTPI count: \" + tr.GetComponents<ProductionTierPageIntegration>().Length);\n    }\n}\n\n// Render verify_selection.png using first naval prefab found via FindAssets\nstring[] navGuids = AssetDatabase.FindAssets(\"Commandship t:Prefab\", new string[] { \"Assets/Prefabs/Units Prefabs\" });\nstring navPath = navGuids.Length > 0 ? AssetDatabase.GUIDToAssetPath(navGuids[0]) : null;\nif (navPath != null)\n{\n    GameObject prev2 = new GameObject(\"__TEMP_PreviewSelection\");\n    prev2.transform.position = new Vector3(0f, 600f, 0f);\n    Camera cam2 = null; RenderTexture rt2 = null; Texture2D tex2 = null;\n    try\n    {\n        Material waterMat = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Materials/Buildings/Depot/Depot_Facade_Mat.mat\");\n        GameObject water = GameObject.CreatePrimitive(PrimitiveType.Cube);\n        water.transform.SetParent(prev2.transform, false);\n        water.transform.localPosition = new Vector3(0f, -0.5f, 0f);\n        water.transform.localScale = new Vector3(18f, 1f, 18f);\n        water.GetComponent<MeshRenderer>().sharedMaterial = waterMat;\n\n        GameObject cmdAsset = AssetDatabase.LoadAssetAtPath<GameObject>(navPath);\n        GameObject shipInst = (GameObject)PrefabUtility.InstantiatePrefab(cmdAsset);\n        shipInst.transform.SetParent(prev2.transform, false);\n        shipInst.transform.localPosition = Vector3.zero;\n        Transform selCh = shipInst.transform.GetChild(0);\n        selCh.gameObject.SetActive(true);\n        PlayerColors.ApplySelectionTint(selCh);\n\n        GameObject camGo = new GameObject(\"Cam2\");\n        camGo.transform.SetParent(prev2.transform, false);\n        camGo.transform.localPosition = new Vector3(4.2f, 4.8f, -4.8f);\n        camGo.transform.LookAt(prev2.transform.position + new Vector3(0f, 0.3f, 0f));\n        cam2 = camGo.AddComponent<Camera>();\n        cam2.clearFlags = CameraClearFlags.SolidColor;\n        cam2.backgroundColor = new Color(0.11f, 0.19f, 0.27f, 1f);\n        cam2.fieldOfView = 42f;\n\n        GameObject lGo = new GameObject(\"L2\");\n        lGo.transform.SetParent(prev2.transform, false);\n        lGo.transform.rotation = Quaternion.Euler(50f, -135f, 0f);\n        Light l2 = lGo.AddComponent<Light>();\n        l2.type = LightType.Directional;\n        l2.intensity = 1.2f;\n\n        rt2 = new RenderTexture(768, 512, 24, RenderTextureFormat.ARGB32);\n        cam2.targetTexture = rt2;\n        cam2.Render();\n        RenderTexture prevRT = RenderTexture.active;\n        RenderTexture.active = rt2;\n        tex2 = new Texture2D(768, 512, TextureFormat.RGBA32, false);\n        tex2.ReadPixels(new Rect(0, 0, 768, 512), 0, 0);\n        tex2.Apply();\n        RenderTexture.active = prevRT;\n        string outPath = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\verify_selection.png\";\n        System.IO.File.WriteAllBytes(outPath, tex2.EncodeToPNG());\n        sb.AppendLine(\"Rendered verify_selection.png for \" + navPath);\n    }\n    finally\n    {\n        if (cam2 != null) cam2.targetTexture = null;\n        if (rt2 != null) UnityEngine.Object.DestroyImmediate(rt2);\n        if (tex2 != null) UnityEngine.Object.DestroyImmediate(tex2);\n        UnityEngine.Object.DestroyImmediate(prev2);\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
