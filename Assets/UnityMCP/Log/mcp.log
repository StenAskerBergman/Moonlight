{"ts":"2026-11-15T17:56:02.168Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1229,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. Inspect why Boat / Submarine / Camera Rig / Selection exist in Match.unity\nvar camRig = UnityEngine.GameObject.Find(\"Camera Rig\");\nvar mainCam = UnityEngine.Camera.main;\nsb.AppendLine(\"CameraRig pos=\" + (camRig != null ? camRig.transform.position.ToString() : \"null\")\n    + \" MainCam=\" + (mainCam != null ? mainCam.transform.position.ToString() : \"null\"));\n\n// Check if Unit.cs prefab or Freight Ship or SeaHawk or anything else has Selection child\nvar assetGuids = UnityEditor.AssetDatabase.FindAssets(\"SeaHawk\");\nsb.AppendLine(\"SeaHawk assets count=\" + assetGuids.Length);\nfor (int i = 0; i < assetGuids.Length; i++) sb.AppendLine(\"  \" + UnityEditor.AssetDatabase.GUIDToAssetPath(assetGuids[i]));\n\n// Check Unit.Selected in Freight Ship / Boat (Unit Inventory) (1) mesh details\nvar boat = UnityEngine.GameObject.Find(\"Boat (Unit Inventory) (1)\");\nif (boat != null && boat.transform.childCount > 0) {\n    var sel = boat.transform.GetChild(0);\n    var mf = sel.GetComponent<UnityEngine.MeshFilter>();\n    var mr = sel.GetComponent<UnityEngine.MeshRenderer>();\n    sb.AppendLine(\"Boat/Selected meshAsset=\" + (mf != null && mf.sharedMesh != null ? UnityEditor.AssetDatabase.GetAssetPath(mf.sharedMesh) + \" verts=\" + mf.sharedMesh.vertexCount : \"null\")\n        + \" mr.en=\" + (mr != null ? mr.enabled.ToString() : \"null\"));\n}\n\n// 2. Inspect Island 31 heightfield around Quay / Depot and find ANY linear/curved dip on flatland (y ~ 0.85 +/- 0.15)\nvar isl31 = UnityEngine.GameObject.Find(\"Island 31\");\nif (isl31 != null) {\n    var mesh = isl31.GetComponent<UnityEngine.MeshFilter>().sharedMesh;\n    var verts = mesh.vertices;\n    var norms = mesh.normals;\n    int side = UnityEngine.Mathf.RoundToInt(UnityEngine.Mathf.Sqrt(verts.Length));\n\n    // Check strict flatland: vertices whose 4 neighbors are ALL in [0.75, 1.00]\n    int strictDips = 0;\n    float maxStrictDip = 0f;\n    int maxStrictDipIdx = -1;\n    int strictSteep = 0;\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            float yL = verts[idx-1].y, yR = verts[idx+1].y, yD = verts[idx-side].y, yU = verts[idx+side].y;\n            if (yL > 0.72f && yR > 0.72f && yD > 0.72f && yU > 0.72f && yL < 1.02f && yR < 1.02f && yD < 1.02f && yU < 1.02f) {\n                float avg = 0.25f * (yL + yR + yD + yU);\n                float dip = avg - y;\n                if (dip > 0.005f) {\n                    strictDips++;\n                    if (dip > maxStrictDip) { maxStrictDip = dip; maxStrictDipIdx = idx; }\n                }\n                if (norms[idx].y < 0.99f) strictSteep++;\n            }\n        }\n    }\n    sb.AppendLine(\"Island 31 Strict Flatland [0.72..1.02]: strictDips(>0.005)=\" + strictDips + \" maxDip=\" + maxStrictDip.ToString(\"F4\") + \" strictSteep(ny<0.99)=\" + strictSteep);\n    if (maxStrictDipIdx >= 0) {\n        int wx = maxStrictDipIdx % side, wz = maxStrictDipIdx / side;\n        sb.AppendLine(\"  maxStrictDip @ (\" + wx + \",\" + wz + \") pos=\" + verts[maxStrictDipIdx] + \" norm=\" + norms[maxStrictDipIdx]\n            + \" yN=[L:\" + verts[maxStrictDipIdx-1].y.ToString(\"F4\") + \",R:\" + verts[maxStrictDipIdx+1].y.ToString(\"F4\")\n            + \",D:\" + verts[maxStrictDipIdx-side].y.ToString(\"F4\") + \",U:\" + verts[maxStrictDipIdx+side].y.ToString(\"F4\") + \"]\");\n    }\n\n    // ALSO check ANY narrow V-trench at ANY height in (0.4 .. 2.0) where y < min(L,R)-0.02 OR y < min(D,U)-0.02\n    int vTrench = 0;\n    int shown = 0;\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            if (y < 0.3f || y > 2.5f) continue;\n            float yL = verts[idx-1].y, yR = verts[idx+1].y, yD = verts[idx-side].y, yU = verts[idx+side].y;\n            float trenchX = UnityEngine.Mathf.Min(yL, yR) - y;\n            float trenchZ = UnityEngine.Mathf.Min(yD, yU) - y;\n            float tMax = UnityEngine.Mathf.Max(trenchX, trenchZ);\n            if (tMax > 0.015f) {\n                vTrench++;\n                if (shown < 12 && vTrench % 5 == 1) {\n                    shown++;\n                    sb.AppendLine(\"  vTrench @ (\" + x + \",\" + z + \") y=\" + y.ToString(\"F3\") + \" ny=\" + norms[idx].y.ToString(\"F2\")\n                        + \" [L:\" + yL.ToString(\"F3\") + \",R:\" + yR.ToString(\"F3\") + \",D:\" + yD.ToString(\"F3\") + \",U:\" + yU.ToString(\"F3\") + \"]\");\n                }\n            }\n        }\n    }\n    sb.AppendLine(\"Island 31 vTrench (y < oppositeMin - 0.015, 0.3<y<2.5): total=\" + vTrench);\n}\n\n// 3. Also run on Island 19\nvar isl19 = UnityEngine.GameObject.Find(\"Island 19\");\nif (isl19 != null) {\n    var mesh = isl19.GetComponent<UnityEngine.MeshFilter>().sharedMesh;\n    var verts = mesh.vertices;\n    var norms = mesh.normals;\n    int side = UnityEngine.Mathf.RoundToInt(UnityEngine.Mathf.Sqrt(verts.Length));\n    int vTrench = 0, shown = 0;\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            if (y < 0.3f || y > 2.5f) continue;\n            float trenchX = UnityEngine.Mathf.Min(verts[idx-1].y, verts[idx+1].y) - y;\n            float trenchZ = UnityEngine.Mathf.Min(verts[idx-side].y, verts[idx+side].y) - y;\n            if (UnityEngine.Mathf.Max(trenchX, trenchZ) > 0.015f) {\n                vTrench++;\n                if (shown < 8 && vTrench % 15 == 1) {\n                    shown++;\n                    sb.AppendLine(\"  Isl19 vTrench @ (\" + x + \",\" + z + \") y=\" + y.ToString(\"F3\") + \" ny=\" + norms[idx].y.ToString(\"F2\")\n                        + \" [L:\" + verts[idx-1].y.ToString(\"F3\") + \",R:\" + verts[idx+1].y.ToString(\"F3\") + \",D:\" + verts[idx-side].y.ToString(\"F3\") + \",U:\" + verts[idx+side].y.ToString(\"F3\") + \"]\");\n                }\n            }\n        }\n    }\n    sb.AppendLine(\"Island 19 vTrench total=\" + vTrench);\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
