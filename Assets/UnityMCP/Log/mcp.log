{"ts":"2026-11-15T18:25:46.483Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2203,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeMat\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    foreach (Transform ch in clone.GetComponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mat = mr.sharedMaterial;\n    var sh = mat.shader;\n    sb.AppendLine(\"Shader: \" + sh.name + \" passCount=\" + mat.passCount + \" keywords=[\" + string.Join(\",\", mat.shaderKeywords) + \"]\");\n    int pc = sh.GetPropertyCount();\n    for (int i = 0; i < pc; i++)\n    {\n        var pt = sh.GetPropertyType(i);\n        string pn = sh.GetPropertyName(i);\n        string val = pt == UnityEngine.Rendering.ShaderPropertyType.Float || pt == UnityEngine.Rendering.ShaderPropertyType.Range\n            ? mat.GetFloat(pn).ToString(\"F3\")\n            : pt == UnityEngine.Rendering.ShaderPropertyType.Color ? mat.GetColor(pn).ToString()\n            : pt == UnityEngine.Rendering.ShaderPropertyType.Vector ? mat.GetVector(pn).ToString()\n            : pt == UnityEngine.Rendering.ShaderPropertyType.Texture ? (mat.GetTexture(pn) != null ? mat.GetTexture(pn).name : \"null\")\n            : \"\";\n        sb.AppendLine(string.Format(\"  prop[{0}] {1} ({2}) = {3}\", i, pn, pt, val));\n    }\n\n    // ALSO render local (15..35, 0..10) at ortho to see the exact black pixels at (24..34, 1..8) vs plainLit vs noNormalMaps vs single channel weights!\n    // Wait check BOTH: set testMat = new Material(mat), and test:\n    // A) Set _Control to solid (0,0,0,1) uniform Texture2D -> does the curve STILL appear?\n    // B) Set _RegionMask to Texture2D.blackTexture -> does the curve STILL appear?\n    // C) Set _UseGrid / _OverlayAlpha / _NormalScale = 0 -> does the curve STILL appear?\n    // WAIT WHAT ABOUT _RegionMask or _Control bilinear interpolation?! No, earlier at (181,13) _Control was (0,0,0,1) AND _SurfaceTint was (0.41,0.41,0.39,0.00)!\n    // Wait WHY didn't (181,13) vary in C or T, YET (24.52, 4.66) IS BLACK ONLY UNDER TerrainSplatNormal AND NOT plainLit?!\n    // Test replacing _Control in MPB with a 4x4 constant (0,0,0,1) texture AND _SurfaceTint with 4x4 white AND _RegionMask with 4x4 black!\n    camGo = new GameObject(\"__ProbeMatCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 18f;\n    cam.transform.position = i31.transform.position + new Vector3(18f, 40f, 18f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    // Wait first check on FULL ortho45 centered on (45,45) where we KNOW curve was visible at local=(30.15, 2.20):\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n\n    System.Func<string, int> countCurveAt30_2 = (lbl) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        var pxs = tex.GetPixels32();\n        // Check strictly in the known seabed region where terrain height is flat -18.436: local x=26..34, z=1..5 -> px x in [148..193], y in [6..28]\n        int cnt = 0; Color32 darkEx = new Color32(255,255,255,255);\n        for (int y = 6; y <= 28; y++)\n        for (int x = 148; x <= 193; x++)\n        {\n            var c = pxs[y * 512 + x];\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float avgN = 0f; int nc = 0;\n            for (int dy = -3; dy <= 3; dy += 3)\n            for (int dx = -3; dx <= 3; dx += 3)\n            {\n                if (dx == 0 && dy == 0) continue;\n                var n = pxs[(y + dy) * 512 + (x + dx)];\n                avgN += (0.299f * n.r + 0.587f * n.g + 0.114f * n.b) / 255f;\n                nc++;\n            }\n            if (lum < (avgN / nc) * 0.5f) { cnt++; if (c.r + c.g + c.b < darkEx.r + darkEx.g + darkEx.b) darkEx = c; }\n        }\n        sb.AppendLine(string.Format(\"SeabedFlat(26..34,1..5) [{0}]: darkPx={1} darkest=({2},{3},{4})\", lbl, cnt, darkEx.r, darkEx.g, darkEx.b));\n        return cnt;\n    };\n\n    countCurveAt30_2(\"baseline\");\n\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var origCtrl = mpb.GetTexture(\"_Control\");\n    var origTint = mpb.GetTexture(\"_SurfaceTint\");\n    var origReg = mpb.GetTexture(\"_RegionMask\");\n\n    // Create 4x4 flat textures\n    var flatCtrl = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var flatTint = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var flatReg = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var fc = new Color[16]; var ft = new Color[16]; var fr = new Color[16];\n    for (int i = 0; i < 16; i++) { fc[i] = new Color(0, 0, 0, 1); ft[i] = new Color(0.5f, 0.5f, 0.5f, 1); fr[i] = Color.black; }\n    flatCtrl.SetPixels(fc); flatCtrl.Apply();\n    flatTint.SetPixels(ft); flatTint.Apply();\n    flatReg.SetPixels(fr); flatReg.Apply();\n\n    mpb.SetTexture(\"_Control\", flatCtrl);\n    mr.SetPropertyBlock(mpb);\n    countCurveAt30_2(\"flat_Control\");\n\n    mpb.SetTexture(\"_Control\", origCtrl);\n    mpb.SetTexture(\"_SurfaceTint\", flatTint);\n    mr.SetPropertyBlock(mpb);\n    countCurveAt30_2(\"flat_SurfaceTint\");\n\n    mpb.SetTexture(\"_SurfaceTint\", origTint);\n    mpb.SetTexture(\"_RegionMask\", flatReg);\n    mr.SetPropertyBlock(mpb);\n    countCurveAt30_2(\"flat_RegionMask\");\n\n    // Also try replacing ALL albedo/normal maps on a temp Material\n    mpb.SetTexture(\"_RegionMask\", origReg);\n    mr.SetPropertyBlock(mpb);\n    var testMat = new Material(mat);\n    for (int i = 0; i < pc; i++)\n    {\n        if (sh.GetPropertyType(i) == UnityEngine.Rendering.ShaderPropertyType.Texture)\n        {\n            string pn = sh.GetPropertyName(i);\n            if (pn.Contains(\"Normal\")) testMat.SetTexture(pn, Texture2D.normalTexture);\n        }\n    }\n    mr.sharedMaterial = testMat;\n    countCurveAt30_2(\"flat_Normals\");\n\n    for (int i = 0; i < pc; i++)\n    {\n        if (sh.GetPropertyType(i) == UnityEngine.Rendering.ShaderPropertyType.Texture)\n        {\n            string pn = sh.GetPropertyName(i);\n            if (!pn.Contains(\"Normal\") && !pn.Contains(\"Control\") && !pn.Contains(\"Tint\") && !pn.Contains(\"Mask\"))\n                testMat.SetTexture(pn, Texture2D.whiteTexture);\n        }\n    }\n    countCurveAt30_2(\"white_Albedos+flat_Normals\");\n\n    mr.sharedMaterial = mat;\n    UnityEngine.Object.DestroyImmediate(testMat);\n    UnityEngine.Object.DestroyImmediate(flatCtrl);\n    UnityEngine.Object.DestroyImmediate(flatTint);\n    UnityEngine.Object.DestroyImmediate(flatReg);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
