{"ts":"2026-11-15T18:52:15.096Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1378,"action":"execute","params":{"action":"execute","code":"string matDir = \"Assets/Materials/Buildings/Depot\";\nSystem.IO.Directory.CreateDirectory(@\"e:\\GitHub\\Moonlight\\\" + matDir);\n\nvar litShader = Shader.Find(\"Universal Render Pipeline/Lit\");\nFunc<string, Texture2D> loadTex = (path) => UnityEditor.AssetDatabase.LoadAssetAtPath<Texture2D>(path);\nFunc<string, Color, string, string, Vector2, float, float, Color, Material> makeMat = (matName, col, alPath, nmPath, tiling, metallic, smooth, emissive) => {\n    string assetPath = matDir + \"/\" + matName + \".mat\";\n    var mat = UnityEditor.AssetDatabase.LoadAssetAtPath<Material>(assetPath);\n    if (mat == null) { mat = new Material(litShader); UnityEditor.AssetDatabase.CreateAsset(mat, assetPath); }\n    mat.shader = litShader;\n    mat.SetColor(\"_BaseColor\", col);\n    var al = !string.IsNullOrEmpty(alPath) ? loadTex(alPath) : null;\n    var nm = !string.IsNullOrEmpty(nmPath) ? loadTex(nmPath) : null;\n    mat.SetTexture(\"_BaseMap\", al);\n    mat.SetTexture(\"_BumpMap\", nm);\n    mat.SetTextureScale(\"_BaseMap\", tiling);\n    mat.SetTextureScale(\"_BumpMap\", tiling);\n    mat.SetFloat(\"_BumpScale\", nm != null ? 0.85f : 1f);\n    if (nm != null) mat.EnableKeyword(\"_NORMALMAP\"); else mat.DisableKeyword(\"_NORMALMAP\");\n    mat.SetFloat(\"_Metallic\", metallic);\n    mat.SetFloat(\"_Smoothness\", smooth);\n    if (emissive.maxColorComponent > 0.01f)\n    {\n        mat.EnableKeyword(\"_EMISSION\");\n        mat.SetColor(\"_EmissionColor\", emissive);\n    }\n    else\n    {\n        mat.DisableKeyword(\"_EMISSION\");\n        mat.SetColor(\"_EmissionColor\", Color.black);\n    }\n    UnityEditor.EditorUtility.SetDirty(mat);\n    return mat;\n};\n\nvar matPaving = makeMat(\"Depot_Paving\", new Color(0.84f, 0.85f, 0.82f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Paving_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Paving_Normal.png\", new Vector2(2f, 2f), 0.05f, 0.25f, Color.black);\nvar matFacade = makeMat(\"Depot_Facade\", new Color(0.76f, 0.80f, 0.78f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Facade_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Facade_Normal.png\", new Vector2(2f, 1.5f), 0.25f, 0.38f, Color.black);\nvar matMetal = makeMat(\"Depot_Metal\", new Color(0.54f, 0.58f, 0.62f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Normal.png\", new Vector2(2f, 2f), 0.65f, 0.45f, Color.black);\nvar matBrass = makeMat(\"Depot_Brass\", new Color(0.95f, 0.74f, 0.32f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Brass_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Brass_Normal.png\", new Vector2(1.5f, 1.5f), 0.45f, 0.50f, Color.black);\nvar matGlow = makeMat(\"Depot_BayGlow\", new Color(1.0f, 0.84f, 0.52f, 1f), null, null, Vector2.one, 0f, 0.2f, new Color(1.4f, 1.0f, 0.42f, 1f));\nvar matCrateBlue = makeMat(\"Depot_CrateBlue\", new Color(0.32f, 0.48f, 0.64f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Normal.png\", new Vector2(1f, 1f), 0.35f, 0.35f, Color.black);\nvar matCrateRust = makeMat(\"Depot_CrateRust\", new Color(0.72f, 0.40f, 0.26f, 1f),\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Albedo.jpg\",\n    \"Assets/Textures/Buildings/Depot/Depot_Metal_Normal.png\", new Vector2(1f, 1f), 0.35f, 0.35f, Color.black);\n\nstring prefabPath = \"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/Depot.prefab\";\nvar root = UnityEditor.PrefabUtility.LoadPrefabContents(prefabPath);\ntry\n{\n    Transform modelRoot = root.transform.Find(\"Model - Placeholder\");\n    if (modelRoot == null)\n    {\n        var go = new GameObject(\"Model - Placeholder\");\n        go.transform.SetParent(root.transform, false);\n        modelRoot = go.transform;\n    }\n    modelRoot.gameObject.layer = 8;\n    modelRoot.localPosition = Vector3.zero;\n    modelRoot.localRotation = Quaternion.identity;\n    modelRoot.localScale = Vector3.one;\n\n    // Remove bare grey placeholder cube visuals from Model - Placeholder itself while preserving a clean BoxCollider\n    var oldMf = modelRoot.GetComponent<MeshFilter>();\n    if (oldMf != null) UnityEngine.Object.DestroyImmediate(oldMf);\n    var oldMr = modelRoot.GetComponent<MeshRenderer>();\n    if (oldMr != null) UnityEngine.Object.DestroyImmediate(oldMr);\n    var col = modelRoot.GetComponent<BoxCollider>();\n    if (col == null) col = modelRoot.gameObject.AddComponent<BoxCollider>();\n    col.center = new Vector3(0f, 0.65f, 0f);\n    col.size = new Vector3(1.92f, 1.30f, 1.92f);\n\n    for (int i = modelRoot.childCount - 1; i >= 0; i--)\n        UnityEngine.Object.DestroyImmediate(modelRoot.GetChild(i).gameObject);\n\n    Action<string, PrimitiveType, Vector3, Vector3, Vector3, Material> addPart = (pName, pType, lPos, lRot, lScale, mat) => {\n        var part = GameObject.CreatePrimitive(pType);\n        part.name = pName;\n        part.layer = 8;\n        var pCol = part.GetComponent<Collider>();\n        if (pCol != null) UnityEngine.Object.DestroyImmediate(pCol);\n        part.transform.SetParent(modelRoot, false);\n        part.transform.localPosition = lPos;\n        part.transform.localEulerAngles = lRot;\n        part.transform.localScale = lScale;\n        part.GetComponent<MeshRenderer>().sharedMaterial = mat;\n    };\n\n    // Foundation quay apron & corner bumpers\n    addPart(\"Foundation_Apron\", PrimitiveType.Cube, new Vector3(0f, 0.06f, 0f), Vector3.zero, new Vector3(1.92f, 0.12f, 1.92f), matPaving);\n    addPart(\"Apron_Trim_Front\", PrimitiveType.Cube, new Vector3(0f, 0.125f, -0.92f), Vector3.zero, new Vector3(1.94f, 0.04f, 0.08f), matBrass);\n    addPart(\"Apron_Trim_Back\", PrimitiveType.Cube, new Vector3(0f, 0.125f, 0.92f), Vector3.zero, new Vector3(1.94f, 0.04f, 0.08f), matMetal);\n\n    // Main Warehouse Hall\n    addPart(\"Warehouse_Body\", PrimitiveType.Cube, new Vector3(-0.14f, 0.50f, 0.14f), Vector3.zero, new Vector3(1.36f, 0.78f, 1.18f), matFacade);\n    addPart(\"Warehouse_Dado\", PrimitiveType.Cube, new Vector3(-0.14f, 0.21f, 0.14f), Vector3.zero, new Vector3(1.40f, 0.18f, 1.22f), matMetal);\n    addPart(\"Warehouse_RoofSlab\", PrimitiveType.Cube, new Vector3(-0.14f, 0.94f, 0.14f), Vector3.zero, new Vector3(1.28f, 0.14f, 1.08f), matMetal);\n    addPart(\"Warehouse_RoofMonitor\", PrimitiveType.Cube, new Vector3(-0.14f, 1.07f, 0.18f), Vector3.zero, new Vector3(0.92f, 0.16f, 0.58f), matFacade);\n    addPart(\"Warehouse_GantryTrim\", PrimitiveType.Cube, new Vector3(-0.14f, 0.89f, -0.42f), Vector3.zero, new Vector3(1.38f, 0.07f, 0.08f), matBrass);\n\n    // Structural Buttresses along Hall walls\n    float[] ribXs = new float[] { -0.72f, -0.34f, 0.04f, 0.44f };\n    for (int r = 0; r < ribXs.Length; r++)\n    {\n        addPart(\"Hall_Buttress_F_\" + r, PrimitiveType.Cube, new Vector3(ribXs[r], 0.52f, -0.45f), Vector3.zero, new Vector3(0.08f, 0.84f, 0.08f), matMetal);\n        addPart(\"Hall_Buttress_B_\" + r, PrimitiveType.Cube, new Vector3(ribXs[r], 0.52f, 0.73f), Vector3.zero, new Vector3(0.08f, 0.84f, 0.08f), matMetal);\n    }\n\n    // Loading Bay Vestibule facing -Z (dock/road front)\n    addPart(\"LoadingBay_Frame\", PrimitiveType.Cube, new Vector3(-0.14f, 0.42f, -0.54f), Vector3.zero, new Vector3(0.84f, 0.62f, 0.34f), matBrass);\n    addPart(\"LoadingBay_Shutter\", PrimitiveType.Cube, new Vector3(-0.14f, 0.37f, -0.69f), Vector3.zero, new Vector3(0.64f, 0.46f, 0.06f), matMetal);\n    addPart(\"LoadingBay_BeaconL\", PrimitiveType.Cube, new Vector3(-0.50f, 0.65f, -0.70f), Vector3.zero, new Vector3(0.07f, 0.10f, 0.06f), matGlow);\n    addPart(\"LoadingBay_BeaconR\", PrimitiveType.Cube, new Vector3(0.22f, 0.65f, -0.70f), Vector3.zero, new Vector3(0.07f, 0.10f, 0.06f), matGlow);\n    addPart(\"LoadingBay_HeaderGlow\", PrimitiveType.Cube, new Vector3(-0.14f, 0.61f, -0.72f), Vector3.zero, new Vector3(0.56f, 0.04f, 0.03f), matGlow);\n\n    // Rooftop Industrial Vents & Antenna Mast\n    addPart(\"Roof_Vent_1\", PrimitiveType.Cylinder, new Vector3(-0.42f, 1.19f, 0.18f), Vector3.zero, new Vector3(0.16f, 0.05f, 0.16f), matBrass);\n    addPart(\"Roof_Vent_2\", PrimitiveType.Cylinder, new Vector3(-0.14f, 1.19f, 0.18f), Vector3.zero, new Vector3(0.16f, 0.05f, 0.16f), matBrass);\n    addPart(\"Roof_Mast\", PrimitiveType.Cylinder, new Vector3(0.20f, 1.32f, 0.30f), Vector3.zero, new Vector3(0.03f, 0.28f, 0.03f), matMetal);\n    addPart(\"Roof_Beacon\", PrimitiveType.Sphere, new Vector3(0.20f, 1.60f, 0.30f), Vector3.zero, new Vector3(0.07f, 0.07f, 0.07f), matGlow);\n\n    // Corner Harbor Crane (+X, -Z quadrant)\n    addPart(\"Crane_Pedestal\", PrimitiveType.Cylinder, new Vector3(0.68f, 0.25f, -0.58f), Vector3.zero, new Vector3(0.28f, 0.13f, 0.28f), matMetal);\n    addPart(\"Crane_Cab\", PrimitiveType.Cube, new Vector3(0.68f, 0.46f, -0.56f), new Vector3(0f, -22f, 0f), new Vector3(0.26f, 0.22f, 0.34f), matBrass);\n    addPart(\"Crane_Jib\", PrimitiveType.Cube, new Vector3(0.79f, 0.84f, -0.80f), new Vector3(-42f, -22f, 0f), new Vector3(0.08f, 0.08f, 0.92f), matBrass);\n    addPart(\"Crane_Cable\", PrimitiveType.Cylinder, new Vector3(0.92f, 0.72f, -1.08f), Vector3.zero, new Vector3(0.018f, 0.36f, 0.018f), matMetal);\n    addPart(\"Crane_Hook\", PrimitiveType.Cube, new Vector3(0.92f, 0.36f, -1.08f), Vector3.zero, new Vector3(0.09f, 0.07f, 0.09f), matMetal);\n\n    // Stacked Cargo Containers (+X, +Z yard pad)\n    addPart(\"Cargo_Blue_A\", PrimitiveType.Cube, new Vector3(0.68f, 0.21f, 0.16f), Vector3.zero, new Vector3(0.32f, 0.18f, 0.56f), matCrateBlue);\n    addPart(\"Cargo_Rust_B\", PrimitiveType.Cube, new Vector3(0.68f, 0.21f, 0.76f), Vector3.zero, new Vector3(0.32f, 0.18f, 0.42f), matCrateRust);\n    addPart(\"Cargo_Top_C\", PrimitiveType.Cube, new Vector3(0.69f, 0.39f, 0.38f), new Vector3(0f, 8f, 0f), new Vector3(0.30f, 0.18f, 0.54f), matCrateRust);\n\n    UnityEditor.PrefabUtility.SaveAsPrefabAsset(root, prefabPath);\n}\nfinally\n{\n    UnityEditor.PrefabUtility.UnloadPrefabContents(root);\n}\nUnityEditor.AssetDatabase.SaveAssets();\n\n// Render temporary Quay + Depot showcase close-up on Island 21 coast to scratch\nvar tempDepot = UnityEditor.PrefabUtility.InstantiatePrefab(UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(prefabPath)) as GameObject;\nvar quayGo = new GameObject(\"TempPreviewQuay\");\nvar qCam = new GameObject(\"TempQuayCam\");\nvar rt = new RenderTexture(1024, 768, 24);\nvar tex = new Texture2D(1024, 768, TextureFormat.RGB24, false);\ntry\n{\n    // Sample a coastal Island chunk to place Depot next to a temporary Quay mesh\n    var island = UnityEngine.Object.FindObjectOfType<Island>();\n    Vector3 anchorPos = new Vector3(-45f, 0.5f, 135f);\n    if (island != null) anchorPos = island.transform.position + new Vector3(45f, 0.2f, 45f);\n    // Use Island 21 shoreline or direct isolated preview next to Ocean Cube (y = -0.5)\n    Vector3 previewPos = new Vector3(0f, -0.5f + 1.9f, -155f); // open water at (0,-155) for crystal clear inspection of walls & building!\n    // Build a quick 4x4 Quay test grid at previewPos using existing QuaySystem + GridSystem\n    quayGo.transform.position = new Vector3(previewPos.x - 2f, -0.5f, previewPos.z - 2f);\n    var gs = quayGo.AddComponent<GridSystem>();\n    gs.width = 6; gs.height = 6; gs.cellSize = 1f;\n    gs.InitializeGrid(new MapGrid { size = 6 }); // avoid MapGrid MonoBehaviour warning by setting up cells manually? Check QuaySystem instead:\n    // Actually spawn existing Island Quay chunk? Better: instantiate Depot on top of Island 21's coastal quay OR just render Depot + manual quay quad test!\n    // Even simpler: find an actual Island's QuaySystem, add 3x3 temp cells near coastline? Wait - don't mutate scene QuaySystem!\n    // Instantiate standalone Box/Wall using Quay Structure.mat so we test BOTH Quay Structure.mat AND Depot.prefab cleanly!\n    var qs = quayGo.AddComponent<QuaySystem>();\n    var qMat = UnityEditor.AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n    var flg = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n    typeof(QuaySystem).GetField(\"topMaterial\", flg).SetValue(qs, qMat);\n    typeof(QuaySystem).GetField(\"wallMaterial\", flg).SetValue(qs, qMat);\n    var gridArr = new Cell[6, 6];\n    for (int gx = 0; gx < 6; gx++) for (int gz = 0; gz < 6; gz++) gridArr[gx, gz] = new Cell(gx, gz, -3.5f, Cell.TerrainType.DeepWater, true);\n    typeof(GridSystem).GetField(\"grid\", flg).SetValue(gs, gridArr);\n    qs.Claim(1, 1, 999); qs.Claim(2, 1, 999); qs.Claim(3, 1, 999); qs.Claim(4, 1, 999);\n    qs.Claim(1, 2, 999); qs.Claim(2, 2, 999); qs.Claim(3, 2, 999); qs.Claim(4, 2, 999);\n    qs.Claim(1, 3, 999); qs.Claim(2, 3, 999); qs.Claim(3, 3, 999); qs.Claim(4, 3, 999);\n    qs.Claim(1, 4, 999); qs.Claim(2, 4, 999); qs.Claim(3, 4, 999); qs.Claim(4, 4, 999);\n    qs.RebuildNow();\n    tempDepot.transform.position = quayGo.transform.position + new Vector3(3f, qs.TopElevationLocal, 3f);\n    tempDepot.transform.rotation = Quaternion.Euler(0f, -20f, 0f);\n\n    qCam.transform.position = tempDepot.transform.position + new Vector3(3.6f, 3.2f, -4.4f);\n    qCam.transform.LookAt(tempDepot.transform.position + new Vector3(0f, 0.25f, 0f));\n    var cam = qCam.AddComponent<Camera>();\n    cam.fieldOfView = 35f;\n    cam.nearClipPlane = 0.2f;\n    cam.farClipPlane = 100f;\n    cam.targetTexture = rt;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 1024, 768), 0, 0);\n    tex.Apply();\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\verify_quay_depot.png\", tex.EncodeToPNG());\n}\nfinally\n{\n 