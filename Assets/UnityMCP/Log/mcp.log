ins(\"frame\"))\n        sb.AppendLine(\"Active UI Image: \" + img.name + \" rect=\" + img.rectTransform.rect + \" pos=\" + img.rectTransform.position);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"},"error":"Compilation failed"}
