ll) as float[];\n    float[] sh = ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache, null) as float[];\n\n    int scz = Mathf.RoundToInt((pts[k].y - orig.y + pad) / step);\n    int scx = Mathf.RoundToInt((pts[k].x - orig.x + pad) / step);\n    sb.AppendLine(\"=== Extra cache fields around src[\" + srcIds[k] + \"] \" + pts[k] + \" ===\");\n    for (int dx = -3; dx <= 3; dx++)\n    {\n        int cidx = scz * res + (scx + dx);\n        sb.AppendLine(string.Format(\"  dx={0,2}: h={1:F3} hm={2:F3} sc={3:F3} pi={4:F3} lake={5} rc={6:F3} sh={7:F2}\",\n            dx,\n            heights != null ? heights[cidx] : -1f,\n            hm != null ? hm[cidx] : -1f,\n            sc != null ? sc[cidx] : -1f,\n            pi != null ? pi[cidx] : -1f,\n            lm != null ? lm[cidx].ToString() : \"null\",\n            rc != null ? rc[cidx] : -1f,\n            sh != null ? sh[cidx] : -1f));\n    }\n}\n\nsb.AppendLine(\"=== 1-sample vertical steps (|dh| > 0.08 in 0.50<h<1.25) across ALL 8 Island Meshes ===\");\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (!mg.name.StartsWith(\"Island \")) continue;\n    var m = mg.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n    if (side * side != m.vertexCount) continue;\n    int cnt = 0;\n    var samples = new System.Collections.Generic.List<string>();\n    for (int z = 2; z < side - 2; z++)\n    {\n        for (int x = 2; x < side - 2; x++)\n        {\n            int idx = z * side + x;\n            float y = v[idx].y;\n            if (y < 0.50f || y > 1.25f) continue;\n            float dMax = Mathf.Max(\n                Mathf.Max(Mathf.Abs(y - v[idx - 1].y), Mathf.Abs(y - v[idx + 1].y)),\n                Mathf.Max(Mathf.Abs(y - v[idx - side].y), Mathf.Abs(y - v[idx + side].y)));\n            if (dMax > 0.08f)\n            {\n                cnt++;\n                if (samples.Count < 10)\n                {\n                    Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                    samples.Add(string.Format(\"({0:F2},{1:F2}) y={2:F3} d={3:F3}\", wp.x, wp.z, y, dMax));\n                }\n            }\n        }\n    }\n    sb.AppendLine(string.Format(\"  {0}: hardSteps(|dh|>0.08 in grass)={1}\", mg.name, cnt));\n    for (int i = 0; i < samples.Count; i++) sb.AppendLine(\"    \" + samples[i]);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
