{"ts":"2026-11-15T01:15:03.622Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1160,"action":"execute","params":{"action":"execute","code":"var urp = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.Universal.UniversalRenderPipelineAsset>(\"Assets/Shaders/UniversalRenderPipelineAsset.asset\");\nvar urpSo = new UnityEditor.SerializedObject(urp);\nurpSo.FindProperty(\"m_ShadowDistance\").floatValue = 200f;\nurpSo.FindProperty(\"m_ShadowCascadeCount\").intValue = 3;\nurpSo.FindProperty(\"m_Cascade3Split\").vector2Value = new UnityEngine.Vector2(0.12f, 0.36f);\nurpSo.FindProperty(\"m_CascadeBorder\").floatValue = 0.15f;\nurpSo.FindProperty(\"m_SoftShadowsSupported\").boolValue = true;\nurpSo.FindProperty(\"m_MSAA\").intValue = 4;\nurpSo.ApplyModifiedProperties();\nUnityEditor.EditorUtility.SetDirty(urp);\n\nvar renderer = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.Universal.ScriptableRendererData>(\"Assets/Shaders/FullScreen VFX/UniversalRenderPipelineAsset_Renderer.asset\");\nvar ssaoType = typeof(UnityEngine.Rendering.Universal.UniversalRenderPipelineAsset).Assembly.GetType(\"UnityEngine.Rendering.Universal.ScreenSpaceAmbientOcclusion\");\nUnityEngine.Rendering.Universal.ScriptableRendererFeature existing = null;\nforeach (var f in renderer.rendererFeatures)\n{\n    if (f != null && f.GetType() == ssaoType) { existing = f; break; }\n}\nif (existing == null)\n{\n    existing = (UnityEngine.Rendering.Universal.ScriptableRendererFeature)UnityEngine.ScriptableObject.CreateInstance(ssaoType);\n    existing.name = \"ScreenSpaceAmbientOcclusion\";\n    existing.SetActive(true);\n    UnityEditor.AssetDatabase.AddObjectToAsset(existing, renderer);\n    var rSo = new UnityEditor.SerializedObject(renderer);\n    var featuresProp = rSo.FindProperty(\"m_RendererFeatures\");\n    int idx = featuresProp.arraySize;\n    featuresProp.InsertArrayElementAtIndex(idx);\n    featuresProp.GetArrayElementAtIndex(idx).objectReferenceValue = existing;\n    rSo.ApplyModifiedProperties();\n}\nvar sSo = new UnityEditor.SerializedObject(existing);\nvar srcProp = sSo.FindProperty(\"m_Settings.Source\");\nvar dsProp = sSo.FindProperty(\"m_Settings.Downsample\");\nvar aoProp = sSo.FindProperty(\"m_Settings.AfterOpaque\");\nvar intProp = sSo.FindProperty(\"m_Settings.Intensity\");\nvar dlsProp = sSo.FindProperty(\"m_Settings.DirectLightingStrength\");\nvar radProp = sSo.FindProperty(\"m_Settings.Radius\");\nvar fallProp = sSo.FindProperty(\"m_Settings.Falloff\");\nif (srcProp != null) srcProp.enumValueIndex = 1; // DepthNormals\nif (dsProp != null) dsProp.boolValue = true;\nif (aoProp != null) aoProp.boolValue = false;\nif (intProp != null) intProp.floatValue = 0.72f;\nif (dlsProp != null) dlsProp.floatValue = 0.25f;\nif (radProp != null) radProp.floatValue = 0.55f;\nif (fallProp != null) fallProp.floatValue = 120f;\nsSo.ApplyModifiedProperties();\n\nvar validateMethod = typeof(UnityEngine.Rendering.Universal.ScriptableRendererData).GetMethod(\"ValidateRendererFeatures\", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);\nif (validateMethod != null) validateMethod.Invoke(renderer, null);\nUnityEditor.EditorUtility.SetDirty(existing);\nUnityEditor.EditorUtility.SetDirty(renderer);\nUnityEditor.AssetDatabase.SaveAssets();\nreturn $\"Updated URP (ShadowDist={urp.shadowDistance}, Cascades={urp.shadowCascadeCount}, MSAA={urp.msaaSampleCount}) and Renderer features={renderer.rendererFeatures.Count}\";","safety_checks":true,"compiler":"auto"}}
