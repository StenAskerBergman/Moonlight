{"ts":"2026-11-15T18:54:41.266Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3820,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\nShader litShader = Shader.Find(\"Universal Render Pipeline/Lit\");\nif (litShader == null) return \"ERROR: Universal Render Pipeline/Lit not found\";\n\nif (!AssetDatabase.IsValidFolder(\"Assets/Materials\")) AssetDatabase.CreateFolder(\"Assets\", \"Materials\");\nif (!AssetDatabase.IsValidFolder(\"Assets/Materials/Buildings\")) AssetDatabase.CreateFolder(\"Assets/Materials\", \"Buildings\");\nstring matDir = \"Assets/Materials/Buildings/Depot\";\nif (!AssetDatabase.IsValidFolder(matDir)) AssetDatabase.CreateFolder(\"Assets/Materials/Buildings\", \"Depot\");\n\nSystem.Func<string, string, string, Color, float, float, float, Vector2, Color, bool, Material> createLit =\n    (assetPath, albedoPath, normalPath, baseColor, metallic, smoothness, bumpScale, tiling, emissionCol, useEmission) =>\n{\n    Material mat = AssetDatabase.LoadAssetAtPath<Material>(assetPath);\n    if (mat == null)\n    {\n        mat = new Material(litShader);\n        AssetDatabase.CreateAsset(mat, assetPath);\n    }\n    else\n    {\n        mat.shader = litShader;\n    }\n\n    mat.SetColor(\"_BaseColor\", baseColor);\n    mat.SetColor(\"_Color\", baseColor);\n    mat.SetFloat(\"_Metallic\", metallic);\n    mat.SetFloat(\"_Smoothness\", smoothness);\n    mat.SetFloat(\"_WorkflowMode\", 1f);\n    mat.SetFloat(\"_Surface\", 0f);\n    mat.SetFloat(\"_Cull\", 2f);\n\n    if (!string.IsNullOrEmpty(albedoPath))\n    {\n        Texture2D albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(albedoPath);\n        if (albedo == null) throw new System.Exception(\"Missing albedo: \" + albedoPath);\n        mat.SetTexture(\"_BaseMap\", albedo);\n        mat.SetTexture(\"_MainTex\", albedo);\n        mat.SetTextureScale(\"_BaseMap\", tiling);\n        mat.SetTextureScale(\"_MainTex\", tiling);\n    }\n    else\n    {\n        mat.SetTexture(\"_BaseMap\", null);\n        mat.SetTexture(\"_MainTex\", null);\n    }\n\n    if (!string.IsNullOrEmpty(normalPath))\n    {\n        Texture2D normal = AssetDatabase.LoadAssetAtPath<Texture2D>(normalPath);\n        if (normal == null) throw new System.Exception(\"Missing normal: \" + normalPath);\n        mat.SetTexture(\"_BumpMap\", normal);\n        mat.SetFloat(\"_BumpScale\", bumpScale);\n        mat.SetTextureScale(\"_BumpMap\", tiling);\n        mat.EnableKeyword(\"_NORMALMAP\");\n    }\n    else\n    {\n        mat.SetTexture(\"_BumpMap\", null);\n        mat.DisableKeyword(\"_NORMALMAP\");\n    }\n\n    if (useEmission)\n    {\n        mat.EnableKeyword(\"_EMISSION\");\n        mat.globalIlluminationFlags = MaterialGlobalIlluminationFlags.BakedEmissive;\n        mat.SetColor(\"_EmissionColor\", emissionCol);\n    }\n    else\n    {\n        mat.DisableKeyword(\"_EMISSION\");\n        mat.SetColor(\"_EmissionColor\", Color.black);\n    }\n\n    EditorUtility.SetDirty(mat);\n    return mat;\n};\n\nstring texDir = \"Assets/Textures/Buildings/Depot\";\nMaterial matApron = createLit(\n    matDir + \"/Depot_Apron_Mat.mat\",\n    texDir + \"/Depot_Paving_Albedo.jpg\",\n    texDir + \"/Depot_Paving_Normal.png\",\n    new Color(0.62f, 0.65f, 0.68f, 1f),\n    0.05f, 0.28f, 0.75f, new Vector2(2f, 2f), Color.black, false);\n\nMaterial matFacade = createLit(\n    matDir + \"/Depot_Facade_Mat.mat\",\n    texDir + \"/Depot_Facade_Albedo.jpg\",\n    texDir + \"/Depot_Facade_Normal.png\",\n    new Color(0.46f, 0.53f, 0.60f, 1f),\n    0.22f, 0.36f, 0.80f, new Vector2(2f, 1f), Color.black, false);\n\nMaterial matSteel = createLit(\n    matDir + \"/Depot_Steel_Mat.mat\",\n    texDir + \"/Depot_Metal_Albedo.jpg\",\n    texDir + \"/Depot_Metal_Normal.png\",\n    new Color(0.24f, 0.27f, 0.32f, 1f),\n    0.70f, 0.48f, 0.75f, new Vector2(2f, 2f), Color.black, false);\n\nMaterial matOchre = createLit(\n    matDir + \"/Depot_OchreTrim_Mat.mat\",\n    texDir + \"/Depot_Brass_Albedo.jpg\",\n    texDir + \"/Depot_Brass_Normal.png\",\n    new Color(0.88f, 0.62f, 0.20f, 1f),\n    0.42f, 0.50f, 0.65f, new Vector2(2f, 2f), Color.black, false);\n\nMaterial matTeal = createLit(\n    matDir + \"/Depot_ContainerTeal_Mat.mat\",\n    texDir + \"/Depot_Metal_Albedo.jpg\",\n    texDir + \"/Depot_Metal_Normal.png\",\n    new Color(0.20f, 0.49f, 0.62f, 1f),\n    0.35f, 0.40f, 0.65f, new Vector2(2f, 1f), Color.black, false);\n\nMaterial matRust = createLit(\n    matDir + \"/Depot_ContainerRust_Mat.mat\",\n    texDir + \"/Depot_Metal_Albedo.jpg\",\n    texDir + \"/Depot_Metal_Normal.png\",\n    new Color(0.68f, 0.32f, 0.22f, 1f),\n    0.32f, 0.38f, 0.65f, new Vector2(2f, 1f), Color.black, false);\n\nMaterial matEmissive = createLit(\n    matDir + \"/Depot_EmissiveBay_Mat.mat\",\n    null, null,\n    new Color(0.95f, 0.82f, 0.45f, 1f),\n    0.10f, 0.75f, 0f, Vector2.one,\n    new Color(1.55f, 1.08f, 0.42f, 1f), true);\n\nAssetDatabase.SaveAssets();\nsb.AppendLine(\"Materials ready: 7\");\n\nint buildLayer = 8;\nSystem.Action<Transform, string, PrimitiveType, Vector3, Vector3, Vector3, Material> addPart =\n    (parent, partName, primitive, localPos, localScale, localEuler, mat) =>\n{\n    GameObject go = GameObject.CreatePrimitive(primitive);\n    go.name = partName;\n    go.layer = buildLayer;\n    Collider col = go.GetComponent<Collider>();\n    if (col != null) UnityEngine.Object.DestroyImmediate(col);\n\n    go.transform.SetParent(parent, false);\n    go.transform.localPosition = localPos;\n    go.transform.localScale = localScale;\n    go.transform.localRotation = Quaternion.Euler(localEuler);\n\n    MeshRenderer mr = go.GetComponent<MeshRenderer>();\n    mr.sharedMaterial = mat;\n    mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;\n    mr.receiveShadows = true;\n};\n\nstring depotPath = \"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/Depot.prefab\";\nGameObject root = PrefabUtility.LoadPrefabContents(depotPath);\ntry\n{\n    sb.Append(\"Root children before: \");\n    for (int i = 0; i < root.transform.childCount; i++) sb.Append(root.transform.GetChild(i).name + \" \");\n    sb.AppendLine();\n\n    Transform holderTf = root.transform.Find(\"Model - Placeholder\");\n    if (holderTf == null)\n    {\n        GameObject holderGo = new GameObject(\"Model - Placeholder\");\n        holderTf = holderGo.transform;\n        holderTf.SetParent(root.transform, false);\n    }\n\n    GameObject holder = holderTf.gameObject;\n    holder.layer = buildLayer;\n    holderTf.localPosition = Vector3.zero;\n    holderTf.localRotation = Quaternion.identity;\n    holderTf.localScale = Vector3.one;\n\n    MeshRenderer oldMr = holder.GetComponent<MeshRenderer>();\n    if (oldMr != null) UnityEngine.Object.DestroyImmediate(oldMr);\n    MeshFilter oldMf = holder.GetComponent<MeshFilter>();\n    if (oldMf != null) UnityEngine.Object.DestroyImmediate(oldMf);\n\n    for (int i = holderTf.childCount - 1; i >= 0; i--)\n    {\n        UnityEngine.Object.DestroyImmediate(holderTf.GetChild(i).gameObject);\n    }\n\n    BoxCollider bc = holder.GetComponent<BoxCollider>();\n    if (bc == null) bc = holder.AddComponent<BoxCollider>();\n    bc.center = new Vector3(0f, 0.65f, 0f);\n    bc.size = new Vector3(1.92f, 1.30f, 1.92f);\n\n    // Base foundation & dock rim\n    addPart(holderTf, \"Foundation_Apron\", PrimitiveType.Cube, new Vector3(0f, 0.04f, 0f), new Vector3(1.92f, 0.08f, 1.92f), Vector3.zero, matApron);\n    addPart(holderTf, \"Foundation_Curb\", PrimitiveType.Cube, new Vector3(0f, 0.095f, 0f), new Vector3(1.86f, 0.03f, 1.86f), Vector3.zero, matSteel);\n\n    // Main warehouse hall\n    addPart(holderTf, \"Warehouse_Body\", PrimitiveType.Cube, new Vector3(-0.12f, 0.43f, -0.14f), new Vector3(1.26f, 0.64f, 1.18f), Vector3.zero, matFacade);\n    addPart(holderTf, \"Warehouse_Dado\", PrimitiveType.Cube, new Vector3(-0.12f, 0.19f, -0.14f), new Vector3(1.30f, 0.16f, 1.22f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Warehouse_OchreBelt\", PrimitiveType.Cube, new Vector3(-0.12f, 0.69f, -0.14f), new Vector3(1.30f, 0.07f, 1.22f), Vector3.zero, matOchre);\n    addPart(holderTf, \"Warehouse_RoofSlab\", PrimitiveType.Cube, new Vector3(-0.12f, 0.78f, -0.14f), new Vector3(1.34f, 0.08f, 1.26f), Vector3.zero, matSteel);\n\n    // Roof monitor + clerestory glazing + cap\n    addPart(holderTf, \"Warehouse_RoofMonitor\", PrimitiveType.Cube, new Vector3(-0.12f, 0.90f, -0.14f), new Vector3(0.84f, 0.16f, 0.56f), Vector3.zero, matFacade);\n    addPart(holderTf, \"Monitor_Glazing\", PrimitiveType.Cube, new Vector3(-0.12f, 0.905f, -0.14f), new Vector3(0.86f, 0.06f, 0.58f), Vector3.zero, matEmissive);\n    addPart(holderTf, \"Warehouse_RoofMonitorCap\", PrimitiveType.Cube, new Vector3(-0.12f, 1.00f, -0.14f), new Vector3(0.92f, 0.05f, 0.62f), Vector3.zero, matSteel);\n\n    // Structural hall buttresses\n    float[] sideZ = new float[] { -0.58f, -0.14f, 0.30f };\n    for (int i = 0; i < sideZ.Length; i++)\n    {\n        addPart(holderTf, \"Hall_Buttress_L\" + i, PrimitiveType.Cube, new Vector3(-0.755f, 0.43f, sideZ[i]), new Vector3(0.08f, 0.66f, 0.11f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Hall_Buttress_R\" + i, PrimitiveType.Cube, new Vector3(0.515f, 0.43f, sideZ[i]), new Vector3(0.08f, 0.66f, 0.11f), Vector3.zero, matSteel);\n    }\n    float[] endX = new float[] { -0.68f, -0.12f, 0.44f };\n    for (int i = 0; i < endX.Length; i++)\n    {\n        addPart(holderTf, \"Hall_Buttress_F\" + i, PrimitiveType.Cube, new Vector3(endX[i], 0.43f, 0.455f), new Vector3(0.10f, 0.66f, 0.08f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Hall_Buttress_B\" + i, PrimitiveType.Cube, new Vector3(endX[i], 0.43f, -0.735f), new Vector3(0.10f, 0.66f, 0.08f), Vector3.zero, matSteel);\n    }\n\n    // Loading bays (front & back)\n    float[] bayX = new float[] { -0.40f, 0.16f };\n    for (int i = 0; i < bayX.Length; i++)\n    {\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Frame\", PrimitiveType.Cube, new Vector3(bayX[i], 0.31f, 0.465f), new Vector3(0.36f, 0.40f, 0.06f), Vector3.zero, matSteel);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.54f, 0.50f), new Vector3(0.40f, 0.06f, 0.13f), Vector3.zero, matOchre);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Glow\", PrimitiveType.Cube, new Vector3(bayX[i], 0.30f, 0.485f), new Vector3(0.26f, 0.32f, 0.03f), Vector3.zero, matEmissive);\n\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Frame\", PrimitiveType.Cube, new Vector3(bayX[i], 0.31f, -0.745f), new Vector3(0.36f, 0.40f, 0.06f), Vector3.zero, matSteel);\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.54f, -0.78f), new Vector3(0.40f, 0.06f, 0.13f), Vector3.zero, matOchre);\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Glow\", PrimitiveType.Cube, new Vector3(bayX[i], 0.30f, -0.765f), new Vector3(0.26f, 0.32f, 0.03f), Vector3.zero, matEmissive);\n    }\n\n    // Roof vents & comms mast\n    float[] ventX = new float[] { -0.52f, -0.18f, 0.14f };\n    for (int i = 0; i < ventX.Length; i++)\n    {\n        addPart(holderTf, \"Roof_Vent_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.87f, -0.58f), new Vector3(0.13f, 0.06f, 0.13f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Roof_VentRim_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.92f, -0.58f), new Vector3(0.10f, 0.02f, 0.10f), Vector3.zero, matOchre);\n    }\n    addPart(holderTf, \"Roof_MastBase\", PrimitiveType.Cube, new Vector3(0.38f, 0.86f, -0.56f), new Vector3(0.14f, 0.09f, 0.14f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Roof_Mast\", PrimitiveType.Cylinder, new Vector3(0.38f, 1.18f, -0.56f), new Vector3(0.03f, 0.32f, 0.03f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Roof_Beacon\", PrimitiveType.Sphere, new Vector3(0.38f, 1.50f, -0.56f), new Vector3(0.08f, 0.08f, 0.08f), Vector3.zero, matEmissive);\n\n    // Corner dock crane\n    addPart(holderTf, \"Crane_Pedestal\", PrimitiveType.Cylinder, new Vector3(0.70f, 0.25f, 0.62f), new Vector3(0.24f, 0.15f, 0.24f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Crane_Turret\", PrimitiveType.Cube, new Vector3(0.70f, 0.49f, 0.62f), new Vector3(0.22f, 0.20f, 0.28f), new Vector3(0f, -20f, 0f), matOchre);\n    addPart(holderTf, \"Crane_CabGlass\", PrimitiveType.Cube, new Vector3(0.65f, 0.52f, 0.74f), new Vector3(0.15f, 0.08f, 0.05f), new Vector3(0f, -20f, 0f), matEmissive);\n    addPart(holderTf, \"Crane_Mast\", PrimitiveType.Cube, new Vector3(0.72f, 0.80f, 0.56f), new Vector3(0.09f, 0.46f, 0.09f), new Vector3(0f, -20f, 0f), matOchre);\n    addPart(holderTf, \"Crane_Counterweight\", PrimitiveType.Cube, new Vector3(0.78f, 0.68f, 0.44f), new Vector3(0.16f, 0.13f, 0.15f), new Vector3(0f, -20f, 0f), matSteel);\n    addPart(holderTf, \"Crane_Jib\", PrimitiveType.Cube, new Vector3(0.61f, 1.12f, 0.76f), new Vector3(0.065f, 0.065f, 0.72f), new Vector3(-34f, -24f, 0f), matOchre);\n    addPart(holderTf, \"Crane_Cable\", PrimitiveType.Cylinder, new Vector3(0.49f, 1.00f, 0.98f), new Vector3(0.015f, 0.22f, 0.015f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Crane_HookSpreader\", PrimitiveType.Cube, new Vector3(0.49f, 0.77f, 0.98f), new Vector3(0.16f, 0.04f, 0.09f), new Vector3(0f, -24f, 0f), matOchre);\n\n    // Stacked cargo containers\n    addPart(holderTf, \"Cargo_FrontTeal\", PrimitiveType.Cube, new Vector3(-0.44f, 0.20f, 0.72f), new Vector3(0.44f, 0.18f, 0.21f), Vector3.zero, matTeal);\n    addPart(holderTf, \"Cargo_FrontRust\", PrimitiveType.Cube, new Vector3(0.08f, 0.20f, 0.74f), new Vector3(0.42f, 0.18f, 0.21f), new Vector3(0f, 3f, 0f), matRust);\n    addPart(holderTf, \"Cargo_FrontUpperOchre\", PrimitiveType.Cube, new Vector3(-0.39f, 0.375f, 0.72f), new Vector3(0.38f, 0.17f, 0.19f), new Vector3(0f, 7f, 0f), matOchre);\n\n    addPart(holderTf, \"Cargo_SideTeal\", PrimitiveType.Cube, new Vector3(0.73f, 0.20f, -0.36f), new Vector3(0.21f, 0.18f, 0.44f), Vector3.zero, matTeal);\n    addPart(holderTf, \"Cargo_SideRust\", PrimitiveType.Cube, new Vector3(0.73f, 0.20f, 0.14f), new Vector3(0.21f, 0.18f, 0.40f), new Vector3(0f, -3f, 0f), matRust);\n    addPart(holderTf, \"Cargo_SideUpperTeal\", PrimitiveType.Cube, new Vector3(0.73f, 0.375f, -0.32f), new Vector3(0.19f, 0.17f, 0.40f), new Vector3(0f, -5f, 0f), matTeal);\n\n    PrefabUtility.SaveAsPrefabAsset(root, depotPath);\n    sb.AppendLine(\"Saved upgraded Depot.prefab with \" + holderTf.childCount + \" visual parts.\");\n}\nfinally\n{\n    PrefabUtility.UnloadPrefabContents(root);\n}\n\n// Render preview of Depot + Quay deck & wall\nGameObject previewRoot = new GameObject(\"__TEMP_DepotQuayPreview\");\npreviewRoot.transform.position = new Vector3(0f, 500f, 0f);\nCamera cam = null;\nRenderTexture rt = null;\nTexture2D tex = null;\nMesh deckMesh = null;\nMesh wallMesh = null;\ntry\n{\n    Material quayMat = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n\n    GameObject deck = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    deck.name = \"PreviewQuayDeck\";\n    deck.transform.SetParent(previewRoot.transform, false);\n    deck.transform.localPosition = new Vector3(0f, -0.25f, 0f);\n    deck.transform.localScale = new Vector3(4.2f, 0.5f, 4.2f);\n    if (quayMat != null)\n    {\n        deckMesh = UnityEngine.Object.Instantiate(deck.GetComponent<MeshFilter>().sharedMesh);\n        Vector2[] uvs = deckMesh.uv;\n        for (int i = 0; i < uvs.Length; i++)\n        {\n            uvs[i] = new Vector2(Mathf.Lerp(0.03f, 0.46f, uvs[i].x), Mathf.Lerp(0.53f, 0.97f, uvs[i].y));\n        }\n        deckMesh.uv = uvs;\n        deck.GetComponent<MeshFilter>().sharedMesh = deckMesh;\n        deck.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n    }\n\n    GameObject wall = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    wall.name = \"PreviewQuayWall\";\n    wall.transform.SetParent(previewRoot.transform, false);\n    wall.transform.localPosition = new Vector3(0f, -0.52f, 2.11f);\n    wall.transform.localScale = new Vector3(4.2f, 0.90f, 0.08f);\n    if (quayMat != null)\n    {\n        wallMesh = UnityEngine.Object.Instantiate(wall.GetComponent<MeshFilter>().sharedMesh);\n        Vector2[] wuv = wallMesh.uv;\n        for (int i = 0; i < wuv.Length; i++)\n        {\n            wuv[i] = new Vector2(Mathf.Lerp(0.55f, 0.77f, wuv[i].x), Mathf.Lerp(0.04f, 0.46f, wuv[i].y));\n        }\n        wallMesh.uv = wuv;\n        wall.GetComponent<MeshFilter>().sharedMesh = wallMesh;\n        wall.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n    }\n\n    GameObject depotAsset = AssetDatabase.LoadAssetAtPath<GameObject>(depotPath);\n    GameObject depotInst = (GameObject)PrefabUtility.InstantiatePrefab(depotAsset);\n    depotInst.transform.SetParent(previewRoot.transform, false);\n    depotInst.transform.localPosition = Vector3.zero;\n\n    GameObject camGo = new GameObject(\"PreviewCam\");\n    camGo.transform.SetParent(previewRoot.transform, false);\n    camGo.transform.localPosition = new Vector3(2.90f, 2.45f, 3.05f);\n    camGo.transform.LookAt(previewRoot.transform.position + new Vector3(0f, 0.35f, 0.1f));\n    cam = camGo.AddComponent<Camera>();\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = new Color(0.14f, 0.22f, 0.28f, 1f);\n    cam.fieldOfView = 36f;\n\n    GameObject lightGo = new GameObject(\"PreviewKeyLight\");\n    lightGo.transform.SetParent(previewRoot.transform, false);\n    lightGo.transform.rotation = Quaternion.Euler(46f, -138f, 0f);\n    Light l = lightGo.AddComponent<Light>();\n    l.type = LightType.Directional;\n    l.intensity = 1.15f;\n    l.color = new Color(1.0f, 0.97f, 0.92f, 1f);\n\n    int w = 960;\n    int h = 640;\n    rt = new RenderTexture(w, h, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    cam.Render();\n\n    RenderTexture prev = RenderTexture.active;\n    RenderTexture.active = rt;\n    tex = new Texture2D(w, h, TextureFormat.RGBA32, false);\n    tex.ReadPixels(new Rect(0, 0, w, h), 0, 0);\n    tex.Apply();\n    RenderTexture.active = prev;\n\n    string scratchDir = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\";\n    System.IO.Directory.CreateDirectory(scratchDir);\n    string outPath = System.IO.Path.Combine(scratchDir, \"verify_depot.png\");\n    System.IO.File.WriteAllBytes(outPath, tex.EncodeToPNG());\n    sb.AppendLine(\"Rendered preview to: \" + outPath);\n}\nfinally\n{\n    if (cam != null) cam.targetTexture = null;\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (deckMesh != null) UnityEngine.Object.DestroyImmediate(deckMesh);\n    if (wallMesh != null) UnityEngine.Object.DestroyImmediate(wallMesh);\n    UnityEngine.Object.DestroyImmediate(previewRoot);\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
{"ts":"2026-11-15T18:54:41.496Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":8,"params":{}}
{"ts":"2026-11-15T18:55:24.692Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1713,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\nShader litShader = Shader.Find(\"Universal Render Pipeline/Lit\");\nstring matDir = \"Assets/Materials/Buildings/Depot\";\nstring texDir = \"Assets/Textures/Buildings/Depot\";\n\nSystem.Action<string, string, string, Color, float, float, float, Vector2, Color, bool> updateLit =\n    (matName, albedoName, normalName, baseCol, metallic, smoothness, bumpScale, tiling, emissiveCol, useEmission) =>\n{\n    string p = matDir + \"/\" + matName;\n    Material mat = AssetDatabase.LoadAssetAtPath<Material>(p);\n    if (mat == null) { mat = new Material(litShader); AssetDatabase.CreateAsset(mat, p); }\n    mat.shader = litShader;\n    mat.SetColor(\"_BaseColor\", baseCol);\n    mat.SetColor(\"_Color\", baseCol);\n    mat.SetFloat(\"_Metallic\", metallic);\n    mat.SetFloat(\"_Smoothness\", smoothness);\n    if (!string.IsNullOrEmpty(albedoName))\n    {\n        Texture2D alb = AssetDatabase.LoadAssetAtPath<Texture2D>(texDir + \"/\" + albedoName);\n        mat.SetTexture(\"_BaseMap\", alb);\n        mat.SetTexture(\"_MainTex\", alb);\n        mat.SetTextureScale(\"_BaseMap\", tiling);\n        mat.SetTextureScale(\"_MainTex\", tiling);\n    }\n    if (!string.IsNullOrEmpty(normalName))\n    {\n        Texture2D nrm = AssetDatabase.LoadAssetAtPath<Texture2D>(texDir + \"/\" + normalName);\n        mat.SetTexture(\"_BumpMap\", nrm);\n        mat.SetFloat(\"_BumpScale\", bumpScale);\n        mat.SetTextureScale(\"_BumpMap\", tiling);\n        mat.EnableKeyword(\"_NORMALMAP\");\n    }\n    if (useEmission)\n    {\n        mat.EnableKeyword(\"_EMISSION\");\n        mat.SetColor(\"_EmissionColor\", emissiveCol);\n    }\n    else\n    {\n        mat.DisableKeyword(\"_EMISSION\");\n        mat.SetColor(\"_EmissionColor\", Color.black);\n    }\n    EditorUtility.SetDirty(mat);\n};\n\nupdateLit(\"Depot_Apron_Mat.mat\", \"Depot_Paving_Albedo.jpg\", \"Depot_Paving_Normal.png\",\n    new Color(0.78f, 0.80f, 0.82f, 1f), 0.04f, 0.28f, 0.80f, new Vector2(3f, 3f), Color.black, false);\nupdateLit(\"Depot_Facade_Mat.mat\", \"Depot_Facade_Albedo.jpg\", \"Depot_Facade_Normal.png\",\n    new Color(0.60f, 0.66f, 0.72f, 1f), 0.20f, 0.36f, 0.80f, new Vector2(2f, 1f), Color.black, false);\nupdateLit(\"Depot_Steel_Mat.mat\", \"Depot_Metal_Albedo.jpg\", \"Depot_Metal_Normal.png\",\n    new Color(0.28f, 0.31f, 0.36f, 1f), 0.65f, 0.45f, 0.70f, new Vector2(2f, 2f), Color.black, false);\nupdateLit(\"Depot_OchreTrim_Mat.mat\", \"Depot_Brass_Albedo.jpg\", \"Depot_Brass_Normal.png\",\n    new Color(0.90f, 0.63f, 0.22f, 1f), 0.38f, 0.48f, 0.60f, new Vector2(2f, 2f), Color.black, false);\nupdateLit(\"Depot_EmissiveBay_Mat.mat\", null, null,\n    new Color(0.55f, 0.85f, 0.98f, 1f), 0.10f, 0.75f, 0f, Vector2.one,\n    new Color(0.45f, 0.92f, 1.18f, 1f), true);\n\nMaterial matApron = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_Apron_Mat.mat\");\nMaterial matFacade = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_Facade_Mat.mat\");\nMaterial matSteel = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_Steel_Mat.mat\");\nMaterial matOchre = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_OchreTrim_Mat.mat\");\nMaterial matTeal = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_ContainerTeal_Mat.mat\");\nMaterial matRust = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_ContainerRust_Mat.mat\");\nMaterial matEmissive = AssetDatabase.LoadAssetAtPath<Material>(matDir + \"/Depot_EmissiveBay_Mat.mat\");\n\n// Also adjust warm amber lamp accent inside loading bay vs cyan clerestory? Keep 7 materials cleanly:\n// Depot_EmissiveBay_Mat = crisp cool cyan Anno window/sensor glow (0.45, 0.92, 1.18) - never washes out to yellow blocks!\n\nAssetDatabase.SaveAssets();\n\nint buildLayer = 8;\nSystem.Action<Transform, string, PrimitiveType, Vector3, Vector3, Vector3, Material> addPart =\n    (parent, partName, primitive, localPos, localScale, localEuler, mat) =>\n{\n    GameObject go = GameObject.CreatePrimitive(primitive);\n    go.name = partName;\n    go.layer = buildLayer;\n    Collider col = go.GetComponent<Collider>();\n    if (col != null) UnityEngine.Object.DestroyImmediate(col);\n\n    go.transform.SetParent(parent, false);\n    go.transform.localPosition = localPos;\n    go.transform.localScale = localScale;\n    go.transform.localRotation = Quaternion.Euler(localEuler);\n\n    MeshRenderer mr = go.GetComponent<MeshRenderer>();\n    mr.sharedMaterial = mat;\n    mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;\n    mr.receiveShadows = true;\n};\n\nstring depotPath = \"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/Depot.prefab\";\nGameObject root = PrefabUtility.LoadPrefabContents(depotPath);\ntry\n{\n    Transform holderTf = root.transform.Find(\"Model - Placeholder\");\n    for (int i = holderTf.childCount - 1; i >= 0; i--)\n    {\n        UnityEngine.Object.DestroyImmediate(holderTf.GetChild(i).gameObject);\n    }\n\n    // Foundation & perimeter steel curb + corner dock bollards\n    addPart(holderTf, \"Foundation_Apron\", PrimitiveType.Cube, new Vector3(0f, 0.04f, 0f), new Vector3(1.92f, 0.08f, 1.92f), Vector3.zero, matApron);\n    addPart(holderTf, \"Foundation_Curb\", PrimitiveType.Cube, new Vector3(0f, 0.09f, 0f), new Vector3(1.86f, 0.025f, 1.86f), Vector3.zero, matSteel);\n    float[] bollardOffsets = new float[] { -0.82f, 0.82f };\n    for (int bx = 0; bx < 2; bx++)\n    {\n        for (int bz = 0; bz < 2; bz++)\n        {\n            addPart(holderTf, \"Dock_Bollard_\" + bx + \"_\" + bz, PrimitiveType.Cylinder,\n                new Vector3(bollardOffsets[bx], 0.13f, bollardOffsets[bz]),\n                new Vector3(0.055f, 0.045f, 0.055f), Vector3.zero, matOchre);\n        }\n    }\n\n    // Main warehouse hall\n    addPart(holderTf, \"Warehouse_Body\", PrimitiveType.Cube, new Vector3(-0.14f, 0.43f, -0.14f), new Vector3(1.24f, 0.64f, 1.18f), Vector3.zero, matFacade);\n    addPart(holderTf, \"Warehouse_Dado\", PrimitiveType.Cube, new Vector3(-0.14f, 0.18f, -0.14f), new Vector3(1.28f, 0.14f, 1.22f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Warehouse_OchreBelt\", PrimitiveType.Cube, new Vector3(-0.14f, 0.695f, -0.14f), new Vector3(1.28f, 0.065f, 1.22f), Vector3.zero, matOchre);\n    addPart(holderTf, \"Warehouse_RoofSlab\", PrimitiveType.Cube, new Vector3(-0.14f, 0.78f, -0.14f), new Vector3(1.32f, 0.08f, 1.26f), Vector3.zero, matSteel);\n\n    // Roof monitor + skylight strips\n    addPart(holderTf, \"Warehouse_RoofMonitor\", PrimitiveType.Cube, new Vector3(-0.14f, 0.90f, -0.14f), new Vector3(0.84f, 0.16f, 0.56f), Vector3.zero, matFacade);\n    addPart(holderTf, \"Monitor_Glazing\", PrimitiveType.Cube, new Vector3(-0.14f, 0.905f, -0.14f), new Vector3(0.86f, 0.055f, 0.58f), Vector3.zero, matEmissive);\n    addPart(holderTf, \"Warehouse_RoofMonitorCap\", PrimitiveType.Cube, new Vector3(-0.14f, 1.00f, -0.14f), new Vector3(0.92f, 0.05f, 0.62f), Vector3.zero, matSteel);\n\n    // Structural pilasters\n    float[] sideZ = new float[] { -0.58f, -0.14f, 0.30f };\n    for (int i = 0; i < sideZ.Length; i++)\n    {\n        addPart(holderTf, \"Hall_Buttress_L\" + i, PrimitiveType.Cube, new Vector3(-0.765f, 0.43f, sideZ[i]), new Vector3(0.08f, 0.66f, 0.11f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Hall_Buttress_R\" + i, PrimitiveType.Cube, new Vector3(0.485f, 0.43f, sideZ[i]), new Vector3(0.08f, 0.66f, 0.11f), Vector3.zero, matSteel);\n    }\n    float[] endX = new float[] { -0.68f, -0.14f, 0.40f };\n    for (int i = 0; i < endX.Length; i++)\n    {\n        addPart(holderTf, \"Hall_Buttress_F\" + i, PrimitiveType.Cube, new Vector3(endX[i], 0.43f, 0.455f), new Vector3(0.10f, 0.66f, 0.08f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Hall_Buttress_B\" + i, PrimitiveType.Cube, new Vector3(endX[i], 0.43f, -0.735f), new Vector3(0.10f, 0.66f, 0.08f), Vector3.zero, matSteel);\n    }\n\n    // Detailed Loading Bays (dark recessed steel roll-up door + slatted bars + ochre canopy + cyan overhead light strip!)\n    float[] bayX = new float[] { -0.41f, 0.13f };\n    for (int i = 0; i < bayX.Length; i++)\n    {\n        // Front (+Z)\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Frame\", PrimitiveType.Cube, new Vector3(bayX[i], 0.31f, 0.46f), new Vector3(0.36f, 0.40f, 0.07f), Vector3.zero, matSteel);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Door\", PrimitiveType.Cube, new Vector3(bayX[i], 0.28f, 0.478f), new Vector3(0.28f, 0.32f, 0.04f), Vector3.zero, matApron);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_DoorStripe\", PrimitiveType.Cube, new Vector3(bayX[i], 0.24f, 0.485f), new Vector3(0.28f, 0.04f, 0.04f), Vector3.zero, matOchre);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.535f, 0.51f), new Vector3(0.40f, 0.055f, 0.14f), Vector3.zero, matOchre);\n        addPart(holderTf, \"LoadingBay_F\" + i + \"_Light\", PrimitiveType.Cube, new Vector3(bayX[i], 0.48f, 0.495f), new Vector3(0.26f, 0.035f, 0.04f), Vector3.zero, matEmissive);\n\n        // Back (-Z)\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Frame\", PrimitiveType.Cube, new Vector3(bayX[i], 0.31f, -0.74f), new Vector3(0.36f, 0.40f, 0.07f), Vector3.zero, matSteel);\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Door\", PrimitiveType.Cube, new Vector3(bayX[i], 0.28f, -0.758f), new Vector3(0.28f, 0.32f, 0.04f), Vector3.zero, matApron);\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Hood\", PrimitiveType.Cube, new Vector3(bayX[i], 0.535f, -0.79f), new Vector3(0.40f, 0.055f, 0.14f), Vector3.zero, matOchre);\n        addPart(holderTf, \"LoadingBay_B\" + i + \"_Light\", PrimitiveType.Cube, new Vector3(bayX[i], 0.48f, -0.775f), new Vector3(0.26f, 0.035f, 0.04f), Vector3.zero, matEmissive);\n    }\n\n    // Roof vents & comms mast\n    float[] ventX = new float[] { -0.52f, -0.18f, 0.14f };\n    for (int i = 0; i < ventX.Length; i++)\n    {\n        addPart(holderTf, \"Roof_Vent_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.87f, -0.58f), new Vector3(0.13f, 0.06f, 0.13f), Vector3.zero, matSteel);\n        addPart(holderTf, \"Roof_VentRim_\" + i, PrimitiveType.Cylinder, new Vector3(ventX[i], 0.92f, -0.58f), new Vector3(0.10f, 0.02f, 0.10f), Vector3.zero, matOchre);\n    }\n    addPart(holderTf, \"Roof_MastBase\", PrimitiveType.Cube, new Vector3(0.36f, 0.86f, -0.56f), new Vector3(0.14f, 0.09f, 0.14f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Roof_Mast\", PrimitiveType.Cylinder, new Vector3(0.36f, 1.18f, -0.56f), new Vector3(0.03f, 0.32f, 0.03f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Roof_Beacon\", PrimitiveType.Sphere, new Vector3(0.36f, 1.50f, -0.56f), new Vector3(0.07f, 0.07f, 0.07f), Vector3.zero, matEmissive);\n\n    // Corner Dock Crane at (0.68, *, 0.62), facing OUTWARD across harbour corner (+X/+Z -> yaw = +42 deg)\n    Vector3 cranePivot = new Vector3(0.68f, 0f, 0.62f);\n    float craneYaw = 42f; // +Z rotated +42 deg around Y points toward (+0.67, 0, +0.74) outward away from building!\n    float boomTilt = -32f; // negative X rotation pitches +Z upward\n    float boomLen = 0.68f;\n    Vector3 boomBase = cranePivot + new Vector3(0f, 0.88f, 0f);\n    Quaternion boomRot = Quaternion.Euler(boomTilt, craneYaw, 0f);\n    Vector3 boomDir = boomRot * Vector3.forward;\n    Vector3 boomMid = boomBase + boomDir * (boomLen * 0.5f);\n    Vector3 boomTip = boomBase + boomDir * boomLen;\n\n    Vector3 backDir = Quaternion.Euler(0f, craneYaw, 0f) * Vector3.back;\n    Vector3 forwardHoriz = Quaternion.Euler(0f, craneYaw, 0f) * Vector3.forward;\n\n    addPart(holderTf, \"Crane_Pedestal\", PrimitiveType.Cylinder, cranePivot + new Vector3(0f, 0.23f, 0f), new Vector3(0.24f, 0.14f, 0.24f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Crane_Turret\", PrimitiveType.Cube, cranePivot + new Vector3(0f, 0.47f, 0f), new Vector3(0.22f, 0.20f, 0.28f), new Vector3(0f, craneYaw, 0f), matOchre);\n    addPart(holderTf, \"Crane_CabGlass\", PrimitiveType.Cube, cranePivot + forwardHoriz * 0.125f + new Vector3(0f, 0.50f, 0f), new Vector3(0.15f, 0.08f, 0.04f), new Vector3(0f, craneYaw, 0f), matEmissive);\n    addPart(holderTf, \"Crane_Counterweight\", PrimitiveType.Cube, cranePivot + backDir * 0.14f + new Vector3(0f, 0.58f, 0f), new Vector3(0.18f, 0.14f, 0.14f), new Vector3(0f, craneYaw, 0f), matSteel);\n    addPart(holderTf, \"Crane_Mast\", PrimitiveType.Cube, cranePivot + new Vector3(0f, 0.74f, 0f), new Vector3(0.09f, 0.34f, 0.09f), new Vector3(0f, craneYaw, 0f), matOchre);\n    addPart(holderTf, \"Crane_Jib\", PrimitiveType.Cube, boomMid, new Vector3(0.065f, 0.065f, boomLen), new Vector3(boomTilt, craneYaw, 0f), matOchre);\n\n    float spreaderY = 0.72f;\n    float cableH = boomTip.y - spreaderY;\n    addPart(holderTf, \"Crane_Cable\", PrimitiveType.Cylinder,\n        new Vector3(boomTip.x, spreaderY + cableH * 0.5f, boomTip.z),\n        new Vector3(0.015f, cableH * 0.5f, 0.015f), Vector3.zero, matSteel);\n    addPart(holderTf, \"Crane_HookSpreader\", PrimitiveType.Cube,\n        new Vector3(boomTip.x, spreaderY, boomTip.z),\n        new Vector3(0.16f, 0.04f, 0.10f), new Vector3(0f, craneYaw, 0f), matOchre);\n\n    // Stacked cargo containers cleanly positioned in apron yard\n    addPart(holderTf, \"Cargo_FrontTeal\", PrimitiveType.Cube, new Vector3(-0.46f, 0.20f, 0.72f), new Vector3(0.42f, 0.18f, 0.21f), Vector3.zero, matTeal);\n    addPart(holderTf, \"Cargo_FrontRust\", PrimitiveType.Cube, new Vector3(0.05f, 0.20f, 0.73f), new Vector3(0.40f, 0.18f, 0.21f), new Vector3(0f, 3f, 0f), matRust);\n    addPart(holderTf, \"Cargo_FrontUpperOchre\", PrimitiveType.Cube, new Vector3(-0.41f, 0.375f, 0.72f), new Vector3(0.36f, 0.17f, 0.19f), new Vector3(0f, 6f, 0f), matOchre);\n\n    addPart(holderTf, \"Cargo_SideTeal\", PrimitiveType.Cube, new Vector3(0.71f, 0.20f, -0.36f), new Vector3(0.21f, 0.18f, 0.44f), Vector3.zero, matTeal);\n    addPart(holderTf, \"Cargo_SideRust\", PrimitiveType.Cube, new Vector3(0.71f, 0.20f, 0.14f), new Vector3(0.21f, 0.18f, 0.40f), new Vector3(0f, -3f, 0f), matRust);\n    addPart(holderTf, \"Cargo_SideUpperTeal\", PrimitiveType.Cube, new Vector3(0.71f, 0.375f, -0.32f), new Vector3(0.19f, 0.17f, 0.40f), new Vector3(0f, -5f, 0f), matTeal);\n\n    PrefabUtility.SaveAsPrefabAsset(root, depotPath);\n    sb.AppendLine(\"Updated Depot.prefab with outward-pointing crane (\" + holderTf.childCount + \" parts).\");\n}\nfinally\n{\n    PrefabUtility.UnloadPrefabContents(root);\n}\n\n// Re-render verification preview\nGameObject previewRoot = new GameObject(\"__TEMP_DepotQuayPreview\");\npreviewRoot.transform.position = new Vector3(0f, 500f, 0f);\nCamera cam = null;\nRenderTexture rt = null;\nTexture2D tex = null;\nMesh deckMesh = null;\nMesh wallMesh = null;\ntry\n{\n    Material quayMat = AssetDatabase.LoadAssetAtPath<Material>(\"Assets/Game Assets/Quay/Quay Structure.mat\");\n\n    GameObject deck = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    deck.name = \"PreviewQuayDeck\";\n    deck.transform.SetParent(previewRoot.transform, false);\n    deck.transform.localPosition = new Vector3(0f, -0.25f, 0f);\n    deck.transform.localScale = new Vector3(4.2f, 0.5f, 4.2f);\n    if (quayMat != null)\n    {\n        deckMesh = UnityEngine.Object.Instantiate(deck.GetComponent<MeshFilter>().sharedMesh);\n        Vector2[] uvs = deckMesh.uv;\n        for (int i = 0; i < uvs.Length; i++)\n        {\n            uvs[i] = new Vector2(Mathf.Lerp(0.02f, 0.29f, uvs[i].x), Mathf.Lerp(0.55f, 0.95f, uvs[i].y));\n        }\n        deckMesh.uv = uvs;\n        deck.GetComponent<MeshFilter>().sharedMesh = deckMesh;\n        deck.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n    }\n\n    GameObject wall = GameObject.CreatePrimitive(PrimitiveType.Cube);\n    wall.name = \"PreviewQuayWall\";\n    wall.transform.SetParent(previewRoot.transform, false);\n    wall.transform.localPosition = new Vector3(0f, -0.52f, 2.11f);\n    wall.transform.localScale = new Vector3(4.2f, 0.90f, 0.08f);\n    if (quayMat != null)\n    {\n        wallMesh = UnityEngine.Object.Instantiate(wall.GetComponent<MeshFilter>().sharedMesh);\n        Vector2[] wuv = wallMesh.uv;\n        for (int i = 0; i < wuv.Length; i++)\n        {\n            wuv[i] = new Vector2(Mathf.Lerp(0.55f, 0.77f, wuv[i].x), Mathf.Lerp(0.04f, 0.46f, wuv[i].y));\n        }\n        wallMesh.uv = wuv;\n        wall.GetComponent<MeshFilter>().sharedMesh = wallMesh;\n        wall.GetComponent<MeshRenderer>().sharedMaterial = quayMat;\n    }\n\n    GameObject depotAsset = AssetDatabase.LoadAssetAtPath<GameObject>(depotPath);\n    GameObject depotInst = (GameObject)PrefabUtility.InstantiatePrefab(depotAsset);\n    depotInst.transform.SetParent(previewRoot.transform, false);\n    depotInst.transform.localPosition = Vector3.zero;\n\n    GameObject camGo = new GameObject(\"PreviewCam\");\n    camGo.transform.SetParent(previewRoot.transform, false);\n    camGo.transform.localPosition = new Vector3(2.90f, 2.45f, 3.10f);\n    camGo.transform.LookAt(previewRoot.transform.position + new Vector3(0.08f, 0.36f, 0.12f));\n    cam = camGo.AddComponent<Camera>();\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = new Color(0.14f, 0.22f, 0.28f, 1f);\n    cam.fieldOfView = 36f;\n\n    GameObject lightGo = new GameObject(\"PreviewKeyLight\");\n    lightGo.transform.SetParent(previewRoot.transform, false);\n    lightGo.transform.rotation = Quaternion.Euler(46f, -138f, 0f);\n    Light l = lightGo.AddComponent<Light>();\n    l.type = LightType.Directional;\n    l.intensity = 1.25f;\n    l.color = new Color(1.0f, 0.97f, 0.92f, 1f);\n\n    int w = 960;\n    int h = 640;\n    rt = new RenderTexture(w, h, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    cam.Render();\n\n    RenderTexture prev = RenderTexture.active;\n    RenderTexture.active = rt;\n    tex = new Texture2D(w, h, TextureFormat.RGBA32, false);\n    tex.ReadPixels(new Rect(0, 0, w, h), 0, 0);\n    tex.Apply();\n    RenderTexture.active = prev;\n\n    string scratchDir = @\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\";\n    string outPath = System.IO.Path.Combine(scratchDir, \"verify_depot.png\");\n    System.IO.File.WriteAllBytes(outPath, tex.EncodeToPNG());\n    sb.AppendLine(\"Rendered updated verify_depot.png\");\n}\nfinally\n{\n    if (cam != null) cam.targetTexture = null;\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (deckMesh != null) UnityEngine.Object.DestroyImmediate(deckMesh);\n    if (wallMesh != null) UnityEngine.Object.DestroyImmediate(wallMesh);\n    UnityEngine.Object.DestroyImmediate(previewRoot);\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
