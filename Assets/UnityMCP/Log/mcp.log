{"ts":"2026-11-15T18:13:47.672Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":8300,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// Scan ALL 8 Island MapGrids by generating textures on temporary clones, checking SurfaceTint & Control thin dark streaks OR cliff-to-cliff dark curves!\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var srcMg = grids[g];\n    if (!srcMg.name.StartsWith(\"Island \")) continue;\n    var clone = UnityEngine.Object.Instantiate(srcMg.gameObject);\n    clone.name = \"__Probe_\" + srcMg.name;\n    clone.transform.SetParent(srcMg.transform.parent, true);\n    try\n    {\n        var cmg = clone.GetComponent<MapGrid>();\n        var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n        if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n        typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags).Invoke(cmg, null);\n\n        var cmr = clone.GetComponent<MeshRenderer>();\n        var mpb = new MaterialPropertyBlock();\n        cmr.GetPropertyBlock(mpb);\n        Texture2D ctrlSrc = mpb.GetTexture(\"_Control\") as Texture2D;\n        Texture2D tintSrc = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n        Texture2D regSrc = mpb.GetTexture(\"_RegionMask\") as Texture2D;\n        var mv = clone.GetComponent<MeshFilter>().sharedMesh.vertices;\n        int w = tintSrc.width;\n\n        var rt = RenderTexture.GetTemporary(w, w, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);\n        var prev = RenderTexture.active;\n        RenderTexture.active = rt;\n        Graphics.Blit(tintSrc, rt);\n        var tintTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n        tintTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n        tintTex.Apply();\n        Color[] tCols = tintTex.GetPixels();\n        Graphics.Blit(ctrlSrc, rt);\n        var ctrlTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n        ctrlTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n        ctrlTex.Apply();\n        Color[] cCols = ctrlTex.GetPixels();\n        RenderTexture.active = prev;\n        RenderTexture.ReleaseTemporary(rt);\n        UnityEngine.Object.DestroyImmediate(tintTex);\n        UnityEngine.Object.DestroyImmediate(ctrlTex);\n\n        // Scan for thin dark streaks (luma < 0.72 * neighbor at +-2px OR control.r drops sharply) or very dark tint anywhere on land (y > 0.3)\n        int veryDark = 0;\n        int sharpDrop = 0;\n        var vSamples = new System.Collections.Generic.List<string>();\n        for (int pz = 3; pz < w - 3; pz++)\n        {\n            for (int px = 3; px < w - 3; px++)\n            {\n                int idx = pz * w + px;\n                float y = mv[idx].y;\n                if (y < 0.35f) continue;\n                Color tc = tCols[idx];\n                Color cc = cCols[idx];\n                float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n                if (luma < 0.25f || (cc.r + cc.g + cc.b + cc.a) < 0.5f)\n                {\n                    veryDark++;\n                    if (vSamples.Count < 4)\n                        vSamples.Add(string.Format(\"DARK w({0:F1},{1:F1}) y={2:F2} tc={3} cc={4}\",\n                            srcMg.transform.position.x + px/6f, srcMg.transform.position.z + pz/6f, y, tc, cc));\n                }\n                // Sharp 1-3px dark streak where BOTH left+right (or up+down) are >= 1.35x brighter\n                Color tcL = tCols[pz * w + (px - 2)], tcR = tCols[pz * w + (px + 2)];\n                Color tcD = tCols[(pz - 2) * w + px], tcU = tCols[(pz + 2) * w + px];\n                float lL = tcL.r * 0.3f + tcL.g * 0.59f + tcL.b * 0.11f;\n                float lR = tcR.r * 0.3f + tcR.g * 0.59f + tcR.b * 0.11f;\n                float lD = tcD.r * 0.3f + tcD.g * 0.59f + tcD.b * 0.11f;\n                float lU = tcU.r * 0.3f + tcU.g * 0.59f + tcU.b * 0.11f;\n                if ((lL > luma * 1.35f && lR > luma * 1.35f) || (lD > luma * 1.35f && lU > luma * 1.35f))\n                {\n                    sharpDrop++;\n                    if (vSamples.Count < 6)\n                        vSamples.Add(string.Format(\"STREAK w({0:F1},{1:F1}) y={2:F2} l={3:F2} tc={4} cc={5}\",\n                            srcMg.transform.position.x + px/6f, srcMg.transform.position.z + pz/6f, y, luma, tc, cc));\n                }\n            }\n        }\n        sb.AppendLine(string.Format(\"{0} pos={1} w={2} reg={3}x{4} | veryDark={5} sharpDrop={6}\",\n            srcMg.name, srcMg.transform.position, w, regSrc ? regSrc.width : 0, regSrc ? regSrc.height : 0, veryDark, sharpDrop));\n        for (int i = 0; i < vSamples.Count; i++) sb.AppendLine(\"  \" + vSamples[i]);\n    }\n    finally\n    {\n        UnityEngine.Object.DestroyImmediate(clone);\n    }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
