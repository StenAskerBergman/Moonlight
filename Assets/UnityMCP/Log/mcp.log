pGrid).GetMethods(flags))\n{\n    if (m.DeclaringType == typeof(MapGrid) && (m.Name == \"RebuildTerrainTextures\" || m.Name == \"GenerateTerrain\" || m.Name == \"BuildMeshesAndTextures\" || m.Name == \"GenerateIslandTerrain\"))\n    {\n        var ps = m.GetParameters();\n        var pstr = \"\";\n        for (int i = 0; i < ps.Length; i++) pstr += ps[i].ParameterType.Name + \" \" + ps[i].Name + \", \";\n        sb.AppendLine(\"Method: \" + m.Name + \"(\" + pstr + \")\");\n    }\n}\n\n// Inspect TerrainType transitions across SW quadrant of Island 31 in src[9].BuiltCache!\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\nvar list = wtf.GetType().GetProperty(\"Sources\", flags).GetValue(wtf, null) as System.Collections.IList;\nvar src9 = list[9];\nvar st = src9.GetType();\nVector2 orig9 = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src9, null);\nfloat pad9 = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src9, null));\nvar cache9 = st.GetProperty(\"BuiltCache\", flags).GetValue(src9, null);\nvar ct = cache9.GetType();\nint res9 = (int)ct.GetProperty(\"Resolution\", flags).GetValue(cache9, null);\nfloat step9 = (float)ct.GetProperty(\"Step\", flags).GetValue(cache9, null);\nfloat[] h9 = (float[])ct.GetProperty(\"Heights\", flags).GetValue(cache9, null);\nfloat[] sh9 = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache9, null);\nfloat[] mb9 = (float[])ct.GetProperty(\"MountainBoosts\", flags).GetValue(cache9, null);\nvar tt9 = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache9, null);\nvar plat9 = ct.GetProperty(\"PlateauData\", flags).GetValue(cache9, null) as System.Array;\n\n// ASCII map of Island 31 (world x=0..60, z=-90..-30, step=1m) showing TerrainTypes & Heights!\nsb.AppendLine(\"=== Island 31 (x=0..60, z=-90..-30, 1m step) TerrainTypes ===\");\nsb.AppendLine(\"Legend: ~=Water .=Beach G=Grass H=Highland L=Land M=Mountain C=Cliff R=River *=Other\");\nfor (int wz = -40; wz >= -88; wz -= 2)\n{\n    sb.Append(string.Format(\"z={0,3}: \", wz));\n    int iz = Mathf.RoundToInt((wz - orig9.y + pad9) / step9);\n    for (int wx = 0; wx <= 60; wx += 1)\n    {\n        int ix = Mathf.RoundToInt((wx - orig9.x + pad9) / step9);\n        if (ix < 0 || ix >= res9 || iz < 0 || iz >= res9) { sb.Append(' '); continue; }\n        int cidx = iz * res9 + ix;\n        string t = tt9.GetValue(cidx).ToString();\n        char ch = t == \"Water\" || t == \"Ocean\" || t == \"Sea\" || t == \"Shallow\" || t == \"Deep\" ? '~'\n            : t == \"Beach\" ? '.'\n            : t == \"Grass\" ? 'G'\n            : t == \"Land\" ? 'L'\n            : t == \"Highland\" ? 'H'\n            : t == \"Mountain\" ? 'M'\n            : t == \"Cliff\" ? 'C'\n            : t == \"River\" ? 'R'\n            : '*';\n        sb.Append(ch);\n    }\n    sb.AppendLine(\"\");\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
