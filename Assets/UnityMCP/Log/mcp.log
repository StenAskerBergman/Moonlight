loat[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache, null);\n    float[] sh = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache, null);\n    float[] hm = (float[])ct.GetProperty(\"HeadlandMasks\", flags).GetValue(cache, null);\n    float[] sc = (float[])ct.GetProperty(\"ShoreCurvatures\", flags).GetValue(cache, null);\n    var tt = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache, null);\n\n    int scz = Mathf.RoundToInt((pts[k].y - orig.y + pad) / step);\n    int scx = Mathf.RoundToInt((pts[k].x - orig.x + pad) / step);\n    sb.AppendLine(\"=== \" + names[k] + \" (Grid 5x5 heights + column dz=-4..4) ===\");\n    for (int dz = 4; dz >= -4; dz--)\n    {\n        sb.Append(string.Format(\"dz={0,2}: \", dz));\n        for (int dx = -4; dx <= 4; dx++)\n            sb.Append(string.Format(\"{0,6:F3} \", h[(scz + dz) * res + (scx + dx)]));\n        sb.AppendLine(\"\");\n    }\n    for (int dz = -4; dz <= 4; dz++)\n    {\n        int idx = (scz + dz) * res + scx;\n        sb.AppendLine(string.Format(\"  dz={0,2}: h={1:F4} bf={2:F3} sf={3:F3} mb={4:F3} ma={5:F3} rc={6:F3} sh={7:F2} hm={8:F3} sc={9:F3} tt={10}\",\n            dz, h[idx], bf[idx], sf[idx], mb[idx], ma[idx], rc[idx], sh[idx], hm[idx], sc[idx], tt.GetValue(idx)));\n    }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
