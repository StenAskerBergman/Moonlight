0; x < r; x++) {\n                    int idx = z * r + x;\n                    float wx = org.x + x * st - pad;\n                    float wz = org.y + z * st - pad;\n                    if (cache.Heights[idx] > s.Settings.waterHeight) {\n                        landPts++;\n                        if (wx < minX) minX = wx; if (wx > maxX) maxX = wx;\n                        if (wz < minZ) minZ = wz; if (wz > maxZ) maxZ = wz;\n                    }\n                    if (cache.Attribution != null && cache.Attribution.DominantRiverIds != null && cache.Attribution.DominantRiverIds[idx] >= 0) riverPts++;\n                }\n            }\n        }\n        if (gt == \"Island\" || landPts > 0) {\n            sb.AppendLine(\"  src[\" + i + \"] \" + gt + \" size=\" + sz + \" org=\" + org + \" landBox=[\" + minX.ToString(\"F1\") + \"..\" + maxX.ToString(\"F1\") + \", \" + minZ.ToString(\"F1\") + \"..\" + maxZ.ToString(\"F1\") + \"] landPts=\" + landPts + \" rivPts=\" + riverPts);\n        }\n    }\n\n    // Check WHERE rivers & sharp height steps & texture seams occur inside flatland\n    sb.AppendLine(\"=== Checking RiverPlan & Sharp Seams on Islands ===\");\n    for (int i = 0; i < srcs.Count; i++) {\n        var s = srcs[i];\n        if (gtF.GetValue(s).ToString() != \"Island\") continue;\n        var cache = bcProp.GetValue(s) as TerrainSampleCache;\n        UnityEngine.Vector2 org = (UnityEngine.Vector2)orgF.GetValue(s);\n        int pad = (int)padF.GetValue(s);\n        var rp = rpF != null ? rpF.GetValue(s) as RiverPlan : null;\n        int r = cache.Resolution;\n        float st = cache.Step;\n\n        // Inspect RiverPlan channels and max slope / dip in river carving vs mainland!\n        int riverCount = (rp != null && rp.Channels != null) ? rp.Channels.Count : 0;\n        int dryRiverCarveCount = 0;\n        float minDryRiverH = 99f, maxDryRiverH = -99f;\n        int narrowTrenchCount = 0;\n        int sampleShown = 0;\n        for (int z = 2; z < r - 2; z++) {\n            for (int x = 2; x < r - 2; x++) {\n                int idx = z * r + x;\n                float h = cache.Heights[idx];\n                int rid = (cache.Attribution != null && cache.Attribution.DominantRiverIds != null) ? cache.Attribution.DominantRiverIds[idx] : -1;\n                if (rid >= 0) {\n                    if (h > 0.3f) {\n                        dryRiverCarveCount++;\n                        if (h < minDryRiverH) minDryRiverH = h;\n                        if (h > maxDryRiverH) maxDryRiverH = h;\n                    }\n                }\n                // Check sharp V-trench or step on flatland [0.4..1.2]\n                if (h > 0.45f && h < 1.15f) {\n                    float hL = cache.Heights[idx-1], hR = cache.Heights[idx+1], hD = cache.Heights[idx-r], hU = cache.Heights[idx+r];\n                    float avg = 0.25f * (hL + hR + hD + hU);\n                    if (avg - h > 0.025f) {\n                        narrowTrenchCount++;\n                        if (sampleShown < 3 && rid >= 0) {\n                            sampleShown++;\n                            sb.AppendLine(\"    RiverDip (\" + x + \",\" + z + \") w=(\" + (org.x + x*st - pad).ToString(\"F1\") + \",\" + (org.y + z*st - pad).ToString(\"F1\") + \") h=\" + h.ToString(\"F3\") + \" rid=\" + rid\n                                + \" nbrs=[\" + hL.ToString(\"F3\") + \",\" + hR.ToString(\"F3\") + \",\" + hD.ToString(\"F3\") + \",\" + hU.ToString(\"F3\") + \"]\");\n                        }\n                    }\n                }\n            }\n        }\n        sb.AppendLine(\"  Isl org=\" + org + \": rivers=\" + riverCount + \" dryRiverSamples=\" + dryRiverCarveCount\n            + (dryRiverCarveCount > 0 ? \" h=[\" + minDryRiverH.ToString(\"F2\") + \"..\" + maxDryRiverH.ToString(\"F2\") + \"]\" : \"\")\n            + \" narrowDips(>0.025)=\" + narrowTrenchCount + \" regActive=\" + raF.GetValue(s));\n\n        if (rp != null && rp.Channels != null) {\n            for 