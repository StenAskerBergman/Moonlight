flags).GetValue(cache, null);\n    float[] rCarves = (float[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache, null);\n    float[] shDists = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache, null);\n    var ttypes = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache, null);\n    var landF = st.GetField(\"ownedLandform\", flags).GetValue(src);\n\n    int flatHS = 0, flatRC = 0, flatStep = 0, flatRiverTT = 0;\n    var samples = new System.Collections.Generic.List<string>();\n    for (int iz = 2; iz < res - 2; iz++)\n    {\n        for (int ix = 2; ix < res - 2; ix++)\n        {\n            int idx = iz * res + ix;\n            float h = heights[idx];\n            float mb = mBoosts[idx];\n            float sl = slopes[idx];\n            float rc = rCarves[idx];\n            string tt = ttypes.GetValue(idx).ToString();\n            if (h > 0.55f && h < 1.25f && mb < 0.05f && shDists[idx] > 1.5f)\n            {\n                float md = Mathf.Max(Mathf.Abs(heights[idx + 1] - heights[idx - 1]), Mathf.Abs(heights[idx + res] - heights[idx - res]));\n                bool hit = false;\n                if (sl > 0.25f) { flatHS++; hit = true; }\n                if (rc > 0.001f) { flatRC++; hit = true; }\n                if (md > 0.04f) { flatStep++; hit = true; }\n                if (tt == \"River\" || tt == \"Water\" || tt == \"Stream\" || tt == \"Lake\" || tt == \"WaterFall\" || tt == \"Rock\" || tt == \"Cliff\")\n                {\n                    flatRiverTT++;\n                    hit = true;\n                }\n                if (hit && samples.Count < 12 && (s == 9 || s == 10))\n                {\n                    float wx = orig.x - pad + ix * step;\n                    float wz = orig.y - pad + iz * step;\n                    samples.Add(string.Format(\"({0:F2},{1:F2}) h={2:F3} sl={3:F3} rc={4:F3} md={5:F3} tt={6}\", wx, wz, h, sl, rc, md, tt));\n                }\n            }\n        }\n    }\n    sb.AppendL