{"ts":"2026-11-15T18:28:56.943Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2298,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeBRLine\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mf = clone.GetComponent<MeshFilter>();\n    var verts = mf.sharedMesh.vertices;\n    var norms = mf.sharedMesh.normals;\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var origCtrl = mpb.GetTexture(\"_Control\") as Texture2D;\n    var origTint = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n\n    camGo = new GameObject(\"__ProbeBRCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    // 1) Scan bottom-right tan seabed box: px x=[390..495], y=[45..160]\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    var pxs = tex.GetPixels32();\n\n    var linePts = new System.Collections.Generic.List<Vector2Int>();\n    for (int y = 45; y <= 160; y++)\n    for (int x = 390; x <= 495; x++)\n    {\n        var c = pxs[y * 512 + x];\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        // Compare against neighbors +-2..3 px (tan seabed around it is ~0.27 lum)\n        float nSum = 0f; int nc = 0;\n        for (int dy = -3; dy <= 3; dy += 3)\n        for (int dx = -3; dx <= 3; dx += 3)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var n = pxs[(y + dy) * 512 + (x + dx)];\n            nSum += (0.299f * n.r + 0.587f * n.g + 0.114f * n.b) / 255f;\n            nc++;\n        }\n        float avg = nSum / nc;\n        if (avg > 0.18f && lum < avg * 0.45f)\n            linePts.Add(new Vector2Int(x, y));\n    }\n    sb.AppendLine(\"BR seabed sharp black pixels: \" + linePts.Count);\n    for (int i = 0; i < Mathf.Min(10, linePts.Count); i++)\n    {\n        var pt = linePts[i];\n        float lx = (pt.x + 0.5f) / 512f * 90f;\n        float lz = (pt.y + 0.5f) / 512f * 90f;\n        int gx = Mathf.Clamp(Mathf.RoundToInt(lx / 90f * 540f), 2, 538);\n        int gz = Mathf.Clamp(Mathf.RoundToInt(lz / 90f * 540f), 2, 538);\n        var c = pxs[pt.y * 512 + pt.x];\n        sb.AppendLine(string.Format(\"  BR#{0} px=({1},{2}) local=({3:F2},{4:F2}) g=({5},{6}) y=({7:F3},{8:F3},{9:F3}) n={10:F3} c=({11},{12},{13})\",\n            i, pt.x, pt.y, lx, lz, gx, gz,\n            verts[gz * 541 + gx - 1].y, verts[gz * 541 + gx].y, verts[gz * 541 + gx + 1].y,\n            norms[gz * 541 + gx], c.r, c.g, c.b));\n    }\n\n    // Check which variation removes those BR linePts!\n    System.Action<string> evalBR = (lbl) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        var p = tex.GetPixels32();\n        int stillDark = 0; Color32 ex = new Color32(255,255,255,255);\n        foreach (var pt in linePts)\n        {\n            var c = p[pt.y * 512 + pt.x];\n            var nb = p[(pt.y + 3) * 512 + pt.x];\n            float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n            float nlum = (0.299f * nb.r + 0.587f * nb.g + 0.114f * nb.b) / 255f;\n            if (nlum > 0.15f && lum < nlum * 0.5f) stillDark++;\n            if (c.r + c.g + c.b < ex.r + ex.g + ex.b) ex = c;\n        }\n        sb.AppendLine(lbl + \": stillDark=\" + stillDark + \"/\" + linePts.Count + \" darkest=(\" + ex.r + \",\" + ex.g + \",\" + ex.b + \")\");\n    };\n\n    // Pass 1: No Shadows\n    var lights = UnityEngine.Object.FindObjectsOfType<Light>();\n    var oldSh = new LightShadows[lights.Length];\n    for (int i = 0; i < lights.Length; i++) { oldSh[i] = lights[i].shadows; lights[i].shadows = LightShadows.None; }\n    evalBR(\"1_noShadows\");\n    for (int i = 0; i < lights.Length; i++) lights[i].shadows = oldSh[i];\n\n    // Pass 2: _UseSurfaceTint = 0\n    var testMpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(testMpb);\n    testMpb.SetFloat(\"_UseSurfaceTint\", 0f);\n    mr.SetPropertyBlock(testMpb);\n    evalBR(\"2_noSurfaceTint\");\n\n    // Pass 3: _Control flat seabed (0,0,0,1)\n    var flatCtrl = new Texture2D(4, 4, TextureFormat.RGBA32, false);\n    var fc = new Color[16]; for (int i = 0; i < 16; i++) fc[i] = new Color(0, 0, 0, 1);\n    flatCtrl.SetPixels(fc); flatCtrl.Apply();\n    testMpb.SetTexture(\"_Control\", flatCtrl);\n    mr.SetPropertyBlock(testMpb);\n    evalBR(\"3_flatCtrl_noTint\");\n\n    // Pass 4: _Control ORIGINAL, _SurfaceTint=0, _SeabedNormal = flat\n    mr.SetPropertyBlock(mpb);\n    var origMat = mr.sharedMaterial;\n    var testMat = new Material(origMat);\n    testMat.SetTexture(\"_SeabedNormal\", Texture2D.normalTexture);\n    mr.sharedMaterial = testMat;\n    evalBR(\"4_flatSeabedNormal\");\n\n    // Pass 5: _SeabedAlbedo = white, _SeabedNormal = flat\n    testMat.SetTexture(\"_SeabedAlbedo\", Texture2D.whiteTexture);\n    evalBR(\"5_whiteSeabed_flatNormal\");\n\n    // Pass 6: URP/Lit gray!\n    mr.sharedMaterial = origMat;\n    UnityEngine.Object.DestroyImmediate(testMat);\n    var plainLit = new Material(Shader.Find(\"Universal Render Pipeline/Lit\"));\n    plainLit.color = Color.gray;\n    mr.sharedMaterial = plainLit;\n    mr.SetPropertyBlock(null);\n    evalBR(\"6_plainLit_noMPB\");\n\n    mr.sharedMaterial = origMat;\n    mr.SetPropertyBlock(mpb);\n    UnityEngine.Object.DestroyImmediate(plainLit);\n    UnityEngine.Object.DestroyImmediate(flatCtrl);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
