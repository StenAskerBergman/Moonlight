{"ts":"2026-11-15T18:26:31.528Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2274,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeDarkPixel\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    foreach (Transform ch in clone.GetComponentsInChildren<Transform>(true)) ch.gameObject.layer = 31;\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mat = mr.sharedMaterial;\n\n    camGo = new GameObject(\"__ProbeDarkCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    var pxs = tex.GetPixels32();\n\n    // Find ALL 17 dark pixels in local (26..34, 1..5) -> px x in [148..193], y in [6..28]\n    // And inspect the EXACT mesh triangle, normals, and TerrainSampleCache at EVERY ONE OF THEM!\n    var mf = clone.GetComponent<MeshFilter>();\n    var verts = mf.sharedMesh.vertices;\n    var norms = mf.sharedMesh.normals;\n    var mc = clone.GetComponent<MeshCollider>();\n\n    int shown = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        float avgN = 0f; int nc = 0;\n        for (int dy = -3; dy <= 3; dy += 3)\n        for (int dx = -3; dx <= 3; dx += 3)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var n = pxs[(y + dy) * 512 + (x + dx)];\n            avgN += (0.299f * n.r + 0.587f * n.g + 0.114f * n.b) / 255f;\n            nc++;\n        }\n        if (lum < (avgN / nc) * 0.5f && shown < 10)\n        {\n            float wx = i31.transform.position.x + ((x + 0.5f) / 512f) * 90f;\n            float wz = i31.transform.position.z + ((y + 0.5f) / 512f) * 90f;\n            int gx = Mathf.Clamp(Mathf.RoundToInt((wx - i31.transform.position.x) / 90f * 540f), 1, 539);\n            int gz = Mathf.Clamp(Mathf.RoundToInt((wz - i31.transform.position.z) / 90f * 540f), 1, 539);\n            int vi = gz * 541 + gx;\n            sb.AppendLine(string.Format(\"DARK px=({0},{1}) local=({2:F2},{3:F2}) c=({4},{5},{6}) n[{7},{8}]={9:F3} n-1={10:F3} n+1={11:F3}\",\n                x, y, wx - i31.transform.position.x, wz - i31.transform.position.z, c.r, c.g, c.b,\n                gx, gz, norms[vi], norms[vi - 1], norms[vi + 1]));\n            shown++;\n        }\n    }\n\n    // ALSO test _DebugView = 1 (samples _BaseMap directly via Unlit!), and test a custom shader that outputs normalWS vs TerrainSplatNormal's EvaluateSurface!\n    var testMat = new Material(mat);\n    testMat.SetFloat(\"_DebugView\", 1f);\n    testMat.SetTexture(\"_BaseMap\", Texture2D.whiteTexture);\n    mr.sharedMaterial = testMat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    pxs = tex.GetPixels32();\n    int dbgDark = 0;\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        if (c.r + c.g + c.b < 700) dbgDark++;\n    }\n    sb.AppendLine(\"_DebugView=1 white dark=\" + dbgDark);\n\n    // Test what _MacroStrength=0 AND _UseSurfaceTint=0 AND flatTextures gives\n    testMat.SetFloat(\"_DebugView\", 0f);\n    testMat.SetFloat(\"_MacroStrength\", 0f);\n    testMat.SetFloat(\"_UseSurfaceTint\", 0f);\n    testMat.SetTexture(\"_SeabedAlbedo\", Texture2D.whiteTexture);\n    testMat.SetTexture(\"_SeabedNormal\", Texture2D.normalTexture);\n    mr.sharedMaterial = testMat;\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    pxs = tex.GetPixels32();\n    int minS = 999; Color32 minC = new Color32(255,255,255,255);\n    for (int y = 6; y <= 28; y++)\n    for (int x = 148; x <= 193; x++)\n    {\n        var c = pxs[y * 512 + x];\n        if (c.r + c.g + c.b < minS) { minS = c.r + c.g + c.b; minC = c; }\n    }\n    sb.AppendLine(string.Format(\"_UseSurfaceTint=0 _Macro=0 whiteSeabed flatNormal minSum={0} minC=({1},{2},{3})\", minS, minC.r, minC.g, minC.b));\n\n    // Also test switching to Shader \"Universal Render Pipeline/Unlit\" vs \"Universal Render Pipeline/Lit\" vs checking if DepthNormals / SSAO / Camera Clear affects it\n    mr.sharedMaterial = mat;\n    UnityEngine.Object.DestroyImmediate(testMat);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
