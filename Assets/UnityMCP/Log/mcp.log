{"ts":"2026-11-15T18:18:56.048Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1360,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// 1. Scan ALL 8 Islands for strict 1-sample creases: lap > 0.025 (or |y - avg4| > 0.025) where 5x5 height in 0.55..1.25\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (!mg.name.StartsWith(\"Island \")) continue;\n    var m = mg.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n    if (side * side != m.vertexCount) continue;\n\n    int lapCnt = 0;\n    float maxLap = 0f;\n    var samples = new System.Collections.Generic.List<string>();\n    for (int z = 3; z < side - 3; z++)\n    {\n        for (int x = 3; x < side - 3; x++)\n        {\n            int idx = z * side + x;\n            float y = v[idx].y;\n            if (y < 0.60f || y > 1.15f) continue;\n            float min5 = 99f, max5 = -99f;\n            for (int dz = -2; dz <= 2; dz++)\n                for (int dx = -2; dx <= 2; dx++)\n                {\n                    float nyv = v[(z + dz) * side + (x + dx)].y;\n                    if (nyv < min5) min5 = nyv;\n                    if (nyv > max5) max5 = nyv;\n                }\n            if (min5 > 0.55f && max5 < 1.25f)\n            {\n                float avg4 = 0.25f * (v[idx - 1].y + v[idx + 1].y + v[idx - side].y + v[idx + side].y);\n                float lap = Mathf.Abs(y - avg4);\n                if (lap > 0.020f)\n                {\n                    lapCnt++;\n                    if (lap > maxLap) maxLap = lap;\n                    if (samples.Count < 10)\n                    {\n                        Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                        samples.Add(string.Format(\"({0:F2},{1:F2}) y={2:F3} lap={3:F3}\", wp.x, wp.z, y, lap));\n                    }\n                }\n            }\n        }\n    }\n    sb.AppendLine(string.Format(\"{0}: flatLap(>0.020)={1} maxLap={2:F4}\", mg.name, lapCnt, maxLap));\n    for (int i = 0; i < samples.Count; i++) sb.AppendLine(\"  \" + samples[i]);\n}\n\n// 2. Also check ALL Terrain meshes WITHOUT height ceiling (e.g. y in 0.1..5.0) for |y - 0.5*(y[x-1]+y[x+1])| or |y - 0.5*(y[z-1]+y[z+1])| creating a 1-sample TRENCH (y < min(neighbors) - 0.03) OR 1-sample RIDGE (y > max(neighbors) + 0.03)!\nsb.AppendLine(\"=== Strict 1-sample V-TRENCH (y < min4 - 0.02) or RIDGE (y > max4 + 0.02) anywhere on y>0.1 ===\");\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (!mg.name.StartsWith(\"Island \")) continue;\n    var m = mg.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n    if (side * side != m.vertexCount) continue;\n\n    int trench = 0, ridge = 0;\n    var samples = new System.Collections.Generic.List<string>();\n    for (int z = 2; z < side - 2; z++)\n    {\n        for (int x = 2; x < side - 2; x++)\n        {\n            int idx = z * side + x;\n            float y = v[idx].y;\n            if (y < 0.2f) continue;\n            float yL = v[idx - 1].y, yR = v[idx + 1].y, yD = v[idx - side].y, yU = v[idx + side].y;\n            bool isTrenchX = (yL - y > 0.02f && yR - y > 0.02f);\n            bool isTrenchZ = (yD - y > 0.02f && yU - y > 0.02f);\n            bool isRidgeX = (y - yL > 0.02f && y - yR > 0.02f);\n            bool isRidgeZ = (y - yD > 0.02f && y - yU > 0.02f);\n            if (isTrenchX || isTrenchZ)\n            {\n                trench++;\n                if (samples.Count < 6)\n                {\n                    Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                    samples.Add(string.Format(\"TRENCH ({0:F2},{1:F2}) y={2:F3}\", wp.x, wp.z, y));\n                }\n            }\n            if (isRidgeX || isRidgeZ)\n            {\n                ridge++;\n                if (samples.Count < 6)\n                {\n                    Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                    samples.Add(string.Format(\"RIDGE ({0:F2},{1:F2}) y={2:F3}\", wp.x, wp.z, y));\n                }\n            }\n        }\n    }\n    sb.AppendLine(string.Format(\"  {0}: trench1px={1} ridge1px={2}\", mg.name, trench, ridge));\n    for (int i = 0; i < samples.Count; i++) sb.AppendLine(\"    \" + samples[i]);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
