{"ts":"2026-11-15T18:46:28.264Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1277,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nvar tf = mm.GetTerrainField();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\nvar sourcesList = tf.GetType().GetField(\"sources\", flags).GetValue(tf) as System.Collections.IList;\nvar src = sourcesList[7] as IslandTerrainProvider;\nvar plan = src.Reservations.RiverPlans[0];\nvar cache = typeof(IslandTerrainProvider).GetField(\"sampleCache\", flags).GetValue(src) as TerrainSampleCache;\nint r = cache.Resolution;\nfloat step = cache.Step;\n\nFunc<Vector2, int, float> noise = (p, sd) => {\n    float sx = (sd & 1023) * 0.017f;\n    float sz = ((sd >> 10) & 1023) * 0.019f;\n    float broad = Mathf.PerlinNoise(p.x * 0.055f + sx, p.y * 0.055f + sz) * 2f - 1f;\n    float detail = Mathf.PerlinNoise(p.x * 0.17f + sz + 41.3f, p.y * 0.17f + sx - 23.7f) * 2f - 1f;\n    return broad * 0.72f + detail * 0.28f;\n};\nvar seedFld = typeof(IslandTerrainProvider).GetField(\"chunkSeed\", flags);\nint seed = (int)seedFld.GetValue(src);\n\nint[,] cells = new int[,] { {531, 351}, {531, 352}, {532, 352} };\nfor (int c = 0; c < 3; c++)\n{\n    int cx = cells[c, 0], cz = cells[c, 1];\n    Vector2 p = new Vector2(cx * step, cz * step);\n    int idx = cz * r + cx;\n    float rc = Mathf.Clamp01(cache.Slopes[idx] * 0.85f + cache.MountainBoosts[idx] * 0.18f);\n    float m = noise(p, seed);\n    sb.AppendLine(string.Format(\"=== Cell ({0},{1}) p={2} macro={3:F3} rc={4:F3} ===\", cx, cz, p, m, rc));\n    for (int i = 0; i < plan.Sections.Count - 1; i++)\n    {\n        var a = plan.Sections[i];\n        var b = plan.Sections[i + 1];\n        Vector2 seg = b.Centre - a.Centre;\n        float len2 = seg.sqrMagnitude;\n        if (len2 < 1e-5f) continue;\n        float along = Mathf.Clamp01(Vector2.Dot(p - a.Centre, seg) / len2);\n        Vector2 centre = Vector2.Lerp(a.Centre, b.Centre, along);\n        Vector2 lat = Vector2.Lerp(a.Lateral, b.Lateral, along).normalized;\n        float signed = Vector2.Dot(p - centre, lat);\n        float across = Vector2.Distance(p, centre);\n        bool left = signed < 0f;\n        float rExt = Mathf.Lerp(left ? a.LeftBank.Extent : a.RightBank.Extent, left ? b.LeftBank.Extent : b.RightBank.Extent, along);\n        float wW = Mathf.Lerp(left ? a.LeftWaterWidth : a.RightWaterWidth, left ? b.LeftWaterWidth : b.RightWaterWidth, along) * (1f + m * 0.1f);\n        float vv = Mathf.Max(0.25f, 1f + m * 0.16f);\n        float outer = wW + rExt * vv;\n        if (across <= outer + 0.5f)\n            sb.AppendLine(string.Format(\"  seg[{0}] along={1:F2} left={2} across={3:F3} wW={4:F2} rExt={5:F2} outer={6:F3} wH={7:F2}\",\n                i, along, left, across, wW, rExt, outer, Mathf.Lerp(a.WaterHeight, b.WaterHeight, along)));\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
