{"ts":"2026-11-15T17:54:40.062Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1287,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\n// 1. All 18 MapGrid objects\nvar grids = UnityEngine.Resources.FindObjectsOfTypeAll<MapGrid>();\nsb.AppendLine(\"=== All MapGrids (\" + grids.Length + \") ===\");\nfor (int i = 0; i < grids.Length; i++) {\n    var g = grids[i];\n    if (UnityEditor.EditorUtility.IsPersistent(g.gameObject)) continue;\n    var mr = g.GetComponent<UnityEngine.MeshRenderer>();\n    var mf = g.GetComponent<UnityEngine.MeshFilter>();\n    var mesh = mf != null ? mf.sharedMesh : null;\n    float minY = 999f, maxY = -999f, maxBY = -999f;\n    if (mesh != null) {\n        var v = mesh.vertices;\n        int side = UnityEngine.Mathf.RoundToInt(UnityEngine.Mathf.Sqrt(v.Length));\n        for (int z = 0; z < side; z++) {\n            for (int x = 0; x < side; x++) {\n                float y = v[z * side + x].y;\n                if (y < minY) minY = y;\n                if (y > maxY) maxY = y;\n                if (x == 0 || z == 0 || x == side - 1 || z == side - 1) if (y > maxBY) maxBY = y;\n            }\n        }\n    }\n    sb.AppendLine(\"  \" + g.gameObject.name + \" act=\" + g.gameObject.activeInHierarchy + \" mr=\" + (mr != null && mr.enabled)\n        + \" type=\" + g.currentGridType + \" pos=\" + g.transform.position\n        + \" y=[\" + minY.ToString(\"F2\") + \"..\" + maxY.ToString(\"F2\") + \"] maxBY=\" + maxBY.ToString(\"F2\"));\n}\n\n// 2. Inspect Island 31 sampleCache & terrain texture features across flatland [0.45..1.15]\nvar isl31 = UnityEngine.GameObject.Find(\"Island 31\");\nif (isl31 != null) {\n    var mg31 = isl31.GetComponent<MapGrid>();\n    var tpF = typeof(MapGrid).GetField(\"terrainProvider\", flags);\n    var tp = tpF != null ? tpF.GetValue(mg31) as IslandTerrainProvider : null;\n    sb.AppendLine(\"=== Island 31 terrainProvider=\" + (tp != null) + \" ===\");\n    if (tp == null) {\n        // Trigger EnsureTerrainProvider? Check methods on MapGrid\n        var m = typeof(MapGrid).GetMethod(\"InitializeTerrainProvider\", flags) ?? typeof(MapGrid).GetMethod(\"EnsureTerrainProvider\", flags);\n        sb.AppendLine(\"  MapGrid init method=\" + (m != null ? m.Name : \"null\"));\n    }\n    var mf = isl31.GetComponent<UnityEngine.MeshFilter>();\n    var mesh = mf.sharedMesh;\n    var verts = mesh.vertices;\n    var norms = mesh.normals;\n    int side = UnityEngine.Mathf.RoundToInt(UnityEngine.Mathf.Sqrt(verts.Length));\n\n    // Find ANY narrow dip/trench in flatland (where center y < avg(L,R,D,U) - 0.015 or < min - 0.01, and neighbors in [0.5, 1.2])\n    int dipCount = 0;\n    float worstDip = 0f;\n    int worstDipIdx = -1;\n    int stepCount = 0;\n    float worstStep = 0f;\n    int worstStepIdx = -1;\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            float yL = verts[idx-1].y, yR = verts[idx+1].y, yD = verts[idx-side].y, yU = verts[idx+side].y;\n            if (yL > 0.55f && yR > 0.55f && yD > 0.55f && yU > 0.55f && yL < 1.15f && yR < 1.15f && yD < 1.15f && yU < 1.15f) {\n                float avg = 0.25f * (yL + yR + yD + yU);\n                float dip = avg - y;\n                if (dip > 0.015f) {\n                    dipCount++;\n                    if (dip > worstDip) { worstDip = dip; worstDipIdx = idx; }\n                }\n                float spanX = UnityEngine.Mathf.Abs(yL - yR);\n                float spanZ = UnityEngine.Mathf.Abs(yD - yU);\n                float sp = UnityEngine.Mathf.Max(spanX, spanZ);\n                if (sp > 0.08f) {\n                    stepCount++;\n                    if (sp > worstStep) { worstStep = sp; worstStepIdx = idx; }\n                }\n            }\n        }\n    }\n    sb.AppendLine(\"  Flatland (all 4 nbrs in [0.55..1.15]): dips(>0.015)=\" + dipCount + \" worstDip=\" + worstDip.ToString(\"F4\")\n        + \" steps(>0.08)=\" + stepCount + \" worstStep=\" + worstStep.ToString(\"F4\"));\n    if (worstDipIdx >= 0) {\n        int wx = worstDipIdx % side, wz = worstDipIdx / side;\n        sb.AppendLine(\"  worstDip @ (\" + wx + \",\" + wz + \") pos=\" + verts[worstDipIdx] + \" norm=\" + norms[worstDipIdx]\n            + \" nbrs=[L:\" + verts[worstDipIdx-1].y.ToString(\"F4\") + \",R:\" + verts[worstDipIdx+1].y.ToString(\"F4\")\n            + \",D:\" + verts[worstDipIdx-side].y.ToString(\"F4\") + \",U:\" + verts[worstDipIdx+side].y.ToString(\"F4\") + \"]\");\n    }\n    if (worstStepIdx >= 0) {\n        int wx = worstStepIdx % side, wz = worstStepIdx / side;\n        sb.AppendLine(\"  worstStep @ (\" + wx + \",\" + wz + \") pos=\" + verts[worstStepIdx] + \" norm=\" + norms[worstStepIdx]\n            + \" nbrs=[L:\" + verts[worstStepIdx-1].y.ToString(\"F4\") + \",R:\" + verts[worstStepIdx+1].y.ToString(\"F4\")\n            + \",D:\" + verts[worstStepIdx-side].y.ToString(\"F4\") + \",U:\" + verts[worstStepIdx+side].y.ToString(\"F4\") + \"]\");\n    }\n\n    // Also check flatland points where norm.y < 0.96 EVEN IF neighbors look small, or across slightly wider band [0.4..1.4]\n    int darkNormCount = 0;\n    float minNy = 1f;\n    int minNyIdx = -1;\n    for (int z = 2; z < side - 2; z++) {\n        for (int x = 2; x < side - 2; x++) {\n            int idx = z * side + x;\n            float y = verts[idx].y;\n            if (y < 0.65f || y > 1.05f) continue;\n            if (norms[idx].y < 0.96f) {\n                darkNormCount++;\n                if (norms[idx].y < minNy) { minNy = norms[idx].y; minNyIdx = idx; }\n            }\n        }\n    }\n    sb.AppendLine(\"  Flatland (0.65<=y<=1.05) norm.y<0.96: count=\" + darkNormCount + \" minNy=\" + minNy.ToString(\"F4\"));\n    if (minNyIdx >= 0) {\n        int wx = minNyIdx % side, wz = minNyIdx / side;\n        sb.AppendLine(\"  minNy @ (\" + wx + \",\" + wz + \") pos=\" + verts[minNyIdx] + \" norm=\" + norms[minNyIdx]\n            + \" nbrs=[L:\" + verts[minNyIdx-1].y.ToString(\"F4\") + \",R:\" + verts[minNyIdx+1].y.ToString(\"F4\")\n            + \",D:\" + verts[minNyIdx-side].y.ToString(\"F4\") + \",U:\" + verts[minNyIdx+side].y.ToString(\"F4\") + \"]\");\n    }\n}\n\n// 3. Check Freight Ship prefab & Selection child & BuildingSelectionRing & Unit Prefabs\nvar fs = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/Prefabs/Units Prefabs/Naval/Trade/Freight Ship.prefab\");\nif (fs != null) {\n    sb.AppendLine(\"=== Freight Ship Prefab Hierarchy ===\");\n    var ts = fs.GetComponentsInChildren<UnityEngine.Transform>(true);\n    for (int i = 0; i < ts.Length; i++) {\n        var r = ts[i].GetComponent<UnityEngine.Renderer>();\n        var mf = ts[i].GetComponent<UnityEngine.MeshFilter>();\n        sb.AppendLine(\"  \" + ts[i].name + \" act=\" + ts[i].gameObject.activeSelf + \" lPos=\" + ts[i].localPosition + \" lScale=\" + ts[i].localScale\n            + (mf != null && mf.sharedMesh != null ? \" mesh=\" + mf.sharedMesh.name : \"\")\n            + (r != null && r.sharedMaterial != null ? \" mat=\" + r.sharedMaterial.name : \"\"));\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
