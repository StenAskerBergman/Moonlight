aterTransitionState.UnderwaterAmount = t > 0.35f ? 1f : 0f;\n    Moonlight.Rendering.UnderwaterTransitionState.WaterLevel = 0f;\n    Moonlight.Rendering.UnderwaterTransitionState.DistortionStrength = 0.014f;\n\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 640, 360), 0, 0);\n    tex.Apply();\n    System.IO.File.WriteAllBytes(System.IO.Path.Combine(dir, $\"dive_frame_{i:D2}.png\"), tex.EncodeToPNG());\n}\n\nRenderTexture.active = null;\ncam.targetTexture = prevTT;\ncam.transform.position = prevPos;\ncam.transform.rotation = prevRot;\nMoonlight.Rendering.UnderwaterTransitionState.Reset();\nUnityEngine.Object.DestroyImmediate(rt);\nUnityEngine.Object.DestroyImmediate(tex);\nreturn $\"Rendered {frameCount} frames targeting {targetCenter}\";","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
