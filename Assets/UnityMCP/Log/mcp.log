{"ts":"2026-11-15T18:15:31.099Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1222,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\nvar sources = wtf.GetType().GetProperty(\"Sources\", flags).GetValue(wtf, null) as System.Collections.IList;\n\n// Helper via inline loops: inspect clusters of lap > 0.03 on ALL 8 Islands!\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var mg = grids[g];\n    if (!mg.name.StartsWith(\"Island \")) continue;\n    var m = mg.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = Mathf.RoundToInt(Mathf.Sqrt(m.vertexCount));\n    if (side * side != m.vertexCount) continue;\n    int cnt04 = 0;\n    float minWx = 9999, maxWx = -9999, minWz = 9999, maxWz = -9999;\n    var pts = new System.Collections.Generic.List<Vector3>();\n    for (int z = 2; z < side - 2; z++)\n    {\n        for (int x = 2; x < side - 2; x++)\n        {\n            int idx = z * side + x;\n            float y = v[idx].y;\n            if (y < 0.45f || y > 2.5f) continue;\n            float avg4 = 0.25f * (v[idx - 1].y + v[idx + 1].y + v[idx - side].y + v[idx + side].y);\n            float lap = Mathf.Abs(y - avg4);\n            if (lap > 0.035f)\n            {\n                cnt04++;\n                Vector3 wp = mg.transform.TransformPoint(v[idx]);\n                if (wp.x < minWx) minWx = wp.x; if (wp.x > maxWx) maxWx = wp.x;\n                if (wp.z < minWz) minWz = wp.z; if (wp.z > maxWz) maxWz = wp.z;\n                if (pts.Count < 8) pts.Add(wp);\n            }\n        }\n    }\n    sb.AppendLine(string.Format(\"{0}: lap(>0.035)={1} box=({2:F1}..{3:F1}, {4:F1}..{5:F1})\", mg.name, cnt04, minWx, maxWx, minWz, maxWz));\n    for (int i = 0; i < pts.Count; i++) sb.Append(\" \" + pts[i].ToString(\"F2\"));\n    if (pts.Count > 0) sb.AppendLine(\"\");\n}\n\n// Detailed dump around Island 29 (44.83, -120.67) and Island 21 (-41.17, 122.33) in Mesh & BuiltCache!\nstring[] targets = new string[] { \"Island 29\", \"Island 21\", \"Island 31\" };\nVector3[] centers = new Vector3[] { new Vector3(44.83f, 0f, -120.67f), new Vector3(-41.17f, 0f, 122.33f), new Vector3(37.50f, 0f, -9.00f) };\nint[] srcIds = new int[] { 8, 7, 9 };\n\nfor (int t = 0; t < targets.Length; t++)\n{\n    var go = GameObject.Find(targets[t]);\n    var m = go.GetComponent<MeshFilter>().sharedMesh;\n    var v = m.vertices;\n    int side = 541;\n    Vector3 lc = go.transform.InverseTransformPoint(centers[t]);\n    int cx = Mathf.Clamp(Mathf.RoundToInt(lc.x * 6f), 6, side - 7);\n    int cz = Mathf.Clamp(Mathf.RoundToInt(lc.z * 6f), 6, side - 7);\n    sb.AppendLine(\"=== Mesh heights around \" + targets[t] + \" \" + centers[t] + \" (local idx \" + cx + \",\" + cz + \") ===\");\n    for (int z = cz - 4; z <= cz + 4; z++)\n    {\n        sb.Append(string.Format(\"z={0,6:F2}: \", go.transform.position.z + z / 6f));\n        for (int x = cx - 4; x <= cx + 4; x++)\n            sb.Append(string.Format(\"{0,6:F3} \", v[z * side + x].y));\n        sb.AppendLine(\"\");\n    }\n    var src = sources[srcIds[t]];\n    var st = src.GetType();\n    Vector2 orig = (Vector2)st.GetProperty(\"WorldOrigin\", flags).GetValue(src, null);\n    float pad = System.Convert.ToSingle(st.GetProperty(\"SampleCachePadding\", flags).GetValue(src, null));\n    var cache = st.GetProperty(\"BuiltCache\", flags).GetValue(src, null);\n    var ct = cache.GetType();\n    int res = (int)ct.GetProperty(\"Resolution\", flags).GetValue(cache, null);\n    float step = (float)ct.GetProperty(\"Step\", flags).GetValue(cache, null);\n    float[] heights = (float[])ct.GetProperty(\"Heights\", flags).GetValue(cache, null);\n    float[] bf = (float[])ct.GetProperty(\"BaseFields\", flags).GetValue(cache, null);\n    float[] sf = (float[])ct.GetProperty(\"SmoothFields\", flags).GetValue(cache, null);\n    float[] mb = (float[])ct.GetProperty(\"MountainBoosts\", flags).GetValue(cache, null);\n    float[] ma = (float[])ct.GetProperty(\"MountainAllowances\", flags).GetValue(cache, null);\n    float[] rc = (float[])ct.GetProperty(\"RiverCarveDepths\", flags).GetValue(cache, null);\n    float[] sh = (float[])ct.GetProperty(\"ShoreDistances\", flags).GetValue(cache, null);\n    var tt = (System.Array)ct.GetProperty(\"TerrainTypes\", flags).GetValue(cache, null);\n\n    int scz = Mathf.RoundToInt((centers[t].z - orig.y + pad) / step);\n    int scx = Mathf.RoundToInt((centers[t].x - orig.x + pad) / step);\n    sb.AppendLine(\"Cache row at scz=\" + scz + \":\");\n    for (int dx = -4; dx <= 4; dx++)\n    {\n        int cidx = scz * res + (scx + dx);\n        sb.AppendLine(string.Format(\"  dx={0,2}: h={1:F3} bf={2:F3} sf={3:F3} mb={4:F3} ma={5:F3} rc={6:F3} sh={7:F2} tt={8}\",\n            dx, heights[cidx], bf[cidx], sf[cidx], mb[cidx], ma[cidx], rc[cidx], sh[cidx], tt.GetValue(cidx)));\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
