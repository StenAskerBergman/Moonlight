{"ts":"2026-11-15T18:14:24.223Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":7743,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nobject wtf = null;\nforeach (var f in typeof(MapManager).GetFields(flags))\n    if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n\n// Print RiverPlan & Mouth info for all 8 islands + scan _Control / _SurfaceTint for ANY 1-3px streak even 8% darker OR any non-grass _Control pixel inside grass!\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>(true);\nfor (int g = 0; g < grids.Length; g++)\n{\n    var srcMg = grids[g];\n    if (!srcMg.name.StartsWith(\"Island \")) continue;\n    var clone = UnityEngine.Object.Instantiate(srcMg.gameObject);\n    clone.name = \"__Probe_\" + srcMg.name;\n    clone.transform.SetParent(srcMg.transform.parent, true);\n    try\n    {\n        var cmg = clone.GetComponent<MapGrid>();\n        var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n        if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n        typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags).Invoke(cmg, null);\n\n        var cmr = clone.GetComponent<MeshRenderer>();\n        var mpb = new MaterialPropertyBlock();\n        cmr.GetPropertyBlock(mpb);\n        Texture2D ctrlSrc = mpb.GetTexture(\"_Control\") as Texture2D;\n        Texture2D tintSrc = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n        var mv = clone.GetComponent<MeshFilter>().sharedMesh.vertices;\n        int w = tintSrc.width;\n\n        var rt = RenderTexture.GetTemporary(w, w, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);\n        var prev = RenderTexture.active;\n        RenderTexture.active = rt;\n        Graphics.Blit(tintSrc, rt);\n        var tintTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n        tintTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n        tintTex.Apply();\n        Color[] tCols = tintTex.GetPixels();\n        Graphics.Blit(ctrlSrc, rt);\n        var ctrlTex = new Texture2D(w, w, TextureFormat.RGBA32, false, true);\n        ctrlTex.ReadPixels(new Rect(0, 0, w, w), 0, 0);\n        ctrlTex.Apply();\n        Color[] cCols = ctrlTex.GetPixels();\n        RenderTexture.active = prev;\n        RenderTexture.ReleaseTemporary(rt);\n        UnityEngine.Object.DestroyImmediate(tintTex);\n        UnityEngine.Object.DestroyImmediate(ctrlTex);\n\n        int ctrlBridge = 0, tint8Pct = 0, lowSum = 0;\n        var hits = new System.Collections.Generic.List<string>();\n        for (int pz = 4; pz < w - 4; pz++)\n        {\n            for (int px = 4; px < w - 4; px++)\n            {\n                int idx = pz * w + px;\n                if (mv[idx].y < 0.45f) continue;\n                Color tc = tCols[idx];\n                Color cc = cCols[idx];\n                float csum = cc.r + cc.g + cc.b + cc.a;\n                if (csum < 0.90f) lowSum++;\n\n                // Check 1-3px non-grass inside grass (cc.r < 0.5 while +-3px has cc.r > 0.85)\n                Color ccL = cCols[pz * w + (px - 3)], ccR = cCols[pz * w + (px + 3)];\n                Color ccD = cCols[(pz - 3) * w + px], ccU = cCols[(pz + 3) * w + px];\n                if ((ccL.r > 0.85f && ccR.r > 0.85f && cc.r < 0.5f) || (ccD.r > 0.85f && ccU.r > 0.85f && cc.r < 0.5f))\n                {\n                    ctrlBridge++;\n                    if (hits.Count < 4)\n                        hits.Add(string.Format(\"CTRL w({0:F1},{1:F1}) y={2:F2} cc={3}\", srcMg.transform.position.x + px/6f, srcMg.transform.position.z + pz/6f, mv[idx].y, cc));\n                }\n\n                // Check 1-2px tint darkening (>10%) inside grass\n                float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n                float lL = tCols[pz * w + (px - 2)].r * 0.3f + tCols[pz * w + (px - 2)].g * 0.59f + tCols[pz * w + (px - 2)].b * 0.11f;\n                float lR = tCols[pz * w + (px + 2)].r * 0.3f + tCols[pz * w + (px + 2)].g * 0.59f + tCols[pz * w + (px + 2)].b * 0.11f;\n                float lD = tCols[(pz - 2) * w + px].r * 0.3f + tCols[(pz - 2) * w + px].g * 0.59f + tCols[(pz - 2) * w + px].b * 0.11f;\n                float lU = tCols[(pz + 2) * w + px].r * 0.3f + tCols[(pz + 2) * w + px].g * 0.59f + tCols[(pz + 2) * w + px].b * 0.11f;\n                if ((lL > luma * 1.12f && lR > luma * 1.12f) || (lD > luma * 1.12f && lU > luma * 1.12f))\n                {\n                    tint8Pct++;\n                    if (hits.Count < 4)\n                        hits.Add(string.Format(\"TINT w({0:F1},{1:F1}) y={2:F2} l={3:F3} tc={4}\", srcMg.transform.position.x + px/6f, srcMg.transform.position.z + pz/6f, mv[idx].y, luma, tc));\n                }\n            }\n        }\n        sb.AppendLine(string.Format(\"{0}: lowSum={1} ctrlBridge={2} tint12Pct={3}\", srcMg.name, lowSum, ctrlBridge, tint8Pct));\n        for (int i = 0; i < hits.Count; i++) sb.AppendLine(\"  \" + hits[i]);\n    }\n    finally\n    {\n        UnityEngine.Object.DestroyImmediate(clone);\n    }\n}\n\n// Check ALL objects in scene that are near (-1.7, -73.9) or on Islands or have Renderer/Mesh/Line/Grid\nsb.AppendLine(\"=== Extra Renderers on Map / Camera ===\");\nvar allRenderers = UnityEngine.Object.FindObjectsOfType<Renderer>(true);\nfor (int i = 0; i < allRenderers.Length; i++)\n{\n    var r = allRenderers[i];\n    if (r is ParticleSystemRenderer) continue;\n    string n = r.gameObject.name;\n    if (n.Contains(\"Quad\") || n.Contains(\"Line\") || n.Contains(\"Ring\") || n.Contains(\"Select\") || n.Contains(\"Box\") || n.Contains(\"Water\") || n.Contains(\"River\") || n.Contains(\"Grid\") || n.Contains(\"Camera\"))\n    {\n        if (n == \"Generated Inland Water\") continue;\n        sb.AppendLine(\"  R: \" + n + \" act=\" + r.gameObject.activeInHierarchy + \" en=\" + r.enabled + \" pos=\" + r.transform.position + \" mat=\" + (r.sharedMaterial ? r.sharedMaterial.name : \"null\"));\n    }\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
