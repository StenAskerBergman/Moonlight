{"ts":"2026-11-15T18:56:52.824Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1403,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\n// 1. Inspect Camera Rig, Main Camera, Camera Target\nGameObject camRig = GameObject.Find(\"Camera Rig\");\nif (camRig != null)\n{\n    sb.AppendLine(\"=== Camera Rig ===\");\n    Component[] comps = camRig.GetComponents<Component>();\n    for (int i = 0; i < comps.Length; i++)\n    {\n        sb.AppendLine(\"  comp[\" + i + \"]: \" + (comps[i] == null ? \"MISSING\" : comps[i].GetType().Name));\n    }\n    MeshFilter mf = camRig.GetComponent<MeshFilter>();\n    if (mf != null) sb.AppendLine(\"  MeshFilter: \" + (mf.sharedMesh != null ? mf.sharedMesh.name : \"null\"));\n    MeshRenderer mr = camRig.GetComponent<MeshRenderer>();\n    if (mr != null) sb.AppendLine(\"  MeshRenderer: en=\" + mr.enabled + \" mat=\" + (mr.sharedMaterial != null ? mr.sharedMaterial.name : \"null\"));\n\n    for (int c = 0; c < camRig.transform.childCount; c++)\n    {\n        Transform ch = camRig.transform.GetChild(c);\n        sb.AppendLine(\"  child[\" + c + \"] \" + ch.name + \" act=\" + ch.gameObject.activeSelf + \" pos=\" + ch.localPosition + \" scale=\" + ch.localScale);\n        Component[] ccomps = ch.GetComponents<Component>();\n        for (int i = 0; i < ccomps.Length; i++)\n        {\n            sb.AppendLine(\"    comp[\" + i + \"]: \" + (ccomps[i] == null ? \"MISSING\" : ccomps[i].GetType().Name));\n        }\n    }\n}\n\n// 2. Inspect Boat / Submarine in scene\nstring[] unitObjNames = new string[] { \"Boat (Unit Inventory) (1)\", \"Submarine (Unit Inventory) (1)\" };\nforeach (string uName in unitObjNames)\n{\n    GameObject u = GameObject.Find(uName);\n    if (u == null)\n    {\n        // Try finding inactive too\n        Unit[] allUnits = Resources.FindObjectsOfTypeAll<Unit>();\n        foreach (Unit uu in allUnits)\n        {\n            if (uu.gameObject.scene.IsValid() && uu.name == uName) { u = uu.gameObject; break; }\n        }\n    }\n    if (u != null)\n    {\n        sb.AppendLine(\"=== Scene Unit: \" + u.name + \" (act=\" + u.activeSelf + \", pos=\" + u.transform.position + \") ===\");\n        for (int i = 0; i < u.transform.childCount; i++)\n        {\n            Transform ch = u.transform.GetChild(i);\n            MeshFilter mf = ch.GetComponent<MeshFilter>();\n            MeshRenderer mr = ch.GetComponent<MeshRenderer>();\n            Collider col = ch.GetComponent<Collider>();\n            sb.AppendLine(\"  ch[\" + i + \"] \" + ch.name + \" act=\" + ch.gameObject.activeSelf +\n                \" pos=\" + ch.localPosition + \" rot=\" + ch.localEulerAngles + \" scale=\" + ch.localScale +\n                \" mesh=\" + (mf != null && mf.sharedMesh != null ? mf.sharedMesh.name : \"none\") +\n                \" mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"none\") +\n                \" col=\" + (col != null ? col.GetType().Name : \"none\"));\n        }\n        SelectionOutlineTarget sot = u.GetComponent<SelectionOutlineTarget>();\n        sb.AppendLine(\"  SelectionOutlineTarget: \" + (sot != null ? (\"selected=\" + sot.IsSelected) : \"NONE\"));\n    }\n}\n\n// 3. Inspect all prefabs in Assets/Prefabs/Units Prefabs\nstring[] guids = AssetDatabase.FindAssets(\"t:Prefab\", new string[] { \"Assets/Prefabs/Units Prefabs\" });\nsb.AppendLine(\"=== Prefabs in Assets/Prefabs/Units Prefabs: \" + guids.Length + \" ===\");\nforeach (string g in guids)\n{\n    string p = AssetDatabase.GUIDToAssetPath(g);\n    GameObject pref = AssetDatabase.LoadAssetAtPath<GameObject>(p);\n    if (pref == null) continue;\n    Unit u = pref.GetComponent<Unit>();\n    if (u == null && pref.transform.childCount == 0) continue;\n    string ch0Info = \"none\";\n    if (pref.transform.childCount > 0)\n    {\n        Transform c0 = pref.transform.GetChild(0);\n        MeshFilter mf = c0.GetComponent<MeshFilter>();\n        MeshRenderer mr = c0.GetComponent<MeshRenderer>();\n        ch0Info = c0.name + \" act=\" + c0.gameObject.activeSelf +\n            \" lPos=\" + c0.localPosition + \" lRot=\" + c0.localEulerAngles + \" lScale=\" + c0.localScale +\n            \" mesh=\" + (mf != null && mf.sharedMesh != null ? mf.sharedMesh.name : \"none\") +\n            \" mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"none\");\n    }\n    sb.AppendLine(\"  \" + System.IO.Path.GetFileName(p) + \" (Unit=\" + (u != null) + \", SOT=\" + (pref.GetComponent<SelectionOutlineTarget>() != null) + \") | ch0: \" + ch0Info);\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
