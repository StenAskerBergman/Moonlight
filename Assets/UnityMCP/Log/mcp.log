 + res + \" exact=\" + (res * res == verts.Length));\n\n// Also render a closer ortho view of Island 31 southern bay and raycast dark pixels directly onto the mesh!\nvar camGo = new GameObject(\"__ProbeCam2\");\nvar cam = camGo.AddComponent<Camera>();\ncam.orthographic = true;\ncam.orthographicSize = 18f;\ncam.transform.position = new Vector3(i31.transform.position.x + 45f, 40f, i31.transform.position.z + 25f);\ncam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\ncam.clearFlags = CameraClearFlags.SolidColor;\ncam.backgroundColor = Color.magenta;\ncam.cullingMask = 1 << i31.layer;\n\nvar rt = new RenderTexture(1024, 1024, 24, RenderTextureFormat.ARGB32);\ncam.targetTexture = rt;\ncam.Render();\n\nRenderTexture.active = rt;\nvar tex = new Texture2D(1024, 1024, TextureFormat.RGBA32, false);\ntex.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\ntex.Apply();\nRenderTexture.active = null;\n\nvar px = tex.GetPixels32();\nint darkCount = 0;\nvar hitCoords = new System.Collections.Generic.List<Vector3>();\nfor (int py = 2; py < 1022; py++)\n{\n    for (int pxx = 2; pxx < 1022; pxx++)\n    {\n        var c = px[py * 1024 + pxx];\n        if (c.r > 230 && c.g < 20 && c.b > 230) continue; // magenta\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        // compare to max of neighbors +-4 px\n        float nSum = 0f; int nCnt = 0;\n        for (int dy = -3; dy <= 3; dy += 3)\n        for (int dx = -3; dx <= 3; dx += 3)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var nc = px[(py + dy) * 1024 + (pxx + dx)];\n            if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n            nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n            nCnt++;\n        }\n        if (nCnt >= 6)\n        {\n            float avg = nSum / nCnt;\n            if (avg > 0.18f && lum < avg * 0.48f)\n            {\n                darkCount++;\n                if (hitCoords.Count < 25)\n                {\n                    Ray ray = cam.ScreenPointToRay(new Vector3(pxx + 0.5f, py + 0.5f, 0f));\n                    RaycastHit hit;\n                    var mc = i31.GetComponent<MeshCollider>();\n                    if (mc != null && mc.Raycast(ray, out hit, 100f))\n                        hitCoords.Add(hit.point);\n                }\n            }\n        }\n    }\n}\nsb.AppendLine(\"Ortho bay dark pixels (<0.48x avg): \" + darkCount);\n\n// Now render WITHOUT SSAO (temporarily toggle SSAO off then back on)\nvar rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\nvar rendererDataListField = rp.GetType().GetField(\"m_RendererDataList\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);\nvar rList = rendererDataListField.GetValue(rp) as UnityEngine.Rendering.Universal.ScriptableRendererData[];\nUnityEngine.Rendering.Universal.ScriptableRendererFeature ssao = null;\nif (rList != null && rList.Length > 0)\n{\n    foreach (var f in rList[0].rendererFeatures)\n    {\n        if (f != null && f.GetType().Name.Contains(\"AmbientOcclusion\")) { ssao = f; break; }\n    }\n}\nif (ssao != null)\n{\n    bool prevActive = ssao.isActive;\n    ssao.SetActive(false);\n    cam.Render();\n    RenderTexture.active = rt;\n    tex.ReadPixels(new Rect(0, 0, 1024, 1024), 0, 0);\n    tex.Apply();\n    RenderTexture.active = null;\n    ssao.SetActive(prevActive);\n    var px2 = tex.GetPixels32();\n    int darkNoSSAO = 0;\n    for (int py = 2; py < 1022; py++)\n    for (int pxx = 2; pxx < 1022; pxx++)\n    {\n        var c = px2[py * 1024 + pxx];\n        if (c.r > 230 && c.g < 20 && c.b > 230) continue;\n        float lum = (0.299f * c.r + 0.587f * c.g + 0.114f * c.b) / 255f;\n        float nSum = 0f; int nCnt = 0;\n        for (int dy = -3; dy <= 3; dy += 3)\n        for (int dx = -3; dx <= 3; dx += 3)\n        {\n            if (dx == 0 && dy == 0) continue;\n            var nc = px2[(py + dy) * 1024 + (pxx + dx)];\n            if (nc.r > 230 && nc.g < 20 && nc.b > 230) continue;\n            nSum += (0.299f * nc.r + 0.587f * nc.g + 0.114f * nc.b) / 255f;\n            nCnt++;\n        }\n        if (nCnt >= 6 && (nSum / nCnt) > 0.18f && lum < (nSum / nCnt) * 0.48f) darkNoSSAO++;\n    }\n    sb.AppendLine(\"Ortho bay dark pixels WITHOUT SSAO: \" + darkNoSSAO);\n}\n\n// Also render the SAME oblique shot as probe_i31_bay but with _Control / _SurfaceTint GPU readback at hitCoords\nforeach (var hp in hitCoords)\n{\n    Vector3 lp = i31.transform.InverseTransformPoint(hp);\n    sb.AppendLine(string.Format(\"hit world={0:F3} local={1:F3}\", hp, lp));\n}\n\n// Inspect GPU pixel values of _Control & _SurfaceTint around each hitPoint\nif (ctrlTex != null && tintTex != null && hitCoords.Count > 0)\n{\n    var crt = new RenderTexture(ctrlTex.width, ctrlTex.height, 0, RenderTextureFormat.ARGB32);\n    Graphics.Blit(ctrlTex, crt);\n    RenderTexture.active = crt;\n    var rCtrl = new Texture2D(ctrlTex.width, ctrlTex.height, TextureFormat.RGBA32, false);\n    rCtrl.ReadPixels(new Rect(0, 0, ctrlTex.width, ctrlTex.height), 0, 0);\n    rCtrl.Apply();\n\n    var trt = new RenderTexture(tintTex.width, tintTex.height, 0, RenderTextureFormat.ARGB32);\n    Graphics.Blit(tintTex, trt);\n    RenderTexture.active = trt;\n    var rTint = new Texture2D(tintTex.width, tintTex.height, TextureFormat.RGBA32, false);\n    rTint.ReadPixels(new Rect(0, 0, tintTex.width, tintTex.height), 0, 0);\n    rTint.Apply();\n    RenderTexture.active = null;\n\n    int sampleHits = Mathf.Min(6, hitCoords.Count);\n    for (int k = 0; k < sampleHits; k++)\n    {\n        Vector3 lp = i31.transform.InverseTransformPoint(hitCoords[k]);\n        int tx = Mathf.Clamp(Mathf.RoundToInt(lp.x / 90f * (ctrlTex.width - 1)), 1, ctrlTex.width - 2);\n        int tz = Mathf.Clamp(Mathf.RoundToInt(lp.z / 90f * (ctrlTex.height - 1)), 1, ctrlTex.height - 2);\n        sb.AppendLine(string.Format(\"Hit#{0} local=({1:F2},{2:F3},{3:F2}) px=({4},{5}): ctrl={6} tint={7} ctrl+z={8} tint+z={9}\",\n            k, lp.x, lp.y, lp.z, tx, tz, rCtrl.GetPixel(tx, tz), rTint.GetPixel(tx, tz),\n            rCtrl.GetPixel(tx, tz + 1), rTint.GetPixel(tx, tz + 1)));\n    }\n    UnityEngine.Object.DestroyImmediate(crt);\n    UnityEngine.Object.DestroyImmediate(trt);\n    UnityEngine.Object.DestroyImmediate(rCtrl);\n    UnityEngine.Object.DestroyImmediate(rTint);\n}\n\nUnityEngine.Object.DestroyImmediate(tex);\nUnityEngine.Object.DestroyImmediate(rt);\nUnityEngine.Object.DestroyImmediate(camGo);\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"},"error":"Runtime error: Index was outside the bounds of the array."}
