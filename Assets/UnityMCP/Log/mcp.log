{"ts":"2026-11-15T18:50:01.431Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1290,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// Check QuaySystem components in scene and prefabs\nvar quays = UnityEngine.Object.FindObjectsOfType<QuaySystem>();\nsb.AppendLine(\"Scene QuaySystem count=\" + quays.Length);\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\nfor (int i = 0; i < Mathf.Min(quays.Length, 3); i++)\n{\n    var q = quays[i];\n    var topMat = typeof(QuaySystem).GetField(\"topMaterial\", flags).GetValue(q) as Material;\n    var wallMat = typeof(QuaySystem).GetField(\"wallMaterial\", flags).GetValue(q) as Material;\n    var atl = typeof(QuaySystem).GetField(\"atlas\", flags).GetValue(q) as QuaySystem.AtlasLayout;\n    sb.AppendLine(string.Format(\"  {0}: top={1} wall={2} deck={3} coping={4} band={5} bay={6} butt={7} rock={8}\",\n        q.name, topMat != null ? topMat.name : \"null\", wallMat != null ? wallMat.name : \"null\",\n        atl.deck, atl.coping, atl.band, atl.wallBay, atl.buttress, atl.rock));\n}\n\n// Also check Depot prefab in scene/asset + other Tycoon prefabs for component pattern\nvar depot = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/Depot.prefab\");\nif (depot != null)\n{\n    sb.AppendLine(\"Depot root comps: \" + depot.GetComponents<Component>().Length + \" layer=\" + depot.layer);\n    foreach (var c in depot.GetComponents<Component>()) sb.AppendLine(\"  comp: \" + (c != null ? c.GetType().Name : \"MISSING\"));\n    for (int i = 0; i < depot.transform.childCount; i++)\n    {\n        var ch = depot.transform.GetChild(i);\n        var mr = ch.GetComponent<MeshRenderer>();\n        sb.AppendLine(\"  ch: \" + ch.name + \" pos=\" + ch.localPosition + \" scale=\" + ch.localScale + \" layer=\" + ch.gameObject.layer + \" mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"none\"));\n    }\n}\nvar cc = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/Prefabs/Building Prefabs/Faction Prefabs/Tycoon Faction/Universal Tier 1/City Center.prefab\");\nif (cc != null)\n{\n    sb.AppendLine(\"CityCenter children=\" + cc.transform.childCount);\n    for (int i = 0; i < Mathf.Min(cc.transform.childCount, 6); i++)\n    {\n        var ch = cc.transform.GetChild(i);\n        var mr = ch.GetComponent<MeshRenderer>();\n        sb.AppendLine(\"  cc ch: \" + ch.name + \" pos=\" + ch.localPosition + \" scale=\" + ch.localScale + \" mat=\" + (mr != null && mr.sharedMaterial != null ? mr.sharedMaterial.name : \"none\"));\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
