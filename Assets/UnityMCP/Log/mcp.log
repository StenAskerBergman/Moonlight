{"ts":"2026-11-15T20:14:38.494Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1274,"action":"execute","params":{"action":"execute","code":"// Check minimum distance from chunk boundary of actual Plateau tabletop vertices (using MapManager) vs Island spillover on Plateau 45\nvar sb = new System.Text.StringBuilder();\nvar p45 = GameObject.Find(\"Plateau 45\");\nif (p45 != null)\n{\n    var mf = p45.GetComponent<MeshFilter>();\n    var v = mf.sharedMesh.vertices;\n    var b = p45.GetComponent<MeshRenderer>().bounds;\n    float furthestIslandSpillFromTopEdge = 0f;\n    for (int i = 0; i < v.Length; i++)\n    {\n        Vector3 w = p45.transform.TransformPoint(v[i]);\n        // Top edge is zMax (b.max.z = 0); spillover is raised above -44.4m on northern margin (z > -45)\n        if (w.z > b.center.z && w.y > -44.2f)\n        {\n            float distFromTop = b.max.z - w.z;\n            if (distFromTop > furthestIslandSpillFromTopEdge)\n                furthestIslandSpillFromTopEdge = distFromTop;\n        }\n    }\n    sb.AppendLine(\"Plateau 45 top spillover depth into chunk = \" + furthestIslandSpillFromTopEdge.ToString(\"F2\")\n        + \"m (UV \" + (furthestIslandSpillFromTopEdge / 90f).ToString(\"F3\") + \")\");\n}\n// Also check where camera starts & TerrainSplat abyss color\nvar grids = UnityEngine.Object.FindObjectsOfType<MapGrid>();\nfor (int i = 0; i < grids.Length; i++)\n{\n    if (grids[i].name == \"Island 47\")\n    {\n        var mr = grids[i].GetComponent<MeshRenderer>();\n        var mf = grids[i].GetComponent<MeshFilter>();\n        sb.AppendLine(\"Island 47 minY=\" + mr.bounds.min.y.ToString(\"F2\"));\n        break;\n    }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
