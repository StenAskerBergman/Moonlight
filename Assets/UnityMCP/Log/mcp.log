{"ts":"2026-11-15T18:28:26.862Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2248,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nGameObject clone = null;\nGameObject camGo = null;\nRenderTexture rt = null;\nTexture2D tex = null;\ntry\n{\n    var i31 = GameObject.Find(\"Island 31\");\n    clone = UnityEngine.Object.Instantiate(i31, i31.transform.position, i31.transform.rotation, i31.transform.parent);\n    clone.name = \"__ProbeTint\";\n    var mg = clone.GetComponent(\"MapGrid\");\n    mg.GetType().GetMethod(\"GenerateTerrain\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance).Invoke(mg, null);\n\n    clone.layer = 31;\n    for (int i = 0; i < clone.transform.childCount; i++) clone.transform.GetChild(i).gameObject.SetActive(false);\n\n    var mr = clone.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpb);\n    var origCtrl = mpb.GetTexture(\"_Control\") as Texture2D;\n    var origTint = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n    sb.AppendLine(string.Format(\"origTint: {0}x{1} fmt={2} mips={3} filter={4} aniso={5} isReadable={6} mipBias={7}\",\n        origTint.width, origTint.height, origTint.format, origTint.mipmapCount, origTint.filterMode, origTint.anisoLevel, origTint.isReadable, origTint.mipMapBias));\n    sb.AppendLine(string.Format(\"origCtrl: {0}x{1} fmt={2} mips={3} filter={4}\",\n        origCtrl.width, origCtrl.height, origCtrl.format, origCtrl.mipmapCount, origCtrl.filterMode));\n\n    // Read GPU pixels of origTint AT DIFFERENT MIP LEVELS by creating a RenderTexture and using Graphics.CopyTexture OR Blit + Save PNG of origTint itself!\n    var trt = new RenderTexture(541, 541, 0, RenderTextureFormat.ARGB32);\n    Graphics.Blit(origTint, trt);\n    RenderTexture.active = trt;\n    var rTint = new Texture2D(541, 541, TextureFormat.RGBA32, false);\n    rTint.ReadPixels(new Rect(0, 0, 541, 541), 0, 0);\n    rTint.Apply();\n    RenderTexture.active = null;\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\origTint_mip0.png\", rTint.EncodeToPNG());\n\n    // Find ANY dark pixels anywhere in rTint (even small dips!)\n    float minVal = 9f; Vector2Int minP = Vector2Int.zero;\n    int darkInBox = 0;\n    for (int y = 0; y < 541; y++)\n    for (int x = 0; x < 541; x++)\n    {\n        Color c = rTint.GetPixel(x, y);\n        float s = c.r + c.g + c.b;\n        if (s < minVal) { minVal = s; minP = new Vector2Int(x, y); }\n        if (x >= 140 && x <= 220 && y >= 0 && y <= 40 && s < 0.8f) darkInBox++;\n    }\n    sb.AppendLine(string.Format(\"rTint mip0 overall minRGBsum={0:F3} at ({1},{2}) c={3}; darkInBox(<0.8)={4}\",\n        minVal, minP.x, minP.y, rTint.GetPixel(minP.x, minP.y), darkInBox));\n\n    // NOW: create an UNCOMPRESSED NO-MIPMAP copy of rTint (`noMipTint`) AND a compressed/mipmap=true copy (`withMipTint`), and render BOTH!\n    var noMipTint = new Texture2D(541, 541, TextureFormat.RGBA32, false);\n    noMipTint.SetPixels32(rTint.GetPixels32());\n    noMipTint.wrapMode = TextureWrapMode.Clamp;\n    noMipTint.Apply();\n\n    camGo = new GameObject(\"__ProbeTintCam\");\n    var cam = camGo.AddComponent<Camera>();\n    cam.orthographic = true;\n    cam.orthographicSize = 45f;\n    cam.transform.position = i31.transform.position + new Vector3(45f, 40f, 45f);\n    cam.transform.rotation = Quaternion.Euler(90f, 0f, 0f);\n    cam.clearFlags = CameraClearFlags.SolidColor;\n    cam.backgroundColor = Color.magenta;\n    cam.cullingMask = 1 << 31;\n    rt = new RenderTexture(512, 512, 24, RenderTextureFormat.ARGB32);\n    cam.targetTexture = rt;\n    tex = new Texture2D(512, 512, TextureFormat.RGBA32, false);\n\n    System.Func<string, int> checkDark = (lbl) =>\n    {\n        cam.Render();\n        RenderTexture.active = rt;\n        tex.ReadPixels(new Rect(0, 0, 512, 512), 0, 0);\n        tex.Apply();\n        RenderTexture.active = null;\n        int dark = 0; Color32 minC = new Color32(255,255,255,255);\n        for (int y = 6; y <= 28; y++)\n        for (int x = 148; x <= 193; x++)\n        {\n            var c = (Color32)tex.GetPixel(x, y);\n            if (c.r + c.g + c.b < 140) dark++;\n            if (c.r + c.g + c.b < minC.r + minC.g + minC.b) minC = c;\n        }\n        sb.AppendLine(lbl + \": dark<140=\" + dark + \" minC=(\" + minC.r + \",\" + minC.g + \",\" + minC.b + \")\");\n        return dark;\n    };\n\n    var mpbTest = new MaterialPropertyBlock();\n    mr.GetPropertyBlock(mpbTest);\n    checkDark(\"1_origTint\");\n\n    origTint.filterMode = FilterMode.Point;\n    checkDark(\"2_origTint_Point\");\n    origTint.filterMode = FilterMode.Bilinear;\n\n    mpbTest.SetTexture(\"_SurfaceTint\", noMipTint);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"3_noMip_RGBA32_copy\");\n\n    // Also render FULL island with origTint vs noMipTint at 541x541 mipLevels? Wait what if mip 1 of origTint has black pixels?!\n    // Test generating a mipmapped RGBA32 copy vs original origTint:\n    var withMipRGBA = new Texture2D(541, 541, TextureFormat.RGBA32, true);\n    withMipRGBA.SetPixels32(rTint.GetPixels32());\n    withMipRGBA.wrapMode = TextureWrapMode.Clamp;\n    withMipRGBA.Apply(true);\n    mpbTest.SetTexture(\"_SurfaceTint\", withMipRGBA);\n    mr.SetPropertyBlock(mpbTest);\n    checkDark(\"4_withMip_RGBA32_copy\");\n\n    // Save mip 1 and mip 2 of origTint by rendering a quad or downsampling! Actually render _DebugView=1 on flat quad? Even faster: Blit with mip!\n    // Check if origTint has mip > 0 blackness by setting origTint.mipMapBias = 2f!\n    mpbTest.SetTexture(\"_SurfaceTint\", origTint);\n    mr.SetPropertyBlock(mpbTest);\n    origTint.mipMapBias = 3f;\n    checkDark(\"5_origTint_mipBias+3\");\n    System.IO.File.WriteAllBytes(@\"C:\\Users\\stena\\.gemini\\antigravity\\brain\\80df3be4-9a2e-42ba-bc73-5c7e3f0a8fe0\\scratch\\origTint_mipBias3.png\", tex.EncodeToPNG());\n    origTint.mipMapBias = 0f;\n\n    UnityEngine.Object.DestroyImmediate(trt);\n    UnityEngine.Object.DestroyImmediate(rTint);\n    UnityEngine.Object.DestroyImmediate(noMipTint);\n    UnityEngine.Object.DestroyImmediate(withMipRGBA);\n}\nfinally\n{\n    if (tex != null) UnityEngine.Object.DestroyImmediate(tex);\n    if (rt != null) UnityEngine.Object.DestroyImmediate(rt);\n    if (camGo != null) UnityEngine.Object.DestroyImmediate(camGo);\n    if (clone != null) UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
