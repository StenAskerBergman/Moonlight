os={g.transform.position}, mat={g.GetComponent<MeshRenderer>()?.sharedMaterial?.name}, esc={g.plateauEscarpmentMaterial?.name}, surf={g.plateauSurfaceMaterial?.name}\");\n        }\n        var utc = Object.FindFirstObjectByType<Moonlight.Rendering.UnderwaterTransitionController>();\n        sb.AppendLine($\"UnderwaterTransitionController: {(utc != null ? utc.name : \"NONE\")}\");\n        return sb.ToString();\n    }\n}\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
