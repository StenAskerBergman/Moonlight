{"ts":"2026-11-15T18:12:22.184Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2088,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\n\nvar i31 = GameObject.Find(\"Island 31\");\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nvar i31Mr = i31.GetComponent<MeshRenderer>();\nvar mpb0 = new MaterialPropertyBlock();\ni31Mr.GetPropertyBlock(mpb0);\nsb.AppendLine(\"Island 31 existing MPB isEmpty=\" + mpb0.isEmpty);\n\n// Check PlayerSpawnManager target & Ship\nvar psm = UnityEngine.Object.FindObjectOfType<PlayerSpawnManager>();\nif (psm != null)\n{\n    foreach (var f in typeof(PlayerSpawnManager).GetFields(flags))\n        sb.AppendLine(\"PSM field \" + f.Name + \" = \" + f.GetValue(psm));\n}\n\n// Check clone with parent set & RebuildTerrainTextures / TextureBuilder\nvar clone = UnityEngine.Object.Instantiate(i31);\nclone.name = \"__TempProbe\";\nclone.transform.SetParent(i31.transform.parent, true);\ntry\n{\n    var cmg = clone.GetComponent<MapGrid>();\n    var srcMg = i31.GetComponent<MapGrid>();\n    // Copy grid/terrainSource if already present, else GenerateTerrain\n    foreach (var f in typeof(MapGrid).GetFields(flags))\n    {\n        if (f.Name == \"pendingWorldField\" || f.Name == \"worldTerrainField\" || f.Name == \"mapManager\")\n        {\n            var val = f.GetValue(srcMg);\n            if (val != null) f.SetValue(cmg, val);\n        }\n    }\n    var wtfField = typeof(MapManager).GetField(\"worldTerrainField\", flags);\n    object wtf = wtfField != null ? wtfField.GetValue(mm) : null;\n    if (wtf == null)\n    {\n        foreach (var f in typeof(MapManager).GetFields(flags))\n            if (f.FieldType.Name == \"WorldTerrainField\") { wtf = f.GetValue(mm); break; }\n    }\n    // Try SetWorldTerrainField or GenerateTerrain\n    var setWtfM = typeof(MapGrid).GetMethod(\"SetWorldTerrainField\", flags);\n    if (setWtfM != null && wtf != null) setWtfM.Invoke(cmg, new object[] { wtf });\n\n    var genM = typeof(MapGrid).GetMethod(\"GenerateTerrain\", flags);\n    genM.Invoke(cmg, null);\n\n    var cmr = clone.GetComponent<MeshRenderer>();\n    var mpb = new MaterialPropertyBlock();\n    cmr.GetPropertyBlock(mpb);\n    sb.AppendLine(\"Clone MPB isEmpty=\" + mpb.isEmpty);\n    Texture2D ctrl = mpb.GetTexture(\"_Control\") as Texture2D;\n    Texture2D tint = mpb.GetTexture(\"_SurfaceTint\") as Texture2D;\n    Texture2D rmask = mpb.GetTexture(\"_RegionMask\") as Texture2D;\n    sb.AppendLine(\"  _Control=\" + (ctrl ? ctrl.width + \"x\" + ctrl.height + \" fmt=\" + ctrl.format : \"null\"));\n    sb.AppendLine(\"  _SurfaceTint=\" + (tint ? tint.width + \"x\" + tint.height + \" fmt=\" + tint.format : \"null\"));\n    sb.AppendLine(\"  _RegionMask=\" + (rmask ? rmask.width + \"x\" + rmask.height + \" fmt=\" + rmask.format : \"null\"));\n\n    // Scan BOTH _Control and _SurfaceTint in Island 31 (x=26..52, z=-62..-48 -> uv x=26/90..52/90, v=(28..42)/90)\n    if (tint != null && ctrl != null)\n    {\n        int w = tint.width;\n        Color[] tCols = tint.GetPixels();\n        Color[] cCols = ctrl.GetPixels();\n        int px0 = Mathf.RoundToInt((26f / 90f) * w);\n        int px1 = Mathf.RoundToInt((52f / 90f) * w);\n        int pz0 = Mathf.RoundToInt((28f / 90f) * w);\n        int pz1 = Mathf.RoundToInt((42f / 90f) * w);\n        int darkTint = 0, darkCtrl = 0;\n        var hits = new System.Collections.Generic.List<string>();\n        for (int pz = pz0; pz <= pz1; pz++)\n        {\n            for (int px = px0; px <= px1; px++)\n            {\n                int idx = pz * w + px;\n                Color tc = tCols[idx];\n                Color cc = cCols[idx];\n                float luma = tc.r * 0.3f + tc.g * 0.59f + tc.b * 0.11f;\n                float csum = cc.r + cc.g + cc.b + cc.a;\n                // Flag