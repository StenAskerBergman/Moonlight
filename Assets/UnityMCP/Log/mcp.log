{"ts":"2026-11-15T19:02:53.473Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":4401,"action":"execute","params":{"action":"execute","code":"System.Text.StringBuilder sb = new System.Text.StringBuilder();\n\nSystem.Action<Transform> layoutTierManagersAndDedupe = (rootTf) =>\n{\n    if (rootTf == null) return;\n    foreach (Transform tr in rootTf.GetComponentsInChildren<Transform>(true))\n    {\n        if (tr.name.StartsWith(\"AB.Tier\"))\n        {\n            ProductionTierPageIntegration[] arr = tr.GetComponents<ProductionTierPageIntegration>();\n            for (int k = 1; k < arr.Length; k++) UnityEngine.Object.DestroyImmediate(arr[k], true);\n        }\n        if (tr.name == \"BG Lower (1)\")\n        {\n            UnityEngine.UI.LayoutElement le = tr.GetComponent<UnityEngine.UI.LayoutElement>();\n            if (le == null) le = tr.gameObject.AddComponent<UnityEngine.UI.LayoutElement>();\n            le.ignoreLayout = true;\n        }\n        if (tr.name == \"Tier Button Manager\" || tr.name == \"Player Faction Controller\" || tr.name == \"Player Tab Controller\")\n        {\n            UnityEngine.UI.HorizontalLayoutGroup hlg = tr.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\n            bool isTbm = (tr.name == \"Tier Button Manager\");\n            if (hlg != null)\n            {\n                hlg.enabled = true;\n                if (isTbm)\n                {\n                    hlg.padding = new RectOffset(4, 4, 2, 2);\n                    hlg.spacing = 2f;\n                    hlg.childAlignment = TextAnchor.MiddleCenter;\n                    hlg.childControlWidth = true;\n                    hlg.childControlHeight = true;\n                    hlg.childForceExpandWidth = true;\n                    hlg.childForceExpandHeight = true;\n                }\n                EditorUtility.SetDirty(hlg);\n            }\n\n            RectTransform mgrRect = (RectTransform)tr;\n            if (tr.gameObject.activeInHierarchy)\n            {\n                UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(mgrRect);\n            }\n            else if (hlg != null)\n            {\n                System.Collections.Generic.List<RectTransform> kids = new System.Collections.Generic.List<RectTransform>();\n                for (int i = 0; i < tr.childCount; i++)\n                {\n                    RectTransform crt = tr.GetChild(i) as RectTransform;\n                    if (crt == null || !crt.gameObject.activeSelf) continue;\n                    UnityEngine.UI.LayoutElement le = crt.GetComponent<UnityEngine.UI.LayoutElement>();\n                    if (le != null && le.ignoreLayout) continue;\n                    kids.Add(crt);\n                }\n                if (kids.Count > 0)\n                {\n                    float padL = hlg.padding.left;\n                    float padR = hlg.padding.right;\n                    float padT = hlg.padding.top;\n                    float padB = hlg.padding.bottom;\n                    float gap = hlg.spacing;\n                    float totalW = mgrRect.rect.width > 1f ? mgrRect.rect.width : mgrRect.sizeDelta.x;\n                    float totalH = mgrRect.rect.height > 1f ? mgrRect.rect.height : mgrRect.sizeDelta.y;\n                    if (totalW < 10f) totalW = 480f;\n                    if (totalH < 10f) totalH = isTbm ? 100f : 40f;\n                    float itemW = (totalW - padL - padR - gap * (kids.Count - 1)) / kids.Count;\n                    float itemH = totalH - padT - padB;\n                    for (int i = 0; i < kids.Count; i++)\n                    {\n                        RectTransform crt = kids[i];\n                        crt.anchorMin = new Vector2(0f, 1f);\n                        crt.anchorMax = new Vector2(0f, 1f);\n                        crt.pivot = new Vector2(0.5f, 0.5f);\n                        crt.sizeDelta = new Vector2(itemW, itemH);\n                        crt.anchoredPosition = new Vector2(padL + itemW * 0.5f + i * (itemW + gap), -(padT + itemH * 0.5f));\n                        EditorUtility.SetDirty(crt);\n                    }\n                }\n            }\n            EditorUtility.SetDirty(tr.gameObject);\n        }\n    }\n};\n\nforeach (Canvas c in Resources.FindObjectsOfTypeAll<Canvas>())\n{\n    if (!c.gameObject.scene.IsValid()) continue;\n    layoutTierManagersAndDedupe(c.transform);\n}\n\nstring uiBPath = \"Assets/Prefabs/Interface Prefabs/HUD Testing/User Interface (B).prefab\";\nif (System.IO.File.Exists(uiBPath))\n{\n    GameObject uiBRoot = PrefabUtility.LoadPrefabContents(uiBPath);\n    try\n    {\n        layoutTierManagersAndDedupe(uiBRoot.transform);\n        PrefabUtility.SaveAsPrefabAsset(uiBRoot, uiBPath);\n    }\n    finally\n    {\n        PrefabUtility.UnloadPrefabContents(uiBRoot);\n    }\n}\n\nAssetDatabase.SaveAssets();\n\n// Print verified layout coordinates in Match.unity\nforeach (Transform tr in Resources.FindObjectsOfTypeAll<Transform>())\n{\n    if (!tr.gameObject.scene.IsValid()) continue;\n    if (tr.name == \"Tier Button Manager\" && tr.parent != null &&\n        (tr.parent.name == \"Faction A: Tyc\" || tr.parent.name == \"Faction B: Eco\" || tr.parent.name == \"Faction C: Sci\"))\n    {\n        sb.Append(tr.parent.name + \" TBM: \");\n        for (int i = 0; i < tr.childCount; i++)\n        {\n            RectTransform rt = tr.GetChild(i) as RectTransform;\n            sb.Append(rt.name + \"(x=\" + rt.anchoredPosition.x.ToString(\"F1\") + \",w=\" + rt.sizeDelta.x.ToString(\"F1\") + \") \");\n        }\n        sb.AppendLine();\n    }\n    if (tr.name == \"AB.Tier 5\" && tr.parent != null && tr.parent.name == \"Faction A: Tyc\")\n    {\n        sb.AppendLine(\"Faction A: Tyc / AB.Tier 5 PTPI count: \" + tr.GetComponents<ProductionTierPageIntegration>().Length);\n    }\n}\n\n// Render visual preview of Faction A: Tyc Tier Button Manager + Player Faction Controller\nGameObject hudObj = GameObject.Find(\"HUD (Bot Building Window)\");\nif (hudObj != null)\n{\n    GameObject tempRoot = new GameObject(\"__TEMP_UIPreview\");\n    tempRoot.transform.position = new Vector3(0f, 800f, 0f);\n    Camera uiCam = null; RenderTexture rt = null; Texture2D tex = null;\n    try\n    {\n        GameObject camGo = new GameObject(\"UICam\");\n        camGo.transform.SetParent(tempRoot.transform, false);\n        camGo.transform.localPosition = new Vector3(0f, 0f, -10f);\n        uiCam = camGo.AddComponent<Camera>();\n        uiCam.orthographic = true;\n        uiCam.orthographicSize = 180f;\n        uiCam.clearFlags = CameraClearFlags.SolidColor;\n        uiCam.backgroundColor = new Color(0.14f, 0.22f, 0.28f, 1f);\n\n        GameObject cvsGo = new GameObject(\"TempCanvas\", typeof(RectTransform), typeof(Canvas), typeof(UnityEngine.UI.CanvasScaler));\n        cvsGo.transform.SetParent(tempRoot.transform, false);\n        Canvas cvs = cvsGo.GetComponent<Canvas>();\n        cvs.renderMode = RenderMode.ScreenSpaceCamera;\n        cvs.worldCamera = uiCam;\n        cvs.planeDistance = 5f;\n        UnityEngine.UI.CanvasScaler cs = cvsGo.GetComponent<UnityEngine.UI.CanvasScaler>();\n        cs.uiScaleMode = UnityEngine.UI.CanvasScaler.ScaleMode.ConstantPixelSize;\n\n        Transform tycSrc = hudObj.transform.Find(\"Faction A: Tyc\");\n        Transform fbcSrc = hudObj.transform.Find(\"Player Faction Controller\");\n        if (tycSrc != null)\n        {\n            GameObject tycClone = UnityEngine.Object.Instantiate(tycSrc.gameObject, cvsGo.transform, false);\n            tycClone.SetActive(true);\n            RectTransform trt = tycClone.GetComponent<RectTransform>();\n            trt.anchorMin = new Vector2(0.5f, 0.5f);\n            trt.anchorMax = new Vector2(0.5f, 0.5f);\n            trt.pivot = new Vector2(0.5f, 0.5f);\n            trt.anchoredPosition = new Vector2(0f, 380f); // Show Tier Button Manager near center of screen\n            Transform tbm = tycClone.transform.Find(\"Tier Button Manager\");\n 