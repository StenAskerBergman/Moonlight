{"ts":"2026-11-15T17:55:11.410Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1544,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n\n// 1. All LineRenderers & TrailRenderers in scene\nvar lrs = UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.LineRenderer>();\nsb.AppendLine(\"=== Scene LineRenderers ===\");\nfor (int i = 0; i < lrs.Length; i++) {\n    var lr = lrs[i];\n    if (UnityEditor.EditorUtility.IsPersistent(lr.gameObject)) continue;\n    string path = lr.gameObject.name;\n    var p = lr.transform.parent;\n    while (p != null) { path = p.name + \"/\" + path; p = p.parent; }\n    sb.AppendLine(\"  LR: \" + path + \" act=\" + lr.gameObject.activeInHierarchy + \" en=\" + lr.enabled + \" posCount=\" + lr.positionCount);\n}\n\n// 2. Any SpriteRenderer or MeshRenderer on SelectionBar, UnitDrag, Canvas, Camera Rig, Camera Target\nvar camRig = UnityEngine.GameObject.Find(\"Camera Rig\");\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\nif (camRig != null) {\n    sb.AppendLine(\"=== Camera Rig Components & Fields ===\");\n    var cr = camRig.GetComponent<CameraRig>();\n    if (cr != null) {\n        var so = new UnityEditor.SerializedObject(cr);\n        var sp = so.GetIterator();\n        while (sp.NextVisible(true)) {\n            if (sp.propertyType == UnityEditor.SerializedPropertyType.ObjectReference)\n                sb.AppendLine(\"  CameraRig.\" + sp.propertyPath + \" = \" + (sp.objectReferenceValue != null ? sp.objectReferenceValue.name : \"null\"));\n        }\n    }\n}\n\n// 3. Check ALL objects named Selected or Selection in scene\nvar allGs = UnityEngine.Resources.FindObjectsOfTypeAll<UnityEngine.GameObject>();\nsb.AppendLine(\"=== Selection-named Scene Objects ===\");\nfor (int i = 0; i < allGs.Length; i++) {\n    var go = allGs[i];\n    if (UnityEditor.EditorUtility.IsPersistent(go)) continue;\n    if (go.name.ToLower().Contains(\"select\") || go.name.ToLower().Contains(\"order\") || go.name.ToLower().Contains(\"ring\")) {\n        string path = go.name;\n        var p = go.transform.parent;\n        while (p != null) { path = p.name + \"/\" + path; p = p.parent; }\n        sb.AppendLine(\"  GO: \" + path + \" act=\" + go.activeSelf + \" actHier=\" + go.activeInHierarchy + \" pos=\" + go.transform.position + \" lPos=\" + go.transform.localPosition + \" lScale=\" + go.transform.localScale);\n    }\n}\n\n// 4. Inspect MapGrid Terrain Materials, Shaders, and Island/Plateau seam on Island 47 vs Plateau 45, Island 33 vs Plateau 35\nforeach (string chunkName in new string[] { \"Island 47\", \"Plateau 45\", \"Island 33\", \"Plateau 35\", \"Island 31\", \"Island 19\", \"Island 17\", \"Plateau 43\", \"Island 29\" }) {\n    var go = UnityEngine.GameObject.Find(chunkName);\n    if (go == null) continue;\n    var mr = go.GetComponent<UnityEngine.MeshRenderer>();\n    var mg = go.GetComponent<MapGrid>();\n    var sm = mr != null ? mr.sharedMaterial : null;\n    string subNames = \"\";\n    for (int c = 0; c < go.transform.childCount; c++) {\n        var ch = go.transform.GetChild(c);\n        var cr = ch.GetComponent<UnityEngine.Renderer>();\n        subNames += ch.name + \"(act=\" + ch.gameObject.activeSelf + (cr != null && cr.sharedMaterial != null ? \",mat=\" + cr.sharedMaterial.name : \"\") + \") \";\n    }\n    sb.AppendLine(\"Chunk \" + chunkName + \" type=\" + mg.currentGridType + \" mat=\" + (sm != null ? sm.name : \"null\") + \" children=[\" + subNames + \"]\");\n}\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
