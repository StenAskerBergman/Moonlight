{"ts":"2026-11-15T18:48:07.267Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":41041,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mm = UnityEngine.Object.FindObjectOfType<MapManager>();\nmm.RegenerateMap();\nvar tf = mm.GetTerrainField();\nvar flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public;\nvar sourcesList = tf.GetType().GetField(\"sources\", flags).GetValue(tf) as System.Collections.IList;\nvar gtFld = typeof(IslandTerrainProvider).GetField(\"gridType\", flags);\nvar orgFld = typeof(IslandTerrainProvider).GetField(\"chunkWorldOrigin\", flags);\nvar szFld = typeof(IslandTerrainProvider).GetField(\"size\", flags);\nvar cacheFld = typeof(IslandTerrainProvider).GetField(\"sampleCache\", flags);\n\nfor (int e = 0; e < sourcesList.Count; e++)\n{\n    var src = sourcesList[e] as IslandTerrainProvider;\n    if (src == null) continue;\n    if (!object.Equals(gtFld.GetValue(src), GridType.Type.Island)) continue;\n    var cache = cacheFld.GetValue(src) as TerrainSampleCache;\n    if (cache == null) continue;\n    int r = cache.Resolution;\n    float maxCoastJ = 0f, maxRivJ = 0f, maxOtherJ = 0f;\n    int cX = 0, cZ = 0, rX = 0, rZ = 0;\n    float rC0 = 0f, rC1 = 0f;\n    for (int z = 0; z < r; z++)\n    for (int x = 0; x < r; x++)\n    {\n        int i0 = z * r + x;\n        float h0 = cache.Heights[i0];\n        if (x + 1 < r)\n        {\n            int i1 = i0 + 1;\n            float d = Mathf.Abs(cache.Heights[i1] - h0);\n            bool hasRiv = cache.RiverCarveDepths[i0] > 0.001f || cache.RiverCarveDepths[i1] > 0.001f;\n            bool inCoast = cache.ShoreDistances[i0] > -26f && cache.ShoreDistances[i0] < 8f;\n            if (hasRiv) { if (d > maxRivJ) { maxRivJ = d; rX = x; rZ = z; rC0 = cache.RiverCarveDepths[i0]; rC1 = cache.RiverCarveDepths[i1]; } }\n            else if (inCoast) { if (d > maxCoastJ) { maxCoastJ = d; cX = x; cZ = z; } }\n            else { if (d > maxOtherJ) maxOtherJ = d; }\n        }\n        if (z + 1 < r)\n        {\n            int i1 = i0 + r;\n            float d = Mathf.Abs(cache.Heights[i1] - h0);\n            bool hasRiv = cache.RiverCarveDepths[i0] > 0.001f || cache.RiverCarveDepths[i1] > 0.001f;\n            bool inCoast = cache.ShoreDistances[i0] > -26f && cache.ShoreDistances[i0] < 8f;\n            if (hasRiv) { if (d > maxRivJ) { maxRivJ = d; rX = x; rZ = z; rC0 = cache.RiverCarveDepths[i0]; rC1 = cache.RiverCarveDepths[i1]; } }\n            else if (inCoast) { if (d > maxCoastJ) { maxCoastJ = d; cX = x; cZ = z; } }\n            else { if (d > maxOtherJ) maxOtherJ = d; }\n        }\n    }\n    Vector2 org = (Vector2)orgFld.GetValue(src);\n    int sz = (int)szFld.GetValue(src);\n    sb.AppendLine(string.Format(\"src[{0}] org=({1:F0},{2:F0}) sz={3} coastJ={4:F3}({5},{6}) rivJ={7:F3}({8},{9} rc:{10:F2}->{11:F2}) otherJ={12:F3}\",\n        e, org.x, org.y, sz, maxCoastJ, cX, cZ, maxRivJ, rX, rZ, rC0, rC1, maxOtherJ));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"codedom"}}
