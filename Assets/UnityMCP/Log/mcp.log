wholeDarkTint++;\n                    if (wHits.Count < 15)\n                        wHits.Add(string.Format(\"({0:F2},{1:F2}) y={2:F2} tc=({3:F2},{4:F2},{5:F2}) cc=({6:F2},{7:F2},{8:F2},{9:F2})\",\n                            x / 6f, -90f + z / 6f, my, tc.r, tc.g, tc.b, cc.r, cc.g, cc.b, cc.a));\n                }\n            }\n        }\n        sb.AppendLine(\"Whole Island 31 flatland (0.65<y<1.05) darkTint(<0.55)/lowCtrl = \" + wholeDarkTint);\n        for (int i = 0; i < wHits.Count; i++) sb.AppendLine(\"  \" + wHits[i]);\n    }\n}\ncatch (System.Exception ex)\n{\n    sb.AppendLine(\"Ex: \" + ex.ToString());\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(clone);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
